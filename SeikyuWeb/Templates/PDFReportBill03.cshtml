    </style>
</head>
@{
    V_ReportBillList3 firstRow = Model.Bill.BillList3.FirstOrDefault();
}
<body class="bill">
    <div class="">
        <div class="head-wrapper">
            <div class="customer-wrapper">
                <p class="customer-address">
                    &#12306;@((firstRow?.CustomerPost)?? "")<br />
                    @((firstRow?.CustomerAddress1) ?? "")<br />
                    <p>&nbsp;</p>
                    @* @((firstRow?.CustomerAddress2) ?? "") *@
                </p>
                <p class="customer-name">
                    <span class="name">@((firstRow?.CustomerName) ?? "")</span>
                    <span class="dear">御中</span>
                </p>
            </div>
            <div class="title-wrapper">
                <div>
                    <h1 class="title">請求書</h1>
                    <p class="date">
                        <span>請求年月日</span>
                        <span>@((firstRow?.SeikyuMonth.ToString("yyyy/MM/dd")) ?? "")</span>
                        <span>@* 頁&emsp;1 *@</span>
                    </p>
                </div>
                <p class="month">@((firstRow?.SeikyuMonth.ToString("MM") ?? ""))月度分</p>
            </div>
            <div class="our-company-wrapper">
                <p class="company-name">@((firstRow?.CompanyName) ?? "")</p>
                <p class="company-info">
                    &#12306;@((firstRow?.CompanyPost) ?? "")&emsp;@((firstRow?.CompanyAddress) ?? "")<br />
                    TEL&nbsp;@((firstRow?.CompanyPhone) ?? "")<br />
                    FAX&nbsp;@((firstRow?.CompanyFax) ?? "")<br />
                    <span class="register-number">登録番号：@((firstRow?.CompanyInfoBank) ?? "")</span>
                </p>
            </div>
        </div>
        <div class="total-bill">
            <div class="bill-info">
                <p class="id">@((firstRow?.CustomerCode) ?? "")</p>
                <p class="message">
                    毎度お引立て有難うございます。下記の通りご請求申し上げます。
                </p>
                <p class="bank">
                    ＜振込銀行＞<span class="note">※振込手数料は貴社負担でお願い致します。</span><br />
                    広島銀行&emsp;広島西支店&emsp;&emsp;当座609650
                </p>
            </div>

            <div class="total-table-wrapper">
                <table style="width: 85%">
                    <thead>
                        <tr>
                            <th style="width: 11.11%">前回請求額</th>
                            <th style="width: 11.11%">今回入金額</th>
                            <th style="width: 11.11%">(内 値引・調整)</th>
                            <th style="width: 10%">繰越残高</th>
                            <th style="width: 12%">今回売上免税額</th>
                            <th style="width: 11.11%">
                                今回売上課税<br />対象額(10%)
                            </th>
                            <th style="width: 11.11%">今回売上<br />消費税額(10%)</th>
                            <th style="width: 11.11%">今回請求額</th>
                            <th style="width: 11.11%">請求合計額</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@(firstRow?.Seikyu_Previous.ToString("N0") ?? "")</td>
                            <td>@(firstRow?.Received_Amount_This.ToString("N0") ?? "")</td>
                            <td>@(firstRow?.Discount.ToString("N0") ?? "")</td>
                            <td>@(firstRow?.Balance_Forward.ToString("N0") ?? "")</td>
                            <td>@(firstRow?.TaxFreePrice.ToString("N0") ?? "")</td>
                            <td>@(firstRow?.Taxable_Amount.ToString("N0") ?? "")</td>
                            <td>@(firstRow?.Tax_Amout.ToString("N0") ?? "")</td>
                            <td>@(Model.Bill.SeikyuUnchin?.ToString("N0") ?? "")</td>
                            <td>@(firstRow?.Seikyu_Total_Amount.ToString("N0") ?? "")</td>
                        </tr>
                    </tbody>
                </table>
                <div class="sign-boxes">
                    <div class="sign"></div>
                    <div class="sign"></div>
                </div>
            </div>
        </div>

        <div class="table-detail-wrap">
            <table class="rows">
                <thead>
                    <tr>
                        <th style="width: 4%">日付</th>
                        <th style="width: 4%">車番</th>
                        <th style="width: 10%">車&emsp;種</th>
                        <th style="width: 10%">発&emsp;地</th>
                        <th style="width: 10%">着&emsp;地</th>
                        <th style="width: 7%">作業時間</th>
                        <th style="width: 11%">品&emsp;名</th>
                        <th style="width: 5%">数&emsp;量</th>
                        <th style="width: 4%">単位</th>
                        <th style="width: 6%">単価</th>
                        <th style="width: 8%">運&emsp;賃</th>
                        <th style="width: 8%">運賃等(免税)</th>
                        <th style="width: 8%">合計金額</th>
                        <th style="width: 5%">摘&emsp;要</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        TNyukin nyukin = Model.Bill.Nyukin;
                        decimal totalAmount = 0;
                        if (nyukin != null)
                        {
                            if (nyukin.CashAmount > 0)
                            {
                                <tr class="sub-header">
                                    <td class="text-center">@nyukin.ProcessDate.ToString("MM/dd")</td>
                                    <td class="text-center"></td>
                                    <td class="text-left"></td>
                                    <td class="text-left"></td>
                                    <td class="text-left"></td>
                                    <td class="text-left"></td>
                                    <td class="text-left">現金</td>
                                    <td></td>
                                    <td class="text-left"></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td>@nyukin.CashAmount.ToString("N0")</td>
                                    <td class="text-left"></td>
                                </tr>
                                totalAmount += nyukin.CashAmount;
                            }
                            if (nyukin.TransferAmount > 0)
                            {
                                <tr class="sub-header">
                                    <td class="text-center">@nyukin.ProcessDate.ToString("MM/dd")</td>
                                    <td class="text-center"></td>
                                    <td class="text-left"></td>
                                    <td class="text-left"></td>
                                    <td class="text-left"></td>
                                    <td class="text-left"></td>
                                    <td class="text-left">振込</td>
                                    <td></td>
                                    <td class="text-left"></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td>@nyukin.TransferAmount.ToString("N0")</td>
                                    <td class="text-left"></td>
                                </tr>
                                totalAmount += nyukin.TransferAmount;
                            }
                            if (nyukin.DraftAmount > 0)
                            {
                                <tr class="sub-header">
                                    <td class="text-center">@nyukin.ProcessDate.ToString("MM/dd")</td>
                                    <td class="text-center"></td>
                                    <td class="text-left"></td>
                                    <td class="text-left"></td>
                                    <td class="text-left"></td>
                                    <td class="text-left"></td>
                                    <td class="text-left">手形</td>
                                    <td></td>
                                    <td class="text-left"></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td>@nyukin.DraftAmount.ToString("N0")</td>
                                    <td class="text-left"></td>
                                </tr>
                                totalAmount += nyukin.DraftAmount;
                            }
                            if (nyukin.CheckAmount > 0)
                            {
                                <tr class="sub-header">
                                    <td class="text-center">@nyukin.ProcessDate.ToString("MM/dd")</td>
