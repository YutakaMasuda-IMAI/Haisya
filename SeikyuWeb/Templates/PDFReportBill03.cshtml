        /* 共通のテーブルスタイル */
        .bill table {
            width: 100%;
            /* margin-inline: auto; */
            margin: auto;
            border-top: 1px solid #000;
            border-collapse: collapse;
            /* table-layout: fixed; */
        }

            .bill table td, .bill table th {
                /* border-inline: 1px solid #000;
                padding-inline: 5px; */
                border-left: 1px solid #000;
                border-right: 1px solid #000;
                padding-left: 5px;
                padding-right: 5px;
                line-height: 140%;
                text-align: right; /* セルはデフォルトで右寄せ */
                break-inside: avoid; /* テーブルの行で改ページ禁止 */
                page-break-inside: avoid;
            }

        .bill .table-detail-wrap {
            page-break-after: always;
        }
        /* .bill table td:is(.text-right), .bill table th:is(.text-right) {
                  text-align: right;
                } */
        .bill table td.text-right, .bill table th.text-right {
            text-align: right;
        }

        /* .bill table td:is(.text-left), .bill table th:is(.text-left) {
                  text-align: left;
                } */
        .bill table td.text-left, .bill table th.text-left {
            text-align: left;
        }

        /* .bill table td:is(.text-center), .bill table th:is(.text-center) {
                  text-align: center;
                } */
        .bill table td.text-center, .bill table th.text-center {
            text-align: center;
        }

        /* テーブルヘッダー */
        .bill table thead th {
            border-left: 1px solid #000;
            border-right: 1px solid #000;
            padding: 2px;
        }

        .bill table tbody tr {
            page-break-inside: avoid !important;
            -webkit-column-break-inside: avoid;
            break-inside: avoid;
            -webkit-region-break-inside: avoid;
            page-break-after: auto !important;
            border-top: 1px solid #fff;
        }

        .bill table thead tr th {
            background-color: #d9d9d9;
            font-size: 16px;
            font-weight: bold;
            text-align: center;
            vertical-align: middle;
            /* padding-block: 2px; */
            padding: 2px;
        }

        /* テーブルボディ */
        .bill table tbody tr td {
            word-break: break-all;
            word-wrap: break-word;
            font-size: 12.34px;
            white-space: normal;
            overflow: hidden;
            vertical-align: top;
            /* border-bottom: 1px solid #fff; */
            
            page-break-inside: avoid;
            page-break-after: auto;
        }

        .bill table tbody tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        /* 小計 */
        /* .bill table tbody tr:is(.sub-total) td {
                border-block: 1px solid #000;
              } */
        .bill table tbody tr.sub-total td {
            border: 1px solid #000;
        }

        .bill .sub-total {
            background-color: #f2f2f2;
        }

        /* テーブルフッター */
        .bill table tfoot tr td {
            font-size: 12.8px;
            border: none;
            padding: 2px;
            border-top: 1px solid #000;
        }

        .bill .tfoot3 {
            /* display: table-footer-group;
            page-break-after: always; */
            page-break-inside: avoid !important;
            -webkit-column-break-inside: avoid;
            break-inside: avoid;
            -webkit-region-break-inside: avoid;
            page-break-after: auto !important;
        }
            .bill table tfoot tr td .total-number {
                /* padding-block-start: 2px; */
                padding-top: 2px;
                width: 100%;
                border: 1px solid #000;
                white-space: nowrap;
                overflow: hidden;
            }
        .bill .tfoot3 {
            /* border-top: 1px solid #000; */
            display: -webkit-box;
            display: -moz-box;
            display: -ms-flexbox;
            display: -webkit-flex;
            display: flex;
            width: 100%;
            align-items: center;
            line-height: 1.5;
            /* padding-top: 3px; */
            padding-top: 3px;
        }

            .bill .tfoot3 .num-box {
                display: -webkit-box;
                display: -moz-box;
                display: -ms-flexbox;
                display: -webkit-flex;
                display: flex;
                align-items: center;
                border: 1px solid #000;
                width: 30%;
                margin-left: 80px;
            }

                .bill .tfoot3 .num-box .text {
                    width: -webkit-fit-content;
                    width: -moz-fit-content;
                    width: fit-content;
                    padding: 0 8px;
                }

                .bill .tfoot3 .num-box .bg {
                    background-color: #d9d9d9;
                    font-weight: bold;
                    text-align: center;
                }

                .bill .tfoot3 .num-box .text-number {
