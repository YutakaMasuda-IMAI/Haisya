                text-align: right;
                -webkit-box-sizing: border-box;
                -moz-box-sizing: border-box;
                box-sizing: border-box;
                /* padding-right: 2px; */
                padding-right: 2px;
            }

                .bill .tfoot3 .total-number:last-child {
                    /* border-right: 1px solid #000; */
                    border-right: 1px solid #000;
                }
        .bill .tfoot4 .total-number {
