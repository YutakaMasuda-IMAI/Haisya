<script>


  $(function () {

    setTimeout(function () {
      $('.modal-backdrop')
        .not('.modal-stack')
        .css('z-index', 1239)
        .addClass('modal-stack');
    }, 0);

    var disp = new Date($("#Search_SelectDay").val());

    /** 日付を文字列にフォーマットする */
    var formatted = `${disp.getFullYear()}\年${(disp.getMonth() + 1).toString().padStart(2, '0')}\月`.replace(/\n|\r/g, '');
    $("input#TargetDayLavelModal").val(formatted);


    //$(".calenderModal").datepicker({
    //  buttonImage: "../img/calender.png",        // カレンダーアイコン画像
    //  buttonText: "カレンダーから選択", // ツールチップ表示文言
    //  buttonImageOnly: true,           // 画像として表示
    //  showOn: "both",                   // カレンダー呼び出し元の定義
    //  dateFormat: "yy\年mm\月",
    //});


  });

  function selectedChangeDayModal(move) {
    var dt = new Date($('#Search_SelectDay').val());
    dt.setMonth(dt.getMonth() + move);
    $("#Search_SelectDay").val(formatDateModal(dt));

    /** 日付を文字列にフォーマットする */
    var formatted = `${dt.getFullYear()}\年${(dt.getMonth() + 1).toString().padStart(2, '0')}\月`.replace(/\n|\r/g, '');
    $("input#TargetDayLavelModal").val(formatted);
    dataListDisplay();
  };

  function formatDateModal(date) {
    var yyyy = date.getFullYear();
    var mm = ('00' + (date.getMonth() + 1)).slice(-2);
    var dd = ('00' + date.getDate()).slice(-2);
    const ymd = String(yyyy) + '/' + String(mm) + '/' + String(dd);
    return ymd;
  };


</script>
