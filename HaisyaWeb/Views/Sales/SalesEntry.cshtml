   // バリデーション関数
  function validateForm() {
    var isValid = true;
    var errorMessages = [];

    // オーバーペイメント理由のバリデーション
    if ($('#overpaymentReasonContainer').is(':visible')) {
      if (!$("#Uriage_Shiharai_Over_Kubun").val()) {
        isValid = false;
        errorMessages.push("支払超過区分を選択してください。");
      }
      if (!$("#Uriage_Shiharai_Over_Reason").val()) {
        isValid = false;
        errorMessages.push("支払超過理由を入力してください。");
      }
    }

    // 立替超過理由のバリデーション
    if ($('#advanceOverpaymentReasonContainer').is(':visible')) {
      if (!$("#Uriage_Tatekae_Over_Kubun").val()) {
        isValid = false;
        errorMessages.push("立替超過区分を選択してください。");
      }
      if (!$("#Uriage_Tatekae_Over_Reason").val()) {
        isValid = false;
        errorMessages.push("立替超過理由を入力してください。");
      }
    }

    // uriageDataのバリデーション
    if ($('#entry').is(':visible')) {
      if (!$("#entry").val()) {
        isValid = false;
        errorMessages.push("請求区分を選択してください。");
      }
    }

    if ($(".billing-info-item").length > 0) {
      $(".billing-info-item").each(function (index) {
        var $item = $(this);
        if (!$item.find("#endDateTime").val() || !$item.find("#closingDay").val() ||
          !$item.find("#KokyakuId").val() || !$item.find("#KazeiKubun").val()) {
          isValid = false;
          errorMessages.push(`請求情報 ${index + 1}: すべての必須項目を入力してください。`);
        }
      });
    }

    // futanTableBodyのバリデーション
    if ($("#futanTableBody tr:not(.kaishafutan_add)").length > 0) {
      $("#futanTableBody tr:not(.kaishafutan_add)").each(function(index) {
        var $row = $(this);
        if (!$row.find("input[name$='.FutanPrice']").val()) {
          isValid = false;
          errorMessages.push(`負担情報 ${index + 1}: 負担額を入力してください。`);
        }
      });
    }

    if ($(".under-payment-item").length > 0) {
      // under-payment-itemのバリデーション
      $(".under-payment-item").each(function(index) {
        var $item = $(this);

        // 赤伝行はチェック対象外
        if ($item.find("#IsCreditSlip").val()) {
          return true;
        }

        if (!$item.find("#endDateTime").val() || !$item.find("#closingDay").val() ||
          !$item.find("#KazeiKubun").val() ||
          (!$item.find("#underPayment").val() && !$item.find("#advance").val() && !$item.find("#surcharge").val())) {
          isValid = false;
          errorMessages.push(`下払情報 ${index + 1}: すべての必須項目を入力してください。`);
        }
      });
    }

    if ($("#uriageUnsyuTableBody tr:not(.templateRow)").length > 0) {
      // uriageUnsyuTableBodyのバリデーション
      $("#uriageUnsyuTableBody tr:not(.templateRow)").each(function(index) {
        var $row = $(this);

        // 運収赤伝元行はチェック対象外
        if ($row.hasClass('akadenRow')) {
          return true;
        }

        // 金額フィールドのチェック
        var hasAmount = parseFloat(kanmaChangeRevert($row.find("#Seisan").val()) || 0) +
                parseFloat(kanmaChangeRevert($row.find("#KojinFutan").val()) || 0) +
                parseFloat(kanmaChangeRevert($row.find("#KojinUnsyu").val()) || 0) +
                parseFloat(kanmaChangeRevert($row.find("#routeAllowance").val()) || 0) +
                parseFloat(kanmaChangeRevert($row.find("#routeOvertime").val()) || 0) +
                parseFloat(kanmaChangeRevert($row.find("#routeMidnight").val()) || 0);

        // ProcessingCategoryが"直接入力"の場合はUnsyu_Dateのチェックを省略
        if (ProcessingCategory === "直接入力") {
          if (!hasAmount) {
            isValid = false;
            errorMessages.push(`運収情報 ${index + 1}: 少なくとも1つの金額を入力してください。`);
          }
        } else {
          // それ以外の場合は従来通りUnsyu_Dateもチェック
          if (!$('#Unsyu_Date').val() || (hasAmount==0)) {
            isValid = false;
            errorMessages.push(`運収情報 ${index + 1}: 運収日と少なくとも1つの金額を入力してください。`);
          }
        }
      });
    }

    // 直接入力の場合の追加バリデーション
    if (ProcessingCategory === "直接入力") {
      if (!$("#salesDay").val() || !$("#KokyakuId2").val() || $("#KokyakuId2").val() === '0' ||
        !$("#seikyuSelectedValue").val() || !$("#uriageSelectedValue").val() ||
        !$("#Uriage_Direct_Seikyu_Group_ID").val()) {
        isValid = false;
        errorMessages.push("直接入力の場合、売上日、顧客、売上区分、売上事業部門、請求担当はすべて必須です。");
      }
    }

    if (!isValid) {
      alertError(errorMessages.join("\n"));
    }

    return isValid;
  }

