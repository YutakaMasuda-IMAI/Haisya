  function compareUriageUnchin() {
    if (@((Model.ProcessingCategory != "案件請求" && Model.ProcessingCategory != "直接入力").ToString().ToLower())) {
      return true;
    }

    var modelUriageUnchin = @Html.Raw(Json.Serialize(Model.UriageUnchin));

    // モデルのUriage_Unchin_IDをキーとしたマップを作成s
    var modelUnchinMap = new Map(modelUriageUnchin.map(item => [item.uriage_Unchin_ID, item]));

    // フォームの項目数がモデルと異なる場合は即座にfalseを返す
    if ($(".billing-info-item").length !== modelUriageUnchin.length && !(hasDefaultRow && $(".billing-info-item").length == 1)) {
      return false;
    }
    var isMatched = true;
    if (hasDefaultRow){
      return !contentChanged;
    }

    if ($(".billing-info-item").length > 0) {
      $(".billing-info-item").each(function() {
        var $item = $(this);
        var uriageUnchinId = parseInt($item.find("input[name$='.Uriage_Unchin_ID']").val());

        // モデルに存在しないIDがある場合は即座にfalseを返す
        if (!modelUnchinMap.has(uriageUnchinId)) {
          isMatched = false;
          return false;
        }

        var modelItem = modelUnchinMap.get(uriageUnchinId);
        // 各フィールドを比較
        if (
          $item.find("#endDateTime").val() + "T00:00:00" !== modelItem.seikyu_Date ||
          parseInt($item.find("#closingDay").val()) !== modelItem.shime_Day ||
          parseInt($item.find("#KokyakuId").val()) !== modelItem.customer_Branch_ID ||
          $item.find("#Tsumi").val() !== modelItem.tsumi ||
          $item.find("#Oroshi").val() !== modelItem.oroshi ||
          $item.find("#ItemName").val() !== modelItem.luggage ||
          parseFloat(kanmaChangeRevert($item.find("#quantity").val())) !== modelItem.qty ||
          ((parseInt($item.find("#SelectedUnit").val()) || 0) !== modelItem.unit && modelItem.unit > 0) ||
          parseFloat(kanmaChangeRevert($item.find("#unitPrice").val())) !== modelItem.unitPrice ||
          parseFloat(kanmaChangeRevert($item.find("#totalPrice").val())) !== modelItem.calcPrice ||
          parseFloat(kanmaChangeRevert($item.find("#SeikyuUnchin").val())) !== modelItem.seikyuUnchin ||
          parseFloat(kanmaChangeRevert($item.find("#TatekaekinTotal").val())) !== modelItem.tatekaekin ||
          parseFloat(kanmaChangeRevert($item.find("#SeikyuTotal").val())) !== modelItem.seikyuTotal ||
          parseInt($item.find("#KazeiKubun").val()) !== modelItem.zei_Kubun)
          {

          isMatched = false;
          return false;
        }
      });
    }
    return isMatched;
  }

