      // 顧客担当はクリア
      $('#CustomerTantouID').val("");
      $('#CustomerTantouCD').val("");
      $('#CustomerTantouName').val("");

      $.ajax({
        url: '@Url.RouteUrl("Default", new { controller = "Sales", action = "GetCustomerSeikyusaki" })',
        type: 'GET',
        contentType: 'application/json',
        data: { Customer_ID: parseInt(obj["Customer_Branch_ID"], 10) },
        success: function(response) {
          if (response.errorMessage != null) {
          alertError(`【エラー】${response.errorMessage}`);
          }
          $('#seikyuCustomerId').text(response.customerSeikyusaki);
          $('#seikyuRemarks').text(response.seikyuRemarks);
          $('#shiharaiRemarks').text(response.shiharai_Remarks);
          $('#shimeDay').text(response.shime_Day);
          return false;
        },
        error: function(xhr) {
          alertError('【ネットワークエラー】:' + xhr);
          console.log(xhr);
        },
        complete: async function(xhr, msg) {
        }
      });
    }
    ModalClose();
    currentButton = null;
    currentContainerIndex = null; // リセット
  }

