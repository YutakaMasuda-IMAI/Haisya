// キャンセルボタン押下時、前のページに戻る
async function CancelButton() {
  event.preventDefault();

  //var modelUriage_ID = @Html.Raw(Json.Serialize(Model.Uriage?.Uriage_ID ?? 0));
    if (!compareUriage() || !compareUriageUnchin() || !compareUriageShiharai() || !compareUriageUnsyu() || !compareUriageFutan()) {
      let result = await alertYesNoMsg("確認", "データが変更されていますが、遷移しますか？", "question", "はい", "いいえ")
      if (result == false)
         return;
    }

    go_back();
}

  function go_back() {
    var form = document.createElement('form');

    form.action = '@Url.RouteUrl("Default", new { controller = "SalesPayment", action = "Index" })';
    form.method = 'POST';
    form.innerHTML = $('#hiddenItem').html();
    document.body.appendChild(form);

    form.submit();
  }

  // 会社負担の削除ボタン押下時の削除処理
  function deleteFutanRow(button) {
  var row = button.parentNode.parentNode;
  row.parentNode.removeChild(row);
  }

  function enableAddButtons(){
    let disable = rowCount == 0 && UnderPaymentrowCount > 0;
    $('#addRowButton').prop('disabled', disable);
    $('#addItemButton').prop('disabled', disable);
  }

  function updateShimedayOption(datePicker, shimeDay = 0) {
    var date = datePicker.val() ? new Date(datePicker.val()) : new Date();
    var daysInMonth = new Date(date.getFullYear(), date.getMonth() + 1, 0).getDate();

    var $closingDay = datePicker.closest('tr').find('#closingDay');
    var currentSelectedDay = shimeDay > 0 ? shimeDay : $closingDay.val();

    $closingDay.empty();
    for (var i = 1; i <= daysInMonth; i++) {
      $closingDay.append($('<option>', {
        value: i,
        text: i
      }));
    }
    if (currentSelectedDay > daysInMonth){
      currentSelectedDay = daysInMonth;
    }
    $closingDay.val(currentSelectedDay);
  }
</script>
