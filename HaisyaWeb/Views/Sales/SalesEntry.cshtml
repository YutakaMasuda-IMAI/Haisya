  function selectCompanyDriverSelectedCallBack(obj) {
    var $templateRow = $('.templateRow');
      var $newRow = $templateRow.clone(true);
      $newRow.show();
      $newRow.removeClass('templateRow');

      var index = $('#uriageUnsyuTableBody tr').length - 1;
      $newRow.attr('data-index', index);

      $newRow.find('input').each(function() {
        var id = $(this).attr('id');
        $(this).attr('data-index', index);
        if (id === 'Driver_ID') {
          $(this).val(obj["Driver_ID"]);
        } else if (id === 'EmployeeNumber') {
          $(this).val(obj["Employee_Number"]);
        } else if (id === 'SyaryoManagementID') {
          $(this).val(obj["SyaryoManagement_ID"]);
        } else if (id === 'DisplayName') {
          $(this).val(obj["Display_Name"]);
        } else if (id === 'SyabanNumber')
          $(this).val(obj["Syaban_Number"]);
      });

      $('#uriageUnsyuTableBody').append($newRow);
  };


