@model HaisyaWeb.Dto.SalesModel

@{
  Layout = "_Layout";
  ViewData["Title"] = "売上・下払入力";
  var hasDefaultRow = 0;
  var rowCount = Model.UriageUnchin.Count > 0 ? Model.UriageUnchin.Count : 0;
}

<link href="~/css/Entry.css" rel="stylesheet" />
<style>
  div.all {
    display: block;
    width: 100%;
    border: #DEE2E6 1px solid;
    font-size: 14px;
  }

  div.top-side {
    display: block;
    width: 100%;
    padding: 0 15px 0 15px;
  }

  div.all-side {
    display: flex;
    width: 100%;
  }

  div.left-side {
    display: block;
    width: 1000px;
    padding: 0 15px 25px 15px;
    border-right: #DEE2E6 1px solid;
  }

  div.right-side {
    display: block;
    width: 100%;
    padding: 0 15px 25px 15px;
  }

  th.detail-list {
    background-color: rgba(250, 231, 162, 1);
  }

  th.detail-list2 {
    background-color: rgba(194, 215, 236, 1);
  }

  th.additional_fees_list {
    background-color: rgba(241, 205, 176, 1);
  }

  th.luggage_list {
    background-color: rgba(250, 231, 162, 1);
  }

  th.route_list {
    background-color: rgba(198,224,180, 1);
  }

  th.total_toll_list {
    background-color: rgba(250, 231, 162, 1);
  }

  th.toll_list {
    background-color: rgba(202, 221, 185, 1);
  }

  th.unchin-list {
    background-color: rgba(250, 231, 162, 1);
  }

  th.kojin-list {
    background-color: rgba(219, 219, 219, 1);
  }

  th.kaisya-futan-list {
    background-color: rgba(250, 231, 162, 1);
  }
  .btn-uriage {
    text-align: center;
    background-color: PaleTurquoise;
    display: block;
    text-decoration: none;
    color: black;
    box-shadow: 3px 3px gray;
    margin: 1px;
    border-radius: 5px;
    padding: 0;
  }
</style>

<div id="hiddenItem" hidden>
  @Html.HiddenFor(model => Model.Search.RangeSearch)
  @Html.HiddenFor(model => Model.Search.SelectDay)
  @Html.HiddenFor(model => Model.Search.SelectEndDay)
  @Html.HiddenFor(model => Model.Search.ExpandSearch)
  @Html.HiddenFor(model => Model.Search.SelectFilter)
  @Html.HiddenFor(model => Model.Search.SelectGroup)
  @Html.HiddenFor(model => Model.Search.SelectTokuisakiID)
  @Html.HiddenFor(model => Model.Search.SelectTokuisakiName)
  @Html.HiddenFor(model => Model.Search.SelectTantou)
  @Html.HiddenFor(model => Model.Search.SelectSeikyuTantou)
  @Html.HiddenFor(model => Model.Search.JyoumuinID)
  @Html.HiddenFor(model => Model.Search.JyoumuinName)

  @if (Model.Search?.SelectStatus != null)
  {
    @for (var i = 0; i < Model.Search.SelectStatus.Length; i++)
    {
      <input type="hidden" id="Search_SelectStatus[@i]" name="Search.SelectStatus[@i]" value="@Model.Search.SelectStatus[i]" />
    }
  }
  @Html.HiddenFor(model => Model.Search.BackMenuAction)
</div>

<div>
  <div id="hedder" class="row">
    <div class="table-div">
      <table class="head-button">
        <tr>
          @if (Model.ProcessingCategory != "赤伝黒伝登録請求" && Model.ProcessingCategory != "赤伝黒伝登録下払")
          {
          <td><h3 id="labelTitle" class="heading-40">売上・下払入力</h3></td>
          }
          else
          {
          <td><h3 id="labelTitle" class="heading-40">赤伝黒伝入力</h3></td>
          }
          @if (Model.ProcessingCategory != "赤伝黒伝登録請求" && Model.ProcessingCategory != "赤伝黒伝登録下払")
          {
          <td><button type="button" class="btn btn-outline-dark" style="width:100px;" onClick="SubmitButton(3);">仮登録</button></td>
          <td><button type="button" class="btn btn-outline-success" style="width:120px;" onClick="SubmitButton(1);">暫定登録</button></td>
          }
          <td><button type="button" class="btn btn-outline-success" style="width:120px;" onClick="SubmitButton(2);">確定登録</button></td>
          @if (Model.ProcessingCategory != "直接入力")
          {
                <td><button type="button" class="btn btn-outline-info" style="width:120px;" onClick="submitNippouEdit();">日報修正</button></td>
          <td><button type="button" class="btn btn-outline-info" style="width:120px;" onClick="submitAnkenEdit();">案件修正</button></td>
          }
          else
          {
          @if (Model.Uriage?.Uriage_ID != 0)
          {
            <td><button type="button" class="btn btn-outline-danger" style="width:100px;" onClick="DeleteButton();">削除</button></td>
          }
          }
          <td style="text-align:right;"><button type="button" class="btn btn-outline-warning" style="width:100px;" onClick="CancelButton();">キャンセル</button></td>
        </tr>
      </table>
    </div>
  </div>
  <div class="all">
    @if ((Model.NumOfFilter == 3 || Model.HaisyaData.Haisya_Kubun == 3 || Model.HaisyaData.Haisya_Kubun == 4) && (Model.Senzoku != null) )
    {
    <div class="top-side">
      <table class="no-line" width="100%">
        <tr>
          <th style="width:120px;">専属名</th>
          <td style="width:300px;">@Html.DisplayFor(model => model.Senzoku.Senzoku_Name)</td>
          <th style="width:150px;">支払区分</th>
          @{
          string ShiharaiKubun = Model.Senzoku.Seikyu_Kubun switch
          {
            0 => "案件ごと",
            1 => "月額",
            _ => ""
          };
          }
          <td style="width:200px;">@ShiharaiKubun</td>
          <th style="width:100px;">請求計算</th>
          @{
          string feeKubunCal = Model.Senzoku.Calc_Kubun switch
          {
            0 => "月額計算",
            1 => "日額計算",
            _ => ""
          };
          string feeKubun = Model.Senzoku.Calc_Kubun switch
          {
            0 => "月額",
            1 => "日額",
            _ => ""
          };
          string feeAmount = Model.Senzoku.Calc_Kubun switch
          {
            0 => Model.Senzoku.Monthly_Fee.ToString("N0"),
            1 => Model.Senzoku.Daily_Fee.ToString("N0"),
            _ => ""
          };
          }
          <td style="width:300px;">@feeKubunCal @feeKubun @feeAmount </td>
          <td>&nbsp;</td>
        </tr>
      </table>
      <table class="no-line" width="100%">
        <tr>
          <th style="width:120px;">主専属車輌</th>
          <td style="width:300px;">@Html.DisplayFor(model => model.MasterSenzokuSyaryo)</td>
          <th style="width:150px;">主専属乗務員</th>
          <td style="width:200px;">@Html.DisplayFor(model => model.MasterSenzokuDriver)</td>
          <th style="width:200px;">主専属傭車先会社</th>
          <td style="width:300px;">@Html.DisplayFor(model => model.MasterSenzokuYosya)</td>
          <td>&nbsp;</td>
        </tr>
      </table>
    </div>
    }
    <div class="all-side">
      <div class="left-side">
        <div style="margin-top: 20px;">
        @if (Model.ProcessingCategory != "直接入力" )
        {
          <div class="table-div">
            <table class="no-line">
              @if (Model.NumOfFilter != 3 && Model.HaisyaData.Haisya_Kubun != 3 && Model.HaisyaData.Haisya_Kubun != 4)
              {
              <tr>
                <th>配車日</th>
                <td>@Model.HaisyaData.Day.ToString("yyyy年MM月dd日 (ddd)", new System.Globalization.CultureInfo("ja-JP"))</td>
              </tr>
              <tr>
                @{
                string kubunText = Model.HaisyaData.Haisya_Kubun switch
                {
                  1 => "自車",
                  2 => "傭車",
                  3 => "専属傭車",
                  4 => "自車専属",
                  5 => "自車専任",
                  _ => ""
                };
                }
                <th>@kubunText</th>
                <td style="display:flex;">
                <div style="width:40px;">車番</div><div style="width:100px;">@Html.DisplayFor(model => model.HaisyaData.SYABAN)</div>
                <div style="width:60px;">乗務員</div><div>@Html.DisplayFor(model => model.HaisyaData.Employee_Number)   @Html.DisplayFor(model => model.HaisyaData.Driver_Name)</div>
                </td>
              </tr>

              @if (Model.HaisyaData.Haisya_Kubun == 2 || Model.HaisyaData.Haisya_Kubun == 3)
              {
                <tr>
                  <th>傭車会社</th>
                  <td>@(Model.Yosya != null ? $"{Model.Yosya.Customer_Branch_Code} {Model.Yosya.Customer_Branch_Name_Abbr}" : "")</td>
                </tr>
              }
              }
            </table>
          </div>

          <div class="category-title">案件情報</div>
          <div class="table-div">
            <table class="no-line">
              <tr>
                <th style="width:80px;">配車担当</th>
                <td style="width: 80px;">@Html.DisplayFor(model => model.DisplayName)</td>
                <th style="width:60px;">案件名</th>
                <td style="width: 160px;">@Html.DisplayFor(model => model.HaisyaData.Work_Name)</td>
                <th style="width:50px;">荷主</th>
                <td>@Html.DisplayFor(model => model.HaisyaData.Customer_Name_Abbr)</td>
              </tr>
              <tr>
                <th>担当者</th>
                <td colspan="3">@Html.DisplayFor(model => model.HaisyaData.KokyakuTantouName)</td>
                <th style="width:50px;">車種</th>
                <td>@Html.DisplayFor(model => model.HaisyaData.SyasyuDisplay)</td>
              </tr>
            </table>
          </div>

          <div class="table-div">
            <table class="list">
              <tr>
                <th class="detail-list">運賃区分</th>
                <th class="detail-list">基本運賃</th>
                <th class="detail-list">追加費用</th>
                <th class="detail-list">有料道路</th>
                <th class="detail-list">値引額</th>
                <th class="detail-list">請求運賃</th>
              </tr>
              <tr>
                @{
                  string seikyuKubun = Model.AnkenDetail.SeikyuKubun switch
                  {
                  0 => "確定運賃",
                  1 => "暫定運賃",
                  _ => ""
                  };
                }
                <td style="text-align:center;">@seikyuKubun</td>
                <td style="text-align:right;">@string.Format("{0:N0}", Model.AnkenDetail.BaseFee)</td>
                <td style="text-align:right;">@string.Format("{0:N0}", Model.AnkenDetail.ExtraCharge)</td>
                <td style="text-align:right;">@string.Format("{0:N0}", Model.AnkenDetail.Toll)</td>
                <td style="text-align:right;">@string.Format("{0:N0}", Model.AnkenDetail.Discount)</td>
                <td style="text-align:right;">@string.Format("{0:N0}", Model.AnkenDetail.GrossAmount)</td>
              </tr>
              <tr>
                <th class="detail-list2">ルート</th>
                <th class="detail-list2">所要時間</th>
                <th class="detail-list2">距離</th>
                <th class="detail-list2">有料道路</th>
                <th class="detail-list2">見積原価</th>
                <th class="detail-list2">標準運賃</th>
              </tr>
              <tr>
                <td style="text-align:center;">@Html.DisplayFor(model => model.AnkenDetail.RouteTypeDisplay)</td>
                <td style="text-align:center;">@Html.DisplayFor(model => model.AnkenDetail.Route_TotalTime)</td>
                <td style="text-align:right;">@Html.DisplayFor(model => model.AnkenDetail.Route_TotalDistance)km</td>
                <td style="text-align:right;">@string.Format("{0:N0}", Model.AnkenDetail.Route_Totaltoll)</td>
                <td style="text-align:right;">@string.Format("{0:N0}", Model.AnkenDetail.Route_GrossAmountTotal)</td>
                <td style="text-align:right;">@string.Format("{0:N0}", Model.AnkenDetail.Route_StdALLFreight)</td>
              </tr>
            </table>
          </div>

          <div class="table-div" style="display:flex;">
            <table class="no-line">
              <tr>
                <td style="width: 40%; vertical-align: top;">
                  <table class="list">
                    <tr>
                      <td colspan="2" style="font-weight:bold;border:none;">追加料金明細</td>
                    </tr>
                    <tr>
                      <th class="additional_fees_list">項目</th>
                      <th class="additional_fees_list" style="width:80px;">金額</th>
                    </tr>
                    @if (Model.AddTollDto.Count() > 0)
                    {
                      @foreach (var item in Model.AddTollDto)
                      {
                        <tr>
                          <td>@item.Item</td>
                          <td style="text-align:right;">@item.Number.ToString("")</td>
                        </tr>
                      }
                    }
                    else
                    {
                      <tr>
                        <td>　</td>
                        <td style="text-align:right;">　</td>
                      </tr>
                    }
                  </table>
                </td>
                <td style="width:2%;">&nbsp;</td>
                <td style="width: 58%; vertical-align: top;">
                  <table class="list">
                    <tr>
                      <td colspan="2" style="font-weight:bold;border:none;">荷物情報</td>
                    </tr>
                    <tr>
                      <th class="luggage_list">項目</th>
                      <th class="luggage_list" style="width:80px;">数</th>
                      <th class="luggage_list" style="width:80px;">単位</th>
                    </tr>
                    @if (Model.BaggageGroupDto.Count() > 0)
                    {
                      @foreach (var item in Model.BaggageGroupDto)
                      {
                        <tr>
                          <td>@item.Item</td>
                          <td style="text-align:right;">@item.Number</td>
                          <td style="text-align:center;">@item.Unit</td>
                        </tr>
                      }
                    }
                    else
                    {
                      <tr>
                        <td></td>
                        <td style="text-align:right;">　</td>
                        <td style="text-align:center;">　</td>
                      </tr>
                    }
                  </table>
                </td>
              </tr>
            </table>
          </div>

          <div class="category-title">運行ポイント</div>
          <div class="table-div">
            @{
              var index = 0;
            }
            @foreach (var item in Model.AnkenPoint)
            {
              <table style="border: 1px solid #000000;width:100%;margin-bottom:5px;">
                <tr>
                  <td rowspan="2" style="width:20px;text-align:center;">@(index + 1)</td>
                  <td>@item.BuildingName</td>
                  <td colspan="2">@Convert.ToDateTime(item.PointDate).ToString("yyyy/MM/dd")</td>
                </tr>
                <tr>
                  <td>@item.Address</td>
                  <td style="width:80px;">@item.PointTime</td>
                  @{
                  string pointKubun = item.Kubun switch
                  {
                    1 => "積み",
                    2 => "経由",
                    9 => "卸し",
                    _ => ""
                  };
                  }
                  <td style="width:80px;">@pointKubun</td>
                </tr>
              </table>

              index++;
            }
          </div>

          <div class="category-title">日報情報</div>
          <div class="table-div">
            <table class="no-line">
              <tr>
                <th>開始日時</th>
                <td>
                  @if (Model.StartDateTime.HasValue)
                  {
                    @Convert.ToDateTime(Model.StartDateTime).ToString("yyyy/MM/dd HH:mm")
                  }
                </td>
                <th>終了日時</th>
                <td colspan="3">
                  @if (Model.EndDateTime.HasValue)
                  {
                    @Convert.ToDateTime(Model.EndDateTime).ToString("yyyy/MM/dd HH:mm")
                  }
                </td>
              </tr>
              <tr>
                <th>総走行距離</th>
                <td>@Html.DisplayFor(model => model.Nippou.Distance)km</td>
                <td colspan="4"></td>
              </tr>
              <tr>
                <th>空車回送</th>
                <td colspan="5">
                  <table class="no-line">
                    <tr>
                      <td style="width:100px;">@string.Format("{0:N0}", Model.NippouKaiso.Dllowance)</td>
                      <td style="width:150px;">@Html.DisplayFor(model => model.NippouKaisoDegitako.車輌名)</td>
                      <td>@Html.DisplayFor(model => model.NippouKaisoDegitako.乗務員名)</td>
                    </tr>
                  </table>
                </td>
              </tr>
              <tr>
                <th>泊まり</th>
                <td colspan="5">
                  <table class="no-line">
                    <tr>
                      <td style="width:100px;">@string.Format("{0:N0}", Model.NippouStay.Dllowance)</td>
                      <td style="width:150px;">@Html.DisplayFor(model => model.NippouStayDegitako.車輌名)</td>
                      <td>@Html.DisplayFor(model => model.NippouStayDegitako.乗務員名)</td>
                    </tr>
                  </table>
                </td>
              </tr>
              <tr>
                <th style="vertical-align:top;">通行代</th>
                <td style="vertical-align: top;">
                  <table class="list" style="width:200px;">
                    <tr>
                      <th class="luggage_list" style="width:100px;">負担名称</th>
                      <th class="luggage_list" style="width:100px;">金額</th>
                    </tr>
                    <tr>
                      <td style="text-align:center;">荷主負担</td>
                      <td style="text-align:right;">@string.Format("{0:N0}", Model.NinushiFutanTotal)</td>
                    </tr>
                    <tr>
                      <td style="text-align:center;">会社負担</td>
                      <td style="text-align:right;">@string.Format("{0:N0}", Model.KaishaFutanTotal)</td>
                    </tr>
                    <tr>
                      <td style="text-align:center;">個人負担</td>
                      <td style="text-align:right;">@string.Format("{0:N0}", Model.KojinFutanTotal)</td>
                    </tr>
                  </table>
                </td>
                <td colspan="4" style="vertical-align: top;">
                  <table class="list">
                    <tr>
                      <th class="route_list" style="width:80px;">区分</th>
                      <th class="route_list" style="width:auto;">出発</th>
                      <th class="route_list" style="width:60px;">金額</th>
                    </tr>
                    <tr>
                      <th class="route_list" style="width:50px;">車番</th>
                      <th class="route_list" style="width:auto;">到着</th>
                      <th class="route_list" style="width:80px;">負担</th>
                    </tr>
                    @{
                      var otherIndex = 0;
                    }
                    @if (Model.NippouTollOther != null)
                    {
                      @foreach (var item in Model.NippouTollOther)
                      {
                        <tr data-index="@otherIndex">
                          <td style="text-align:center;">
                            @Model.TollKubun.FirstOrDefault(x => x.Code_Data ==
                                  item.Toll_Kubun.ToString())?.Code_Name
                          </td>
                          <td style="text-align:center;">@item.Start_Name</td>
                          <td style="text-align:right;">@string.Format("{0:N0}", item.Toll_Fee)</td>
                        </tr>
                        <tr>
                          <td style="text-align:center;">@Model.HaisyaData.SYABAN</td>
                          <td style="text-align:center;">@item.End_Name</td>
                          @{
                            string futanKubun = item.Futan_Kubun switch
                            {
                              1 => "自己負担",
                              2 => "会社負担",
                              3 => "荷主負担",
                              _ => ""
                            };
                          }
                          <td style="text-align:center;">@futanKubun</td>
                        </tr>
                        otherIndex++;
                      }
                    }
                  </table>
                </td>
              </tr>
            </table>
          </div>
        }
        else
        {
          <div class="table-div">
            <table class="no-line">
              <tr>
                <th><label class="label required">売上日</label></th>
                <td>
                  @Html.TextBoxFor(model => model.Uriage.Direct_Uriage_Date, "{0:yyyy-MM-dd}", new
                        {
                        @class = "form-control ",
                        type = "date",
                        @id = "salesDay",
                        @style = "width:140px;",
                              @onchange = "contentChanged=true;"
                        })
                </td>
              </tr>
            </table>
          </div>

          <div class="table-div">
            <table class="no-line">
              <tr>
                <th style="width:140px"><label class="label required">顧客</label></th>
                <td style="width: 80px;"><button type="button" id="btnKokyaku2" class="btn btn-uriage select-button btnKokyaku" style="width:60px;">選択</button></td>
                @{
                  var matchedCustomer = Model?.AddCustomerDto?.FirstOrDefault(c => c.CustomerId == Model?.Uriage?.Direct_Customer_Branch_ID);
                  var kokyakuCode = matchedCustomer?.Code ?? "";
                  var kokyakuName = matchedCustomer?.Name ?? "";
                }
                <td style="width:100px;"><input type="text" class="form-control" id="KokyakuCode2" value="@kokyakuCode" readonly onchange="contentChanged=true;" /></td>
                <td style="width:auto;"><input type="text" class="form-control" id="KokyakuName2" value="@kokyakuName" readonly onchange="contentChanged=true;" /></td>
                <td style="width:1px;"><input type="text" class="form-control" id="KokyakuId2" value="@Model.Uriage.Direct_Customer_Branch_ID" readonly hidden /></td>
              </tr>
              <tr>
                <th width="140px">顧客担当</th>
                <td style="width: 80px;"><button type="button" class="btn btn-uriage select-button" style="width:60px;" onclick="CustomerTantouDialog()">選択</button></td>
                <td style="width:100px;"><input type="text" class="form-control" id="CustomerTantouCD" value="@Model.AddCustomerTantouDto.Code" readonly /></td>
                <td style="width:auto;"><input type="text" class="form-control" id="CustomerTantouName" value="@Model.AddCustomerTantouDto.Name" readonly /></td>
                <td style="width:1px;"><input type="text" class="form-control" id="CustomerTantouID" value="@Model.Uriage.Direct_Customer_Tantou_ID" readonly hidden /></td>
              </tr>
              <tr>
                <th><label class="label required">売上区分</label></th>
                <td style="width:80px;"><input type="text" id="seikyuSelectedValue" class="form-control" style="width:50px;text-align: center;" readonly value="@Model.Uriage.Direct_Uriage_Kubun"/></td>
                <td style="width:auto;" colspan="2">
                  @Html.DropDownListFor(
                    m => m.Uriage.Direct_Uriage_Kubun,
                    new SelectList(Model.SalesKubunDto, "Value", "Text"),
                                new { @class = "form-control list dropdown", @id = "directSeikyuDropdown", @style = "width:160px;", @onchange = "contentChanged=true;" }
                    )
                </td>
                <td></td>
                <td></td>
              </tr>
              <tr>
                <th width="140px"><label class="label required">売上事業部門</label></th>
                <td style="width:80px;"><input type="text" id="uriageSelectedValue" class="form-control" style="width:50px;text-align: center;" readonly value="@Model.Uriage.Direct_Uriage_Bumon"/></td>
                <td style="width:auto;" colspan="2">
                  @Html.DropDownListFor(
                      m => m.Uriage.Direct_Uriage_Bumon,
                      new SelectList(Model.SalesBusinessSegmentDto, "Value", "Text"),
                                new { @class = "form-control list dropdown", @id = "directUriageDropdown", @onchange = "contentChanged=true;" }
                      )
                </td>
                <td></td>
              </tr>
              <tr>
