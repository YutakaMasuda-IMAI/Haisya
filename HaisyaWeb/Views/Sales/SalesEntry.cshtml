  // 下払情報の数量と単価をかけて下払運賃を計算するメソッド
  function updateTotalPricePayment(index) {
    var $container = $('.under-payment-item[data-index="' + index + '"]');
    var quantity = parseFloat(kanmaChangeRevert($container.find('#quantity').val())) || 0;
    var unitPrice = parseFloat(kanmaChangeRevert($container.find('#unitPrice').val())) || 0;
