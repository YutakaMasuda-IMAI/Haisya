    updateTotals();
  }

  //下払の各合計値（下払合計・割増合計・立替金合計・下払総額）を計算するメソッド
  function updateTotals() {
    totalUnderPayment = 0;
    totalUnderPaymentKingaku = 0;
    let totalSurcharge = 0;
    totalAdvance = 0;

    $('.under-payment-item').each(function () {
      var totalPrice = parseFloat(kanmaChangeRevert($(this).find('#totalPrice').val())) || 0;
      var underPayment = parseFloat(kanmaChangeRevert($(this).find('#underPayment').val())) || 0;
      var surcharge = parseFloat(kanmaChangeRevert($(this).find('#surcharge').val())) || 0;
      var advance = parseFloat(kanmaChangeRevert($(this).find('#advance').val())) || 0;

      totalUnderPayment += totalPrice;
      totalSurcharge += surcharge;
      totalAdvance += advance;
      totalUnderPaymentKingaku += underPayment;
    });

    // 税込み計算（仮に税率10%とする）
    const taxRate = 1.0;
    const taxIncludedUnderPayment = totalUnderPayment * taxRate;
    const taxIncludedSurcharge = totalSurcharge * taxRate;
    const grandTotal = taxIncludedUnderPayment + taxIncludedSurcharge + totalAdvance;

    $('#totalUnderPayment').text(kanmaChange2(totalUnderPayment.toFixed(0)));
    $('#totalSurcharge').text(kanmaChange2(totalSurcharge.toFixed(0)));
    $('#totalAdvance').text(kanmaChange2(totalAdvance.toFixed(0)));
    $('#grandTotal').text(kanmaChange2(Math.floor(grandTotal)));

    updateTatekaekinTotal();
  }

  // 請求運賃の請求運賃の合計 - 立替金の合計を計算するメソッド
  function calculateTotalBillingFeeMinusAdvance() {
    totalBillingFee = 0;

    $('.unchin-list-body tr').each(function() {
      let billingFee = parseFloat(kanmaChangeRevert($(this).find('td:first-child input').val())) || 0;
      let advance = parseFloat(kanmaChangeRevert($(this).find('td:nth-child(2) input').val())) || 0;

      totalBillingFee += billingFee;
    });

    let result = totalBillingFee - totalAdvance;
    return result;
  }

