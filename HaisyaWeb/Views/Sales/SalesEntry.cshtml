  }

  //一旦入力した請求運賃～割増5まで全て足した金額を運賃合計に表示（修正予定）
  function calculateTotalFreight(index) {
    var $container = $('.billing-info-item[data-index="' + index + '"]');

    var seikyuUnchin = parseFloat(kanmaChangeRevert($container.find('#SeikyuUnchin').val())) || 0;
    var tatekaekinTotal = parseFloat(kanmaChangeRevert($container.find('#TatekaekinTotal').val())) || 0;
    var warimashi1 = parseFloat(kanmaChangeRevert($container.find('#Warimashi1').val())) || 0;
    var warimashi2 = parseFloat(kanmaChangeRevert($container.find('#Warimashi2').val())) || 0;
    var warimashi3 = parseFloat(kanmaChangeRevert($container.find('#Warimashi3').val())) || 0;
    var warimashi4 = parseFloat(kanmaChangeRevert($container.find('#Warimashi4').val())) || 0;
    var warimashi5 = parseFloat(kanmaChangeRevert($container.find('#Warimashi5').val())) || 0;

    var totalFreight = parseInt(seikyuUnchin + tatekaekinTotal + warimashi1 + warimashi2 + warimashi3 + warimashi4 + warimashi5);

    $container.find('#SeikyuTotal').val(kanmaChange2(totalFreight.toFixed(0)));
}

