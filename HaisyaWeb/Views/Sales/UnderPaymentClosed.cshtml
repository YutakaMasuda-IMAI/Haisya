            <td></td>
          </tr>
        </table>

        <table class="no-line">
          <tr>
            <th>赤伝黒伝発生理由</th>
          </tr>
          <tr>
            <td colspan="2">
              <textarea class="form-control inputtable" id="Remarks" name="Remarks" style="resize: none; overflow-y: auto; height: 100px; width: 100%; background-color: white;">@Html.Raw(uriageShitabarai.Remarks)</textarea>
