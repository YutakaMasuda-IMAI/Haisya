@model HaisyaWeb.Dto.SalesModel

<style>
  #underPaymentContainer input:not([readonly]):not(:disabled),
  #underPaymentContainer select:not(:disabled),
  #underPaymentContainer textarea:not(:disabled) {
    background-color: #fff;
  }

  #underPaymentContainer input[readonly],
  #underPaymentContainer input:disabled,
  #underPaymentContainer select:disabled,
  #underPaymentContainer textarea[readonly] {
    background-color: #fff;
  }
</style>

@{
  var UnderPaymentIndex = 0;
}
@foreach (var uriageShitabarai in Model.UriageShitabarai)
{
  <div class="under-payment-item" data-index="@UnderPaymentIndex">
    <div id="underPaymentContainer" style="margin-top: 10px; border: 1px solid #cccccc; padding: 10px;">
      <div style="display:none;">
        @Html.HiddenFor(m => uriageShitabarai.Uriage_Shiharai_ID)
        @Html.HiddenFor(m => uriageShitabarai.Default_Kubun)
      </div>

      @{
        var selectedDay = uriageShitabarai.Shime_Day;
        var matchedCustomer = Model.AddCustomerDto.FirstOrDefault(c => c.CustomerId == uriageShitabarai.Yosya_Branch_ID);
        var kokyakuId = 0;
        var kokyakuCode = matchedCustomer?.Code ?? "";
        var kokyakuName = matchedCustomer?.Name ?? "";
        var Sort = uriageShitabarai.Sort + 1;
        var Uriage_Shitabarai_Kubun = uriageShitabarai.Uriage_Kubun;
      }

      @*赤伝黒伝の表示のみ*@
      @if (uriageShitabarai.IsCreditSlip)
      {
        <input type="hidden" id="Uriage_Shiharai_Kubun_aka" name="Uriage_Shiharai_Kubun_aka" value=@Uriage_Shitabarai_Kubun>
        <input type="hidden" id="Insert_User_aka" name="Insert_User_aka" value=@uriageShitabarai.Insert_User>
        <input type="hidden" id="Update_User_aka" name="Update_User_aka" value=@uriageShitabarai.Update_User>
        <table class="no-line">
          <tr>
            <th>支払日</th>
            <td>
              @Html.TextBoxFor(m => uriageShitabarai.Shiharai_Date, "{0:yyyy-MM-dd}", new
                {
                  @class = "form-control",
                  @id = "endDateTime_aka",
                  type = "date",
                  @style = "width:140px;background-color: white;",
                  @onchange = "contentChanged=true; updateShimedayOption($(this));",
                  @readonly = true,
                })
            </td>
            <th style="white-space: nowrap;">締日</th>
            <td>
              <select id="closingDay_aka" class="form-control dropdown" style="width: 60px; background-color: white;" disabled>
                @for (int i = 1; i <= 31; i++)
                {
                  if (i == selectedDay)
                  {
                    <option value="@i" selected>@i</option>
                  }
                  else
                  {
                    <option value="@i">@i</option>
                  }
                }
              </select>
            </td>
            <th style="white-space: nowrap;">車番</th>
            <td>
              @Html.TextBoxFor(m => uriageShitabarai.Syaban, new { @class = "form-control", id = "Syaban_aka", @style = "width: 100px; background-color: white;", @readonly = true })
            </td>
            <td style="text-align:right;">
            </td>
          </tr>
        </table>

        <table class="no-line">
          <tr>
            <th>下払先会社</th>
            @{
              if (Model.HaisyaData.Haisya_Kubun == 2 || Model.HaisyaData.Haisya_Kubun == 3)
              {
                kokyakuId = Model.Yosya.Yosya_Branch_ID;
                kokyakuName = Model.Yosya.Customer_Branch_Name_Abbr;
                kokyakuCode = Model.Yosya.Customer_Branch_Code;
              }
              else
              {
                kokyakuCode = matchedCustomer?.Code ?? "";
                kokyakuId = matchedCustomer.CustomerId;
                kokyakuName = matchedCustomer.Name;
              }

            }
            <td style="width:120px;">
              <input type="text" class="form-control" id="KokyakuCode3_aka" style="background-color: white" value="@kokyakuCode" readonly />
            </td>
            <td style="width:auto;">
              <input type="text" class="form-control" id="KokyakuName3_aka" style="background-color: white" value="@kokyakuName" readonly />
            </td>
            <td style="width:100px;">
              <input type="hidden" class="form-control" id="KokyakuId3_aka" style="background-color: white" value="@kokyakuId" readonly />
            </td>
          </tr>
        </table>

        <table class="no-line">
          <tr>
            <th>積</th>
            <td>
              @Html.TextBoxFor(m => uriageShitabarai.Tsumi, new { @class = "form-control", @id = "Tsumi_aka", @style = "background-color: white;", @readonly = true })
            </td>
            <th>卸</th>
            <td>
              @Html.TextBoxFor(m => uriageShitabarai.Oroshi, new { @class = "form-control", @id = "Oroshi_aka", @style = "background-color: white;", @readonly = true })
            </td>
            <th style="white-space: nowrap;">品名</th>
            <td>
              @Html.TextBoxFor(m => uriageShitabarai.Luggage, new { @class = "form-control", @id = "ItemName_aka", @style = "background-color: white;", @readonly = true })
            </td>
          </tr>
        </table>

        <table class="no-line">
          <tr>
            <th style="white-space: nowrap;">数量</th>
            <td>
              @Html.TextBoxFor(m => uriageShitabarai.Qty, new
                {
                  @class = "form-control",
                  @id = "quantity_aka",
                  type = "text",
                  @style = "width:100px; text-align: right;",
                  @oninput = "filterDigitsOnly(this);",
                  @onblur = "kanmaChange(this);",
                  @readonly = true
                })
            </td>
            <th style="white-space: nowrap;">単位</th>
            <td>
              @Html.DropDownListFor(
                    m => uriageShitabarai.Unit,
                    new SelectList(Model.UnitDto, "Value", "Text"),
                    new { @class = "form-control dropdown", @id = "SelectedUnit_aka", @style = "width:140px; ", @disabled = true }
                    )
            </td>
            <th style="white-space: nowrap;">単価</th>
            <td>
              @Html.TextBoxFor(m => uriageShitabarai.UnitPrice, "{0:N0}", new
                {
                  @class = "form-control",
                  @id = "unitPrice_aka",
                  type = "text",
                  @style = "width:140px; text-align: right;",
                  @oninput = "filterDigitsOnly(this);",
                  @onblur = "kanmaChange(this);",
                  @readonly = true
                })
            </td>
            <th style="white-space: nowrap;">下払運賃</th>
            <td>
              @Html.TextBoxFor(m => uriageShitabarai.CalcPrice, "{0:N0}", new
                {
                  @class = "form-control",
                  @id = "totalPrice_aka",
                  type = "text",
                  @readonly = true,
                  @style = "width:100px; text-align: right;"
                })
            </td>
          </tr>
        </table>

        <table class="no-line">
          <tr>
            <th style="white-space: nowrap;">下払金額</th>
            <td>
              @Html.TextBoxFor(m => uriageShitabarai.ShiharaiPrice, "{0:N0}", new
                {
                  @class = "form-control under-payment-input",
                  @id = "underPayment_aka",
                  type = "text",
                  name = "underPayment",
                  @style = "width:100px; text-align: right;",
