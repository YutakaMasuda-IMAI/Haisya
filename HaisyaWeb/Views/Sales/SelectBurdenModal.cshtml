  /** 登録処理 */
  function SelectLuggageRegExec() {

  var tableBody = document.getElementById("futanTableBody");
  var selectedLuggageTable = document.getElementById("tableSelectLuggage-body");
  var rows = selectedLuggageTable.getElementsByTagName("tr");

  for (var i = 1; i < rows.length; i++) {
    var kubun = rows[i].cells[1].getElementsByTagName("input")[0].value;
    var name = rows[i].cells[2].getElementsByTagName("input")[0].value;

    var newRow = tableBody.insertRow();
    newRow.innerHTML = `
      <input type="hidden" name="UriageFutan[].Uriage_Futan_ID" value="0" />
      <input type="hidden" name="UriageFutan[].Default_Kubun" value="0" />
      <input type="hidden" name="UriageFutan[].futan_Kubun" value="${kubun}" />
      <td>${name}</td>
      <td><input type="text" class="form-control inputtable" style="text-align:right;" value="0" name=".FutanPrice" onblur = "kanmaChange(this);" /></td>
      <td  style="border:none;"><button type="button" class="btn btn-danger btn-sm" onclick="deleteFutanRow(this)">削除</button></td>
      `;
  }

  ModalClose();
  };

  // 会社負担の削除ボタン押下時の削除処理
  function deleteFutanRow(button) {
  var row = button.parentNode.parentNode;
  row.parentNode.removeChild(row);
}


  // 会社負担の削除ボタン押下時の削除処理
  function deleteFutanRow(button) {
    var row = button.parentNode.parentNode;
    row.parentNode.removeChild(row);
  }
</script>

