@model HaisyaWeb.Dto.SalesModel

<style>
    #billingInfoContainer input[readonly],
    #billingInfoContainer input:disabled,
    #billingInfoContainer select:disabled,
    #billingInfoContainer textarea[readonly] {
        background-color: #fff;
    }

    table.no-line input,
    table.no-line select,
    table.no-line textarea {
        background-color: white;
    }

    table.no-line th {
        width: 80px;
    }
</style>
@{
    var BillingInfoIndex = 0;
}
@foreach (var uriageUnchin in Model.UriageUnchin)
{
    <div class="billing-info-item" data-index="@BillingInfoIndex">
      <div id="billingInfoContainer" style="margin-top: 10px; border: 1px solid #cccccc; padding: 10px;">
        <div style="display:none;">
          @Html.HiddenFor(m => uriageUnchin.Uriage_Unchin_ID)
          @Html.HiddenFor(m => uriageUnchin.Default_Kubun)
        </div>

        @{
          var selectedDay = uriageUnchin.Shime_Day;
          var matchedCustomer = Model.AddCustomerDto.FirstOrDefault(c => c.CustomerId == uriageUnchin.Customer_Branch_ID);
          var kokyakuCode = matchedCustomer?.Code ?? "";
          var kokyakuName = matchedCustomer?.Name ?? "";
          var Sort = uriageUnchin.Sort + 1;
          var Uriage_Unchin_Kubun = uriageUnchin.Uriage_Kubun;
        }

        @*赤伝黒伝の表示のみ*@
        @if (uriageUnchin.IsCreditSlip)
        {
          <input type="hidden" id="IsCreditSlip" name="IsCreditSlip" value="1">
          <input type="hidden" id="Uriage_Unchin_Kubun_aka" name="Uriage_Unchin_Kubun_aka" value=@Uriage_Unchin_Kubun>
          <input type="hidden" id="Insert_User_aka" name="Insert_User_aka" value=@uriageUnchin.Insert_User>
          <input type="hidden" id="Update_User_aka" name="Update_User_aka" value=@uriageUnchin.Update_User>

          <table class="no-line">
            <tr>
              <th>請求日</th>
              <td style="width:200px;">
                @Html.TextBoxFor(m => uriageUnchin.Seikyu_Date, "{0:yyyy-MM-dd}", new
                    {
                        @class = "form-control inputtable",
                        @id = "endDateTime_aka",
                        type = "date",
                        @style = "width:140px;",
                        @onchange = "contentChanged=true; updateShimedayOption($(this));",
                        @readonly = true,
                    })
              </td>
              <th>締日</th>
              <td>
                <select id="closingDay_aka" class="form-control dropdown" style="width:60px;" onchange="contentChanged=true;" disabled>
                  @for (int i = 1; i <= 31; i++)
                  {
                    if (i == selectedDay)
                    {
                      <option value="@i" selected>@i</option>
                    }
                    else
                    {
                      <option value="@i">@i</option>
                    }
                  }
                </select>
              </td>
              <th>請求明細</th>
              <td>
                @Html.TextBoxFor(m => Sort, "{0:N0}", new
                {
                    @class = "form-control seikyu_detaii_sort",
                    type = "text",
                    @style = "width:60px;",
                    @readonly = true,
                })
              </td>
              @if (uriageUnchin.Default_Kubun == 0 || uriageUnchin.IsCreditSlip)
              {
                <td width="300px"></td>
              }
              else if (Model.IsDeletable)
              {
                <td style="text-align:right;" width="300px"><button class="btn btn-outline-danger delete-row">削除</button></td>
              }
            </tr>
          </table>

          <table class="no-line">
            <tr>
              <th>請求先</th>
              <td style="width:120px;"><input type="text" class="form-control" id="KokyakuCode_aka" value="@kokyakuCode" readonly /></td>
              <td style="width:auto;"><input type="text" class="form-control" id="KokyakuName_aka" value="@kokyakuName" readonly /></td>
              <td style="width:1px;"><input type="text" class="form-control" id="KokyakuId_aka" value="@uriageUnchin.Customer_Branch_ID" readonly hidden /></td>
            </tr>
          </table>

          <table class="no-line">
            <tr>
              <th>積</th>
              <td>@Html.TextBoxFor(m => uriageUnchin.Tsumi, new { @class = "form-control", @id = "Tsumi_aka", @onchange = "contentChanged=true;" })</td>
              <th>卸</th>
              <td>@Html.TextBoxFor(m => uriageUnchin.Oroshi, new { @class = "form-control", @id = "Oroshi_aka", @onchange = "contentChanged=true;" })</td>
              <th>品名</th>
              <td>@Html.TextBoxFor(m => uriageUnchin.Luggage, new { @class = "form-control", @id = "ItemName_aka", @onchange = "contentChanged=true;" })</td>
            </tr>
          </table>

          <table class="no-line">
            <tr>
              <th>数量</th>
              <td>
                @Html.TextBoxFor(m => uriageUnchin.Qty, "{0:N0}", new
                {
                    @class = "form-control",
                    @id = "quantity_aka",
                    type = "text",
                    @style = "width:100px;text-align:right;",
                    @oninput = "filterDigitsOnly(this);",
                    @onblur = "kanmaChange(this);",
                    @onchange = "contentChanged=true;",
                    @readonly = true,
                })
              </td>
              <th>単位</th>
              <td style="width:140px;">
                @Html.DropDownListFor(
                        m => uriageUnchin.Unit,
                        new SelectList(Model.UnitDto, "Value", "Text"),
                        new { @class = "form-control dropdown", @id = "SelectedUnit_aka", @onchange = "contentChanged=true;", @disabled = "disabled" }
                    )
              </td>
              <th>単価</th>
              <td>
                @Html.TextBoxFor(m => uriageUnchin.UnitPrice, "{0:N0}", new
                    {
                        @class = "form-control",
                        @id = "unitPrice_aka",
                        type = "text",
                        @style = "width:100px;text-align:right;",
                        @oninput = "filterDigitsOnly(this);",
                        @onblur = "kanmaChange(this);",
                        @onchange = "contentChanged=true;",
                        @readonly = true,
                    })
              </td>
              <th>請求運賃</th>
              <td>
                @Html.TextBoxFor(m => uriageUnchin.CalcPrice, "{0:N0}", new
                    {
                        @class = "form-control",
                        @id = "totalPrice_aka",
                        type = "text",
                        @style = "width:100px;text-align:right;",
                        @readonly = true,
                        @onblur = "kanmaChange(this);"
                    })
              </td>
            </tr>
          </table>

          <table class="list" style="margin-top:10px;">
            <tr>
              <th class="unchin-list" style="width:100px;">
                @(string.IsNullOrEmpty(Model.CustomerUriageCalcData?.SeikyuUnchin_Name)
                      ? "請求運賃"
                      : Model.CustomerUriageCalcData?.SeikyuUnchin_Name)
              </th>
              <th class="unchin-list" style="width:120px;">
                @(string.IsNullOrEmpty(Model.CustomerUriageCalcData?.Tatekaekin_Name)
                      ? "立替金（税込）"
                      : Model.CustomerUriageCalcData?.Tatekaekin_Name)
              </th>
              <th class="unchin-list" style="width:100px; @((Model.CustomerUriageCalcData?.Warimashi1_Visible ?? false) == false ? "display:none;" : "")">
                @(string.IsNullOrEmpty(Model.CustomerUriageCalcData?.Warimashi1_Name)
                      ? "割増1"
                      : Model.CustomerUriageCalcData?.Warimashi1_Name)
              </th>
              <th class="unchin-list" style="width:100px; @((Model.CustomerUriageCalcData?.Warimashi2_Visible ?? false) == false ? "display:none;" : "")">
                @(string.IsNullOrEmpty(Model.CustomerUriageCalcData?.Warimashi2_Name)
                      ? "割増2"
                      : Model.CustomerUriageCalcData?.Warimashi2_Name)
              </th>
              <th class="unchin-list" style="width:100px; @((Model.CustomerUriageCalcData?.Warimashi3_Visible ?? false) == false ? "display:none;" : "")">
                @(string.IsNullOrEmpty(Model.CustomerUriageCalcData?.Warimashi3_Name)
                      ? "割増3"
                      : Model.CustomerUriageCalcData?.Warimashi3_Name)
              </th>
              <th class="unchin-list" style="width:100px; @((Model.CustomerUriageCalcData?.Warimashi4_Visible ?? false) == false ? "display:none;" : "")">
                @(string.IsNullOrEmpty(Model.CustomerUriageCalcData?.Warimashi4_Name)
                      ? "割増4"
                      : Model.CustomerUriageCalcData?.Warimashi4_Name)
              </th>
              <th class="unchin-list" style="width:100px; @((Model.CustomerUriageCalcData?.Warimashi5_Visible ?? false) == false ? "display:none;" : "")">
                @(string.IsNullOrEmpty(Model.CustomerUriageCalcData?.Warimashi5_Name)
                      ? "割増5"
                      : Model.CustomerUriageCalcData?.Warimashi5_Name)
              </th>
              <th class="unchin-list" style="width:100px;">課税区分</th>
              <th class="unchin-list" style="width:100px;">
                @(string.IsNullOrEmpty(Model.CustomerUriageCalcData?.SeikyuTotal_Name)
                      ? "運賃合計"
                      : Model.CustomerUriageCalcData?.SeikyuTotal_Name)
              </th>
              <td style="border:none;"></td>
            </tr>
            <tbody class="unchin-list-body">
              <tr>
                <td>@Html.TextBoxFor(m => uriageUnchin.SeikyuUnchin, "{0:N0}", new { @class = "form-control", @style = "text-align:right;", @onblur = "kanmaChange(this);", @id = "SeikyuUnchin_aka", @onchange = "contentChanged=true;", @oninput = "filterDigitsOnly(this);", @readonly = true })</td>
                <td>@Html.TextBoxFor(m => uriageUnchin.Tatekaekin, "{0:N0}", new { @class = "form-control", @onblur = "kanmaChange(this);", @id = "TatekaekinTotal_aka", @style = "text-align:right;", @onchange = "contentChanged=true;", @oninput = "filterDigitsOnly(this);", @readonly = true })</td>
                <td style="@((Model.CustomerUriageCalcData?.Warimashi1_Visible ?? false) == false ? "display:none;" : "")"><input type="text" id="Warimashi1_aka" class="form-control" style="text-align:right;" onblur="kanmaChange(this);" onchange="contentChanged=true;" oninput="filterDigitsOnly(this);" value="@uriageUnchin.Warimashi1.ToString("N0")" readonly="readonly" /></td>
                <td style="@((Model.CustomerUriageCalcData?.Warimashi2_Visible ?? false) == false ? "display:none;" : "")"><input type="text" id="Warimashi2_aka" class="form-control" style="text-align:right;" onblur="kanmaChange(this);" onchange="contentChanged=true;" oninput="filterDigitsOnly(this);" value="@uriageUnchin.Warimashi2.ToString("N0")" readonly="readonly" /></td>
                <td style="@((Model.CustomerUriageCalcData?.Warimashi3_Visible ?? false) == false ? "display:none;" : "")"><input type="text" id="Warimashi3_aka" class="form-control" style="text-align:right;" onblur="kanmaChange(this);" onchange="contentChanged=true;" oninput="filterDigitsOnly(this);" value="@uriageUnchin.Warimashi3.ToString("N0")" readonly="readonly" /></td>
                <td style="@((Model.CustomerUriageCalcData?.Warimashi4_Visible ?? false) == false ? "display:none;" : "")"><input type="text" id="Warimashi4_aka" class="form-control" style="text-align:right;" onblur="kanmaChange(this);" onchange="contentChanged=true;" oninput="filterDigitsOnly(this);" value="@uriageUnchin.Warimashi4.ToString("N0")" readonly="readonly" /></td>
                <td style="@((Model.CustomerUriageCalcData?.Warimashi5_Visible ?? false) == false ? "display:none;" : "")"><input type="text" id="Warimashi5_aka" class="form-control" style="text-align:right;" onblur="kanmaChange(this);" onchange="contentChanged=true;" oninput="filterDigitsOnly(this);" value="@uriageUnchin.Warimashi5.ToString("N0")" readonly="readonly" /></td>
                <td>
                  @Html.DropDownListFor(
                          m => uriageUnchin.Zei_Kubun,
                          new SelectList(Model.KazeiKubunDto, "Value", "Text", 0),
                          new { @class = "form-control list dropdown", @id = "KazeiKubun_aka", @onchange = "contentChanged=true;", @disabled = "disabled" }
                      )
                </td>
                <td>@Html.TextBoxFor(m => uriageUnchin.SeikyuTotal, "{0:N0}", new { @class = "form-control", @style = "text-align:right;", @type = "text", @readonly = true, @id = "SeikyuTotal_aka" })</td>
                <td style="border:none;"></td>
              </tr>
            </tbody>
          </table>

        }

        <table class="no-line">
          <tr>
            <th>請求日</th>
            <td style="width:200px;">
              @Html.TextBoxFor(m => uriageUnchin.Seikyu_Date, "{0:yyyy-MM-dd}", new
                  {
                      @class = "form-control inputtable",
                      @id = "endDateTime",
                      type = "date",
                      @style = "width:140px;",
                      @onchange = "contentChanged=true; updateShimedayOption($(this));",
                  })
            </td>
            <th>締日</th>
            <td>
              <select id="closingDay" class="form-control dropdown" style="width:60px;" onchange="contentChanged=true;">
                @for (int i = 1; i <= 31; i++)
                {
                  if (i == selectedDay)
                  {
                    <option value="@i" selected>@i</option>
                  }
                  else
                  {
                    <option value="@i">@i</option>
                  }
                }
              </select>
            </td>
            <th>請求明細</th>
            <td>
              @Html.TextBoxFor(m => Sort, "{0:N0}", new
              {
                  @class = "form-control seikyu_detaii_sort",
                  type = "text",
                  @style = "width:60px;",
                  @readonly = "readonly"
              })
            </td>
            @if (uriageUnchin.Default_Kubun == 0 && (!uriageUnchin.IsCreditSlip))
            {
              <td width="300px"></td>
            }
            else if (Model.IsDeletable)
            {
              <td style="text-align:right;" width="300px"><button class="btn btn-outline-danger delete-row" id="deleteButton">削除</button></td>
            }
          </tr>
        </table>

        <table class="no-line">
          <tr>
            <th>請求先</th>
            <td style="width:120px;"><input type="text" class="form-control" id="KokyakuCode" value="@kokyakuCode" readonly /></td>
            <td style="width:auto;"><input type="text" class="form-control" id="KokyakuName" value="@kokyakuName" readonly /></td>
            <td style="width:100px;">
              <button class="btn btn-outline-primary btnKokyaku" id="btnKokyaku" data-index="@BillingInfoIndex">選択</button>
            </td>
            <td style="width:1px;"><input type="text" class="form-control" id="KokyakuId" value="@uriageUnchin.Customer_Branch_ID" readonly hidden /></td>
          </tr>
        </table>

        <table class="no-line">
          <tr>
            <th>積</th>
            <td>@Html.TextBoxFor(m => uriageUnchin.Tsumi, new { @class = "form-control", @id = "Tsumi", @onchange = "contentChanged=true;" })</td>
            <th>卸</th>
            <td>@Html.TextBoxFor(m => uriageUnchin.Oroshi, new { @class = "form-control", @id = "Oroshi", @onchange = "contentChanged=true;" })</td>
            <th>品名</th>
            <td>@Html.TextBoxFor(m => uriageUnchin.Luggage, new { @class = "form-control", @id = "ItemName", @onchange = "contentChanged=true;" })</td>
          </tr>
        </table>

        <table class="no-line">
          <tr>
            <th>数量</th>
            <td>
              @Html.TextBoxFor(m => uriageUnchin.Qty, "{0:N0}", new
              {
                  @class = "form-control",
                  @id = "quantity",
                  type = "text",
                  @style = "width:100px;text-align:right;",
                  @oninput = "filterDigitsOnly(this);",
                  @onblur = "kanmaChange(this);",
                  @onchange = "contentChanged=true;"
              })
            </td>
            <th>単位</th>
            <td style="width:140px;">
              @Html.DropDownListFor(
                      m => uriageUnchin.Unit,
                      new SelectList(Model.UnitDto, "Value", "Text"),
                      new { @class = "form-control dropdown", @id = "SelectedUnit", @onchange = "contentChanged=true;" }
                  )
            </td>
            <th>単価</th>
            <td>
              @Html.TextBoxFor(m => uriageUnchin.UnitPrice, "{0:N0}", new
                  {
                      @class = "form-control",
                      @id = "unitPrice",
                      type = "text",
                      @style = "width:100px;text-align:right;",
                      @oninput = "filterDigitsOnly(this);",
                      @onblur = "kanmaChange(this);",
                      @onchange = "contentChanged=true;"
                  })
            </td>
            <th>請求運賃</th>
            <td>
              @Html.TextBoxFor(m => uriageUnchin.CalcPrice, "{0:N0}", new
                  {
                      @class = "form-control",
                      @id = "totalPrice",
                      type = "text",
                      @style = "width:100px;text-align:right;",
                      @readonly = true,
                      @onblur = "kanmaChange(this);"
                  })
            </td>
          </tr>
        </table>

        <table class="list" style="margin-top:10px;">
          <tr>
            <th class="unchin-list" style="width:100px;">
              @(string.IsNullOrEmpty(Model.CustomerUriageCalcData?.SeikyuUnchin_Name)
                      ? "請求運賃"
                      : Model.CustomerUriageCalcData?.SeikyuUnchin_Name)
            </th>
            <th class="unchin-list" style="width:120px;">
              @(string.IsNullOrEmpty(Model.CustomerUriageCalcData?.Tatekaekin_Name)
                      ? "立替金（税込）"
                      : Model.CustomerUriageCalcData?.Tatekaekin_Name)
            </th>
            <th class="unchin-list" style="width:100px; @((Model.CustomerUriageCalcData?.Warimashi1_Visible ?? false) == false ? "display:none;" : "")">
              @(string.IsNullOrEmpty(Model.CustomerUriageCalcData?.Warimashi1_Name)
                      ? "割増1"
                      : Model.CustomerUriageCalcData?.Warimashi1_Name)
            </th>
            <th class="unchin-list" style="width:100px; @((Model.CustomerUriageCalcData?.Warimashi2_Visible ?? false) == false ? "display:none;" : "")">
              @(string.IsNullOrEmpty(Model.CustomerUriageCalcData?.Warimashi2_Name)
                      ? "割増2"
                      : Model.CustomerUriageCalcData?.Warimashi2_Name)
            </th>
            <th class="unchin-list" style="width:100px; @((Model.CustomerUriageCalcData?.Warimashi3_Visible ?? false) == false ? "display:none;" : "")">
              @(string.IsNullOrEmpty(Model.CustomerUriageCalcData?.Warimashi3_Name)
                      ? "割増3"
                      : Model.CustomerUriageCalcData?.Warimashi3_Name)
            </th>
            <th class="unchin-list" style="width:100px; @((Model.CustomerUriageCalcData?.Warimashi4_Visible ?? false) == false ? "display:none;" : "")">
              @(string.IsNullOrEmpty(Model.CustomerUriageCalcData?.Warimashi4_Name)
                      ? "割増4"
                      : Model.CustomerUriageCalcData?.Warimashi4_Name)
            </th>
            <th class="unchin-list" style="width:100px; @((Model.CustomerUriageCalcData?.Warimashi5_Visible ?? false) == false ? "display:none;" : "")">
              @(string.IsNullOrEmpty(Model.CustomerUriageCalcData?.Warimashi5_Name)
                      ? "割増5"
                      : Model.CustomerUriageCalcData?.Warimashi5_Name)
            </th>
            <th class="unchin-list" style="width:100px;">課税区分</th>
            <th class="unchin-list" style="width:100px;">
              @(string.IsNullOrEmpty(Model.CustomerUriageCalcData?.SeikyuTotal_Name)
                      ? "運賃合計"
                      : Model.CustomerUriageCalcData?.SeikyuTotal_Name)
            </th>
            <td style="border:none;"></td>
          </tr>
          <tbody class="unchin-list-body">
            <tr>
              <td>@Html.TextBoxFor(m => uriageUnchin.SeikyuUnchin, "{0:N0}", new { @class = "form-control", @style = "text-align:right;", @onblur = "kanmaChange(this);", @id = "SeikyuUnchin", @onchange = "contentChanged=true;", @oninput = "filterDigitsOnly(this);" })</td>
              <td>@Html.TextBoxFor(m => uriageUnchin.Tatekaekin, "{0:N0}", new { @class = "form-control", @onblur = "kanmaChange(this);", @id = "TatekaekinTotal", @style = "text-align:right;", @onchange = "contentChanged=true;", @oninput = "filterDigitsOnly(this);" })</td>
              <td style="@((Model.CustomerUriageCalcData?.Warimashi1_Visible ?? false) == false ? "display:none;" : "")"><input type="text" id="Warimashi1" class="form-control" style="text-align:right;" onblur="kanmaChange(this);" onchange="contentChanged=true;" oninput="filterDigitsOnly(this);" value="@uriageUnchin.Warimashi1.ToString("N0")" /></td>
              <td style="@((Model.CustomerUriageCalcData?.Warimashi2_Visible ?? false) == false ? "display:none;" : "")"><input type="text" id="Warimashi2" class="form-control" style="text-align:right;" onblur="kanmaChange(this);" onchange="contentChanged=true;" oninput="filterDigitsOnly(this);" value="@uriageUnchin.Warimashi2.ToString("N0")" /></td>
              <td style="@((Model.CustomerUriageCalcData?.Warimashi3_Visible ?? false) == false ? "display:none;" : "")"><input type="text" id="Warimashi3" class="form-control" style="text-align:right;" onblur="kanmaChange(this);" onchange="contentChanged=true;" oninput="filterDigitsOnly(this);" value="@uriageUnchin.Warimashi3.ToString("N0")" /></td>
              <td style="@((Model.CustomerUriageCalcData?.Warimashi4_Visible ?? false) == false ? "display:none;" : "")"><input type="text" id="Warimashi4" class="form-control" style="text-align:right;" onblur="kanmaChange(this);" onchange="contentChanged=true;" oninput="filterDigitsOnly(this);" value="@uriageUnchin.Warimashi4.ToString("N0")" /></td>
              <td style="@((Model.CustomerUriageCalcData?.Warimashi5_Visible ?? false) == false ? "display:none;" : "")"><input type="text" id="Warimashi5" class="form-control" style="text-align:right;" onblur="kanmaChange(this);" onchange="contentChanged=true;" oninput="filterDigitsOnly(this);" value="@uriageUnchin.Warimashi5.ToString("N0")" /></td>
              <td>
                @Html.DropDownListFor(
                        m => uriageUnchin.Zei_Kubun,
                        new SelectList(Model.KazeiKubunDto, "Value", "Text", 0),
                        new { @class = "form-control list dropdown", @id = "KazeiKubun", @onchange = "contentChanged=true;" }
                    )
              </td>
              <td>@Html.TextBoxFor(m => uriageUnchin.SeikyuTotal, "{0:N0}", new { @class = "form-control", @style = "text-align:right;", @type = "text", @readonly = "readonly", @id = "SeikyuTotal" })</td>
              <td style="border:none;"></td>
            </tr>
          </tbody>
        </table>

        @if (uriageUnchin.IsCreditSlip)
        {
          <input type="hidden" id="Uriage_Unchin_Kubun" name="Uriage_Unchin_Kubun" value="1">
          <table class="no-line">
            <tr>
              <th>赤伝黒伝発生理由</th>
            </tr>
            <tr>
              <td><textarea id="AkaKuro_Remarks" name="AkaKuro_Remarks" class="form-control inputtable" style="resize: none; overflow-y: auto; height: 100px; width: 100%;" onchange="contentChanged=true;">@Html.Raw(uriageUnchin.AkaKuro_Remarks)</textarea></td>
            </tr>
          </table>
        }
        else
        {
          if (Uriage_Unchin_Kubun == 1)
          {
            <input type="hidden" id="Uriage_Unchin_Kubun" name="Uriage_Unchin_Kubun" value=@Uriage_Unchin_Kubun>
            <table class="no-line">
              <tr>
                <th>赤伝黒伝発生理由</th>
              </tr>
              <tr>
                <td><textarea id="AkaKuro_Remarks" name="AkaKuro_Remarks" class="form-control inputtable" style="resize: none; overflow-y: auto; height: 100px; width: 100%;" onchange="contentChanged=true;">@Html.Raw(uriageUnchin.AkaKuro_Remarks)</textarea></td>
              </tr>
            </table>
          }
        }

      </div>
    </div>
    BillingInfoIndex++;
}

<script>
    var IsRequestReadOnly = @Html.Raw(Json.Serialize(Model.IsRequestReadOnly));
    $(document).ready(function () {
    // 活性・非活性を制御
    if (IsRequestReadOnly) {
        $(".billing-info-item").find("#TatekaekinTotal, #ItemName, #Oroshi, #Tsumi, #KazeiKubun, #SelectedUnit, #endDateTime, #closingDay").prop("disabled", true);
        $(".billing-info-item").find("#btnKokyaku, #deleteButton").prop("disabled", true);
        $(".billing-info-item").find("input[type='text'], input[type='number'], textarea").prop("readonly", true);
        $(".billing-info-item").find("select").prop("disabled", true);
    }

    // 締日のドロップダウンメニューをendDateTimeの月の日にちに合わせて動的に更新するメソッド
    function updateClosingDayOptions() {
        $(".billing-info-item").find('#endDateTime').each(function (index) {
                updateShimedayOption($(this));
        });
    }

    // 初期化時に実行
    updateClosingDayOptions();
    $('.billing-info-item').each(function() {
        var index = $(this).data('index');
        updateTotalPrice(index);
    });

    // 監視対象の入力フィールドを指定
    const fieldsToWatch = '.billing-info-item #SeikyuUnchin, .billing-info-item #TatekaekinTotal, .billing-info-item #Warimashi1, .billing-info-item #Warimashi2, .billing-info-item #Warimashi3, .billing-info-item #Warimashi4, .billing-info-item #Warimashi5';

    // 入力フィールドの変更を監視
    $(document).on('input', fieldsToWatch, function() {
        var $container = $(this).closest('.billing-info-item');
        var index = $container.data('index');
        calculateTotalFreight(index);
    });

    // EndDateTime が変更されたときに実行
    $('#endDateTime').on('change', updateClosingDayOptions);

    // 数量または単価が変更されたときに実行
    $('.billing-info-item #quantity, .billing-info-item #unitPrice').on('input', function() {
            var $container = $(this).closest('.billing-info-item');
            var index = $container.data('index');
            updateTotalPrice(index);
        });
    });

    // 請求運賃の入力フィールドの変更を監視
    $(document).on('input', '.unchin-list-body tr td:first-child input', function () {
        updateRouteAllowance();
    });

    // 動的に追加された請求情報の入力フィールドも監視
    $(document).on('input', '#billingInfoContainer .unchin-list-body tr td:first-child input', function () {
        updateRouteAllowance();
    });
</script>
