@model HaisyaWeb.Dto.SalesModel

<div id="underPaymentContainer" style="margin-top: 10px; border: 1px solid #cccccc; padding: 10px;">
  <div class="table-div">
    <div style="display:none;">
      @Html.Hidden("Uriage_Shiharai_ID", 0)
      @Html.Hidden("Default_Kubun", 0)
      @Html.HiddenFor(m => Model.Uriage_Shiharai_Kubun)
    </div>
    <table class="no-line">
      <tr>
        <th>下払日</th>
        <td>
          @Html.TextBoxFor(model => model.EndDateTime, "{0:yyyy-MM-dd}", new
              {
                @class = "form-control inputtable",
                @id = "endDateTime",
                type = "date",
                @style = "width:140px;"
              })
        </td>
        <td style="text-align:right;"><button type="button" class="btn btn-outline-danger delete-row-under">削除</button></td>
      </tr>
    </table>

    <table class="no-line">
      <tr>
        <th>下払先会社</th>
        <td style="width:120px;"><input type="text" class="form-control inputtable" id="KokyakuCode3" style="background-color: white" readonly /></td>
        <td style="width:auto;"><input type="text" class="form-control inputtable" id="KokyakuName3" style="background-color: white" readonly /></td>
        <td style="width:80px;"><button type="button" class="btn btn-outline-primary btnKokyaku" id="btnKokyaku3" data-index="@Model.RowCount">変更</button></td>
        <td style="width:1px;"><input type="text" class="form-control" id="KokyakuId3" readonly hidden /></td>
      </tr>
      <tr>
      <th>下払先担当</th>
        <td><input type="text" class="form-control inputtable" id="CustomerTantouCD" readonly /></td>
        <td><input type="text" class="form-control inputtable" id="CustomerTantouName" readonly /></td>
        <td><button type="button" class="btn btn-outline-primary" onclick="ShitabaraiTantouDialog(this)" data-index="@Model.RowCount">変更</button></td>
        <td><input type="text" class="form-control" id="CustomerTantouID" readonly hidden /></td>
      </tr>
    </table>

    <table class="no-line">
      <tr>
        <th>下払金額</th>
        <td style="width:200px;"><input type="text" id="underPayment" name="underPayment" value="0" class="form-control under-payment-input inputtable" style="width:100px;text-align:right;" oninput="filterDigitsOnly(this);" onblur="kanmaChange(this);" /></td>
        <th>割増</th>
        <td style="width:200px;"><input type="text" id="surcharge" name="surcharge" value="0" class="form-control under-payment-input inputtable" style="width: 100px; text-align: right;" oninput="filterDigitsOnly(this);" onblur="kanmaChange(this);" /></td>
        <th>立替金（税込）</th>
        <td style="width:200px;"><input type="text" id="advance" name="advance" value="0" class="form-control under-payment-input inputtable" style="width: 100px; text-align: right;" oninput="filterDigitsOnly(this);" onblur="kanmaChange(this);" /></td>
        <td></td>
      </tr>
    </table>

    <table class="no-line">
      <tr>
        <th>赤伝黒伝発生理由</th>
      </tr>
      <tr>
        <td><textarea id="" name="" class="inputtable" style="resize: none; overflow-y: auto; height: 100px; width: 100%;"></textarea></td>
      </tr>
    </table>
  </div>
</div>
