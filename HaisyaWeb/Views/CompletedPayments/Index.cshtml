  async function openFileDialog() {
    try {
      // Request the user to select multiple files
      const fileHandles = await window.showOpenFilePicker({
        multiple: true,
        types: [
          {
            description: 'CSV files',
            accept: { 'text/csv': ['.csv'] },
          },
        ],
      });

      // Process each selected file
      const filePromises = fileHandles.map(async (fileHandle) => {
        const file = await fileHandle.getFile();
        const arrayBuffer = await file.arrayBuffer();
        const text = new TextDecoder('shift-jis').decode(arrayBuffer);
        return parseCSV(text);
      });

      const results = await Promise.all(filePromises);

            sendDataToBackend(results[0]);
        } catch (error) {
            console.error('Error opening files:', error);
        }
    }

  function parseCSV(text) {
    const rows = text
      .trim()
      .split('\n')
      .map((row) => row.split(','));

        let obj = {};
        let nyukin = [];
        let count = 0;
        // CSVファイルの全部の行をループして、オブジェクト化
        for (let i = 1; i < rows.length; i++) {
            obj = {};
            for (let j = 0; j < rows[i].length; j++) {
                @* CSVフォーマット
                2		Seikyu_ID	int	Yes	9
                3	０：入金、１：返金	Process_Kubun	int	Yes	1
                4		Process_Date	datetime	Yes	2024-08-06 15:30:00
                5		Cash_Amount	money	Yes	2.2
                6		Transfer_Amount	money	Yes	2.2
                7		Draft_Amount	money	Yes	2.2
                8		Check_Amount	money	Yes	2.2
                9		Service_Charge_Amount	money	Yes	2.2
                10		Unchin_Offset	money	Yes	2.2
                11		General_Offset	money	Yes	2.2
                12		Adjustment_Amount	money	Yes	2.2
                13		Total_Amount	money	Yes	2.2
                *@
                @* 名前（Seikyu_ID、Process_Kubunなど）の取得 *@
                let key = rows[0][j];
                let value = rows[i][j];
                if (key === 'Seikyu_ID' || key === 'Process_Kubun' || key === 'Nyukin_ID') {
                    obj[key] = Number(value);
                } else if (key === 'Process_Date') {
                    obj[key] = formatDate(value);
                } else if (
                    key === 'Cash_Amount' ||
                    key === 'Transfer_Amount' ||
                    key === 'Draft_Amount' ||
                    key === 'Check_Amount' ||
                    key === 'Service_Charge_Amount' ||
                    key === 'Unchin_Offset' ||
                    key === 'General_Offset' ||
                    key === 'Adjustment_Amount' ||
                    key === 'Total_Amount'
                ) {
                    obj[key] = parseFloat(value);
                } else if (key === 'Remarks') {
                    obj[key] = value;
                } else if (key === 'Del_Flg'){
                    obj[key] = value != '0'
                }
            }
            nyukin.push(obj);
        }
        return nyukin;
    }

  function sendDataToBackend(nyukinLists) {
    const payload = {
      SeikyuDataLists: seikyuDataLists,
      NyukinLists: nyukinLists,
    };
    const json = JSON.stringify(payload);

    $.ajax({
      url: '@Url.RouteUrl("Default", new { controller = "CompletedPayments", action = "InsertTNyukin2" })',
      type: 'POST',
      contentType: 'application/json',
      data: json,
      success: function (response) {
        if (response.message != null) {
          alertError(`【エラー】${response.message}`);
        }
        dataListDisplay();
      },
      error: function (jqXHR, textStatus, errorThrown) {
        alertError('CSV取込み失敗しました');
        console.error('Error sending data to backend:', textStatus, errorThrown);
      },
    });
  }

    function selectCustomerDriverSelectedCallBack(result) {
        $('#Search_SelectTokuisakiID' + btnTokuisaki).val(result['Employee_Number']);
        $('#Search_SelectTokuisakiName' + btnTokuisaki).val(result['Display_Name']);
    }
    function formatDate(value) {
        const date = new Date(value);
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0'); // Months are zero-based
        const day = String(date.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }
</script>
