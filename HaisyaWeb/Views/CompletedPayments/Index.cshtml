  function tglSelectTokuisaki(checked) {
    if (checked) {
      $('#lblkara').show();
      $('#tokuisakiTo').show();
    } else {
      $('#lblkara').hide();
      $('#tokuisakiTo').hide();
      $('#Search_SelectTokuisakiIDTo').val('');
      $('#Search_SelectTokuisakiNameTo').val('')
    }
    $('#Search_RangeSearch').val(checked);
    dataListDisplay();
  }


  /**
  * 指定年月変更処理
  * @@param move
  */
  function ChangeMonth(move) {

    var selectMonth = new Date($("#Search_SelectMonth").val());

    var changeMonth = new Date(selectMonth.setMonth(selectMonth.getMonth() + move));

    $("#Search_SelectMonth").val(formatMonth(changeMonth, "/"));
    $("#TargetMonthInput").val($("#Search_SelectMonth").val());

    ChangeTargetMonth();

  };

  /**
    * 指定年月変更後処理
    * */
  function ChangeTargetMonth() {

    var val = $("#Search_SelectMonth").val();
    var dateVal = new Date(val);
    var disp = MonthToString(dateVal);
    $("#TargetMonthLavel").val(disp);

    dataListDisplay();
  };

