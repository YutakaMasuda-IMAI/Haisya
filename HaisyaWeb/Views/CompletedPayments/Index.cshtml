    $("#TargetMonthLavel").val(disp);

    $("#TargetMonthInput").val($("#Search_SelectMonth").val());


    var radio = document.getElementsByName('num_of_zeikubun');
    for (let i = 0; i < radio.length; i++) {
      if (radio.item(i).value == $('#Search_SelectZeiKubun').val()) {
        radio.item(i).checked = true;
      }
    }

    radio = document.getElementsByName('num_of_hakkoukubun');
    for (let i = 0; i < radio.length; i++) {
      if (radio.item(i).value == $('#Search_SelectHakkouKubun').val()) {
        radio.item(i).checked = true;
      }
    }

    tglSelectTokuisaki($('#tglSelectTokuisaki').prop("checked"));
  });

  $(function () {
    $('input[name="num_of_zeikubun"]:radio').change(function () {
      dataListDisplay();
    });

