@model CommonDialogModel.SelectVenderModel


<style>

  .table-Venderlist-input {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    font-size: initial;
  }
</style>

@if (Model.VenderList.Count() == 0)
{
  <div style="width: 100%; background: #3366CC ">
    <h4 style="text-align:left; margin-left: 20px;color: white;">データ無し</h4>
  </div>
}


<table id="myTable" class="ex_table-Vender table-bordered border-info" width="100%" border="1">
  <thead style="background-color: chartreuse;  ">
    <tr align="center">
      <th class="ex-table-th" style="width: 80px; vertical-align: middle;">選択</th>
      <th class="ex-table-th" style="width: 50px;">
        <a data-koumoku="Kubun_Sort" href="#" onclick="dataListFirstSortChange('Vender_Code')" style="">業者<br />コード</a>
      </th>
      <th class="ex-table-th" style="width: 170px;">
        <a data-koumoku="Kubun_Sort" href="#" onclick="dataListFirstSortChange('Vender_Name')" style="">業者名</a>
      </th>
      <th class="ex-table-th" style="width: 100px;">
        <a data-koumoku="Kubun_Sort" href="#" onclick="dataListFirstSortChange('Vender_Name_Abbr')" style="">略称</a>
      </th>
      <th class="ex-table-th" style="width: 80px;">
        <a data-koumoku="Kubun_Sort" href="#" onclick="dataListFirstSortChange('Vender_Name_Kana')" style="">検索カナ</a>
      </th>
      <th class="ex-table-th" style="width: 50px;">
        <a data-koumoku="Kubun_Sort" href="#" onclick="dataListFirstSortChange('Phone1')" style="">電話番号1</a>
      </th>
      <th class="ex-table-th" style="width: 50px;">
        <a data-koumoku="Kubun_Sort" href="#" onclick="dataListFirstSortChange('Fax1')" style="">FAX番号1</a>
      </th>
    </tr>
  </thead>
  <tbody>
    @{
      int i = 1;
    }
    @foreach (var item in Model.VenderList.OrderBy(m => m.Vender_Code).Take(100).ToList())
    {
      int rem;
      int div = Math.DivRem(i, 2, out rem);
      string color = rem == 0 ? "khaki" : "	whitesmoke";
      <tr style="font-size: 12px; font-weight: bold; background-color: @(color); height: 20px;">
        <td style="vertical-align: middle;">
          <button type="button" name="btnVenderList" class="btn btn-success" style="width: 100%; padding:0;">選択</button>
        </td>

        <td hidden>
          @Html.TextBoxFor(modelItem => item.Vender_ID, null, new { @readonly = "readonly", })
        </td>
        <td hidden>
          @Html.TextBoxFor(modelItem => item.Vender_Code, null, new { @readonly = "readonly", @class = "table-Venderlist-input", @style = "width:100px;" })
        </td>
        <td hidden>
          @Html.TextBoxFor(modelItem => item.Vender_Name, null, new { @readonly = "readonly", @class = "table-Venderlist-input" })
        </td>
        <td hidden>
          @Html.TextBoxFor(modelItem => item.Vender_Name_Abbr, null, new { @readonly = "readonly", @class = "table-Venderlist-input" })
        </td>
        <td hidden>
          @Html.TextBoxFor(modelItem => item.Vender_Name_Kana, null, new { @readonly = "readonly", @class = "table-Venderlist-input" })
        </td>
        <td hidden>
          @Html.TextBoxFor(modelItem => item.Phone1, null, new { @readonly = "readonly", @class = "table-Venderlist-input", @style = "width:100px;" })
        </td>
        <td hidden>
          @Html.TextBoxFor(modelItem => item.Fax1, null, new { @readonly = "readonly", @class = "table-Venderlist-input", @style = "width:100px;" })
        </td>
      </tr>
      i++;
    }
  </tbody>
</table>



<script>

  $(function () {


    $('button[name="btnVenderList"]').on('click', function () {

      let result = SelectCommonDialog($(this));
      //alert(data);

      selectOnClick(result);

    });


  });

</script>