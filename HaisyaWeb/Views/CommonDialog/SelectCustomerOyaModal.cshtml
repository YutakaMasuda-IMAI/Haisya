@model CommonDialogModel.SelectCustomerOyaModel



<style>
  .div-area-customer-dialog {
    margin: auto;
    flex-wrap: wrap;
    display: flex;
    padding: 0 5px 0 5px
  }

  .tab_class-customer-dialog {
    width: calc(100%/2);
    height: 50px;
    background-color: aquamarine;
    line-height: 50px;
    font-size: 15px;
    text-align: center;
    display: block;
    float: left;
    order: -1;
    border: double;
  }

  input[name="tab_name-customer-dialog"] {
    display: none;
  }

  input:checked + .tab_class-customer-dialog {
    background-color: cadetblue;
    color: aliceblue;
  }

  .content_class-customer-dialog {
    display: none;
    width: 100%;
  }

  input:checked + .tab_class-customer-dialog + .content_class-customer-dialog {
    display: block;
  }

  .table-CustomerListDataModal {
    overflow: auto;
    /*width: 100%;*/
    max-height: 700px;
  }

    .table-CustomerListDataModal table {
      margin: 0;
      border-spacing: 0;
      /*width: 100%;*/
      font-size: 12px;
    }

    .table-CustomerListDataModal th {
      white-space: nowrap;
      position: sticky;
      top: -1px;
      left: 0;
      border-right: 1px solid #999;
      border-bottom: 1px solid #999;
      background-color: lemonchiffon;
      text-align: center;
      padding: 0.2rem 0 0.2rem 0;
    }

    .table-CustomerListDataModal td {
      white-space: nowrap;
      padding: 2px;
      border-right: 1px solid #999;
      border-bottom: 1px solid #999;
    }

    .table-CustomerListDataModal tr:first-child th {
      border-top: 1px solid #999;
    }

    .table-CustomerListDataModal th:first-child {
      border-left: 1px solid #999;
    }

    .table-CustomerListDataModal tr:first-child th:first-child {
      z-index: 1;
    }
</style>


<div id="hiddenItem" hidden>
  @Html.HiddenFor(Model => Model.CompanyID)
  @Html.HiddenFor(Model => Model.SelectedID)
  @Html.HiddenFor(Model => Model.UserID)

</div>


<div class="modal-dialog container" role="document" style="">
  <div class="modal-content">
    <div class="model-body">
      <div class="div-area-customer-dialog">
        <div class="content_class-customer-dialog">
          <table class="table jbc-table table-borderless p-0" style="background-color: whitesmoke;" border="1">
            <tbody>
              <tr style="vertical-align: middle;">
                <td class="col-sm-10">
                  <label class="control-label align-self-center align-middle text-end p-0" style="">顧客コード（前方一致）：</label>
                  @Html.TextBoxFor(model => Model.SearchCustomerCd, null, new { @class = "text", @style = "width:100px;" })
                </td>

                <td class="col-sm-1">
                  <button type="button" style="width: 100px; float: right;" class="btn btn-primary align-items-end" onclick="listDisplay();return false;">検索</button>
                </td>
              </tr>
            </tbody>
          </table>

          <div id="CommonDialogToCustomerList" class="table-CustomerListDataModal dataList m-0" style="height:500px;">
          </div>
        </div>
      </div>
    </div>
  </div>
</div>




<script>

  $(window).on('load', function () {

  });

  $(async function () {

    const _sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
    $('.content_class-customer-dialog').show();

    $("#SearchCustomerCd").keypress(function(e) {
        if (e.keyCode == 13) {
          listDisplay();
          return false;
        }
    });

    listDisplay();
  });


  /**
   * 画面を閉じる
   * selectCustomerModalCloseCallBack
   * */
  function ModalCommonDialogClose() {

    $('#ModalCommonDialog').html('');

    if (typeof selectCustomerOyaModalCloseCallBack == 'function') {
      // 関数があった場合の処理内容
      selectCustomerOyaModalCloseCallBack();
    }
  };

  /**
   * 一覧データ選択時の処理
   * selectCustomerModalCloseCallBack
   * @@param data
   */
  function selectOnClick(data) {

    $('#ModalCommonDialog').html('');
    $('#ModalCommonDialog').dialog("close");


    //コールバック関数チェック
    if (typeof selectCustomerOyaSelectedCallBack == 'function') {
      // 関数があった場合の処理内容
      selectCustomerOyaSelectedCallBack(data);
    }

  };

  function listDisplay() {

    $.post('@Url.RouteUrl("Default", new { controller = "CommonDialog", Action = "JsonGetSelectCustomerOyaDataList" })',
    {
        SearchCustomerCd: $("#SearchCustomerCd").val(),
    },
    function (data) {
        if (data.message != null) {
            alertError(`【エラー】${data.message}`);
        }
        else {
            $('#CommonDialogToCustomerList').html(data.partialView);
        }
    }
    );

    };

</script>
<script src="~/js/EnterKeyCancel.js"></script>