@model CommonDialogModel.SelectVenderModel


<style>
</style>

@if (Model.VenderList.Count() == 0)
{
  <div style="width: 100%; background: #3366CC ">
    <h4 style="text-align:left; margin-left: 20px;color: white;">データ無し</h4>
  </div>
}


<table id="@(Model.ListIdName)" class="table table-address">
  <thead>
    <tr><th>@(Model.TheadTitle)</th></tr>
  </thead>
  <tbody>
    @foreach (var item in Model.VenderList)
    {
    <tr>
      <td>
        <button class="btn btn-dark" style="width: 100% !important;height: 70%;" onclick="return false;">
          <div style="padding: 0px 0px 0px 2px; margin: 0; background: none; width: 100%; line-height: initial; text-align: left;">
            <div style="display:inline-flex; float: left;">
              @Html.DisplayFor(modelItem => item.Vender_Code) ： @Html.DisplayFor(modelItem => item.Vender_Name)
            </div>
          </div>
        </button>
      </td>

      <td hidden width="20px" style="vertical-align: middle;" align="center">
        @Html.TextBoxFor(modelItem => item.Vender_ID, null, new { @readonly = "readonly", })
      </td>
      <td hidden width="20px" style="vertical-align: middle;" align="center">
        @Html.TextBoxFor(modelItem => item.Vender_Code, null, new { @readonly = "readonly", })
      </td>
      <td hidden width="170px">
        @Html.TextBoxFor(modelItem => item.Vender_Name, null, new { @readonly = "readonly", })
      </td>
      <td hidden width="100px">
        @Html.TextBoxFor(modelItem => item.Vender_Name_Abbr, null, new { @readonly = "readonly", })
      </td>
      <td hidden width="80px">
        @Html.TextBoxFor(modelItem => item.Vender_Name_Kana, null, new { @readonly = "readonly", })
      </td>
      <td hidden width="50px">
        @Html.TextBoxFor(modelItem => item.Phone1, null, new { @readonly = "readonly", })
      </td>
      <td hidden width="50px">
        @Html.TextBoxFor(modelItem => item.Fax1, null, new { @readonly = "readonly", })
      </td>

    </tr>
    }
  </tbody>
</table>


<script>

  $(function () {


    $('#@(Model.ListIdName) tbody tr').on('click', function () {

      let result = SelectCommonDialog($(this));
      //alert(data);

      selectOnClick(result);

    });





  });


</script>