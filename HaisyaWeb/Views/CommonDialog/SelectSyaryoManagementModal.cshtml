@model CommonDialogModel.SelectSyaryoManagementModel



<style>
  .div-area-syaryomanagement-dialog {
    margin: auto;
    flex-wrap: wrap;
    display: flex;
    padding: 0 5px 0 5px
  }

  .table-SyaryoManagementListDataModal {
    overflow: auto;
    width: 100%;
    max-height: 700px;
  }

    .table-SyaryoManagementListDataModal table {
      margin: 0;
      border-spacing: 0;
      width: 100%;
      font-size: 12px;
    }

    .table-SyaryoManagementListDataModal th {
      white-space: nowrap;
      position: sticky;
      top: -1px;
      left: 0;
      border-right: 1px solid #999;
      border-bottom: 1px solid #999;
      background-color: lemonchiffon;
      text-align: center;
      padding: 0.2rem 0 0.2rem 0;
    }

    .table-SyaryoManagementListDataModal td {
      white-space: nowrap;
      padding: 2px;
      border-right: 1px solid #999;
      border-bottom: 1px solid #999;
    }

    .table-SyaryoManagementListDataModal tr:first-child th {
      border-top: 1px solid #999;
    }

    .table-SyaryoManagementListDataModal th:first-child {
      border-left: 1px solid #999;
    }

    .table-SyaryoManagementListDataModal tr:first-child th:first-child {
      z-index: 1;
    }
</style>


<div id="hiddenItem" hidden>
  @Html.HiddenFor(Model => Model.CompanyID)
  @Html.HiddenFor(Model => Model.SelectedID)
  @Html.HiddenFor(Model => Model.UserID)
  @Html.HiddenFor(Model => Model.MyTantouOnlyFlg)
</div>


<div class="modal-dialog container" role="document" style="">
  <div class="modal-content">
    <div class="model-body">
      <div class="div-area-syaryomanagement-dialog">
        <table class="table jbc-table table-borderless" style="padding: 0; background-color: whitesmoke;" border="1">
          <tbody>
            <tr style="vertical-align: middle;">
              @*<td width="20px"></td>*@
              <td class="col-sm-2">
                <label class="control-label align-self-center align-middle text-end" style="padding:0;">車番：</label>
                @Html.TextBoxFor(model => Model.Syaban, null, new { @class = "text", @style = "width:100px;" })
              </td>
              <td class="col-sm-3">
                @Html.LabelFor(model => model.SelectSyasyuID, htmlAttributes: new { @class = "control-label align-self-center align-middle text-end", @style = "padding: 0;" })
                <div class="" style="display: inline-block; _display: inline; padding: 0; width: 80%;">
                  @Html.DropDownListFor(model => model.SelectSyasyuID, new SelectList(Model.SyasyuSelectList, "Value", "Text", "Selected"), "車種を選択", new { @class = "form-control", @style = "padding: 0;" })
                  @Html.ValidationMessageFor(model => model.SelectSyasyuID, "", new { id = "SelectDriverKubun", @class = "text-danger align-middle" })
                </div>
              </td>
              @*<td class="col-sm-3">
                  @Html.LabelFor(model => model.SelectKata, htmlAttributes: new { @class = "control-label align-self-center align-middle text-end", @style = "padding: 0;" })
                  <div class="2" style="display: inline-block; _display: inline; padding: 0; width: 80%;">
                    @Html.DropDownListFor(model => model.SelectKata, new SelectList(Model.KataSelectList, "Value", "Text", "Selected"), "型を選択", new { @class = "form-control", @style = "padding: 0;" })
                    @Html.ValidationMessageFor(model => model.SelectKata, "", new { id = "SelectMonth", @class = "text-danger align-middle" })
                  </div>
                </td>*@
              <td class="col-sm-4">
                <div style="border: .1em solid #bbb; padding: 0; margin: 0 5px 0 5px; border-radius: 10px; display: block; ">
                  @Html.LabelFor(model => model.MyTantouOnlyFlg, htmlAttributes: new { @class = "control-label align-self-center align-middle", @style = "padding: 0; margin-right: 2rem;" })
                  <input type="radio" name="num_of_inq" value="0">全て　
                  <input type="radio" name="num_of_inq" value="1">担当車輌のみ　
                </div>
              </td>
              <td class="col-sm-1">
                <button type="button" style="width: 100px; float: right;" class="btn btn-primary align-items-end" onclick="listDisplay();return false;">検索</button>
              </td>
            </tr>
          </tbody>
        </table>
        <div id="alertTop" style="vertical-align: middle; margin-top: 1px;">
          @*<label>※Top100件を抽出</label>*@
        </div>

        <div id="DataList-SyaryoManagementListDataModal" class="table-SyaryoManagementListDataModal dataList" style="height:500px; margin: 0;">

        </div>

      </div>
    </div>
  </div>

</div>


<script>

    $(function () {

      ///担当車輌フラグ
      var radio = document.getElementsByName('num_of_inq');
      for (let i = 0; i < radio.length; i++) {
        if (radio.item(i).value == $("#MyTantouOnlyFlg").val()) {
          radio.item(i).checked = true;
        }
      }

    ///担当車輌フラグの条件変更時
    $('input[name="num_of_inq"]:radio').change(function () {
      listDisplay();
      return false;
    });

    ///車番コードの条件変更時
      $('#Syaban').on('change', function () {
      listDisplay();
      return false;
    });

    ///車種の条件変更時
      $('#SelectSyasyuID').on('change', function () {
      listDisplay();
      return false;
    });

    /////型の条件変更時
    //  $('#SelectKata').on('change', function () {
    //  listDisplay();
    //  return false;
    //});

      listDisplay();

  });

  /**
   * 画面を閉じる
   * selectSyaryoModalCloseCallBack
   * */
  function ModalCommonDialogClose() {

    $('#ModalCommonDialog').html('');

    if (typeof selectSyaryoManagementModalCloseCallBack == 'function') {
      // 関数があった場合の処理内容
      selectSyaryoManagementModalCloseCallBack();
    }     
  };

  /**
   * 一覧データ選択時の処理
   * selectSyaryoModalCloseCallBack
   * @@param data
   */
  function selectOnClick(data) {

    $('#ModalCommonDialog').html('');
    $('#ModalCommonDialog').dialog("close");

    //コールバック関数チェック
    if (typeof selectSyaryoManagementSelectedCallBack == 'function') {
      // 関数があった場合の処理内容
      selectSyaryoManagementSelectedCallBack(data);
    } 
  };

  /**
   * 車輌検索一覧の表示
   * */
  function listDisplay() {

    var selectTab = $('input[name="num_of_inq"]:checked').val();
    $('#MyTantouOnlyFlg').val(selectTab);


    $.post('@Url.RouteUrl("Default", new { controller = "CommonDialog", Action = "JsonGetSyaryoManagementDataList" })',
      {
        Syaban: $("#Syaban").val(),
        SelectSyasyuID: $("#SelectSyasyuID").val(),
/*        SelectKata: $("#SelectKata").val(),*/
        MyTantouOnlyFlg: $("#MyTantouOnlyFlg").val(),
      },
      function (data) {
          if (data.message != null) {
              alertError(`【エラー】${data.message}`);
          }
          else {
              $('#alertTop').hide();
              $('#DataList-SyaryoManagementListDataModal').html(data.partialView);
          }
      }
    );

  };


</script>
<script src="~/js/EnterKeyCancel.js"></script>