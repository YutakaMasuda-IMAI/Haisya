    function CreatePolylineTable(list) {


        alert(list.length);

        $("#Polyline").empty();

        for (var i = 0; i < list.length; i++) {

            var aa = "Map" + String(i + 1);
            var bb = '<table id="' + aa + '">';
            var tableJQ = $(bb);

            //alert(list[i].length);

            for (var m = 0; m < list[i].length; m++) {

                var latVal = list[i][m][0];
                var lngVal = list[i][m][1];

                alert(latVal + ";" + lngVal);

                var trJQ_r = $('<tr></tr>').appendTo(tableJQ);

                $('<td>' + latVal + '</td>').appendTo(trJQ_r);
                $('<td>' + lngVal + '</td>').appendTo(trJQ_r);

            }

            $("#Polyline").append(tableJQ);

        };

    };


    /*------------------------------------------------
         文字列の左右に指定した文字を連結して固定長にする
        --------------------------------------------------*/
    function padLeft(pad, str) {
        if (typeof str === 'undefined')
            return pad;

        return (pad + str).slice(-pad.length);
    };
    function padRight(pad, str) {
        if (typeof str === 'undefined')
            return pad;

        return (str + pad).substring(0, pad.length);
    };


    function MapGetCenterPoint() {
        //alert("MapGetCenterPoint()");
        var latLng = map.getCenter();
        var latlon = latLng.lng + ',' + latLng.lat;
        return latlon;
    };


    function GetAddressForDesktop(lat, lng, komoku) {

        var latlon = String(lng) + ',' + String(lat);

        alert(latlon);

        $.ajax({
            url: '@Url.RouteUrl("Default", new { controller = "Home2", Action = "MapGetAddressFromPosition" })',
            type: 'post',
            cache: false,
            dataType: 'json',
            async: true,
            data: { positionl: String(latlon), }
        }).done(function(response) {

            if (response.errorMessage != null) {
                alertError(`【エラー】${response.errorMessage}`);
                return String(null);
            } else {
                alert("【戻り値】" + response.result);
                return response.result;
            }


        }).fail(function (xhr) {
            alert('fail:' + xhr);
            console.log(xhr);
            return String(null);
        }).always(function (xhr, msg) {

        });

        return String(null);
    };


    function setPolyline(routeId, lineStyle) {

        var selector = "#Map" + routeId +" tr";
        //alert(selector);

        var latlons = [];


        //var lineStyle2 = "solid";

        $(selector).each(function (i, e) {

            //alert("aaa");

            for (var i = 0, l = $(this).length; i < l; i++) {

                var cells = $(this).eq(i).children();//1行目から順にth、td問わず列を取得

                var latVal = cells.eq(0).text();
                var lngVal = cells.eq(1).text();

                //alert(latVal + ";" + lngVal);
                latlons.push(new ZDC.LatLng(parseFloat(latVal), parseFloat(lngVal)));

            }

        });

        // ポリラインを作成
        // ポリラインを地図オブジェクト(map)に追加
        switch (String(routeId)) {
            case "1":
                if (pl[1] === undefined) {  } else { map.removeWidget(pl[1]); }
                pl[1] = new ZDC.Polyline(latlons, { color: '#ff0000', width: 5, pattern: lineStyle, opacity: 1.0 });
                map.addWidget(pl[1]);
                break;
            case "2":
                if (pl[2] === undefined) { } else { map.removeWidget(pl[2]); }
                pl[2] = new ZDC.Polyline(latlons, { color: '#4800ff', width: 5, pattern: lineStyle, opacity: 1.0 });
                map.addWidget(pl[2]);
                break;
            case "3":
                if (pl[3] === undefined) { } else { map.removeWidget(pl[3]); }
                pl[3] = new ZDC.Polyline(latlons, { color: '#00ff21', width: 5, pattern: lineStyle, opacity: 1.0 });
                map.addWidget(pl[3]);
                break;
            case "4":
                if (pl[4] === undefined) { } else { map.removeWidget(pl[4]); }
                pl[4] = new ZDC.Polyline(latlons, { color: '#ff00dc', width: 5, pattern: lineStyle, opacity: 1.0 });
                map.addWidget(pl[4]);
                break;
            default:
                if (pl[0] === undefined) { } else { map.removeWidget(pl[0]); }
                pl[0] = new ZDC.Polyline(latlons, { color: '#00ffff', width: 5, pattern: lineStyle, opacity: 1.0 });
                map.addWidget(pl[0]);
                break;

        }

        return;

    };


    function SetMarkerToTruck(lat, lng, iconID, kubun, popupVal) {

        var iconPath = '';
        var host = 'https://' + location.hostname;

        switch (kubun) {
            case "TruckB":
                iconPath = host + '/MapApplication/img/TruckIconBlue.png';
                break;
            case "TruckR":
                iconPath = host + '/MapApplication/img/TruckIconRed.png';
                break;
        }

        var widgetPopup = new ZDC.Popup(new ZDC.LatLng(parseFloat(lat), parseFloat(lng)), {
            htmlSource: popupVal,
            closeButton: false
        });
        var widget = new ZDC.Marker(new ZDC.LatLng(parseFloat(lat), parseFloat(lng)), {
            custom: {
                base: {
                    imgSrc: iconPath
                    }
            }
        });
        widget.addEventListener('click', function (event) {
            MarkerClickToTruck(iconID);
        });
        widget.addEventListener('mouseover', function (event) {
            map.addWidget(widgetPopup);
        });
        widget.addEventListener('mouseout', function (event) {
            map.removeWidget(widgetPopup);
        });
        map.addWidget(widget)
    };


    function SetMarkerToCargo(lat, lng, iconID, kubun, popupVal) {

        var iconPath = '';
        var host = 'https://' + location.hostname;

        switch (kubun) {
            case "TruckB":
                iconPath = host + '/MapApplication/img/TruckIconBlue.png';
                break;
            case "TruckR":
                iconPath = host + '/MapApplication/img/TruckIconRed.png';
                break;
        }

        var widgetPopup = new ZDC.Popup(new ZDC.LatLng(parseFloat(lat), parseFloat(lng)), {
            htmlSource: popupVal,
            closeButton: false
        });
        var widget = new ZDC.Marker(new ZDC.LatLng(parseFloat(lat), parseFloat(lng)), {
            custom: {
                base: {
                    imgSrc: iconPath
                }
            }
        });
        widget.addEventListener('click', function (event) {
            MarkerClickToCargo(iconID);
        });
        widget.addEventListener('mouseover', function (event) {
            map.addWidget(widgetPopup);
        });
        widget.addEventListener('mouseout', function (event) {
            map.removeWidget(widgetPopup);
        });
        map.addWidget(widget)
    };

