<div class="modal-dialog modal-dialog-centered" role="document" style="">
  <div class="modal-content">
    <div class="modal-header" style="background-color: gainsboro;">
      <h1 class="modal-title fs-3" id="exampleModalLabel">トラックメイト連携</h1>
      <button type="button" class="btn btn-primary" onclick="regExec(); return false;" style="width: 150px;">連携</button>
      <button type="button" class="btn btn-secondary" onclick="closeModel(); return false;" style="width: 150px;">中止</button>
    </div>
    <div class="model-body">
      <form id="form1">
        <div id="hidden" hidden>
          @Html.HiddenFor(model => Model.CompanyID)
        </div>
        <div class="contents-wrap-middle" style="margin: 10px;">
          <h4 class="">注意</h4>
          <span>
            ・この画面で入力内容を
            ・一度データを登録すると物理削除は出来ません。「非表示フラグ」を立ててください。<br />
            @*<label style="color:red; font-weight:bolder;">・「顧客ID」の値が0以上の場合は、親得意先データを変更しても反映されません</label>*@
          </span>
        </div>
        <h3>得意先情報</h3>
        <table class="table table-striped-columns table-bordered border-primary" border="1" style="margin: 10px; width:96%;">
          <thead>
            <tr style="background-color: aquamarine;">
              <th align="center" style="text-align: center; width: 120px; ">項目名</th>
              <th align="center" style="text-align: center;">値</th>
              <th align="center" style="text-align: center;">例</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th>顧客ID</th>
              <td >
                <div style="display: flex">
                  @Html.TextBoxFor(model => Model.CustomerData.Customer_ID, null, new { @readonly = "readonly", @class = "form-control text-left readonly", @onblur = "", @style = "width: 50px; padding: 0;" })
                  <span style="width:2rem;"></span>
                  <button class="btn btn-success" onclick="openCommonDialogForCustomer(); return false;">親の付替え</button>
                </div>
              </td>
              <td></td>
            </tr>
            <tr hidden>
              <th></th>
              <td>@Html.TextBoxFor(model => Model.CustomerData.Company_ID, null, new { @readonly = "readonly", @class = "form-control text-left", @onblur = "", @style = "width: 95%; padding: 0;" })</td>
