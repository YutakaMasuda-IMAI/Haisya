      </form>
    </div>
  </div>
</div>

<script>

  $(function () {


    $('#CustomerData_Password').on('keyup', function () {
      // 入力値取得
      const value = $(this).val();
      // 入力値をもとに強度を確認
      const result = pwCheckStrength(value);
      // 結果を出力
      $('#CustomerData_Password_ValidationMessage').text(result);
    });


    if ($('#CustomerData_Customer_ID').val() > 0) {
      ChangeCustomerData(true);
    }

  });



  function ChangeCustomerData(val) {

    $("[id^='CustomerData']").attr('disabled', val);
    $('#YosyaFlg').attr('disabled', val);
  }


  function regExec() {

    if (varidationCheck()) {
      return false;
    }

    ChangeCustomerData(false);

    //Formの参照を取る
    var $form = $('#form1');

    //alert($form.serialize());

    $.ajax({
          url: '@Url.RouteUrl("Default", new { controller = "Customer", Action = "TracmateLinkRegExec" })',
          type: 'post',
          data: $form.serialize(),
        }).done(function (response) {
          if (response.errorMessage != null && response.errorMessage != '') {
              alertError(`【エラー】${response.errorMessage}`);
              return false;
          } else {
            closeModelAndRefresh();
            return false;
          }
        }).fail(function (xhr) {
          alert('【ネットワークエラー】:' + xhr);
            console.log(xhr);
            return false;
        }).always(function (xhr, msg) {
            console.log(xhr, msg);
        });

  }




  function varidationCheck() {

    if (!($('#CustomerData_Customer_Name').val() != null && $('#CustomerData_Customer_Name').val().length > 0)) {
      alert("顧客名が入力されていません");
      $('#CustomerData_Customer_Name').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#CustomerData_Customer_Name').css('background-color', 'white');
    }

    if (!($('#CustomerData_Customer_Name_Abbr').val() != null && $('#CustomerData_Customer_Name_Abbr').val().length > 0)) {
      alert("略名が入力されていません");
      $('#CustomerData_Customer_Name_Abbr').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#CustomerData_Customer_Name_Abbr').css('background-color', 'white');
    }

    if (!($('#CustomerData_Customer_Name_Kana').val() != null && $('#CustomerData_Customer_Name_Kana').val().length > 0)) {
      alert("顧客名カナが入力されていません");
      $('#CustomerData_Customer_Name_Kana').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#CustomerData_Customer_Name_Kana').css('background-color', 'white');
    }

    if (!($('#CustomerData_PostCode').val() != null && $('#CustomerData_PostCode').val().length > 0)) {
      alert("郵便番号が入力されていません");
      $('#CustomerData_PostCode').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#CustomerData_PostCode').css('background-color', 'white');
    }

    if (!($('#CustomerData_Address1').val() != null && $('#CustomerData_Address1').val().length > 0)) {
      alert("住所１が入力されていません");
      $('#CustomerData_Address1').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#CustomerData_Address1').css('background-color', 'white');
    }

    if (!($('#CustomerData_Phone1').val() != null && $('#CustomerData_Phone1').val().length > 0)) {
      alert("電話番号１が入力されていません");
      $('#CustomerData_Phone1').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#CustomerData_Phone1').css('background-color', 'white');
    }


    return false;

  };


  function openCommonDialogForCustomer() {

    openCommonDialogForCustomerOya($('#Company_ID').val(), null, null);

  };

  /**
   * 共通得意先選択ダイアログで一覧選択されたときのCallBack関数
   * */
  function selectCustomerOyaSelectedCallBack(obj) {
    
    $('#CustomerData_Company_ID').val(obj["Customer_ID"]);
    $('#CustomerData_Customer_ID_Oya').val(obj["Customer_ID"]);
    $('#CustomerData_Customer_Code_Oya').val(obj["Customer_ID"]);

    $('#CustomerData_Customer_Code').val(obj["Customer_Code"]);
    $('#CustomerData_Yosya_Flg').val(obj["Yosya_Flg"]);
    $('#CustomerData_Customer_Name').val(obj["Customer_Name"]);
    $('#CustomerData_Customer_Name_Abbr').val(obj["Customer_Name_Abbr"]);
    $('#CustomerData_Customer_Name_Kana').val(obj["Customer_Name_Kana"]);
    $('#CustomerData_PostCode').val(obj["PostCode"]);
    $('#CustomerData_Address1').val(obj["Address1"]);
    $('#CustomerData_Address2').val(obj["Address2"]);
    $('#CustomerData_Phone1').val(obj["Phone1"]);
    $('#CustomerData_Phone2').val(obj["Phone2"]);
    $('#CustomerData_Fax1').val(obj["Fax1"]);
    $('#CustomerData_Fax2').val(obj["Fax2"]);
    $('#CustomerData_Insert_User').val(obj["Insert_User"]);

    $('#CustomerData_Customer_ID').val(obj["Customer_ID"]);
    $('#CustomerBranchData_Customer_ID').val(obj["Customer_ID"]);

    if ($('#CustomerData_Customer_ID').val() > 0) {
      ChangeCustomerData(true);
    }

  };

</script>
