@model HaisyaWeb.Models.CustomerTruckmeteListDto


@{
    Layout = "../Setting/MasterDataMenu";
    ViewData["Title"] = "ﾄﾗｯｸﾒｲﾄ連携";
}


<head>
  <link href="~/css/Customer.css" rel="stylesheet" />

  <style>
  </style>
</head>

<body>
  <div id="hiddenItem" hidden>
    @Html.HiddenFor(model => Model.CompanyID)
    @Html.HiddenFor(model => Model.SelectKubun)
  </div>
  <div>
    <h3>@*トラックメイト未連携顧客一覧*@</h3>
    
  </div>
  <div>
    @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "Form2" }))
    {
    <div id="hedder" class="row" style="margin-bottom: -20px; margin-left: -20px; width: 105%;">
      <h6 class="heading-pagetitle">トラックメイト未連携顧客一覧</h6>
      <div class="form-group" style="width: 100%">
        <div class="row">
          <table class="table jbc-table table-borderless" style="padding: 0; background-color: whitesmoke;" border="1">
            <tbody>
              <tr>
                <td width="20px"></td>
                <td class="col-sm-2">
                  <label class="control-label align-self-center align-middle text-end" style="padding:0;">顧客コード：</label>
                  <input type="text" id="txtCode" style="width: 150px; display: inline-block;" class="form-control" />
                </td>
                <td class="col-sm-2">
                  <label class="control-label align-self-center align-middle text-end" style="padding:0;">検索キー：</label>
                  <input type="text" id="txtKey" style="width: 150px; display: inline-block;" class="form-control" />
                </td>
                <td class="col-sm-3">
                  <label class="control-label align-self-center align-middle text-end" style="padding:0;">電話(Fax)番号：</label>
                  <input type="text" id="txtPhone" style="width: 150px; display: inline-block;" class="form-control" />
                </td>
                <td class="col-sm-2" style="align-content: center;">
                  <div style="border: .1em solid #bbb; padding: 0; margin: 0 15px 0 15px; border-radius: 10px; text-align: center; ">
                    <input type="radio" name="num_of_select" value="0" checked>得意先　
                    <input type="radio" name="num_of_select" value="1">傭車先　
                  </div>
                </td>
                <td class="col-sm-1" style="text-align: center;">
                  <button type="button" style="width: 100px;" class="btn btn-primary align-items-end" onclick="listDisplay();return false;">検索</button>
                </td>
                <td style="vertical-align: middle; text-align: center;">
                  <label>※Top30件を抽出</label>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    }
  </div>

  <div id="CustomerList" style="margin-left: -20px; width: 105%; margin-right: 0px; margin-top: 20px;">
  </div>

  <!--<div>-->
    @*//モダール表示用のスペースを追加*@
    <!--<div id="ModalHere" data-keyboard="false" data-backdrop="static"></div>
    <div id="SortHere" hidden></div>
  </div>-->
</body>


<script>

  $(window).on('load', function () {

    let tabs = $('.sub-btn'); // tabのクラスを全て取得し、変数tabsに配列で定義
    $('.sub-btn').removeClass('active');
    $('#tabCustomerLink').addClass('active');

    listDisplay();
  });

  $(function () {

    $('#txtCode').on('change', function () {
      listDisplay();
      return false;
    });

    $('#txtKey').on('change', function () {
      listDisplay();
      return false;
    });

    $('#txtPhone').on('change', function () {
      listDisplay();
      return false;
    });

    $('input[name="num_of_select"]:radio').change(function () {
      $('#SelectKubun').val($('input[name="num_of_select"]:radio:checked').val());
      listDisplay();
    });


  });

  function closeModel() {
    $('#ModalHere').dialog('close');
    $('#ModalHere').hide();
    $('#ModalHere').html('');
    $("#btnDialogClose").trigger("click");
  };

  function closeModelAndRefresh() {
    $('#ModalHere').dialog('close');
    $('#ModalHere').hide();
    $('#ModalHere').html('');
    $("#btnDialogClose").trigger("click");
    listDisplay();
    alertInfo("登録が完了しました。");
  };

  function listDisplay() {


    $.post('@Url.RouteUrl("Default", new { controller = "Customer", Action = "JsonGetDataListForTrucmete" })',
      {
        code: $("#txtCode").val(),
        key: $("#txtKey").val(),
        phone: $("#txtPhone").val(),
        select: $('#SelectKubun').val(),
      },
      function (data) {
        //alert(data.partialView);
        $('#CustomerList').html(data.partialView);
      }
    );

  };

  /// <summary>
  ///
  /// </summary>
  function ankenListFirstSortChange(name) {

    if (typeof name === "undefined") {
      return;
    }




  };


  function submitData(code) {

    CommonWaitStart();

     $.post('@Url.RouteUrl("Default", new { controller = "Customer", Action = "TracmateLinkModal" })',
        {
          code: code,
          select: $('#SelectKubun').val(),
        })
        .done(function (response) {
          if (response.message != null) {
              alertError(`【エラー】${response.message}`);
              return false;
          } else {
            //alert("【done】" + response.partialView);
            $("#ModalHere").html(response.partialView);
            DailogOpen2("ModalHere", "", 780, "auto", "center top")

            return false;
          }
        })
        .fail(function (xhr) {
            console.log(xhr);
        })
        .always(function (xhr, msg) {
          console.log(xhr, msg);
          CommonWaitEnd();
        });

  }

</script>