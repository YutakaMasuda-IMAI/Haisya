@model HaisyaWeb.Models.CustomerBranchModalDto


<style>

  .tab_class {
    width: calc(100%/5);
    height: 50px;
    background-color: aquamarine;
    line-height: 50px;
    font-size: 15px;
    text-align: center;
    display: block;
    float: left;
    order: -1;
    border: double;
  }

  input[name="tab_name"] {
    display: none;
  }

  input:checked + .tab_class {
    background-color: cadetblue;
    color: aliceblue;
  }

  .content_class {
    display: none;
    width: 100%;
  }

  input:checked + .tab_class + .content_class {
    display: block;
  }

  /*  .float-left {
    float: left;
    padding: 0.5em 1em;
    margin: 2em 0;
    background: #f0f7ff;
    border: dashed 2px #5b8bd0;
  }

  .float-right {
    float: right;
    padding: 0.5em 1em;
    margin: 2em 0;
    background: #f0f7ff;
    border: dashed 2px #5b8bd0;
  }*/

  .readonly {
    background-color: lightgray;
  }

  .table-customer-tantou th {
    padding: 0.1rem;
  }

    table tbody tr th {
        align-content: center;
    }

    select {
        padding: 0 0 0 0.5rem;
    }

    input {
        padding: 0 0 0 0.5rem;
    }

  .div-content {
    margin: auto;
    flex-wrap: wrap;
    display: flex;
    padding: 0 5px 0 5px
  }
</style>


<div class="modal-dialog modal-dialog-centered" role="document" style="">
  <div class="modal-content">
    <div id="divCustomerBranchBody" class="model-body">
      <div>
        @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "frmCustomerBranch", @onsubmit = "return false;" }))
        {
        <div id="hidden" hidden>
          @Html.HiddenFor(model => Model.EditEnabled)
          @Html.HiddenFor(model => Model.CompanyID)
          @Html.HiddenFor(model => Model.CustomerID)
          @Html.HiddenFor(model => Model.CustomerData.Customer_ID)
          @Html.HiddenFor(model => Model.CustomerData.Yosya_Flg)
          @Html.HiddenFor(model => Model.CustomerBranchID)
          @Html.HiddenFor(model => Model.CustomerBranchData.Toll_Kubun)
          <input type="hidden" id="SelectCustomerModalKubun" />
        </div>

          <div class="div-content">
            <input type="radio" name="tab_name" id="tab1" checked>
            <label class="tab_class" for="tab1">全般</label>
            <div class="content_class">
              <div class="contents-wrap-middle" style="margin: 10px;">
                <h4 class="">注意</h4>
                <span>
                  ・この画面で入力内容を
                  ・一度データを登録すると物理削除は出来ません。「非表示フラグ」を立ててください。
                </span>
              </div>
              <table class="table table-striped-columns table-bordered border-primary" border="1" style="margin: 10px; width:96%;">
                <thead>
                  <tr style="background-color: aquamarine;">
                    <th width="100px" align="center" style="text-align: center;">項目名</th>
                    <th width="350px" align="center" style="text-align: center;">値</th>
                    <th width="100px" align="center" style="text-align: center;">項目名</th>
                    <th width="350px" align="center" style="text-align: center;">値</th>
                  </tr>
                </thead>
                <tbody>
                  <tr hidden>
                    <th></th>
                    <td>@Html.TextBoxFor(model => Model.CustomerBranchData.Customer_ID, null, new { @class = "form-control text-left", @onblur = "", @style = "width: 95%;" })</td>
                    <th></th>
                    <td>@Html.TextBoxFor(model => Model.CustomerBranchData.Customer_Branch_ID, null, new { @class = "form-control text-left", @onblur = "", @style = "width: 95%;" })</td>
                  </tr>
                  <tr>
                    <th>顧客コード</th>
                    <td style="display: flex;">
                      @Html.TextBoxFor(model => Model.CustomerData.Customer_Code, null, new { @readonly = "", @class = "form-control text-left readonly", @onblur = "", @style = "width: 100px;" })
                      <span style="width:2rem;"></span>
                      <label style="text-align: right; align-content: center;">@((Model.CustomerData.Yosya_Flg == 0) ? "傭車フラグ無し": "傭車フラグあり" )</label>
                      @if (Model.EditEnabled)
                      {
                      <span style="width:2rem;"></span>
                      <button type="button" class="btn btn-success" onclick="openCommonDialogForCustomer(); return false;">親の付替え</button>
                      }
                    </td>
                    <th>顧客名</th>
                    <td>@Html.TextBoxFor(model => Model.CustomerData.Customer_Name, null, new { @readonly = "", @class = "form-control text-left readonly", @onblur = "", @style = "width: 95%;" })</td>
                  </tr>
                  <tr>
                    <th style="color: red;">得意先コード</th>
                    <td style="display: flex;">
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Customer_Branch_Code_Trac_Tokuisaki, null, new { @class = "form-control text-left", @style = "width: 100px;" })
                      <span style="width:2rem;"></span>
                      <label style="text-align: right; align-content: center;">ﾄﾗｯｸﾒｲﾄ連携ｺｰﾄﾞ</label>
                    </td>
                    <th style="color: red;">傭車先コード</th>
                    <td >
                      <div style="display: flex;">
                        @Html.TextBoxFor(model => Model.CustomerBranchData.Customer_Branch_Code_Trac_Yosyasaki, null, new { @class = "form-control text-left YosyaFlg", @style = "width: 100px;" })
                        <span class="YosyaFlg" style="width:2rem;"></span>
                        <label class="YosyaFlg" style="text-align: right; align-content: center;">ﾄﾗｯｸﾒｲﾄ連携ｺｰﾄﾞ</label>
                      </div>
                    </td>
                  </tr>
                  <tr>
                    <th style="color: red;">支店コード</th>
                    <td>
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Customer_Branch_Code, null, new { @class = "form-control text-left", @style = "width: 100px;" })
                    </td>
                    <th style="">法人番号</th>
                    <td>
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Customer_Branch_Number, null, new { @class = "form-control text-left", @style = "width: 200px;" })
                    </td>
                  </tr>
                  <tr>
                    <th style="color: red;">支店正式名称</th>
                    <td>
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Customer_Branch_Name, null, new { @class = "form-control text-left", @style = "width: 95%;" })
                    </td>
                    <th style="color: red;">表示名</th>
                    <td>
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Customer_Branch_Name_Abbr, null, new { @class = "form-control text-left", @style = "width: 80%;" })
                    </td>
                  </tr>
                  <tr>
                    <th style="color: red;">支店名カナ</th>
                    <td>
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Customer_Branch_Name_Kana, null, new { @class = "form-control text-left", @style = "width: 80%;" })
                    </td>
                    <th style="color: red;"></th>
                    <td></td>
                  </tr>
                  <tr>
                    <th style="color: red;">郵便番号</th>
                    <td>
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Customer_Branch_Post, null, new { @class = "form-control text-left", @style = "width: 100px;" })
                    </td>
                    <th style="color: red;">住所１</th>
                    <td>
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Customer_Branch_Address1, null, new { @class = "form-control text-left", @style = "width: 95%;" })
                    </td>
                  </tr>
                  <tr>
                    <th style="">住所２</th>
                    <td>
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Customer_Branch_Address2, null, new { @class = "form-control text-left", @style = "width: 95%;" })
                    </td>
                    <th style="">住所３</th>
                    <td>
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Customer_Branch_Address3, null, new { @class = "form-control text-left", @style = "width: 95%;" })
                    </td>
                  </tr>
                  <tr>
                    <th style="color: red;">電話番号1</th>
                    <td>
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Customer_Branch_Phone1, null, new { @class = "form-control text-left", @style = "width: 180px;" })
                    </td>
                    <th style="">電話番号2</th>
                    <td>
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Customer_Branch_Phone2, null, new { @class = "form-control text-left", @style = "width: 180px;" })
                    </td>
                  </tr>
                  <tr>
                    <th style="color: red;">FAX番号1</th>
                    <td>
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Customer_Branch_Fax1, null, new { @class = "form-control text-left", @style = "width: 180px;" })
                    </td>
                    <th style="">FAX番号2</th>
                    <td>
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Customer_Branch_Fax2, null, new { @class = "form-control text-left", @style = "width: 180px;" })
                    </td>
                  </tr>
                  <tr>
                    <th style="">ﾒｰﾙ宛名</th>
                    <td>
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Mail_Title, null, new { @class = "form-control text-left", @style = "width: 80%;" })
                    </td>
                    <th style="color: red;"></th>
                    <td>
                    </td>
                  </tr>
                  <tr>
                    <th style="">ﾒｰﾙｱﾄﾞﾚｽ1</th>
                    <td>
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Mail_Address1, null, new { @class = "form-control text-left", @style = "width: 80%;" })
                    </td>
                    <th style="">ﾒｰﾙｱﾄﾞﾚｽ2</th>
                    <td>
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Mail_Address2, null, new { @class = "form-control text-left", @style = "width: 80%;" })
                    </td>
                  </tr>
                  <tr>
                    <th>非表示フラグ</th>
                    <td class="">
                      <div style="display: inline-flex;">
                        @Html.CheckBoxFor(model => Model.CustomerBranchData.Del_Flg, new { @class = "form-control text-left form-check-input" })
                        <label style="margin-left: 20px; font-size: 11px;">※オンにすると、登録時に選択不可。</label>
                      </div>
                    </td>
                  </tr>
                  <tr hidden>
                    <th style="color: red;">登録者</th>
                    <td>
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Insert_User, null, new { @class = "form-control text-left", @style = "width: 200px;" })
                    </td>
                    <th style="color: red;">更新者</th>
                    <td>
                      @Html.TextBoxFor(model => Model.CustomerBranchData.Update_User, null, new { @class = "form-control text-left", @style = "width: 200px;" })
                    </td>
                  </tr>
                  <tr>
                    <th>登録年月日:</th>
                    <td>@Convert.ToDateTime(Model.CustomerBranchData.Insert_Datetime).ToString("yyyy/MM/dd HH:mm:ss")</td>
                    <th>最終更新日:</th>
                    <td>@Convert.ToDateTime(Model.CustomerBranchData.Update_Datetime).ToString("yyyy/MM/dd HH:mm:ss")</td>
                  </tr>
                  <tr hidden>
                    <th>登録年月日</th>
                    <td hidden>@Html.TextBoxFor(model => Model.CustomerBranchData.Insert_Datetime, null, new { @class = "form-control" })</td>
                    <th>最終更新日</th>
                    <td hidden>@Html.TextBoxFor(model => Model.CustomerBranchData.Update_Datetime, null, new { @class = "form-control" })</td>
                  </tr>
                </tbody>
              </table>

              <div class="modal-header" style="padding-top: 0; padding-bottom: 0; margin-right: 2rem;">
                <h4>顧客担当</h4>
                <button type="button" class="btn btn-success" onclick="insertRow(); return false;">行追加</button>
              </div>
              <table id="tableTantou" class="table table-bordered border-primary table-customer-tantou" border="1" style="margin: 10px; width:96%;">
                <thead>
                  <tr style="background-color: aquamarine;">

                    <th hidden rowspan="2">Tantou_ID</th>
                    <th hidden rowspan="2">Customer_ID</th>
                    <th hidden rowspan="2">Company_ID</th>
                    <th hidden rowspan="2">Customer_Branch_ID</th>


                    <th width="25%" align="center" style="text-align: center; color: red;">担当者名</th>
                    <th width="25%" align="center" style="text-align: center; color: red;">表記名</th>
                    <th width="25%" align="center" style="text-align: center;">担当者名カナ</th>
                    <th width="15%" align="center" style="text-align: center;">部署名</th>
                    <th width="10%" align="center" style="text-align: center;">役職名</th>
                    <th rowspan="3" max-width="20px" width="20px" style="writing-mode: vertical-lr; text-align: center; align-content: center;">削除</th>
                  </tr>

                  <tr style="background-color: aquamarine;">
                    <th align="center" style="text-align: center;">メールアドレス１</th>
                    <th align="center" style="text-align: center;">メールアドレス２</th>
                    <th colspan="3" width="40%" align="center" style="text-align: center;">メール宛名</th>
                  </tr>
                  <tr style="background-color: aquamarine;">
                    <th align="center" style="text-align: center;">電話番号１</th>
                    <th align="center" style="text-align: center;">電話番号２</th>
                    <th align="center" style="text-align: center;">FAX番号１</th>
                    <th align="center" style="text-align: center;">FAX番号２</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  @{
                    var CustomerTantouList = Model.CustomerTantouList.OrderBy(m => m.Tantou_Code).ThenBy(m => m.Tantou_ID).ToList();
                    for (int i = 0; i < CustomerTantouList.Count; i++)
                    {
                      <tr id="row-@(i)-1" name="row-@(i)" style="vertical-align: middle;">
                        <td hidden rowspan="2">@Html.TextBoxFor(model => CustomerTantouList[i].Tantou_ID, null, new { @readonly = "readonly", @class = "form-control", @style = "" })</td>
                        <td hidden rowspan="2">@Html.TextBoxFor(model => CustomerTantouList[i].Customer_ID, null, new { @readonly = "readonly", @class = "form-control", @style = "" })</td>
                        <td hidden rowspan="2">@Html.TextBoxFor(model => CustomerTantouList[i].Company_ID, null, new { @readonly = "readonly", @class = "form-control", @style = "" })</td>
                        <td hidden rowspan="2">@Html.TextBoxFor(model => CustomerTantouList[i].Customer_Branch_ID, null, new { @readonly = "readonly", @class = "form-control", @style = "" })</td>

                        @if (Model.EditEnabled)
                        {

                          <td>@Html.TextBoxFor(model => CustomerTantouList[i].Tantou_Name, null, new { @class = "form-control", @style = "" })</td>
                          <td>@Html.TextBoxFor(model => CustomerTantouList[i].Tantou_Name_Abbr, null, new { @class = "form-control", @style = "" })</td>
                          <td>@Html.TextBoxFor(model => CustomerTantouList[i].Tantou_Name_Kana, null, new { @class = "form-control", @style = "" })</td>
                          <td>@Html.TextBoxFor(model => CustomerTantouList[i].Busyo_Name, null, new { @class = "form-control", @style = "" })</td>
                          <td>@Html.TextBoxFor(model => CustomerTantouList[i].Position_Name, null, new { @class = "form-control", @style = "" })</td>

                          @if (CustomerTantouList[i].Tantou_ID == 0)
                          {
                            <td rowspan="3" class="p-0" style="vertical-align: middle;" align="center"><button type="button" class="btn btn-warning" onclick="deleteRow(this); return false;" style="margin: 0;">行<br />削<br />除</button></td>
                          }
                          else
                          {
                            <td rowspan="3" class="p-0" style="vertical-align: middle;" align="center">@Html.CheckBoxFor(model => CustomerTantouList[i].Del_Flg, new { @class = "form-control text-left form-check-input" })</td>
                          }
                        }
                        else
                        {
                          <td>@(CustomerTantouList[i].Tantou_Name)</td>
                          <td>@(CustomerTantouList[i].Tantou_Name_Abbr)</td>
                          <td>@(CustomerTantouList[i].Tantou_Name_Kana)</td>
                          <td>@(CustomerTantouList[i].Busyo_Name)</td>
                          <td>@(CustomerTantouList[i].Position_Name)</td>
                          <td rowspan="3"></td>
                        }
                      </tr>
                      <tr id="row-@(i)-2" name="row-@(i)" style="vertical-align: middle;">
                        @if (Model.EditEnabled)
                        {
                          <td>@Html.TextBoxFor(model => CustomerTantouList[i].Mail_Address1, null, new { @class = "form-control", @style = "" })</td>
                          <td>@Html.TextBoxFor(model => CustomerTantouList[i].Mail_Address2, null, new { @class = "form-control", @style = "" })</td>
                          <td colspan="3">@Html.TextBoxFor(model => CustomerTantouList[i].Mail_Title, null, new { @class = "form-control", @style = "" })</td>
                        }
                        else
                        {
                          <td>@(CustomerTantouList[i].Mail_Address1)</td>
                          <td>@(CustomerTantouList[i].Mail_Address2)</td>
                          <td colspan="3">@(CustomerTantouList[i].Tantou_Name_Abbr)</td>
                        }
                      </tr>
                      <tr id="row-@(i)-3" name="row-@(i)" style="vertical-align: middle; border-bottom : 5px double red ">
                        @if (Model.EditEnabled)
                        {
                          <td>@Html.TextBoxFor(model => CustomerTantouList[i].Phone1, null, new { @class = "form-control", @style = "" })</td>
                          <td>@Html.TextBoxFor(model => CustomerTantouList[i].Phone2, null, new { @class = "form-control", @style = "" })</td>
                          <td>@Html.TextBoxFor(model => CustomerTantouList[i].Fax1, null, new { @class = "form-control", @style = "" })</td>
                          <td colspan="2">@Html.TextBoxFor(model => CustomerTantouList[i].Fax2, null, new { @class = "form-control", @style = "" })</td>
                        }
                        else
                        {

                          <td>@(CustomerTantouList[i].Phone1)</td>
                          <td>@(CustomerTantouList[i].Phone2)</td>
                          <td>@(CustomerTantouList[i].Fax1)</td>
                          <td colspan="2">@(CustomerTantouList[i].Fax2)</td>
                        }
                      </tr>

                    }
                  }
                </tbody>
              </table>
            </div>
            <input type="radio" name="tab_name" id="tab2">
            <label class="tab_class" for="tab2">請求/受領書情報</label>
            <div class="content_class">
              <div>
                <h4>請求情報</h4>
                <table class="table table-striped-columns table-bordered border-primary" border="1" style="margin: 10px; width:96%;">
                  <thead>
                    <tr style="background-color: aquamarine;">
                      <th width="120px" align="center" style="text-align: center;">項目名</th>
                      <th width="350px" align="center" style="text-align: center;">値</th>
                      <th width="120px" align="center" style="text-align: center;">項目名</th>
                      <th width="350px" align="center" style="text-align: center;">値</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <th style="color: red;">請求担当</th>
                      <td>
                        @Html.DropDownListFor(model => model.CustomerBranchData.SeikyuTantouID, new SelectList(Model.CompanyUserGroupList, "Value", "Text", "Selected"), "担当者を選択", new { @class = "form-control", @style = "width: auto;" })
                      </td>
                      <th style="">請求先集約</th>
                      <td style="display: flex;">
                        <button type="button" class="btn btn-outline-secondary" style="width:70px;" onclick="SlectSeikyuCustomer('seikyu'); return false;">選択</button>
                        @Html.HiddenFor(model => Model.CustomerBranchData.Seikyu_Customer_Branch_ID)
                        @Html.TextBoxFor(model => Model.Seikyu_Customer_Branch_Name, null, new { @readonly = "@readonly", @class = "form-control text-left", @style = "margin-left:0.3rem; width: 350px;" })
                      </td>
                    </tr>
                    <tr>
                      <th style="color: red;">請求区分</th>
                      <td style="display: flex;">
                        @Html.DropDownListFor(model => model.CustomerBranchData.Seikyu_Kubun, new SelectList(Model.SeikyuKubunSelectList, "Value", "Text", "Selected"), "請求区分を選択", new { @class = "form-control", @style = "width: auto;" })
                        <span style="width:1rem;"></span>
                        <label style="text-align: right; align-content: center;">単位：</label>
                        @Html.DropDownListFor(model => model.CustomerBranchData.SeikyuDate_Kubun, new SelectList(Model.SeikyuDateKubunSelectList, "Value", "Text", "Selected"), "請求日区分を選択", new { @class = "form-control", @style = "width: auto;" })
                      </td>
                      <th style="color: red;">締日/消費税</th>
                      <td style="display: flex;">
                        <label style="text-align: right; align-content: center;">締日：</label>
                        @Html.TextBoxFor(model => Model.CustomerBranchData.Shime_Day, null, new { @class = "form-control text-left", @style = "width: 50px;" })
                        <span style="width:1rem;"></span>
                        <label style="text-align: right; align-content: center;">消費税：</label>
                        @Html.DropDownListFor(model => model.CustomerBranchData.Tax_Fraction_Kubun, new SelectList(Model.SeikyuTakKubunSelectList, "Value", "Text", "Selected"), "消費税区分", new { @class = "form-control", @style = "width: auto;" })
                        <span style="width:1rem;"></span>
                        <label style="text-align: right; align-content: center;">丸め位置：</label>
                        @Html.TextBoxFor(model => Model.CustomerBranchData.Tax_Fraction_Position, null, new { @class = "form-control text-left", @style = "width: 50px;" })
                      </td>
                    </tr>
                    <tr>
                      <th style="color: red;">回収</th>
                      <td style="display: flex;">
                        <label style="text-align: right; align-content: center;">回収サイト：</label>
                        @Html.DropDownListFor(model => model.CustomerBranchData.Collection_Sight, new SelectList(Model.CollectionSightSelectList, "Value", "Text", "Selected"), "", new { @class = "form-control", @style = "width: auto;" })
                        <span style="width:1rem;"></span>
                        <label style="text-align: right; align-content: center;">回収日：</label>
                        @Html.TextBoxFor(model => Model.CustomerBranchData.Collection_Day, null, new { @class = "form-control text-left", @style = "width: 50px;" })
                      </td>
                      <th style="color: red;">請求先宛名</th>
                      <td>
                        @Html.TextBoxFor(model => Model.CustomerBranchData.Seikyu_Atesaki, null, new { @class = "form-control text-left", @style = "width: 80%;" })
                      </td>
                    </tr>
                    <tr>
                      <th style="">請求先住所</th>
                      <td colspan="3">
                        <div style="">
                          <table width="100%">
                            <tbody>
                              <tr>
                                <th style="width: 80px;text-align: right;">郵便番号</th>
                                <td>@Html.TextBoxFor(model => Model.CustomerBranchData.Seikuy_PostCode, null, new { @class = "form-control text-left", @style = "width: 100px;" })</td>
                              </tr>
                              <tr>
                                <th style="text-align:right;">住所１</th>
                                <td>@Html.TextBoxFor(model => Model.CustomerBranchData.Seikyu_Address1, null, new { @class = "form-control text-left", @style = "width: 80%;" })</td>
                              </tr>
                              <tr>
                                <th style="text-align:right;">住所２</th>
