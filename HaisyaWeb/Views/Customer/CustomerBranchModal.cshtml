<script>

  $(function () {

    $(document).ready(function () {

      var radio = document.getElementsByName('tollkubun');
      for (let i = 0; i < radio.length; i++) {
        if (radio.item(i).value == $('#CustomerBranchData_Toll_Kubun').val()) {
          radio.item(i).checked = true;
        }
      };

      yosyaDisplayChange();



    });


    $('input[name="tollkubun"]').on('change', function () {
      let val = $(this).val();
      $('#CustomerBranchData_Toll_Kubun').val(val);
    });

    if ($('#EditEnabled').val() == 'True')
    {
      $(".ui-dialog-titlebar").append('<button type="button" class="btn btn-primary" onclick="regExec(); return false;">@(Model.BtnCaption)</button>');
    }

    $('#Seikyu_Customer_Branch_Name').addClear({ onClear: function () { $('#CustomerBranchData_Seikyu_Customer_Branch_ID').val(0); }, top: 10, });
    $('#Shiharai_Customer_Branch_Name').addClear({ onClear: function () { $('#CustomerBranchData_Shiharai_Customer_Branch_ID').val(0); }, top: 10, });

    });

  function yosyaDisplayChange() {

    if ($('#CustomerData_Yosya_Flg').val() == '1') {
      $('#divNoYosya').hide();
      $('#divYosya').show();
      $(".YosyaFlg").prop("disabled", false);

    } else {

      $(".YosyaFlg").prop("disabled", true);
      $('#divYosya').hide();
      $('#divNoYosya').show();

    }

  }

  /**
   * 登録処理
   * */
  function regExec() {

    if (varidationCheck()) {
      return false;
    }

    let $form = $('#frmCustomerBranch');

    $.ajax({
          url: '@Url.RouteUrl("Default", new { controller = "Customer", Action = "CustomerBranchRegExec" })',
          type: 'post',
      data: $form.serialize(),
        }).done(function (response) {
          if (response.errorMessage != null && response.errorMessage !== '') {
              alertError(`【エラー】${response.errorMessage}`);
              return false;
          } else {
            closeModelAndRefresh();
            return false;
          }
        }).fail(function (xhr) {
          alert('【ネットワークエラー】:' + xhr);
            console.log(xhr);
            return false;
        }).always(function (xhr, msg) {
            console.log(xhr, msg);
        });

  };

  /**
   * 入力チェック
   * */
  function varidationCheck() {

    if (!($('#CustomerBranchData_Customer_Branch_Name').val() != null && $('#CustomerBranchData_Customer_Branch_Name').val().length > 0)) {
      alertInputError("名称が入力されていません");
      $('#CustomerBranchData_Customer_Branch_Name').css('background-color', 'lightcoral');
