  /**
   * 担当者データの行削除
   */
  function deleteRow(obj) {
    // 削除ボタンを押下された行を取得
    tr = obj.parentNode.parentNode;

    var rowindex = tr.sectionRowIndex

    var table = document.getElementById("tableTantou");

    if (tr.sectionRowIndex > 0) {
      // trのインデックスを取得して行を削除する
      table.deleteRow(rowindex + 3);
      table.deleteRow(rowindex + 2);
    }

  };

  /**
   * 高速請求情報の行追加処理
   * @@param idName
   */
  function insertRowSeikyuKubun(idName) {

    //alert(idName);

    // テーブル取得
    var table = document.getElementById(idName);
    // 行を行末に追加
    var row = table.insertRow(-1);
    row.style.verticalAlign = "middle";
    // 行数取得
    var row_len = Math.floor(table.rows.length) - 2;

    // セルの挿入
    var cell1 = row.insertCell(-1);
    var cell2 = row.insertCell(-1);
    var cell3 = row.insertCell(-1);
    var cell4 = row.insertCell(-1);
    var cell5 = row.insertCell(-1);
    var cell6 = row.insertCell(-1);

    cell2.align = "center";
    cell3.align = "center";

    cell4.hidden = true;
    cell5.hidden = true;
    cell6.hidden = true;

    //// セルの内容入力
    cell1.innerHTML = repalceidNameEx(idName, row_len, $("#" + idName + "_0__Distance").html());
    cell2.innerHTML = repalceidNameEx(idName, row_len, $("#" + idName + "_0__Delete").html());
    cell3.innerHTML = repalceidNameEx(idName, row_len, $("#" + idName + "_0__Insert").html());
    cell4.innerHTML = repalceidNameEx(idName, row_len, $("#" + idName + "_0__SeikyuType").html());
    cell5.innerHTML = repalceidNameEx(idName, row_len, $("#" + idName + "_0__Customer_Branch_ID").html());
    cell6.innerHTML = repalceidNameEx(idName, row_len, $("#" + idName + "_0__Sort").html());

    $("#" + idName + "_" + row_len + "__SeikyuType").val(0);
    $("#" + idName + "_" + row_len + "__Sort").val(row_len);

    $("#" + idName + "_" + row_len +"__Distance input:text").each(function () {
      this.value = "";
    });
  };

  /**
 * 高速請求情報の行追加時のidとnameの名称変更処理
 * @@param row_len
 * @@param html
 */
  function repalceidNameEx(idName,row_len, html) {
    //html = html.replace(idName + "_0", idName + "_" + row_len + "");
    //html = html.replace(idName + "[0]", idName + "[" + row_len + "]");
    html = replace_all(html, idName + "_0", idName + "_" + row_len + "");
    html = replace_all(html, idName + "[0]", idName + "[" + row_len + "]");
    return html;
  }


  /**
* 行削除
*/
  function deleteRowForSeikyuKubun(obj) {
