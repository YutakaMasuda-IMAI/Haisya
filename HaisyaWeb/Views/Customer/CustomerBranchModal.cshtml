  /**
   * 担当者の重複チェック
   * @@param m
   * @@param paramID
   */
  function checkData(m, paramID) {
    // table要素を取得
    var tableElem = document.getElementById('tableTantou');
    // 行（tr要素）を取得
    var row_len = Math.floor(tableElem.rows.length / 3) - 1;

    for (r = 1, lenA = row_len; r <= lenA; r++) {
      if (r != m) {
        var check = $('#CustomerTantouList_' + (r - 1) + '__Tantou_Name').val();
        if ((check != null && check.length > 0)) {
          if (check == paramID) {
            return true;
          }
        }
      }
    };
    return false;
  };


