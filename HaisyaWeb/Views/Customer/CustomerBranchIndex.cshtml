@model HaisyaWeb.Models.CustomerBranchModalDto

@{
    Layout = "../Setting/MasterDataMenu";
    ViewData["Title"] = "顧客一覧";
}

<head>
  <link href="~/css/Customer.css" rel="stylesheet" />
  <script src="~/js/EnterKeyCancel.js"></script>
  <style>
  </style>
</head>

<body>
  <div id="hiddenItem" hidden>
    @Html.HiddenFor(model => Model.CompanyID)
  </div>
  <div>
    @*<h3>顧客一覧</h3>*@
    
  </div>
  <div>
    @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "Form2" }))
    {
    <div id="hedder" class="row" style="margin-bottom: -20px;">
      <h6 class="heading-pagetitle">顧客支店一覧</h6>
      <div class="form-group" style="width: 100%">
        <div class="row">
          <table class="table jbc-table table-borderless" style="padding: 0; background-color: whitesmoke;" border="1">
            <tbody>
              <tr>
                <td width="20px"></td>
                <td class="col-sm-3">
                  <label class="control-label align-self-center align-middle text-end" style="padding:0;">顧客支店コード：</label>
                  <input type="text" id="txtCode" style="width: 150px; display: inline-block;" class="form-control" />
                </td>
                <td class="col-sm-3">
                  <label class="control-label align-self-center align-middle text-end" style="padding:0;">検索キー：</label>
                  <input type="text" id="txtKey" style="width: 150px; display: inline-block;" class="form-control" />
                </td>
                <td class="col-sm-3">
                  <label class="control-label align-self-center align-middle text-end" style="padding:0;">電話(Fax)番号：</label>
                  <input type="text" id="txtPhone" style="width: 150px; display: inline-block;" class="form-control" />
                </td>
                <td>
                  <button type="button" style="width: 100px;" class="btn btn-primary align-items-end" onclick="listDisplay();return false;">検索</button>
                  @*<button type="button" type="button" class="btn btn-success align-items-end" style="float: right; width: 150px;" onclick="addNewCustomer(); return false;">新規追加</button>*@
                </td>

              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    }
  </div>

  <div style="vertical-align: middle; margin-top: 2px;">
      <label>※Top100件を抽出</label>
  </div>

  <div id="CustomerBranchList" style=margin-right: 0px; margin-top: 2px;">
  </div>

</body>


<script>

  $(window).on('load', function () {

    let tabs = $('.sub-btn'); // tabのクラスを全て取得し、変数tabsに配列で定義
    $('.sub-btn').removeClass('active');
    $('#tabCustomerBranch').addClass('active');

    listDisplay();
  });

  $(function () {

    $('#txtCode').on('change', function () {
      listDisplay();
      return false;
    });

    $('#txtKey').on('change', function () {
      listDisplay();
      return false;
    });

    $('#txtPhone').on('change', function () {
      listDisplay();
      return false;
    });




  });

  function closeModel() {
    $('#ModalHere').html('');
    //$('#ModalHere').dialog('close');
    $("#btnDialogClose").click();
  };

  function closeModelAndRefresh() {
    $('#ModalHere').html('');
    $("#btnDialogClose").click();
    
    

    listDisplay();
    alertInfo("登録が完了しました。");
  };

  function listDisplay() {

    $.post('@Url.RouteUrl("Default", new { controller = "Customer", Action = "JsonGetCustomerBranchDataList" })',
      {
        CompanyID: $("#CompanyID").val(),
        code: $("#txtCode").val(),
        key: $("#txtKey").val(),
        phone: $("#txtPhone").val(),
      },
      function (data) {
        //alert(data.partialView);
        $('#CustomerBranchList').html(data.partialView);
      }
    );

  };

  /// <summary>
  ///
  /// </summary>
  function ankenListFirstSortChange(name) {

    if (typeof name === "undefined") {
      return;
    }




  };


  function submitCustomerBranchData(customerBranchID) {

    CommonWaitStart();

   $.post('@Url.RouteUrl("Default", new { controller = "Customer", Action = "CustomerBranchModal" })',
      {
        customerBranchID: customerBranchID,
      })
      .done(function (response) {
        if (response.message != null) {
            alertError(`【エラー】${response.message}`);
            return false;
        } else {
          //alert("【done】" + response.partialView);
          $("#ModalHere").html(response.partialView);
          DailogOpen("ModalHere","顧客支店/営業所情報", 1200, 1000);

          return false;
        }
      })
     .fail(function (xhr, msg) {
       console.log(xhr);
       alertError(msg);
      })
      .always(function (xhr, msg) {
        console.log(xhr, msg);
        CommonWaitEnd();
      });

  };

</script>