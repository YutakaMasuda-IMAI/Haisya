    .table-detail-wrap table.totalsum, .table-detail-wrap table.totalsum tr td{
      border: none;
    }

      .table-detail-wrap table.totalsum tr td .total-number {
        padding-right:2px;
      }
  </style>
</head>
@{
  var firstRow = Model.Bill.BillList.FirstOrDefault();
}
<body class="bill">
  <div class="opacity">
    <div class="head-wrapper">
      <div class="customer-wrapper">
        <p class="customer-address">
          &#12306;@((firstRow?.CustomerPost)?? "")<br />
          @((firstRow?.CustomerAddress1) ?? "")<br />
          @((firstRow?.CustomerAddress2) ?? "")
        </p>
        <p class="customer-name">
          <span class="name">@((firstRow?.CustomerName) ?? "")</span>
          <span class="dear">御中</span>
        </p>
      </div>
      <div class="title-wrapper">
        <div>
          <h1 class="title">請求書</h1>
          <p class="date">
            <span>請求年月日</span>
            <span>@((firstRow?.SeikyuMonth.ToString("yyyy/MM/dd")) ?? "")</span>
            <span>@* 頁&emsp;1 *@</span>
          </p>
        </div>
        <p class="month">@((firstRow?.SeikyuMonth.ToString("MM") ?? ""))月度分</p>
      </div>
      <div class="our-company-wrapper">
        <p class="company-name">@((firstRow?.CompanyName) ?? "")</p>
        <p class="company-info">
          &#12306;@((firstRow?.CompanyPost) ?? "")&emsp;@((firstRow?.CompanyAddress) ?? "")<br />
          TEL&nbsp;@((firstRow?.CompanyPhone) ?? "")<br />
          FAX&nbsp;@((firstRow?.CompanyFax) ?? "")<br />
          <span class="register-number">登録番号：@((firstRow?.CompanyInfoBank) ?? "")</span>
        </p>
      </div>
    </div>
    <div class="total-bill">
      <div class="bill-info">
        <p class="id">@((firstRow?.CustomerCode) ?? "")</p>
        <p class="message">
          毎度お引立て有難うございます。下記の通りご請求申し上げます。
        </p>
        <p class="bank">
          ＜振込銀行＞<span class="note">※振込手数料は貴社負担でお願い致します。</span><br />
          広島銀行&emsp;広島西支店&emsp;&emsp;当座609650
        </p>
      </div>

      <div class="total-table-wrapper">
        <table style="width: 80%">
          <thead>
            <tr>
              <th style="width: 12.5%">前回請求額</th>
              <th style="width: 12.5%">今回入金額</th>
              <th style="width: 12.5%">(内 値引・調整)</th>
              <th style="width: 12.5%">繰越残高</th>
              <th style="width: 12.5%">
                今回売上課税<br />対象額(10%)
              </th>
              <th style="width: 12.5%">今回売上<br />消費税額(10%)</th>
              <th style="width: 12.5%">今回請求額</th>
              <th style="width: 12.5%">請求合計額</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>@(Model.Bill.PrintSeikyu?.Seikyu_Previous?.ToString("N0") ?? firstRow?.Seikyu_Previous.ToString("N0") ?? "")</td>
              <td>@(Model.Bill.PrintSeikyu?.Received_Amount_This?.ToString("N0") ?? firstRow?.Received_Amount_This.ToString("N0") ?? "")</td>
              <td>@(firstRow?.Discount.ToString("N0") ?? "")</td>
              <td>@(Model.Bill.PrintSeikyu?.Balance_Forward?.ToString("N0") ?? firstRow?.Balance_Forward.ToString("N0") ?? "")</td>
              <td>@(Model.Bill.PrintSeikyu?.Taxable_Amount?.ToString("N0") ?? firstRow?.Taxable_Amount.ToString("N0") ?? "")</td>
              <td>@(Model.Bill.PrintSeikyu?.Tax_Amout?.ToString("N0") ?? firstRow?.Tax_Amout.ToString("N0") ?? "")</td>
              <td>@(Model.Bill.SeikyuUnchin?.ToString("N0") ?? "")</td>
              <td>@(Model.Bill.PrintSeikyu?.Seikyu_Total_Amount?.ToString("N0") ?? firstRow?.Seikyu_Total_Amount.ToString("N0") ?? "")</td>
            </tr>
          </tbody>
        </table>
        <div class="sign-boxes">
          <div class="sign"></div>
          <div class="sign"></div>
        </div>
      </div>
    </div>

    <div class="table-detail-wrap">
      <table class="rows">
        <thead>
          <tr>
            <th style="width: 4%">日付</th>
            <th style="width: 4%">車番</th>
            <th style="width: 10%">車&emsp;種</th>
            <th style="width: 10%">発&emsp;地</th>
            <th style="width: 10%">着&emsp;地</th>
            <th style="width: 7%">作業時間</th>
            <th style="width: 13%">品&emsp;名</th>
            <th style="width: 5%">数&emsp;量</th>
            <th style="width: 5%">単位</th>
            <th style="width: 5%">単価</th>
            <th style="width: 7%">運&emsp;賃</th>
            <th style="width: 5%">通行料</th>
            <th style="width: 10%">合計金額</th>
            <th style="width: 5%">摘&emsp;要</th>
          </tr>
        </thead>
        <tbody>
          @{
            var nyukin = Model.Bill.Nyukin;
            decimal totalAmount = 0;
            if (nyukin != null)
            {
              if (nyukin.Cash_Amount > 0)
              {
                <tr class="sub-header">
                  <td class="text-center">@nyukin.Process_Date.ToString("MM/dd")</td>
                  <td class="text-center"></td>
                  <td class="text-left"></td>
                  <td class="text-left"></td>
                  <td class="text-left"></td>
                  <td class="text-left"></td>
                  <td class="text-left">現金</td>
                  <td></td>
                  <td class="text-left"></td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td>@nyukin.Cash_Amount.ToString("N0")</td>
                  <td class="text-left"></td>
                </tr>
                totalAmount += nyukin.Cash_Amount;
              }
              if (nyukin.Transfer_Amount > 0)
              {
                <tr class="sub-header">
                  <td class="text-center">@nyukin.Process_Date.ToString("MM/dd")</td>
                  <td class="text-center"></td>
                  <td class="text-left"></td>
                  <td class="text-left"></td>
                  <td class="text-left"></td>
                  <td class="text-left"></td>
                  <td class="text-left">振込</td>
                  <td></td>
                  <td class="text-left"></td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td>@nyukin.Transfer_Amount.ToString("N0")</td>
                  <td class="text-left"></td>
                </tr>
                totalAmount += nyukin.Transfer_Amount;
              }
              if (nyukin.Draft_Amount > 0)
              {
                <tr class="sub-header">
                  <td class="text-center">@nyukin.Process_Date.ToString("MM/dd")</td>
                  <td class="text-center"></td>
                  <td class="text-left"></td>
                  <td class="text-left"></td>
                  <td class="text-left"></td>
                  <td class="text-left"></td>
                  <td class="text-left">手形</td>
                  <td></td>
                  <td class="text-left"></td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td>@nyukin.Draft_Amount.ToString("N0")</td>
                  <td class="text-left"></td>
                </tr>
                totalAmount += nyukin.Draft_Amount;
              }
              if (nyukin.Check_Amount > 0)
              {
                <tr class="sub-header">
                  <td class="text-center">@nyukin.Process_Date.ToString("MM/dd")</td>
                  <td class="text-center"></td>
                  <td class="text-left"></td>
                  <td class="text-left"></td>
                  <td class="text-left"></td>
                  <td class="text-left"></td>
                  <td class="text-left">小切</td>
                  <td></td>
                  <td class="text-left"></td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td>@nyukin.Check_Amount.ToString("N0")</td>
                  <td class="text-left"></td>
                </tr>
                totalAmount += nyukin.Check_Amount;
              }
              if (nyukin.Service_Charge_Amount > 0)
              {
                <tr class="sub-header">
                  <td class="text-center">@nyukin.Process_Date.ToString("MM/dd")</td>
                  <td class="text-center"></td>
                  <td class="text-left"></td>
                  <td class="text-left"></td>
                  <td class="text-left"></td>
                  <td class="text-left"></td>
                  <td class="text-left">手数料</td>
                  <td></td>
                  <td class="text-left"></td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td>@nyukin.Service_Charge_Amount.ToString("N0")</td>
                  <td class="text-left"></td>
                </tr>
                totalAmount += nyukin.Service_Charge_Amount;
              }
