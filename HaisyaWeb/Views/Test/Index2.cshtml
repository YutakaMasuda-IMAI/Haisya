

@{
  Layout = "_Layout";
  ViewData["Title"] = "テスト一覧";
}

<head>
  <link href="~/css/Test.css" rel="stylesheet" />
  <style>
    .btn-test {
      width: 200px !important;
      height: 50px;
      font-size: 20px;
    }
  </style>

  @* 共通住所選択ダイアログを呼ぶ時は、呼ぶ元画面で下記スクリプトをロードすること（苦肉の策です。本当は共通ダイアログ画面で読み込みたい。失敗する・・・） *@
  @* 下記3行を必ずControllersに追加すること *@
  @*
    ///////////// Controller ////////////////////
    string url = _mapApiSettiong.WebUri.JavaScriptAPI + "/auth/jsapi/loader.htm";
    url += GetMapApiUrlPram();
    model.MapsApiForJSUrl = url;
    ///////////// Model ////////////////////
    /// <summary>マップAPIのURL（JS用）</summary>
    public string MapsApiForJSUrl { get; set; }
  *@
  <!-- ローダーのURLをscriptでロードする -->
  <!-- ログイン認証の場合 -->
  @*<script src="@(Model.MapsApiForJSUrl)"></script>*@

  @* このスタブでは、とりあえずベタで記載します。 *@
  <script src="https://app.zip-site.com/auth/jsapi/loader.htm"></script>

</head>

<div hidden>
  <input data-val="true" id="Company_ID" name="Company_ID" type="text" value="1">
  <input data-val="true" id="User_ID" name="User_ID" type="text" value="1">
</div>



<div class="containe" style="text-align: center;">
  <h1>ダイアログ　スタブ</h1>
  <div class="row" style="border: groove; padding: 1rem; display: inline-table;">
    <button class="btn-test" onclick="testCustomerOyaOnClick(); return false;">親得意先選択</button>
