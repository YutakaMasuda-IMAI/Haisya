    <label>
      苦肉の策！！何か良い方法は？？下記をmodal画面で読んでも使えない・・・なぜ？？？<br />
      とりあえず、共通住所検索を呼ぶ元画面において、下記追加対応をお願いいたします。<br />
      ///////////// Controller ////////////////////<br />
      string url = _mapApiSettiong.WebUri.JavaScriptAPI + "/auth/jsapi/loader.htm";<br />
      url += GetMapApiUrlPram();<br />
      model.MapsApiForJSUrl = url;<br />
      ///////////// Model ////////////////////<br />
      /// &lt;summary&gt; マップAPIのURL（JS用）&lt;/summary&gt;<br />
      public string MapsApiForJSUrl { get; set; }<br />
      ///////////// chtml ///////////////////<br />
      &lt;script src="&#64;(Model.MapsApiForJSUrl)"&gt;&lt;/script&gt;
    </label>
