   * */
  function selectCustomerOyaSelectedCallBack(obj) {

    $('#CustomerOyaID').val(obj["Customer_ID"]);
    $('#CustomerOyaCD').val(obj["Customer_Code"]);
    $('#CustomerOyaName').val(obj["Customer_Name_Abbr"]);
  };

  /**
   * 共通得意先選択ダイアログの閉じるときのCallBack関数（任意）
   * */
  function selectCustomerOyaModalCloseCallBack() {

