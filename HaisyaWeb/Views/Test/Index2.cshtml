      <input id="CustomerOyaName" style="width: 500px;" />
    </div>
  </div>
  <br />
  <div class="row" style="border: groove; padding: 1rem; display: inline-table;">
    <button class="btn-test" onclick="testCustomerOnClick(); return false;">得意先選択</button>
    <div class="row" style="display: inline-block; margin-top: 1rem;">
      <input id="CustomerID" style="width: 100px;" />
      <input id="CustomerCD" style="width: 100px;" />
      <input id="CustomerName" style="width: 500px;" />
    </div>
  </div>
  <br />
