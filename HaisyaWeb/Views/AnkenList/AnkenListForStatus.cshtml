@model HaisyaWeb.Models.AnkenModel.AnkenListModel
@using HaisyaWeb.Dto
@using System.Reflection;

<style>
  #myTable {
  }

    #myTable tbody tr td {
      padding: 0;
      max-width: 100px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

      #myTable tbody tr td div {
        width: 100%;
        padding: 0;
      }
</style>


@{
  var list = Model.AnkenDataLists.GroupBy(m => m.AnkenStatusDisplay).OrderBy(m => m.Key).ToList();
}

@if (Model.AnkenDataLists.Count() == 0)
{
  <div style="width: 100%; background: #999999 ">
    <h4 style="text-align: center; margin-left: 20px; margin-top: 20px; color: white;">データ無し</h4>
  </div>
}

@foreach (var group in list)
{
  var iCount = Model.AnkenDataLists.Where(m => m.AnkenStatusDisplay == group.Key).Count();
  <div style="width: 100%; background: #999999 ">
    <h4 style="text-align:left; margin-left: 20px;color: white;">@(group.Key)(@(iCount))</h4>
  </div>


  <table id="myTable" class="table ex_tableAnkenList" style="width: 100%;" border="1">
    <thead>
      <tr align="center">
        <th rowspan="2"><input id="chkALL" type="checkbox" /></th>
        <th rowspan="2">
          案件<br />画面
        </th>
        <th rowspan="2" style="width: 50px ">
          <a data-koumoku="Kubun_Sort" href="#" onclick="ankenListFirstSortChange('Anken_No')" style="">案件No</a>
        </th>
        <th rowspan="2" style="width: 50px ">
          帳票<br />参照
        </th>
        <th hidden>
          <a data-koumoku="Kubun_Sort" href="#" onclick="ankenListFirstSortChange('TantouID')" style="">配車担当Id</a>
        </th>
        <th rowspan="2" style="max-width: 150px">
          <a data-koumoku="Kubun_Sort" href="#" onclick="ankenListFirstSortChange('Tantou_Name')" style="">配車<br />担当</a>
        </th>
        <th rowspan="2" style="width: 70px ">
          <a data-koumoku="Kubun_Sort" href="#" onclick="ankenListFirstSortChange('AnkenStatusDisplay')" style="">案件<br />状況</a>
        </th>
        <th rowspan="2" style="width: 50px ">
          <a data-koumoku="Kubun_Sort" href="#" onclick="ankenListFirstSortChange('AnkenStep')" style="">進捗<br />状況</a>
        </th>
        <th rowspan="2">
          <a data-koumoku="Kubun_Sort" href="#" onclick="ankenListFirstSortChange('START_PointDate')" style="">積日</a>
        </th>
        <th rowspan="2">
          <a data-koumoku="Kubun_Sort" href="#" onclick="ankenListFirstSortChange('END_PointDate')" style="">卸日</a>
        </th>
        <th hidden>
          <a data-koumoku="Kubun_Sort" href="#" onclick="ankenListFirstSortChange('KokyakuId')" style="">顧客Id</a>
        </th>
        <th rowspan="2" style="max-width: 250px">
          <a data-koumoku="Kubun_Sort" href="#" onclick="ankenListFirstSortChange('KokyakuName')" style="">顧客</a>
        </th>
        <th rowspan="2" style="max-width: 250px">
          <a data-koumoku="Kubun_Sort" href="#" onclick="ankenListFirstSortChange('START_Address')" style="">積地</a>
        </th>
        <th rowspan="2" style="max-width: 250px">
          <a data-koumoku="Kubun_Sort" href="#" onclick="ankenListFirstSortChange('END_Address')" style="">卸地</a>
        </th>
        <th rowspan="2" style="max-width: 150px">
          <a data-koumoku="Kubun_Sort" href="#" onclick="ankenListFirstSortChange('SyasyuDisplay2')" style="">車種</a>
        </th>
        <th rowspan="1">
          <a data-koumoku="Kubun_Sort" href="#" onclick="ankenListFirstSortChange('ZanteiAmount')" style="">暫定金額</a>
        </th>

        <th rowspan="1" class="haisya">
          区分
        </th>
        <th rowspan="1" class="haisya">
          担当乗務員
        </th>

        <th rowspan="1" class="haisya">
          傭車１
        </th>

      </tr>
      <tr align="center">
        <th rowspan="1">
          <a data-koumoku="Kubun_Sort" href="#" onclick="ankenListFirstSortChange('KakuteiAmount')" style="">確定金額</a>
        </th>
        <th rowspan="1" class="haisya">
          車番
        </th>
        <th rowspan="1" class="haisya">
          携帯電話
        </th>
        <th rowspan="1" class="haisya">
          傭車２
        </th>
      </tr>
    </thead>
    <tbody>

      @{
          IEnumerable<V_AnkenDataList_Local> listData = Model.AnkenDataLists;

          if ("asc".Equals(Model.SortParam.SortOrder))
          {
            listData = listData.OrderBy(s => s.GetType().GetRuntimeProperty(Model.SortParam.SortItemParam).GetValue(s, null)).ThenBy(s => s.Anken_No).ToList();
          }
          else
          {
            listData = listData.OrderByDescending(s => s.GetType().GetRuntimeProperty(Model.SortParam.SortItemParam).GetValue(s, null)).ThenBy(s => s.Anken_No).ToList();
          }

      }

            @foreach (var item in listData)
      {
        <tr>
          <td rowspan="2" width="30px" align="center">
            <input name="Target" type="checkbox" value="@(item.Anken_ID)" />
          </td>

          <td rowspan="2" width="70px" style="padding: 0.2rem;">
            <button type="button" class="btn btn-outline-success" style="width: 100%; padding:0;" onclick="submitAnkenEdit(@(item.Anken_ID))">選択</button>
          </td>
          <td rowspan="2" align="center" style="white-space: normal;">
            @Html.DisplayFor(modelItem => item.Anken_No)
          </td>
          <td rowspan="2" style="padding: 0.2rem;">
            <div style="display: inline-block; overflow: visible;">
              @{
                V_HaisyaDataList_Local haisyaData = Model.HaisyaDataLists.FirstOrDefault(m => m.Anken_ID == item.Anken_ID);
              }
              <button type="button" class="btn btn-outline-info p-0" style="width: 50px;" onclick="AnkenRefenceModal(@(item.Anken_ID), @(haisyaData.AnkenDisplay_ID))">選択</button>
              @*<label style="width: calc(100% - 55px); text-align: center; writing-mode: vertical-lr; vertical-align: middle;">なし</label>*@
            </div>
          </td>
          <td rowspan="2" hidden>
            @Html.DisplayFor(modelItem => item.TantouID)
          </td>
          <td rowspan="2" align="center">
            @Html.DisplayFor(modelItem => item.Tantou_Name)
          </td>
          <td rowspan="2" align="center">
            @{
              int num = item.AnkenStatusDisplay.IndexOf("(");
              string AnkenStatusDisplay1 = item.AnkenStatusDisplay;
              if (num > 0) { AnkenStatusDisplay1 = item.AnkenStatusDisplay.Substring(0, num); }

            }
            @(AnkenStatusDisplay1)

            @{
              string AnkenStatusDisplay2 = null;
              if (num > 0) { AnkenStatusDisplay2 = item.AnkenStatusDisplay.Substring(num); }
            }
            @if (AnkenStatusDisplay2 != null)
            {
              <br />@(AnkenStatusDisplay2)
            }
          </td>
          <td rowspan="2" align="center">
            @Html.DisplayFor(modelItem => item.AnkenStep)
          </td>
          <td rowspan="2" align="center" width="50px">
            @Convert.ToDateTime(item.START_PointDate).ToString("MM/dd")<br />
            @Html.DisplayFor(modelItem => item.START_PointTime)
          </td>
          <td rowspan="2" align="center" width="50px">
            @Convert.ToDateTime(item.END_PointDate).ToString("MM/dd")<br />
            @Html.DisplayFor(modelItem => item.END_PointTime)
          </td>
          <td rowspan="2" hidden>
            @Html.DisplayFor(modelItem => item.KokyakuId)
          </td>
          <td rowspan="2" align="left">
            <div>@Html.DisplayFor(modelItem => item.KokyakuName)</div>
          </td>
          <td rowspan="2" align="left">
            <div style="">@Html.DisplayFor(modelItem => item.START_BuildingName)</div>
            <div style="">@Html.DisplayFor(modelItem => item.START_Address)</div>
          </td>
          <td rowspan="2" align="left">
            <div style="">@Html.DisplayFor(modelItem => item.END_BuildingName)</div>
            <div style="">@Html.DisplayFor(modelItem => item.END_Address)</div>
          </td>
          <td rowspan="2" align="center">
            <div style="">@Html.DisplayFor(modelItem => item.SyasyuDisplay2)</div>
            <div style="">@Convert.ToInt32(item.Daisuu).ToString("0台")</div>
          </td>
          <td rowspan="1" align="center" width="70px">
            @Convert.ToInt32(item.ZanteiAmount).ToString("C")
          </td>

          @{
            var haisya = Model.HaisyaDataLists.FirstOrDefault(m => m.Anken_ID == item.Anken_ID);
          }

          <td rowspan="1" align="center" width="50px">
            @Html.DisplayFor(modelItem => haisya.HaisyaKubunDisplay)
          </td>
          <td rowspan="1" align="center" width="70px">
            @if (haisya != null)
            {
              @*@if (haisya.Haisya_Kubun == 2 || haisya.Haisya_Kubun == 3)
                {
                  @Html.DisplayFor(modelItem => haisya.Driver_Branch_Name)
                }
                else
                {

                }*@
              @Html.DisplayFor(modelItem => haisya.Driver_Name)@(item.Daisuu > 1 ? "等":"")
            }
          </td>

          <td rowspan="1" align="left" width="200px">
            @Html.DisplayFor(modelItem => haisya.Yosya_Display1)
          </td>




        </tr>

        <tr>
          <td rowspan="1" align="center">
            @Convert.ToInt32(item.KakuteiAmount).ToString("C")
          </td>
          <td rowspan="1" align="center">
            @Html.DisplayFor(modelItem => haisya.SYABAN)
          </td>
          <td rowspan="1" align="left">
            @Html.DisplayFor(modelItem => haisya.Driver_Phone)
          </td>
          <td rowspan="1" align="left">
            @Html.DisplayFor(modelItem => haisya.Yosya_Display2)
          </td>
        </tr>
        <!--<tr>

        <td rowspan="1"></td>
        <td rowspan="1" align="center" width="200px">-->
        @*@Html.DisplayFor(modelItem => item.SubCon3Display)*@
        <!--</td>
        </tr>-->

      }
    </tbody>
  </table>
}


<script>

  $(document).ready(function () {

  });


  $(function () {

    var isLine = true;
    var numTh = $("#myTable").find("th").length;
    var tdCount = 0;
    $("#myTable").find("tbody").find("tr").each(function () {
      tdCount += $(this).find("td").length;
      if (isLine == true) {
        $(this).find("td").addClass("even");
      }
      else {
        $(this).find("td").addClass("odd");
      }
      if (numTh == tdCount) {
        isLine = !isLine;
        tdCount = 0;
      }
    });


    /// <summary>
    /// 締め済みの行はチェックを入れさせない
    /// </summary>
    $('input:checkbox[name="Target"]').on('change', function () {

      alert("bbbb");

      if ($(this).parents('tr').children('td:nth-child(2)').first().text().trim() == 1) {
        $(this).prop('checked', false);
      }
    });

    /// <summary>
    /// チェックボックス全選択変更時
    /// </summary>
    $('#chkALL').on('change', function () {
      ChangeALLCheckBoxChanged($(this).prop('checked'));
    });
  });

  function ExecShowDetailOnClick(paramDay, paramKintai) {
    ExecShowDetailEX(paramDay, paramKintai);
  }

   /**
   * 案件照会画面(モーダル)を開く
   * @@param ankenID
   * @@param ankenDisplayID
   * @@param driverID
   * @@param driverSyaryoID
   * @@param haisyaKubun
   */
  function AnkenRefenceModal(ankenID, ankenDisplayID, driverID = null, driverSyaryoID = null, haisyaKubun = null) {
    var url = '@Url.RouteUrl("Default", new { controller = "AnkenReference", Action = "Index" })';
    AnkenRefenceModalEx(url, ankenID, ankenDisplayID, driverID, driverSyaryoID, haisyaKubun);
  };

</script>