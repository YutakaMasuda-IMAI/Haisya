@model AnkenModel.SelectLuggageDto


<style>

  .table-LuggageModal {
    width: 100%;
  }

    .table-LuggageModal tbody {
        overflow-y: auto;
    }
    .table-LuggageModal th {
      padding: 0;
      text-align: center;
    }

    .table-LuggageModal td {
      padding: 0;
      height: 15px;
      text-align: center;
    }

      .table-LuggageModal td button {
        width: 90%;
        height: 95%
      }

        .table-LuggageModal td button input {
          color: white;
        }
</style>


@{
}
<link href="~/css/Anken.css" rel="stylesheet" />



<div class="modal-dialog" role="document" style="max-width:1100px; min-height: 440px;">
  <div class="modal-content">
    <div hidden>
      <input type="number" id="SelectLuggageGroup" value="0" />
      <table id="tableLuggageSelectListModal">
        <thead></thead>
        <tbody id="tableLuggageSelectListModal-tbody">
          @{
            var luggagelist = Model.LuggageList.OrderBy(m => m.Luggage_Group_ID).ThenBy(m => m.SortOrder).ToList();
            foreach (var item in luggagelist)
            {
              <tr><td>@(item.Luggage_Group_ID)</td><td>@(item.Luggage_ID)</td><td>@(item.Luggage_Name)</td><td>@(item.Unit_Name)</td></tr>
            }
          }
        </tbody>
      </table>
    </div>

@*     <div class="modal-header">
      <h3>荷物情報選択</h3>
    </div> *@

    <div class="model-body" style="height: 400px;">
      <div class="div-area">
        @*<label class="tab_class" for="tab1"></label>*@
        <div class="">
          <div class="row">
            <div class="col-6 col-sm-3">
              <table class="table table-LuggageModal">
                <thead>
                  <tr><th>荷物グループ</th></tr>
                </thead>
                <tbody>
                  @{
                    var luggageGroupList = Model.LuggageGroupList.OrderBy(m => m.SortOrder).ToList();
                    foreach (var item in luggageGroupList)
                    {
                      <tr><td><button type="button" class="btn btn-dark" onclick="onClickLuggageGroup(@(item.Luggage_Group_ID)); return false;">@(item.Luggage_GroupName)</button></td></tr>
                    }

                  }
                </tbody>
              </table>
            </div>
            <div class="col-6 col-sm-3">
              <table id="tableLuggage" class="table table-LuggageModal">
                <thead>
                  <tr><th>荷物詳細</th></tr>
                </thead>
                <tbody id="tableLuggage-body">
                </tbody>
              </table>
            </div>
            @*<div class="col-1 col-sm-1" style="">
              </div>*@
            <div class="col-6" style="margin-top: -20px;">
              <h6 style="padding:0;margin:0;">選択荷物</h6>
              <table id="tableLuggageListModal" class="table table-LuggageModal">
                <thead>
                  <tr style="background-color:aquamarine;">
                    <th>荷物</th>
                    <th>数</th>
                    <th style="font-size:9px;">単位</th>
                    <th>備考</th>
                  </tr>
                </thead>
                <tbody id="tableSelectLuggage-body">
                  @{
                    if (Model.LuggageList != null)
                    {
                      var LuggageList = Model.AnkenLuggageList.OrderBy(m => m.Insert_Datetime).ToList();
                      for (int i = 0; i < LuggageList.Count; i++)
                      {
                        var luggage = Model.LuggageList.FirstOrDefault(m => m.Luggage_ID == Model.AnkenLuggageList[i].Luggage_ID);
                        if (luggage != null)
                        {
                          <tr>
                            <td hidden>@Html.TextBoxFor(model => Model.AnkenLuggageList[i].Anken_ID, null, new { @readonly = "readonly", })</td>
                            <td hidden>@Html.TextBoxFor(model => Model.AnkenLuggageList[i].Anken_Order, null, new { @readonly = "readonly", })</td>
                            <td hidden>@Html.TextBoxFor(model => Model.AnkenLuggageList[i].Luggage_ID, null, new { @readonly = "readonly", @type = "number" })</td>
                            <th><input type="text" value="@(luggage.Luggage_Name)" readonly style="width: 200px;" id="AnkenLuggageList_@(i)__Luggage_Name" name="AnkenLuggageList[@(i)].Luggage_Name" /></th>
                            <td align="center">@Html.TextBoxFor(model => Model.AnkenLuggageList[i].Luggage_Count, null, new { @type = "number", @style = "width: 50px; background-color: aqua;" })</td>
                            <th><input type="text" value="@(luggage.Unit_Name)" readonly style="width: 30px;" id="AnkenLuggageList_@(i)__Unit_Name" name="AnkenLuggageList[@(i)].Unit_Name" /></th>
                            <td>@Html.TextBoxFor(model => Model.AnkenLuggageList[i].Remarks, null, new { @style = "width: 250px; background-color: aqua;" })</td>
                          </tr>
                        }
                        else
                        {
                          <tr>
                            <td hidden>@Html.TextBoxFor(model => Model.AnkenLuggageList[i].Anken_ID, null, new { @readonly = "readonly", })</td>
                            <td hidden>@Html.TextBoxFor(model => Model.AnkenLuggageList[i].Anken_Order, null, new { @readonly = "readonly", })</td>
                            <td hidden>@Html.TextBoxFor(model => Model.AnkenLuggageList[i].Luggage_ID, null, new { @readonly = "readonly", @type = "number" })</td>
                            <th><input type="text" value="" readonly style="width: 200px;" id="AnkenLuggageList_@(i)__Luggage_Name" name="AnkenLuggageList[@(i)].Luggage_Name" /></th>
                            <td align="center">@Html.TextBoxFor(model => Model.AnkenLuggageList[i].Luggage_Count, null, new { @type = "number", @style = "width: 50px; background-color: aqua;" })</td>
                            <th><input type="text" value="" readonly style="width: 30px;" id="AnkenLuggageList_@(i)__Unit_Name" name="AnkenLuggageList[@(i)].Unit_Name" /></th>
                            <td>@Html.TextBoxFor(model => Model.AnkenLuggageList[i].Remarks, null, new { @style = "width: 250px; background-color: aqua;" })</td>
                          </tr>
                        }

                      }
                    }
                  }
                </tbody>
              </table>

            </div>
          </div>
        </div>


      </div>
    </div>

    <div style="vertical-align: middle; display: inline-block; " class="modal-footer">
      <div class="row">
        <div class="col-8">
          <div>
            名前<input id="addLuggageText" type="text" style="width: 200px;" value="" />
            単位<input id="addLuggageUnit" type="text" style="width: 50px;" value="" />
            <button type="button" id="btnModelCancel" class="btn btn-secondary" data-dismiss="modal" onclick="addLuggageMaster(); return false;">荷物詳細追加</button>
          </div>
        </div>
        <div class="col-2"><button type="button" id="btnModelHolidayReister" class="btn btn-success" onclick="SelectLuggageRegExec(); return false;">登録</button></div>
        <div class="col-2"><button type="button" id="btnModelCancel" class="btn btn-secondary" data-dismiss="modal" onclick="ModalClose();">Close</button></div>
      </div>
    </div>
  </div>
</div>






<script>

  $('#SelectLuggageGroup').val(0);

  $(function () {

    // テーブル取得
    var tableElemLuggage = document.getElementById("tableLuggageListModal");
    var rowElemsLuggage = tableElemLuggage.rows;
    var check = rowElemsLuggage[1].cells[2].firstElementChild.value;
    if (check == '0') {
      rowElemsLuggage[1].style.display = "none";
    }

  });


  /** M_Luggageマスタの登録 */
  function addLuggageMaster() {

    var addName = $('#addLuggageText').val();
    var addUnit = $('#addLuggageUnit').val();
    var gID = $('#SelectLuggageGroup').val();

    if ('0' == gID) {
      alertInputError("登録する荷物グループを選択してください。");
      return true;
    }

    if (!(addName != null && addName.length > 0)) {
      alertInputError("荷物名称が入力されていません");
      $('#addLuggageText').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#addLuggageText').css('background-color', 'white');
    }

    if (!(addUnit != null && addUnit.length > 0)) {
      alertInputError("単位が入力されていません");
      $('#addLuggageUnit').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#addLuggageUnit').css('background-color', 'white');
    }

    // table要素を取得
    var tableElem = document.getElementById('tableLuggageSelectListModal');
    // 行（tr要素）を取得
    var rowElems = tableElem.rows;

    for (i = 0, len = rowElems.length; i < len; i++) {
      var groupID = rowElems[i].cells[0].innerHTML;
      var name = rowElems[i].cells[2].innerHTML;
      if (gID == groupID && name == addName) {
        alertError("入力された名称は既に選ばれています。");
        return false;
      }
    }

    var luggageNewID = 0;

    $.post('@Url.RouteUrl("Default", new { controller = "AnkenRegister", Action = "JsonAddLuggageMaster" })',
    {
      paramGroupID: gID, paramLuggageText: addName, paramUnit: addUnit,
    })
    .done(function (response) {
      if (response.message != null) {
          alertError(`【エラー】${response.message}`);
          return false;
      } else {
        luggageNewID = Number(response.resultVal);
        AddtableLuggageSelectListModal(gID, luggageNewID, addName, addUnit);
        onClickLuggageGroup(gID);
        $('#addLuggageText').val('');
        $('#addLuggageUnit').val('');
        return false;
      }
    })
    .fail(function (xhr) {
        console.log(xhr);
    })
  };

  /**
   * M_Luggageマスタの選択用リストにデータ追加
   * @@param paramGroupID
   * @@param paramID
   * @@param paramText
   * @@param paramUnit
   */
  function AddtableLuggageSelectListModal(paramGroupID, paramID, paramText, paramUnit) {

    var tbody = document.getElementById("tableLuggageSelectListModal-tbody");
    var row = tbody.insertRow(-1);

    var cell0 = row.insertCell(-1);
    var cell1 = row.insertCell(-1);
    var cell2 = row.insertCell(-1);
    var cell3 = row.insertCell(-1);
    cell0.innerHTML = paramGroupID;
    cell1.innerHTML = paramID;
    cell2.innerHTML = paramText;
    cell3.innerHTML = paramUnit;
  }

  /**
   *　荷物グループの選択処理
   * @@param paramGroupID
   */
  function onClickLuggageGroup(paramGroupID) {

    $('#SelectLuggageGroup').val(paramGroupID);

    $("#tableLuggage-body").remove();

    // テーブル取得
    var table = document.getElementById("tableLuggage");
    var tbody = document.createElement("tbody");
    tbody.setAttribute('id', 'tableLuggage-body');
    table.appendChild(tbody);

    // table要素を取得
    var tableElem = document.getElementById('tableLuggageSelectListModal');
    // 行（tr要素）を取得
    var rowElems = tableElem.rows;

    // 取得した行（tr要素）を繰り返しHTMLを取得;
    for (i = 0, len = rowElems.length; i < len; i++) {
      var groupID = rowElems[i].cells[0].innerHTML;

      if (paramGroupID == groupID) {
        var id = rowElems[i].cells[1].innerHTML;
        var name = rowElems[i].cells[2].innerHTML;
        var unit = rowElems[i].cells[3].innerHTML;

        var row = tbody.insertRow(-1);
        var cell1 = row.insertCell(-1);
        cell1.innerHTML = '<button type="button" class="btn btn-dark" ondblclick="ondblclickLuggage(\'' + id + '\'); return false;">' + name + '(' + unit + ')</button>';
      }
    }

  };


  /**
   * 荷物詳細の選択処理
   * @@param paramID
   */
  function ondblclickLuggage(paramID) {

    var gID = $('#SelectLuggageGroup').val();

    // テーブル取得
    var tableElemLuggage = document.getElementById("tableLuggageListModal");
    // 行（tr要素）を取得
    var rowElemsLuggage = tableElemLuggage.rows;

    for (i = 1, len = rowElemsLuggage.length; i < len; i++) {
      var luggageId = rowElemsLuggage[i].cells[2].firstElementChild.value;
      if (paramID == luggageId) {
        alertError("選択された荷物は既に選ばれています。");
        return false;
      }
    }

    // table要素を取得
    var tableElem = document.getElementById('tableLuggageSelectListModal');
    // 行（tr要素）を取得
    var rowElems = tableElem.rows;

    // 取得した行（tr要素）を繰り返しHTMLを取得;
    for (i = 0, len = rowElems.length; i < len; i++) {
      var id = rowElems[i].cells[1].innerHTML;
      var groupID = rowElems[i].cells[0].innerHTML;

      if (gID == groupID && paramID == id) {
        var nm = rowElems[i].cells[2].innerHTML;
        var unit = rowElems[i].cells[3].innerHTML;
        
        var row_len = 1
        var check = rowElemsLuggage[row_len].cells[2].firstElementChild.value;

        if (check != '0') {
          row_len = insertRow(tableElemLuggage, 1);
        } else {
          rowElemsLuggage[row_len].style.removeProperty('display');
        }
        var id = rowElemsLuggage[row_len].cells[0].firstElementChild.id;
        document.getElementById(id).defaultValue = $('#Anken_ID').val();
        id = rowElemsLuggage[row_len].cells[1].firstElementChild.id;
        document.getElementById(id).defaultValue = $('#Anken_Latest_Order').val();
        id = rowElemsLuggage[row_len].cells[2].firstElementChild.id;
        document.getElementById(id).defaultValue = paramID;
        id = rowElemsLuggage[row_len].cells[3].firstElementChild.id;
        document.getElementById(id).defaultValue = nm;
        id = rowElemsLuggage[row_len].cells[4].firstElementChild.id;
        document.getElementById(id).defaultValue = 1;
        id = rowElemsLuggage[row_len].cells[5].firstElementChild.id;
        document.getElementById(id).defaultValue = unit;
        id = rowElemsLuggage[row_len].cells[6].firstElementChild.id;
        document.getElementById(id).defaultValue = "";
      }
    }


  };

  /**
* 行追加処理
* */
  function insertRow(tableElem, baseRow) {
    // 行（tr要素）を取得
    var rowElems = tableElem.rows;
    // tbody要素にtr要素（行）を最後に追加
    var trElem = tableElem.tBodies[0].insertRow(-1);
    trElem.style.verticalAlign = 'middle';

    var row_len = rowElems.length - 1;
    var html = rowElems[baseRow].innerHTML;
    trElem.innerHTML = repalceidName(row_len - 1, html);

    return row_len;
  };

  /**
*　idとnameの書換え
* @@param row_len
* @@param html
*/
  function repalceidName(row_len, html) {
    html = replace_all(html, "AnkenLuggageList_0", "AnkenLuggageList_" + row_len + "");
    html = replace_all(html, "AnkenLuggageList[0]", "AnkenLuggageList[" + row_len + "]");
    return html;
  }

  /** 登録処理 */
  function SelectLuggageRegExec() {

    ///表示名の設定
    // table要素を取得
    var tableElem = document.getElementById('tableLuggageListModal');
    // 行（tr要素）を取得
    var rowElems = tableElem.rows;

    var disp = "";

    // 取得した行（tr要素）を繰り返しHTMLを取得;
    for (i = 1, len = rowElems.length; i < len; i++) {
      var name = rowElems[i].cells[3].firstElementChild.value;
      var num = rowElems[i].cells[4].firstElementChild.value;

      if (!(num != null && num.length > 0)) {
        alertInputError("数が入力されていません");
        rowElems[i].cells[4].backgroundColor = "lightcoral";
        return true;
      } else {
        rowElems[i].cells[4].backgroundColor = "white";
      }

      disp += name + "×" + num + "；";
    }


    var tableElem1 = document.getElementById("tableSelectLuggage-body");
    var tableElem2 = document.getElementById("tableLuggageList-body");

    tableElem2.innerHTML = tableElem1.innerHTML;

    $('#LuggageDisplay').val(disp).change();



    ModalClose();
  };




</script>

