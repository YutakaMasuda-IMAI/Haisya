   */
  function VaridationCheckForReg() {

    let flgResult = false;

    // table要素を取得
    let tableElem = document.getElementById('tablePointList');
    // 行（tr要素）を取得
    let rowElems = tableElem.rows;

    // 取得した行（tr要素）を繰り返しHTMLを取得;
    for (i = 0, len = rowElems.length; i < len; i++) {

      var id = rowElems[i].id;

      let elements = rowElems[i].querySelectorAll('[name$="].Kubun"]');
      elements.forEach((inputObj) => {
        kubun = inputObj.value;
      });

      if (kubun != 2) {
        elements = rowElems[i].querySelectorAll('[Name^="PointList["]');
        elements.forEach((inputObj) => {
          if (inputObj.name.indexOf("PointDateTime") > 0) {
            var pointDateTime = inputObj.value;

            if (!(pointDateTime != null && pointDateTime.length > 0)) {
              alertInputError("日時が指定されていません");
              $('#' + inputObj.id + '').css('background-color', 'lightcoral');
              flgResult = true;
              return true;
            } else {
              let datetime = new Date(pointDateTime);
              if (datetime.getFullYear() > 2000) {
                $('#' + inputObj.id + '').css('background-color', 'white');

                //// 積みだけは時間を指定
                //if (kubun == 1 && datetime.getHours() == 0) {
                //  alertInputError("積みにおいては暫定でも時間まで指定してください");
                //  $('#' + inputObj.id + '').css('background-color', 'lightcoral');
                //  flgResult = true;
                //  return true;
                //}

              } else {
                alertInputError("日時が選択されていません");
                $('#' + inputObj.id + '').css('background-color', 'lightcoral');
                flgResult = true;
                return true;

              }
            }

          };
        });
      }

    }
    if (flgResult) {
      return true;
    }

    if (!($('#Daisuu').val() != null && $('#Daisuu').val().length > 0)) {
      alertInputError("台数が選択されていません");
      $('#Daisuu').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#Daisuu').css('background-color', 'white');
    }

    if (!($('#HaisyaTantouID').val() != null && $('#HaisyaTantouID').val().length > 0)) {
      alertInputError("配車担当が選択されていません");
      $('#HaisyaTantouID').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#HaisyaTantouID').css('background-color', 'white');
    }

    //if ($('#NumberCommLimitKubun').val() == "0") {
    //  if (!($('#NumberCommLimitDateTime').val() != null && $('#NumberCommLimitDateTime').val().length > 0)) {
    //    alert("車番連絡希望期日が入力されていません");
    //    $('#NumberCommLimitDateTime').css('background-color', 'lightcoral');
    //    return true;
    //  } else {
    //    $('#NumberCommLimitDateTime').css('background-color', 'white');
    //  }
    //} else {
    //  $('#NumberCommLimitDateTime').css('background-color', 'white');
    //}

    return false;
  };

  /**
   * 住所から緯度経度を算出して地図に反映
   */
  function GetlatlonFromAddress() {

    CommonWaitStart();

    let addressVal = $('#txtAddress').val();
    //alert(addressVal);
    if (addressVal == "") {
      return false;
    }

    $.post(
        '@Url.RouteUrl("Default", new { controller = "Map", Action = "GetlatlonFromAddress" })', {
          address: String(addressVal),

        })
      .done(function(response) {

        if (response.errorMessage != null) {
          alertError(`【エラー】${response.errorMessage}`);
          return false;
        } else {
          //alert(response.latlon_lat + ";;;" + response.latlon_lng);
          map.setCenter(new ZDC.LatLng(Number(response.latlon_lat), Number(response.latlon_lng)));
          //map.setZoom(Number(15));
          //return false;
        }
      })
      .fail(function(xhr) {
        alertError('fail:' + xhr);
        console.log(xhr);
        return false;
      })
      .always(function(xhr, msg) {
        CommonWaitEnd();
      });

  };

