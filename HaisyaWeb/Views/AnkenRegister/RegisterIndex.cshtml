<script>

  window.onload = async function() {

    CommonWaitStart();

    if ($('#btnAnkneRireki').length) {
      $('#btnAnkneRireki').prop('disabled', true);
    }

    if ($('#Anken_Latest_Order').val() > 1) {
      GetAnkenRireki();
