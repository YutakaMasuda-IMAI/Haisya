  function VaridationCheckForDriveRoute() {

    if (!($('#SyasyuID').val() != null && $('#SyasyuID').val().length > 0 && $('#SyasyuID').val() != '0')) {
      alertInputError("車種が選択されていません");
      $('#SyasyuID').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#SyasyuID').css('background-color', 'white');
    }

    if (!($('#Ferry').val() != null && $('#Ferry').val().length > 0)) {
      alertInputError("フェリー考慮指定が選択されていません");
      $('#Ferry').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#Ferry').css('background-color', 'white');
    }

    if (!($('#TimeRestriction').val() != null && $('#TimeRestriction').val().length > 0)) {
      alertInputError("規制考慮が選択されていません");
      $('#TimeRestriction').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#TimeRestriction').css('background-color', 'white');
    }

    if (!($('#Twouturn').val() != null && $('#Twouturn').val().length > 0)) {
      alertInputError("2段階Uターン回避指定が選択されていません");
      $('#Twouturn').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#Twouturn').css('background-color', 'white');
    }

    if (!($('#Area').val() != null && $('#Area').val().length > 0)) {
      alertInputError("標準運賃計算エリアが選択されていません");
      $('#Area').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#Area').css('background-color', 'white');
    }

    let flgResult = false;
    let text = document.querySelectorAll(".pointInputCheck");
    text.forEach(function(inputObj) {
      let inputObjID = inputObj.id.substring(0, inputObj.id.indexOf('__')) + '__Address';
      let doc = document.getElementById(inputObjID);
      if (!(doc.value != null && doc.value.length > 0)) {
        alertInputError("ルート場所が指定されていません");
        doc.style.backgroundColor = 'lightcoral';
        flgResult = true;
        return;
      } else {
        doc.style.backgroundColor = 'white';
      }

      inputObjID = inputObj.id.substring(0, inputObj.id.indexOf('__')) + '__Kubun';
      doc = document.getElementById(inputObjID);
      if (!(doc.value != null && doc.value.length > 0)) {
        alertInputError("積み卸しが選択されていません");
        doc.style.backgroundColor = 'lightcoral';
        flgResult = true;
        return;
      } else {
        doc.style.backgroundColor = 'white';
      }

    });

    if (flgResult) {
      return true;
    }

    return false;
  };

