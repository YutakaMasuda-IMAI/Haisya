  /** 地図を表示する */
  function MapPreview() {

    return new Promise((resolve, reject) => {
        // マップエレメント要素を取得する
        let mapElement = document.getElementById("ZMap");

        // MapOptionsをデフォルト値から変更する場合各パラメータに値を設定
        let mapOptions = ZisAuth.getMapOption();
        mapOptions.zipsMapType = "kP8KjZdn";
        mapOptions.center = new ZDC.LatLng(34.35132785373264, 132.35272922092014);

        mapOptions.zoom = 10; // ★ズームレベルを設定
        mapOptions.minZoom = 3
        mapOptions.maxZoom = 22;
        mapOptions.touchOperation = true;

        // 地図を生成
        map = new ZDC.Map(
          mapElement,
          mapOptions,
          function() {
            // Success callback
            // コントロールを追加する
            // コンパスの表示
            map.addControl(new ZDC.Compass('top-right'));
            // ズームボタンの表示
            map.addControl(new ZDC.ZoomButton('bottom-right'));
            // スケールバーの表示
            map.addControl(new ZDC.ScaleBar('bottom-left'));
            // 中心マーカーを作成します
            map.addControl(new ZDC.CenterMarker());

            divSerchResize();

            resolve();
          },
          function() {
            // Failure callback
            resolve();
          }
        );
    });

  }

  /**
   * 地図のセンターの住所情報をゼンリンAPIより取得
   * @@param s
   * @@param i
   */
  function GetAddress(s, i) {

    if (map == null || map.getCenter() == null) {
      return false;
    }

    let sId = s + '_' + i;
    $('#SetAddressItem').val(sId);

    let latLng = map.getCenter();
    $('#' + sId + '__Lat').val(latLng.lat);
    $('#' + sId + '__Lng').val(latLng.lng);


    ///処理中ダイアログ
    Swal.fire({
      title: '住所データ読込中',
      html: 'ゼンリン地図APIで住所情報取得中です。<br /> 表示されるまでそのままお待ちください。<br /> 場所が密集地の場合、読み込みに時間がかかります。',
      allowOutsideClick: false //枠外をクリックしても画面を閉じない
        ,
      showConfirmButton: false,
      didOpen: () => {
        Swal.showLoading();
      }
    });


    let slatlon = String(latLng.lng) + ',' + String(latLng.lat);
    //alert(slatlon);

    $.post(
        '@Url.RouteUrl("Default", new { controller = "Map", Action = "MapGetAddressFromPosition" })', {
          position: String(slatlon),
          modal_flg: 1,
          range: 1,
        })
      .done(function(response) {

        if (response.errorMessage != null) {
          alertError(`【エラー】${response.errorMessage}`);
          return false;
        } else {
          $("#ModalHere").html(response.partialView);
          DailogOpen("ModalHere", "住所選択", 800, 600);
          CommonWaitEnd();
          return;
        }
      })
      .fail(function(xhr) {
        alertError(xhr, "【ネットワークエラー】");
        console.log(xhr);
        return false;
      })
      .always(function(xhr, msg) {
        /*    //console.log(xhr, msg);*/
      });
    return false;
  };

