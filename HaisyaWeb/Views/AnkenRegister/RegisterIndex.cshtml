@model AnkenModel.AnkenRegisterModel

@{
  Layout = "_Layout";
  ViewData["Title"] = "案件登録";
}


<meta charset="UTF-8">
<link href="~/css/Anken.css" rel="stylesheet" />

<style>
  body {
    margin: 0;
    padding: 0;
  }

  #ZMap {
    position: absolute;
    top: 20px;
    bottom: 0;
    width: 100%;
  }

  .row > * {
    padding-right: 0.2rem;
    padding-left: 0.2rem;
  }

  .row {
    margin-left: 0;
    padding: 0;
    margin: 0;
  }

  .abc label,
  .abc input {
    font-size: 12px !important;
  }
</style>

<!-- ローダーのURLをscriptでロードする -->
<!-- ログイン認証の場合 -->
<script src="@(Model.MapsApiForJSUrl)"></script>

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "frmMain", @class = "contact-form p-0", @style = "", @onsubmit = "return false;" }))
{
  @Html.AntiForgeryToken()
  <div hidden>

    @Html.HiddenFor(model => model.SelectDay)

    @Html.HiddenFor(model => model.SelectTantou)
    @Html.HiddenFor(model => model.SelectSyasyu)
    @Html.HiddenFor(model => model.SelectKata)
    @Html.HiddenFor(model => model.SelectGroup)
    @Html.HiddenFor(model => model.SelectMonth)

    @*@Html.TextBoxFor(model => model.BackMenu)*@
    @Html.HiddenFor(model => model.SenzokuID)
    @Html.HiddenFor(model => model.SenzokuDriverID)

    <input type="text" id="AnkenID_Before" name="AnkenID_Before" value="@(Model.Anken_ID)" />
    @Html.TextBoxFor(model => model.Anken_ID)

    @Html.TextBoxFor(model => model.UserID)

    @Html.TextBoxFor(model => model.Anken_Latest_Order)
    @Html.TextBoxFor(model => model.Company_ID)
    @Html.TextBoxFor(model => model.Branch_ID)

    @Html.TextBoxFor(model => model.ExecType)
    @Html.TextBoxFor(model => model.Syasyu)
    @Html.TextBoxFor(model => model.SyasyuSize)
    @Html.TextBoxFor(model => model.Kata)
    @Html.TextBoxFor(model => model.Width)
    @Html.TextBoxFor(model => model.Weight)

    @Html.TextBoxFor(model => model.TollKubun)
    @Html.TextBoxFor(model => model.SeikyuKubun)
    @Html.TextBoxFor(model => model.AnkenStatus)
    @Html.TextBoxFor(model => model.SelectPointTab)
    @Html.TextBoxFor(model => model.NumberCommLimitKubun)
    @Html.TextBoxFor(model => model.WebViewFlg)
    @Html.TextBoxFor(model => model.HaisyaPlanKubun)
    @Html.TextBoxFor(model => model.Anken_Kubun)
    @Html.TextBoxFor(model => model.SyasyuDisplay)
    @Html.TextBoxFor(model => Model.RegKubun)
    @Html.TextBoxFor(model => Model.Anken_ID_KakoSelect)
    @Html.HiddenFor(model => model.BackMenuAction, new { @style = "" })
    @Html.HiddenFor(model => model.BackMenuAction2, new { @style = "" })
    <input hidden id="SetAddressItem" />
  </div>

  <div>
    <div role="document">
      <div class="">
        <div id="divJisya">
          <div id="divDetaiHeader" class="modal-header w-100" style="">
            <table class="ex_TableBackgroundNone w-100 h-100">
              @{
                if (Model.Title != null && Model.Title.Length > 0)
                {
                  <tr>
                    <th colspan="4">
                      <h5 style="color:mediumblue">@(Model.Title)</h5>
                    </th>

                  </tr>
                }
              }
              <tr>
                <td class="w-20">
                  <h3 id="labelTitle" class="heading-40">@(Model.Anken_ID > 0 ? "案件変更登録" : "案件新規登録")</h3>
                </td>
                <td class="w-30" style="padding: 0 20px;">
                  <div class="d-inline-flex h-100 w-100 p-0" style="">
                    <input type="text" name="dummy" class="d-none" style="">
                    @if (Model.Anken_ID > 0)
                    {
                      <button type="button" id="btnAnkenCopy" class="btn btn-outline-info ms-2 w-40" style="margin: 5px 0 5px 0;" onclick="BtnAnkenCopyOnClick(); return false;">コピー</button>
                    }
                    else
                    {
                      <button type="button" id="btnSerchKakoAnken" class="btn btn-outline-dark w-60" style="margin: 5px 0 5px 0;" onclick="btnSelectKakoAnkenDisplayOnClick(); return false;">過去案件検索機能</button>
                    }
                    <div id="boxEmailSettings"></div>
                  </div>
                </td>
                <td class="w-40" style="padding: 0 20px;">
                  <div class="d-inline-flex h-100 w-100 p-0" style="">
                    @if (Model.Anken_ID > 0)
                    {
                      <button type="button" id="btnRegExec" name="btnRegExec" value="Update" class="btn btn-outline-danger w-30" style="margin: 5px 0 5px 0;" onclick="btnRegExecOnclick('Update'); return false;">更新</button>
                      <button type="button" id="btnRegExec" name="btnRegExec" value="AddNew" class="btn btn-outline-primary w-30 ms-2" style="margin: 5px 0 5px 0;" onclick="btnRegExecOnclick('AddNew'); return false;">履歴登録</button>
                      <button type="button" id="btnAnkneRireki" name="btnRegExec" class="btn btn-outline-success w-30 ms-2" style="margin: 5px 0 5px 0;" onclick="btnShowAnkenRirekiOnclick(); return false;">変更履歴</button>
                    }
                    else
                    {
                      <button type="button" id="btnRegExec" name="btnRegExec" value="AddNew" class="btn btn-outline-success w-75" style=" margin: 5px 0 5px 0;" onclick="btnRegExecOnclick('AddNew'); return false;">登録</button>
                    }
                  </div>
                </td>
                <td class="w-10" style="">
                  <div class="d-inline-flex h-100 w-100 p-0" style="">
                    <button type="button" name="btnClose" value="Close" class="btn btn-outline-warning w-100" style="margin: 5px 0 5px -10px;" onclick="btnCloseOnClick(); return false;">閉じる</button>
                  </div>
                </td>
              </tr>
            </table>
          </div>
          <div id="divDetail" class="model-body">
            <div class="row">
              <div id="div-body-main" class="col-sm-10 p-0" style="">
                <div class="row">
                  <div id="div-body-left" class="col-sm-6 border">
                    <div class="item">
                      @Html.LabelFor(model => model.Anken_No, htmlAttributes: new { @class = "label required", @style = "" })

                      <div class="d-flex">
                        @Html.TextBoxFor(model => model.Anken_No, null, new { @readonly = "readonly", @class = "control-label align-self-center align-middle text-end", @style = "border: none; text-align-last: start;width: 200px;" })
                        <div class="p-0 nowrap" style="">
                          @Html.LabelFor(model => Model.HaisyaTantouID, htmlAttributes: new { @class = "label required text-end", @style = "width: 70px; min-width: 0px;" })
                          @Html.DropDownListFor(model => model.HaisyaTantouID, new SelectList(Model.TantouSelectList, "Value", "Text", "Selected"), "配車担当", new { @class = "form-control list dropDownList", @style = "" })
                        </div>
                        <div class="p-0 nowrap" style="">
                          @Html.LabelFor(model => model.EigyoID, htmlAttributes: new { @class = "label text-end", @style = "width: 70px; min-width: 0px;" })
                          @Html.DropDownListFor(model => model.EigyoID, new SelectList(Model.EigyoSelectList, "Value", "Text", "Selected"), "営業担当", new { @class = "form-control list dropDownList", @style = "" })
                        </div>
                      </div>
                    </div>
                    <div class="item">
                      @Html.LabelFor(model => model.WorkName, htmlAttributes: new { @class = "label", @style = "" })
                      @Html.TextBoxFor(model => model.WorkName, null, new { @class = "form-control", @style = "ime-mode: active; width: calc(100% - (130px));" })
                    </div>
                    <div class="item">
                      <label class="label required" style="">案件状況</label>
                      <div class="radio-group" style="">
                        <input type="radio" class="btn-check" name="num_of_AnkenStatus" id="optAnkenStatus0" value="0" style=""><label class="btn btn-outline-secondary" for="optAnkenStatus0">確定</label>
                        <input type="radio" class="btn-check ms-1" name="num_of_AnkenStatus" id="optAnkenStatus1" value="1" style=""><label class="btn btn-outline-secondary" for="optAnkenStatus1">暫定(配車必要)</label>
                        <input type="radio" class="btn-check ms-1" name="num_of_AnkenStatus" id="optAnkenStatus2" value="2" style=""><label class="btn btn-outline-secondary" for="optAnkenStatus2">暫定(配車不要)</label>
                      </div>
                    </div>
                    <div class="item">
                      <label class="label required " for="KokyakuId" style="">@Html.LabelFor(model => model.KokyakuId)<span class="kakoSerch"></span></label>
                      @if (Model.SenzokuID == 0)
                      {
                        <button type="button" id="btnKokyaku" class="btn btn-anken select-button" style="" onclick="return false;">選択</button>
                      }
                      @Html.TextBoxFor(model => model.KokyakuCode, null, new { @readonly = "readonly", @class = "form-control input-anken text-center", @style = "width:120px;" })
                      @Html.TextBoxFor(model => model.KokyakuName, null, new { @readonly = "readonly", @class = "form-control input-anken", @style = "width: calc(100% - 340px);" })
                      @Html.TextBoxFor(model => model.KokyakuId, null, new { @hidden = "true", @class = "form-control input-anken search w-auto", @style = "" })
                    </div>
                    <div class="item">
                      @Html.LabelFor(model => model.KokyakuTantouId, htmlAttributes: new { @class = "label required", @style = "" })
                      @if (Model.SenzokuID == 0)
                      {
                        <button type="button" id="btnKokyakuTantou" class="btn btn-anken select-button" style="" onclick="return false;">選択</button>
                      }
                      @Html.TextBoxFor(model => model.KokyakuTantouName, null, new { @readonly = "readonly", @class = "form-control input-anken", @style = "width: calc(100% - 230px);" })
                      @*@Html.TextBoxFor(model => model.KokyakuTantouPhone, null, new { @readonly = "readonly", @class = "form-control input-anken", @style = "width: 180px;;" })*@
                      @Html.TextBoxFor(model => model.KokyakuTantouId, null, new { @hidden = "true", @class = "form-control input-anken search w-auto", @style = "" })
                    </div>
                    <div class="item">
                      <label class="label required " for="SyasyuID" style="">@Html.LabelFor(model => model.SyasyuID)<span class="kakoSerch"></span></label>
                      <div class="d-inline-flex" style="">
                        <div class="p-0" style="min-width: 250px;">
                          @Html.DropDownListFor(model => model.SyasyuID, new SelectList(Model.SyasyuSelectList, "Value", "Text", "Selected"), "車種を選択", new { @class = "form-control list dropDownList search", @style = "" })
                          @Html.ValidationMessageFor(model => model.SyasyuID, "", new { id = "SelectSyasyu", @class = "text-danger align-middle" })
                        </div>
                        <div class="">
                          @Html.LabelFor(model => model.Daisuu, htmlAttributes: new { @class = "label text-end", @style = "width: auto;" })
                          @Html.DropDownListFor(model => model.Daisuu, new SelectList(Model.DaisuuSelectList, "Value", "Text", "Selected"), "台数", new { @class = "form-control list dropDownList text-center", @style = "" })
                          @Html.ValidationMessageFor(model => model.Daisuu, "", new { id = "SelectDaisuu", @class = "text-danger align-middle" })
                        </div>
                      </div>
                    </div>
                    <div class="item">
                    </div>
                    <div class="item">
                      <label class="label required" style="">配車予定</label>
                      <div class="radio-group" style="">
                        <input type="radio" class="btn-check" name="num_of_NumberHaisyaPlanKubun" id="optHaisyaPlanKubun0" value="0"><label class="btn btn-outline-warning" for="optHaisyaPlanKubun0">未定</label>
                        <input type="radio" class="btn-check" name="num_of_NumberHaisyaPlanKubun" id="optHaisyaPlanKubun1" value="1"><label class="btn btn-outline-warning" for="optHaisyaPlanKubun1">自車</label>
                        <input type="radio" class="btn-check" name="num_of_NumberHaisyaPlanKubun" id="optHaisyaPlanKubun2" value="2"><label class="btn btn-outline-warning" for="optHaisyaPlanKubun2">傭車</label>
                        @*<input type="radio" class="btn-check" name="num_of_NumberHaisyaPlanKubun" id="optHaisyaPlanKubun3" value="3"><label class="btn btn-outline-warning" for="optHaisyaPlanKubun3">専属庸車</label>*@
                        <input type="radio" class="btn-check" name="num_of_NumberHaisyaPlanKubun" id="optHaisyaPlanKubun4" value="4"><label class="btn btn-outline-warning" for="optHaisyaPlanKubun4">専属</label>
                        <input type="radio" class="btn-check" name="num_of_NumberHaisyaPlanKubun" id="optHaisyaPlanKubun5" value="5"><label class="btn btn-outline-warning" for="optHaisyaPlanKubun5">自車専任</label>
                      </div>
                    </div>
                    <div class="item" id="HaisyaPlanKubun_SelectDriver">
                      <label class="label required" style="">専任乗務員</label>
                      <div class="row" style="display: block;">
                        <button type="button" id="btnKokyaku" class="btn btn-anken select-button" style="" onclick="SelectCompanyDriverOnClick(); return false;">選択</button>
                        @Html.TextBoxFor(model => model.HaisyaDriverDisplay, null, new { @readonly = "readonly", @class = "form-control input-anken", @style = "width: calc(100% - 230px);" })
                        @Html.TextBoxFor(model => model.HaisyaDriverId, null, new { @hidden = "true", @class = "form-control input-anken search w-auto", @style = "" })
                        @Html.TextBoxFor(model => model.HaisyaDriverSyaryoId, null, new { @hidden = "true", @class = "form-control input-anken search w-auto", @style = "" })
                      </div>

                    </div>
                    <div class="item" hidden>
                      @if (Model.SenzokuID == 0)
                      {
                        @Html.LabelFor(model => model.PublishGroup, htmlAttributes: new { @class = "label", @style = "" })
                        @Html.DropDownListFor(model => model.PublishGroup, new SelectList(Model.PublishGroupSelectList, "Value", "Text", "Selected"), "公開グループを選択", new { @class = "form-control list dropDownList", @style = "" })
                        @Html.ValidationMessageFor(model => model.PublishGroup, "", new { id = "SelectPublishGroup", @class = "text-danger align-middle" })
                      }
                    </div>

                    <div class="item">
                      @Html.LabelFor(model => model.TollKubun, htmlAttributes: new { @class = "label required", @style = "width: 120px;" })
                      <div class="d-flex">
                        <div class="radio-group" style="">
                          <input type="radio" class="btn-check" name="num_of_TollKubun" id="optTollKubun0" value="4"><label class="btn btn-outline-success" for="optTollKubun0">無し</label>
                          <input type="radio" class="btn-check" name="num_of_TollKubun" id="optTollKubun1" value="1"><label class="btn btn-outline-success" for="optTollKubun1">全高</label>
                          <input type="radio" class="btn-check" name="num_of_TollKubun" id="optTollKubun2" value="2"><label class="btn btn-outline-success" for="optTollKubun2">一部</label>
                          <input type="radio" class="btn-check" name="num_of_TollKubun" id="optTollKubun3" value="3"><label class="btn btn-outline-success" for="optTollKubun3">金額</label>
                          @*<input type="radio" class="btn-check" name="num_of_TollKubun" id="optTollKubun4" value="5"><label class="btn btn-outline-success" for="optTollKubun4">実費精算</label>*@
                          <input type="radio" class="btn-check" name="num_of_TollKubun" id="optTollKubun5" value="9"><label class="btn btn-outline-success" for="optTollKubun5">他</label>
                        </div>
                        <br />
                        <div id="divTollKubun-TollMoney" class="row align-content-center ms-3">
                          <label class="label required" style="">金額を指定</label>
                          @Html.TextBoxFor(model => model.TollMoney, "{0:N0}", new { @class = "form-control text-end inputbox ms-0", @style = "width: 100px;", @onblur = "kanmaChange(this);" })
                        </div>
                      </div>
                      <div id="divTollKubun-TollRemarks" class="row">
                        <label class="label required" style="">高速備考</label>
                        @Html.EditorFor(model => model.TollRemarks, new { htmlAttributes = new { @class = "form-control", @rows = "2", @style = "ime-mode: active; width: calc(100% - (150px));" } })
                      </div>
                    </div>

                    <div class="item">
                      @Html.LabelFor(model => model.NumberCommLimitKubun, htmlAttributes: new { @class = "label", @style = "" })
                      <div class="row">
                        <div class="p-0" style="min-width: 180px;width: auto;">
                          <div class="radio-group" style="">
                            <input type="radio" class="btn-check" name="num_of_NumberCommLimitKubun" id="optCommLimitKubun0" value="0"><label class="btn btn-outline-primary" for="optCommLimitKubun0">要</label>
                            <input type="radio" class="btn-check" name="num_of_NumberCommLimitKubun" id="optCommLimitKubun1" value="1"><label class="btn btn-outline-primary" for="optCommLimitKubun1">不要</label>
                          </div>
                        </div>
                        <div class="" id="tdNumberCommLimitDateTimeLavel" style="width: auto;">
                          <label class="control-label align-self-center align-middle text-end m-0 p-0" style="line-height: 15px;">希望<br />期日</label>
                          @*@Html.LabelFor(model => model.NumberCommLimitDateTime, htmlAttributes: new { @class = "label text-end w-auto", @style = "" })*@
                          @Html.EditorFor(model => model.NumberCommLimitDateTime, null, null, new { htmlAttributes = new { @Class = "form-control txt-time", @Style = "width: 230px;" }, })
                        </div>
                      </div>
                    </div>
                    <div class="item">
                      <label class="label" style="">荷待ち時間</label>
                      <div class="row" style="">
                        <div class="col-sm-6 p-0 nowrap" style="">
                          <label class="control-label align-self-center align-middle text-end m-0 p-0" style="line-height: 15px;">積み<br />時間</label>
                          @Html.TextBoxFor(model => model.TsumiTaskTime, null, new { @readonly = "readonly", @class = "form-control txt-time", @style = "width: 80px;" })
                          <button type="button" name="TsumiTaskTimeP" value="tsumi" class="btn btnCircle align-baseline" style="width: 15%; max-width:45px;" onclick="return false;">+</button>
                          <button type="button" name="TsumiTaskTimeM" value="tsumi" class="btn btnCircle align-baseline" style="width: 15%; max-width: 45px;" onclick="return false;">-</button>
                        </div>
                        <div class="col-sm-6 nowrap p-0" style="">
                          <label class="control-label align-self-center align-middle text-end m-0 p-0" style="line-height: 15px;">卸し<br />時間</label>
                          @Html.TextBoxFor(model => model.OroshiTaskTime, null, new { @readonly = "readonly", @class = "form-control txt-time", @style = "width: 80px;" })
                          <button type="button" name="TsumiTaskTimeP" value="oroshi" class="btn btnCircle align-baseline" style="width: 15%; max-width: 45px;" onclick="return false;">+</button>
                          <button type="button" name="TsumiTaskTimeM" value="oroshi" class="btn btnCircle align-baseline" style="width: 15%; max-width: 45px;" onclick="return false;">-</button>
                        </div>
                      </div>
                    </div>
                    <div class="item">
                      <label class="label required" style="">走行条件</label>
                      <div class="row nowrap" style="">
                        <div class="col-4 p-0" style="">
                          @Html.LabelFor(model => model.Ferry, htmlAttributes: new { @class = "label p-0", @style = "font-size: 12px;" })<br />
                          @Html.DropDownListFor(model => model.Ferry, new SelectList(Model.FerrySelectList, "Value", "Text", "Selected"), new { @class = "form-control list dropDownList", @style = "" })
                          @Html.ValidationMessageFor(model => model.Ferry, "", new { id = "SelectFerry", @class = "text-danger align-middle" })
                        </div>
                        <div class="col-4 p-0" style="">
                          @Html.LabelFor(model => model.TimeRestriction, htmlAttributes: new { @class = "label p-0", @style = "font-size: 12px;" })<br />
                          @Html.DropDownListFor(model => model.TimeRestriction, new SelectList(Model.TimeRestrictionSelectList, "Value", "Text", "Selected"), new { @class = "form-control list dropDownList", @style = "" })
                          @Html.ValidationMessageFor(model => model.TimeRestriction, "", new { id = "SelectRegulation", @class = "text-danger align-middle" })
                        </div>
                        <div class="col-4 p-0" style="">
                          @Html.LabelFor(model => model.Twouturn, htmlAttributes: new { @class = "label p-0", @style = "font-size: 12px;" })<br />
                          @Html.DropDownListFor(model => model.Twouturn, new SelectList(Model.TwouturnSelectList, "Value", "Text", "Selected"), new { @class = "form-control list dropDownList", @style = "" })
                          @Html.ValidationMessageFor(model => model.Twouturn, "", new { id = "SelectTwouturn", @class = "text-danger align-middle" })
                        </div>
                      </div>
                    </div>
                    <div class="item">
                      <div class="row nowrap" style="">
                        <div class="col-5 align-content-center p-0" style="">
                          <label class="label required" style="line-height: 17px;width: 120px;">労務費<br />計算区分</label>
                          @Html.DropDownListFor(model => model.DriverGrossCalc, new SelectList(Model.DriverGrossCalcSelectList, "Value", "Text", "Selected"), new { @class = "form-control list dropDownList text-center", @style = "" })
                          @Html.ValidationMessageFor(model => model.DriverGrossCalc, "", new { id = "SelectDriverGrossCalc", @class = "text-danger align-middle" })
                        </div>
                        <div class="col-3 align-content-center p-0" style="">
                          <label class="control-label align-self-center align-middle text-end m-0 p-0" style="line-height: 17px;">運賃<br />エリア</label>
                          @Html.DropDownListFor(model => model.Area, new SelectList(Model.AreaSelectList, "Value", "Text", "Selected"), new { @class = "form-control list dropDownList text-center", @style = ";" })
                          @Html.ValidationMessageFor(model => model.Area, "", new { id = "SelectArea", @class = "text-danger align-middle" })
                        </div>
                        <div class="col-4 align-content-center p-0" style="">
                        </div>
                      </div>
                    </div>
                    <div hidden>
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.BreakTime)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.RestTime)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.FuelConsume)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.RestTimeDisplay)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.StdFreight)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.StdExcharge)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.StdTotalFreight)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.GrossAmountForLaborCost)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.GrossAmountForFuelCost)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.GrossAmountForSyaryoCost)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.GrossAmountForLuggage)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.GrossAmountForExcharge)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.GrossAmount)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.TotalDays)

                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.Syasyu)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.Kata)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.SyasyuSize)

                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.Height)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.Width)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.Weight)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.Nenpi)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.RouteTitleStyle)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.RouteTypeClass)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.RestTimeDisplay)
                      @Html.TextBoxFor(model => model.SelectedDriveRouteDisplay.BreakTimeDisplay)

                    </div>
                  </div>

                  <div id="div-body-right" class="col-sm-6 border">

