  /**
   * 登録処理のインターフェースを返却する
   * @@param $form
   */
  function ajaxRegExec($form) {
    CommonWaitStart();

    return new Promise((resolve, reject) => {
      $.ajax({
        url: '@Url.RouteUrl("Default", new { controller = "AnkenRegister", Action = "RegExec2" })',
        type: 'post',
        data: $form.serialize(),
      }).done(async function(response) {
        if (response.errorMessage != null) {
          // エラー
          resolve(response.errorMessage);
        } else {
          let obj = response.t_Anken;
          //alert("【done】" + obj["anken_No"]);
          $('#Anken_ID').val(obj["anken_ID"]);
          $('#Anken_No').val(obj["anken_No"]);
          $('#Anken_Latest_Order').val(obj["anken_Latest_Order"]);

          if ($('#AnkenID_Before').val() == "0") {
            $('#btnRegExec').text("更新");
            $('#btnRegExec').val("Update");
          }

          // 正常終了
          resolve("正常");

        }
      }).fail(function(xhr) {
        alertError(xhr, "【ネットワークエラー】");
        console.log(xhr);
        // エラー
        resolve(false);
      }).always(function(xhr, msg) {
        CommonWaitEnd();
      });

    })

  };


