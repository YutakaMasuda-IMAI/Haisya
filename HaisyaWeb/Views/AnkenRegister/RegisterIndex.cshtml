    /**　高速区分の入力項目を非表示にする */
    TollKubunInputHidden($('#TollKubun').val());

    /////修正画面時には
    if (document.getElementById("Anken_ID").value != "0" &&
      document.getElementById("SelectedDriveRouteDisplay_routeID").value.length > 0) {
      SerchDriveRoot("2");
    }

    // CommonWaitEnd();

  };


  $(function() {

    $(document).ready(function() {



      //TollKubunInputHidden(0);
      /** 過去案件検索一覧を非表示に設定する */
      ChangeBodyDispaly(0);

      var radio = document.getElementsByName('num_of_AnkenStatus');
      for (let i = 0; i < radio.length; i++) {
        if (radio.item(i).value == $('#AnkenStatus').val()) {
          radio.item(i).checked = true;
        }
      };

      var radio = document.getElementsByName('num_of_SeikyuKubun');
      for (let i = 0; i < radio.length; i++) {
        if (radio.item(i).value == $('#SeikyuKubun').val()) {
          radio.item(i).checked = true;
        }
      };

      var radio = document.getElementsByName(
        'num_of_NumberHaisyaPlanKubun');
      for (let i = 0; i < radio.length; i++) {
        if (radio.item(i).value == $('#HaisyaPlanKubun').val()) {
          radio.item(i).checked = true;
        }
      };

      var radio = document.getElementsByName('num_of_TollKubun');
      for (let i = 0; i < radio.length; i++) {
        if (radio.item(i).value == $('#TollKubun').val()) {
          radio.item(i).checked = true;
        }
      };

      var radio = document.getElementsByName(
        'num_of_NumberCommLimitKubun');
      for (let i = 0; i < radio.length; i++) {
        if (radio.item(i).value == $('#NumberCommLimitKubun').val()) {
          radio.item(i).checked = true;
        }
      };
      num_of_NumberCommLimitKubunOnChecnge($('#NumberCommLimitKubun').val());

      var radio = document.getElementsByName('num_of_PointTab');
      for (let i = 0; i < radio.length; i++) {
        if (radio.item(i).value == $('#SelectPointTab').val()) {
          radio.item(i).checked = true;
        }
      };

      var radio = document.getElementsByName('num_of_NumberHaisyaPla nKubun');
      for (let i = 0; i < radio.length; i++) {
        if (radio.item(i).value == $('#HaisyaPlanKubun').val()) {
          radio.item(i).checked = true;
        }
      };
      haisyaPlanKubunOnChanged($('#HaisyaPlanKubun').val());


      $('.map-container').height($('#divRootDisplay').height());
      $('.map-container2').height($('#divRootDisplay').height() - 60);

      /////積卸選択時のchangeイベントを設定
      var elements = document.querySelectorAll('[name$="].Kubun"]');
      //elements.addEventListener('change', PointListDisplayChange);
      elements.forEach((inputObj) => {
        inputObj.addEventListener('change', PointListDisplayChange);
      });


    });


    $(window).resize(function(event) {
      divSerchResize();
    });

    $('button[name="TsumiTaskTimeP"]').on('click', function() {
      let button = this;
      let val = $(button).val();
      let data = $('#TsumiTaskTime').val();
      if ("oroshi" == val) {
        data = $('#OroshiTaskTime').val();
      }
      let sDatetime = '1900/01/01 ' + data + ':00';
      //alert(sDatetime);
      let dateVal = new Date(sDatetime);
      let dateVal2 = new Date(dateVal.setMinutes(dateVal.getMinutes() + 30));
      //alert(dateVal2);
      let mm = ('00' + (dateVal2.getHours())).slice(-2);
      let nn = ('00' + (dateVal2.getMinutes())).slice(-2);
      let s = mm + ':' + nn;
      if ("tsumi" == val) {
        data = $('#TsumiTaskTime').val(s);
      }
      if ("oroshi" == val) {
        data = $('#OroshiTaskTime').val(s);
      }
    });

    $('button[name="TsumiTaskTimeM"]').on('click', function() {
      let button = this;
      let val = $(button).val();
      let data = $('#TsumiTaskTime').val();
      if ("oroshi" == val) {
        data = $('#OroshiTaskTime').val();
      }
      let sDatetime = '1900/01/01 ' + data + ':00';
      //alert(sDatetime);
      let dateVal = new Date(sDatetime);
      let dateVal2 = new Date(dateVal.setMinutes(dateVal.getMinutes() - 30));
      //alert(dateVal2);
      let mm = ('00' + (dateVal2.getHours())).slice(-2);
      let nn = ('00' + (dateVal2.getMinutes())).slice(-2);
      let s = mm + ':' + nn;
      if ("tsumi" == val) {
        data = $('#TsumiTaskTime').val(s);
      }
      if ("oroshi" == val) {
        data = $('#OroshiTaskTime').val(s);
      }

    });

    $('input[name="num_of_NumberCommLimitKubun"]').on('change', function() {
      let val = $(this).val();
      num_of_NumberCommLimitKubunOnChecnge(val);
    });

    $('#txtAddress').on('keydown ', function(event) {
      if (event.key === 'Enter') {
        //alert('keydown ');
        GetlatlonFromAddress();
      }
      //return false;
    });

    $('input[name="num_of_AnkenStatus"]').on('change', function() {
      let val = $(this).val();
      $('#AnkenStatus').val(val);
    });

    $('input[name="num_of_SeikyuKubun"]').on('change', function() {
      let val = $(this).val();
      $('#SeikyuKubun').val(val);
    });

    $('input[name="num_of_TollKubun"]').on('change', function() {
      let val = $(this).val();
      $('#TollKubun').val(val);
      TollKubunInputHidden(val);

    });

    $('input[name="num_of_NumberCommLimitKubun"]').on('change', function() {
      let val = $(this).val();
      $('#NumberCommLimitKubun').val(val);
    });

    $('input[name="num_of_NumberHaisyaPlanKubun"]').on('change', function() {
      let val = $(this).val();
      $('#HaisyaPlanKubun').val(val);
      haisyaPlanKubunOnChanged(val);
    });

    $('#SyasyuID').on('change', function() {
      let val = $(this).children(':selected').text();
      $('#SyasyuDisplay').val(val);
    });


    $('#btnKokyaku').on('click', function(event) {
      openCommonDialogForCustomer($('#Company_ID').val(), $('#UserID').val(), $('#KokyakuId').val());
      return false;
    });

    $('#btnKokyakuTantou').on('click', function(event) {

      let KokyakuId = $('#KokyakuId').val();
      if (KokyakuId == 0) {
        alertInputError("まず顧客を選択してください。");
        return false;
      }

      openCommonDialogForCustomerTantou($('#Company_ID').val(), $('#UserID').val(), KokyakuId, $('#KokyakuTantouId').val());
      return false;

    });

    $('button[name="btnAnkenKubun"]').on('click', async function(event) {
      let val = $(this).val();
      $('#Anken_Kubun').val(val);
      $('#divAnkenSelectKubun').hide();

      if (val == '0') {
        //自動車運送画面
        $('#divJisya').show();
      } else {
        //利用運送画面
        RiyoUnsoTrans();
      }
      disableScroll();
      await MapPreview();
      enableScroll();
    });

    $('#btnSelectAddress').on('click', function(event) {
      CommonWaitStart();

      let $form = $('#frmMain');

      $.ajax({
        url: '@Url.RouteUrl("Default", new { controller = "AnkenRegister", Action = "SelectAddressModal" })',
        type: 'post',
        data: $form.serialize(),
      }).done(function(response) {
        if (response.message != null) {
          alertError(`【エラー】${response.errorMessage}`);
          return false;
        } else {
          //alert("【done】" + response.partialView);
          $("#ModalHere").html(response.partialView);
          DailogOpen("ModalHere", "住所検索", 1200, 600);
          return;
        }
      }).fail(function(xhr) {
        alertError(xhr, "【ネットワークエラー】");
        console.log(xhr);
        return false;
      }).always(function(xhr, msg) {
        CommonWaitEnd();
      });

    });

    /** ポイントリストの表示設定切替（経由地の場合は日時を非活性等） **/
    PointListDisplayChange();


    $(".search").on("change", function() {
      //alert("ボタンがクリックされました");
      let isHidden = $("#divSerchMain").is(":hidden");
      //alert(isHidden);
      if (!isHidden) {
        SetSelectKakoAnkenList();
      };

    });

    $(".seikyu").on("change", function() {
      //alert("seikyuがchangeされました");
      //$(".seikyu").filter(function () {
      //  alert($(this).attr('name'));

      //});

      var total = kanmaChangeRevert($('#BaseFee').val()) +
        kanmaChangeRevert($('#ExtraCharge').val()) + kanmaChangeRevert($(
          '#Toll').val()) - kanmaChangeRevert($('#Discount').val());
      $('#GrossAmount').val(total).blur();
    });


  });


  // // スクロール無効化
  function disableScroll() {
    // 現在の位置を保存
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
    const scrollLeft = window.pageXOffset || document.documentElement.scrollLeft;

    // スクロール位置を固定
    window.onscroll = function() {
      window.scrollTo(scrollTop, scrollLeft);
    };
  }

  // スクロール無効化解除
  function enableScroll() {
    window.onscroll = function() {};
  }


  /** 過去検索一覧のdivの高さを左の入力項目の高さに合わせる（スクロールのため） */
  function divSerchResize() {
    //alert("resize");
    $("#divSerchMain").height($("#div-body-left").height());

  };

  /**　高速区分の入力項目を非表示にする */
  function TollKubunInputHidden(val) {
    $('#divTollKubun-TollMoney').hide();
    $('#divTollKubun-TollRemarks').hide();

    if (val == 2) {
      $('#divTollKubun-TollMoney').show();
    }
    if (val == 3) {
      $('#divTollKubun-TollMoney').show();
    }
    if (val == 9) {
      $('#divTollKubun-TollRemarks').show();
    }
  };

  /**　登録・更新ボタン押下 */
  async function btnRegExecOnclick(val) {

    if (VaridationCheckForDriveRoute()) {
      return false;
    }

    if (VaridationCheckForReg()) {
      return false;
    }

    //logout();

    $('#ExecType').val(val);

    let sMessage = "";

    if ($('#Anken_ID').val() != null && $('#Anken_ID').val() > 0) {
      if ("Update" == val) {
        sMessage = "更新しますか？";
      } else {
        sMessage = "履歴登録しますか？";
      }
    } else {
      sMessage = "新規登録しますか？";
    }

