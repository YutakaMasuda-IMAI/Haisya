  /**
   * ポリラインを地図オブジェクト(map)に追加
   * @@param model
   */
  function setPolyline(obj) {

    let latlons = [];

    let line = obj["line"];

    line.forEach(point => {
      latlons.push(new ZDC.LatLng(point["lat"], point["lng"]));
    });

    // ポリラインを地図オブジェクト(map)に追加
    pl = new ZDC.Polyline(latlons, {
      color: '#ff0000',
      width: 5,
      pattern: 'solid',
      opacity: 1.0
    });
    map.addWidget(pl);
  };


