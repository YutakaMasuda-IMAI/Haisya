  /**
   * 過去案件リストの案件ボタンクリック
   * @@param obj
   */
  async function btnSelectKakoAnkenOnClick(obj) {

    var ankenId = obj["Anken_ID"];
    //alert(ankenId);

    $('#Anken_ID_KakoSelect').val(ankenId);

    var amount = Number(obj["GrossAmount"]);
    if (!isNaN(amount)) {
      amount = amount.toLocaleString();
    }
    //num.toLocaleString() // => "12,345"

    var sMessage = "下記案件情報をコピーして新規作成しますか？　<br/>「はい」を選択すると、新規登録用に画面を開き直します。<br/>";
    sMessage += "<div style='text-align: left; padding-left: 2rem;'>";
    sMessage += "顧客名：" + obj["KokyakuName"] + "<br/>";
    sMessage += "車種：" + obj["SyasyuDisplay2"] + "<br/>";
    sMessage += "積み：" + obj["StartAddressDisplay3"] + "<br/>";
    sMessage += "卸し：" + obj["EndAddressDisplay3"] + "<br/>";
    sMessage += "荷物：" + obj["Luggage"] + "<br/>";
    sMessage += "請求額：" + amount + "円<br/>";
    sMessage += "</div>";

    let resultMsg = await alertYesNoMsg("流用確認", null, "warning", "流用", null, sMessage);
    if (resultMsg == false) {
      return false;
    }

    logout();

    var form = document.getElementById('frmMain');
    form.action = '@Url.RouteUrl("Default", new { controller = "AnkenRegister", Action = "ExecCopyAnkenForKako" })';
    form.method = 'POST';
    form.submit();

    return false;


  };

