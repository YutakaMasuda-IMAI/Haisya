@model AnkenModel.SelectEquipmentDto


<style>

  .table-EquipmentModal {
    width: 100%;
  }

    .table-EquipmentModal th {
      padding: 0;
      text-align: center;
    }

    .table-EquipmentModal td {
      padding: 0;
      height: 15px;
      text-align: center;
    }

      .table-EquipmentModal td button {
        width: 90%;
        height: 95%
      }

        .table-EquipmentModal td button input {
          color: white;
        }
</style>


@{
}
<link href="~/css/Anken.css" rel="stylesheet" />



<div role="dialog" id="addRireki" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
  <div class="modal-dialog" role="document" style="max-width:1100px; min-height: 700px;">
    <div class="modal-content">
      <div hidden>
        <input type="number" id="SelectEquipmentGroup" value="0" />
        <table id="tableEquipmentSelectListModal">
          <thead></thead>
          <tbody id="tableEquipmentSelectListModal-tbody">
            @{
              var luggagelist = Model.EquipmentList.OrderBy(m => m.Equipment_Group_ID).ThenBy(m => m.SortOrder).ToList();
              foreach (var item in luggagelist)
              {
                <tr><td>@(item.Equipment_Group_ID)</td><td>@(item.Equipment_ID)</td><td>@(item.Equipment_Name)</td><td>@(item.Unit_Name)</td></tr>
              }
            }
          </tbody>
        </table>


      </div>
      <div class="modal-header">
        <h3>荷物情報選択</h3>
      </div>

      <div class="model-body">
        <div class="div-area">
          @*<label class="tab_class" for="tab1"></label>*@
          <div class="">
            <div class="row">
              <div class="col-6 col-sm-3">
                <table class="table table-EquipmentModal">
                  <thead>
                    <tr><th>荷物グループ</th></tr>
                  </thead>
                  <tbody>
                    @{
                      var luggageGroupList = Model.EquipmentGroupList.OrderBy(m => m.SortOrder).ToList();
                      foreach (var item in luggageGroupList)
                      {
                        <tr><td><button class="btn btn-dark" onclick="onClickEquipmentGroup(@(item.Equipment_Group_ID)); return false;">@(item.Equipment_GroupName)</button></td></tr>
                      }

                    }
                  </tbody>
                </table>
              </div>
              <div class="col-6 col-sm-3">
                <table id="tableEquipment" class="table table-EquipmentModal">
                  <thead>
                    <tr><th>荷物詳細</th></tr>
                  </thead>
                  <tbody id="tableEquipment-body">
                  </tbody>
                </table>
              </div>
              @*<div class="col-1 col-sm-1" style="">
              </div>*@
              <div class="col-6" style="margin-top: -20px;">
                <h6 style="padding:0;margin:0;">選択荷物</h6>
                <table id="tableEquipmentListModal" class="table table-EquipmentModal">
                  <thead>
                    <tr style="background-color:aquamarine;">
                      <th>荷物</th>
                      <th>数</th>
                      <th style="font-size:9px;">単位</th>
                      <th>備考</th>
                    </tr>
                  </thead>
                  <tbody id="tableSelectEquipment-body">
                    @{
                      if (Model.EquipmentList != null)
                      {
                        var EquipmentList = Model.AnkenEquipmentList.OrderBy(m => m.Insert_Datetime).ToList();
                        for (int i = 0; i < EquipmentList.Count; i++)
                        {
                          var luggage = Model.EquipmentList.FirstOrDefault(m => m.Equipment_ID == Model.AnkenEquipmentList[i].Equipment_ID);
                          if (luggage != null)
                          {
                            <tr>
                              <td hidden>@Html.TextBoxFor(model => Model.AnkenEquipmentList[i].Anken_ID, null, new { @readonly = "readonly", })</td>
                              <td hidden>@Html.TextBoxFor(model => Model.AnkenEquipmentList[i].Anken_Order, null, new { @readonly = "readonly", })</td>
                              <td hidden>@Html.TextBoxFor(model => Model.AnkenEquipmentList[i].Equipment_ID, null, new { @readonly = "readonly", @type = "number" })</td>
                              <th><input type="text" value="@(luggage.Equipment_Name)" readonly style="width: 200px;" id="AnkenEquipmentList_@(i)__Equipment_Name" name="AnkenEquipmentList[@(i)].Equipment_Name" /></th>
                              <td align="center">@Html.TextBoxFor(model => Model.AnkenEquipmentList[i].Equipment_Count, null, new { @type = "number", @style = "width: 50px; background-color: aqua;" })</td>
                              <th><input type="text" value="@(luggage.Unit_Name)" readonly style="width: 30px;" id="AnkenEquipmentList_@(i)__Unit_Name" name="AnkenEquipmentList[@(i)].Unit_Name" /></th>
                              <td>@Html.TextBoxFor(model => Model.AnkenEquipmentList[i].Remarks, null, new { @style = "width: 250px; background-color: aqua;" })</td>
                            </tr>
                          }
                          else
                          {
                            <tr>
                              <td hidden>@Html.TextBoxFor(model => Model.AnkenEquipmentList[i].Anken_ID, null, new { @readonly = "readonly", })</td>
                              <td hidden>@Html.TextBoxFor(model => Model.AnkenEquipmentList[i].Anken_Order, null, new { @readonly = "readonly", })</td>
                              <td hidden>@Html.TextBoxFor(model => Model.AnkenEquipmentList[i].Equipment_ID, null, new { @readonly = "readonly", @type = "number" })</td>
                              <th><input type="text" value="" readonly style="width: 200px;" id="AnkenEquipmentList_@(i)__Equipment_Name" name="AnkenEquipmentList[@(i)].Equipment_Name" /></th>
                              <td align="center">@Html.TextBoxFor(model => Model.AnkenEquipmentList[i].Equipment_Count, null, new { @type = "number", @style = "width: 50px; background-color: aqua;" })</td>
                              <th><input type="text" value="" readonly style="width: 30px;" id="AnkenEquipmentList_@(i)__Unit_Name" name="AnkenEquipmentList[@(i)].Unit_Name" /></th>
                              <td>@Html.TextBoxFor(model => Model.AnkenEquipmentList[i].Remarks, null, new { @style = "width: 250px; background-color: aqua;" })</td>
                            </tr>
                          }

                        }
                      }
                    }
                  </tbody>
                </table>
                
              </div>
            </div>
          </div>


        </div>
      </div>

      <div style="vertical-align: middle; display: inline-block; " class="modal-footer">
        <div class="row">
          <div class="col-8">
            <div>
              名前<input id="addEquipmentText" type="text" style="width: 200px;" value="" />
              単位<input id="addEquipmentUnit" type="text" style="width: 50px;" value="" />
              <button id="btnModelCancel" class="btn btn-secondary" data-dismiss="modal" onclick="addEquipmentMaster(); return false;">荷物詳細追加</button>
            </div>
          </div>
          <div class="col-2"><button id="btnModelHolidayReister" class="btn btn-success" onclick="SelectEquipmentRegExec(); return false;">登録</button></div>
          <div class="col-2"><button id="btnModelCancel" class="btn btn-secondary" data-dismiss="modal" onclick="ModalClose();">Close</button></div>
        </div>
      </div>
    </div>
  </div>
</div>






<script>

  $('#SelectEquipmentGroup').val(0);

  $(function () {

    // テーブル取得
    var tableElemEquipment = document.getElementById("tableEquipmentListModal");
    var rowElemsEquipment = tableElemEquipment.rows;
    var check = rowElemsEquipment[1].cells[2].firstElementChild.value;
    if (check == '0') {
      rowElemsEquipment[1].style.display = "none";
    }

  });

  /** M_Equipmentマスタの登録 */
  function addEquipmentMaster() {

    var addName = $('#addEquipmentText').val();
    var addUnit = $('#addEquipmentUnit').val();
    var gID = $('#SelectEquipmentGroup').val();

    if ('0' == gID) {
      alertInputError("登録する荷物グループを選択してください。");
      return true;
    }

    if (!(addName != null && addName.length > 0)) {
      alertInputError("荷物名称が入力されていません");
      $('#addEquipmentText').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#addEquipmentText').css('background-color', 'white');
    }

    if (!(addUnit != null && addUnit.length > 0)) {
      alertInputError("単位が入力されていません");
      $('#addEquipmentUnit').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#addEquipmentUnit').css('background-color', 'white');
    }

    // table要素を取得
    var tableElem = document.getElementById('tableEquipmentSelectListModal');
    // 行（tr要素）を取得
    var rowElems = tableElem.rows;

    for (i = 0, len = rowElems.length; i < len; i++) {
      var groupID = rowElems[i].cells[0].innerHTML;
      var name = rowElems[i].cells[2].innerHTML;
      if (gID == groupID && name == addName) {
        alertError("入力された名称は既に選ばれています。");
        return false;
      }
    }

    var luggageNewID = 0;

    $.post('@Url.RouteUrl("Default", new { controller = "AnkenRegister", Action = "JsonAddEquipmentMaster" })',
    {
      paramGroupID: gID, paramEquipmentText: addName, paramUnit: addUnit,
    })
    .done(function (response) {
      if (response.message != null) {
          alertError(`【エラー】${response.message}`);
          return false;
      } else {
        luggageNewID = Number(response.resultVal);
        AddtableEquipmentSelectListModal(gID, luggageNewID, addName, addUnit);
        onClickEquipmentGroup(gID);
        $('#addEquipmentText').val('');
        $('#addEquipmentUnit').val('');
        return false;
      }
    })
    .fail(function (xhr) {
        console.log(xhr);
    })
  };

  /**
   * M_Equipmentマスタの選択用リストにデータ追加
   * @@param paramGroupID
   * @@param paramID
   * @@param paramText
   * @@param paramUnit
   */
  function AddtableEquipmentSelectListModal(paramGroupID, paramID, paramText, paramUnit) {

    var tbody = document.getElementById("tableEquipmentSelectListModal-tbody");
    var row = tbody.insertRow(-1);

    var cell0 = row.insertCell(-1);
    var cell1 = row.insertCell(-1);
    var cell2 = row.insertCell(-1);
    var cell3 = row.insertCell(-1);
    cell0.innerHTML = paramGroupID;
    cell1.innerHTML = paramID;
    cell2.innerHTML = paramText;
    cell3.innerHTML = paramUnit;
  }

  /**
   *　荷物グループの選択処理
   * @@param paramGroupID
   */
  function onClickEquipmentGroup(paramGroupID) {

    $('#SelectEquipmentGroup').val(paramGroupID);

    $("#tableEquipment-body").remove();

    // テーブル取得
    var table = document.getElementById("tableEquipment");
    var tbody = document.createElement("tbody");
    tbody.setAttribute('id', 'tableEquipment-body');
    table.appendChild(tbody);

    // table要素を取得
    var tableElem = document.getElementById('tableEquipmentSelectListModal');
    // 行（tr要素）を取得
    var rowElems = tableElem.rows;

    // 取得した行（tr要素）を繰り返しHTMLを取得;
    for (i = 0, len = rowElems.length; i < len; i++) {
      var groupID = rowElems[i].cells[0].innerHTML;

      if (paramGroupID == groupID) {
        var id = rowElems[i].cells[1].innerHTML;
        var name = rowElems[i].cells[2].innerHTML;
        var unit = rowElems[i].cells[3].innerHTML;

        var row = tbody.insertRow(-1);
        var cell1 = row.insertCell(-1);
        cell1.innerHTML = '<button class="btn btn-dark" ondblclick="ondblclickEquipment(\'' + id + '\'); return false;">' + name + '(' + unit + ')</button>';
      }
    }

  };


  /**
   * 荷物詳細の選択処理
   * @@param paramID
   */
  function ondblclickEquipment(paramID) {

    var gID = $('#SelectEquipmentGroup').val();

    // テーブル取得
    var tableElemEquipment = document.getElementById("tableEquipmentListModal");
    // 行（tr要素）を取得
    var rowElemsEquipment = tableElemEquipment.rows;

    for (i = 1, len = rowElemsEquipment.length; i < len; i++) {
      var luggageId = rowElemsEquipment[i].cells[2].firstElementChild.value;
      if (paramID == luggageId) {
        alertError("選択された荷物は既に選ばれています。");
        return false;
      }
    }

    // table要素を取得
    var tableElem = document.getElementById('tableEquipmentSelectListModal');
    // 行（tr要素）を取得
    var rowElems = tableElem.rows;

    // 取得した行（tr要素）を繰り返しHTMLを取得;
    for (i = 0, len = rowElems.length; i < len; i++) {
      var id = rowElems[i].cells[1].innerHTML;
      var groupID = rowElems[i].cells[0].innerHTML;

      if (gID == groupID && paramID == id) {
        var nm = rowElems[i].cells[2].innerHTML;
        var unit = rowElems[i].cells[3].innerHTML;
        
        var row_len = 1
        var check = rowElemsEquipment[row_len].cells[2].firstElementChild.value;

        if (check != '0') {
          row_len = insertRow(tableElemEquipment, 1);
        } else {
          rowElemsEquipment[row_len].style.removeProperty('display');
        }
        var id = rowElemsEquipment[row_len].cells[0].firstElementChild.id;
        document.getElementById(id).defaultValue = $('#Anken_ID').val();
        id = rowElemsEquipment[row_len].cells[1].firstElementChild.id;
        document.getElementById(id).defaultValue = $('#Anken_Latest_Order').val();
        id = rowElemsEquipment[row_len].cells[2].firstElementChild.id;
        document.getElementById(id).defaultValue = paramID;
        id = rowElemsEquipment[row_len].cells[3].firstElementChild.id;
        document.getElementById(id).defaultValue = nm;
        id = rowElemsEquipment[row_len].cells[4].firstElementChild.id;
        document.getElementById(id).defaultValue = 1;
        id = rowElemsEquipment[row_len].cells[5].firstElementChild.id;
        document.getElementById(id).defaultValue = unit;
        id = rowElemsEquipment[row_len].cells[6].firstElementChild.id;
        document.getElementById(id).defaultValue = "";
      }
    }


  };

  /**
* 行追加処理
* */
  function insertRow(tableElem, baseRow) {
    // 行（tr要素）を取得
    var rowElems = tableElem.rows;
    // tbody要素にtr要素（行）を最後に追加
    var trElem = tableElem.tBodies[0].insertRow(-1);
    trElem.style.verticalAlign = 'middle';

    var row_len = rowElems.length - 1;
    var html = rowElems[baseRow].innerHTML;
    trElem.innerHTML = repalceidName(row_len - 1, html);

    return row_len;
  };

  /**
*　idとnameの書換え
* @@param row_len
* @@param html
*/
  function repalceidName(row_len, html) {
    html = replace_all(html, "AnkenEquipmentList_0", "AnkenEquipmentList_" + row_len + "");
    html = replace_all(html, "AnkenEquipmentList[0]", "AnkenEquipmentList[" + row_len + "]");
    return html;
  }

  /** 登録処理 */
  function SelectEquipmentRegExec() {

    ///表示名の設定
    // table要素を取得
    var tableElem = document.getElementById('tableEquipmentListModal');
    // 行（tr要素）を取得
    var rowElems = tableElem.rows;

    var disp = "";

    // 取得した行（tr要素）を繰り返しHTMLを取得;
    for (i = 1, len = rowElems.length; i < len; i++) {
      var name = rowElems[i].cells[3].firstElementChild.value;
      var num = rowElems[i].cells[4].firstElementChild.value;

      if (!(num != null && num.length > 0)) {
        alertInputError("数が入力されていません");
        rowElems[i].cells[4].backgroundColor = "lightcoral";
        return true;
      } else {
        rowElems[i].cells[4].backgroundColor = "white";
      }

      disp += name + "×" + num + "；";
    }


    var tableElem1 = document.getElementById("tableSelectEquipment-body");
    var tableElem2 = document.getElementById("tableEquipmentList-body");

    tableElem2.innerHTML = tableElem1.innerHTML;

    $('#EquipmentDisplay').val(disp);



    ModalClose();
  };


</script>

