          }
          if (tatemonoObj != null && tatemonoObj.length > 0) {
            $("#tableTatemonoForSarch-body").remove();
            var table = document.getElementById("tableTatemonoForSarch");
            var tbody = document.createElement("tbody");
            tbody.setAttribute('id', 'tableTatemonoForSarch-body');
            table.appendChild(tbody);

            tatemonoObj.forEach((element) => {
              // 行を行末に追加
              var row = tbody.insertRow(-1);
              row.style.verticalAlign = "middle";
              // セルの挿入
              var cell1 = row.insertCell(-1);
              var cell2 = row.insertCell(-1);
              cell1.hidden = true;

              cell1.innerHTML = element.address;
              var html = '';
              html += '<button class="btn btn-dark" onclick="onClickRireki(\'' + element.position.lat + '\',\'' + element.position.lng + '\',\'' + element.address + '\'); return false;">';
              html += '<div style="padding: 0px 0px 0px 2px; margin: 0; background: none; width: 100%; line-height: initial; text-align: left;">';
