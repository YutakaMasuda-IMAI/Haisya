              if (element.Post_code != null) { html += '<div style="display:inline-flex; float: left; font-size: 12px; width: 150px;">〒<label class="" readonly="readonly" style="border: none; width: 100%; background: none;">' + element.Post_code + '</label></div>'; }
              html += '<label class="" readonly="readonly" style="border: none; width: 100%; background: none; font-size: 12px;">' + element.Address + '</label>';
              html += '</div>';
              html += '</button>';
              cell2.innerHTML = html;

            });
          }
          return false;
        }
      })
      .fail(function (xhr) {
        console.log(xhr);
      })
      .always(function (xhr, msg) {
        console.log(xhr, msg);
      });
