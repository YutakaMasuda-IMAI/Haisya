@model SettingModel.AnkenExchargeModalDto

@{
  Layout = "_LayoutForSettingModal";

}

<style>
  /*  .float-left {
    float: left;
    padding: 0.5em 1em;
    margin: 2em 0;
    background: #f0f7ff;
    border: dashed 2px #5b8bd0;
  }

  .float-right {
    float: right;
    padding: 0.5em 1em;
    margin: 2em 0;
    background: #f0f7ff;
    border: dashed 2px #5b8bd0;
  }*/

  .readonly {
    background-color: lightgray;
  }
</style>


<div role="dialog" id="addRireki" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document" style="max-width:750px;">
    <div class="modal-content">
      <div class="modal-header" style="background-color: gainsboro;">
        <h1 class="modal-title fs-3" id="exampleModalLabel">@(Model.Title)</h1>
        <button type="button" type="button" class="btn btn-primary" onclick="regExec(); return false;">@(Model.BtnCaption)</button>
        <button type="button" type="button" class="btn btn-secondary" onclick="closeModel(); return false;">閉じる</button>
      </div>
      <div class="model-body">
        <form id="form1">
          <div id="hidden" hidden>
            @Html.HiddenFor(model => Model.BtnCaption)
            @Html.HiddenFor(model => Model.Title)
            @Html.HiddenFor(model => Model.M_Anken_Excharge.Komoku_ID)
          </div>
          <div class="contents-wrap-middle" style="margin: 10px;">
            <h4 class="">注意</h4>
            <span>
              ・【重要】車種サイズ毎に同じ項目キーで同じ項目内容(金額は変更)を登録してください。<br>
              ・一度データを登録すると物理削除は出来ません。「非表示フラグ」を立ててください。
            </span>
          </div>
          <table class="table table-striped-columns table-bordered border-primary" border="1" style="margin: 10px; width:96%;">
            <thead>
              <tr style="background-color: aquamarine;">
                <th align="center" style="text-align: center;">項目名</th>
                <th align="center" style="text-align: center;">値</th>
                <th align="center" style="text-align: center;">例</th>
              </tr>
            </thead>
            <tbody>
              <tr hidden>
                <th width="200px">会社ID</th>
                <td width="200px">@Html.TextBoxFor(model => Model.M_Anken_Excharge.Company_ID, null, new { @class = "form-control text-end", @onblur = "", @style = "width: 100px; padding: 0;" })</td>
                <td width="400px"></td>
              </tr>
              <tr hidden>
                <th width="200px">並び順</th>
                <td width="400px">@Html.TextBoxFor(model => Model.M_Anken_Excharge.SortOrder, null, new { @class = "form-control text-end", @onblur = "", @style = "width: 100px; padding: 0;" })</td>
                <td></td>
              </tr>
              <tr>
                <th style="color: red;">車種サイズ</th>
                <td>
                  @Html.DropDownListFor(model => model.M_Anken_Excharge.SIZE, new SelectList(Model.SyaryoSizeSelectList, "Value", "Text", "Selected"), "車種サイズを選択", new { @class = "form-control list dropDownList", @style = "padding: 0; width: 100%" })
                  @Html.ValidationMessageFor(model => model.M_Anken_Excharge.SIZE, "", new { id = "SelectTollSyasyu", @class = "text -danger align-middle" })
                </td>
                <td width="400px">小型車/中型車/大型車/トレーラ等</td>
              </tr>
              <tr>
                <th style="color: red;">項目キー</th>
                <td>@Html.TextBoxFor(model => Model.M_Anken_Excharge.Komoku_Key, null, new { @class = "form-control", @style = "width: 50px; padding: 0;" })</td>
                <td>車種サイズ毎に同じ項目キーで同じ内容を登録してください。</td>
              </tr>
              <tr>
                <th style="color: red;">項目名称</th>
                <td>@Html.TextBoxFor(model => Model.M_Anken_Excharge.Komoku_Name, null, new { @class = "form-control", @style = "width: 95%; padding: 0;" })</td>
                <td>フル名称を登録</td>
              </tr>
              <tr>
                <th style="color: red;">略称</th>
                <td>@Html.TextBoxFor(model => Model.M_Anken_Excharge.Komoku_Name_abbr, null, new { @class = "form-control", @style = "width: 95%; padding: 0;" })</td>
                <td>略名を記載</td>
              </tr>
              <tr>
                <th style="color: red;">標準金額</th>
                <td>@Html.TextBoxFor(model => Model.M_Anken_Excharge.StdExcharge, "{0:N0}", new { @class = "form-control text-end", @style = "width: 70px; padding: 0;" })</td>
                <td>標準運賃に加算されます</td>
              </tr>
              <tr>
                <th style="color: red;">原価金額</th>
                <td>@Html.TextBoxFor(model => Model.M_Anken_Excharge.GrossExcharge, "{0:N0}", new { @class = "form-control text-end", @style = "width: 70px; padding: 0;" })</td>
                <td>原価計算に加算されます</td>
              </tr>

              <tr>
                <th>非表示フラグ</th>
                <td class="">@Html.CheckBoxFor(model => Model.M_Anken_Excharge.HIDDEN_FLG, new { @class = "form-control text-left form-check-input" })</td>
                <td>オンにすると、登録時に選択不可。</td>
              </tr>
              <tr>
                <th>最終更新日</th>
                <td>@Convert.ToDateTime(Model.M_Anken_Excharge.UP_DATE).ToString("yyyy/MM/dd HH:mm:ss")</td>
                <td hidden>@Html.TextBoxFor(model => Model.M_Anken_Excharge.UP_DATE, null, new { @class = "form-control text-end" })</td>
              </tr>
            </tbody>
          </table>

        </form>
      </div>
    </div>
  </div>
</div>


<script>

  $(function () {

  });



  function regExec() {

    if (varidationCheck()) {
      return false;
    }

    //Formの参照を取る
    var $form = $('#form1');

    //alert($form.serialize());

    $.ajax({
          url: '@Url.RouteUrl("Default", new { controller = "Setting", Action = "AnkenExchargeRegExec" })',
          type: 'post',
          data: $form.serialize(),
        }).done(function (response) {
          if (response.errorMessage != null) {
              alertError(`【エラー】${response.errorMessage}`);
              return false;
          } else {
            closeModelAndRefresh();
            return false;
          }
        }).fail(function (xhr) {
          alert('【ネットワークエラー】:' + xhr);
            console.log(xhr);
            return false;
        }).always(function (xhr, msg) {
            console.log(xhr, msg);
        });

  }




  function varidationCheck() {

    if (!($('#M_Anken_Excharge_SIZE').val() != null && $('#M_Anken_Excharge_SIZE').val().length > 0)) {
      alert("車種サイズが入力されていません");
      $('#M_Anken_Excharge_SIZE').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#M_Anken_Excharge_SIZE').css('background-color', 'white');
    }

    if (!($('#M_Anken_Excharge_Komoku_Key').val() != null && $('#M_Anken_Excharge_Komoku_Key').val().length > 0)) {
      alert("項目キーが入力されていません");
      $('#M_Anken_Excharge_Komoku_Key').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#M_Anken_Excharge_Komoku_Key').css('background-color', 'white');
    }

    if (!($('#M_Anken_Excharge_Komoku_Name').val() != null && $('#M_Anken_Excharge_Komoku_Name').val().length > 0)) {
      alert("項目名称が入力されていません");
      $('#M_Anken_Excharge_Komoku_Name').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#M_Anken_Excharge_Komoku_Name').css('background-color', 'white');
    }

    if (!($('#M_Anken_Excharge_Komoku_Name_abbr').val() != null && $('#M_Anken_Excharge_Komoku_Name_abbr').val().length > 0)) {
      alert("略称が入力されていません");
      $('#M_Anken_Excharge_Komoku_Name_abbr').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#M_Anken_Excharge_Komoku_Name_abbr').css('background-color', 'white');
    }

    if ($('#M_Anken_Excharge_SortOrder').val() == 0) {
      if (varidationCheckForOverlap($('#M_Anken_Excharge_SIZE').val(), $('#M_Anken_Excharge_Komoku_Key').val())) {
        alert("入力の車種・型は既に登録されています");
        $('#M_Anken_Excharge_SIZE').css('background-color', 'lightcoral');
        $('#M_Anken_Excharge_Komoku_Key').css('background-color', 'lightcoral');
        return true;
      } else {
        $('#M_Anken_Excharge_SIZE').css('background-color', 'white');
        $('#M_Anken_Excharge_Komoku_Key').css('background-color', 'white');
      }
    }

    return false;

  };

</script>