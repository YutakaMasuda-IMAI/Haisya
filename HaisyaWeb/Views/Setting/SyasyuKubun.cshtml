@model SettingModel.SyasyuKubunDto

  @{
      Layout = "_LayoutForSettingWindow";

      //var listData = Model.SyasyuKubunList.OrderBy(m => m.SortOrder).ToList();
  }

<div id="content" class="container">
  <!-- 2秒間だけアラートを表示する -->
  <!--<div class="col-12">
    <div id="alert-1" class="lead"></div>
  </div>-->
  <div hidden>
    @Html.HiddenFor(model => Model.CompanyID)
  </div>
  <h2>
    <span class="glyphicon glyphicon-chevron-right"></span>車種区分設定
  </h2>

  <div id="main">
    @*<div class="setting-separator">車輌サイズリスト<span style="font-size: 12px; color: red;"> - 標準運賃計算に使用する「車種サイズ」を設定。</span></div>*@

    <div class="contents-wrap-middle">
      <h4 class="">使い方</h4>
      <span>
        <span style="background-color: #FF9966 ">・下記リストは乗務員に設定します。統計用に使用されます。</span><br>
        ・右側の上下「▲ ▼」ボタンで並び替えできます。<br>
        ・並び替え終了後は、最上部の「並び順変更反映」ボタンにて保存して下さい。<br>
        <span style="background-color: #FF9966 ">・同時に複数のユーザーが変更処理を実施するとデータが壊れたり、不整合が発生したりします。必ず１ユーザーのみで実施してください。</span>
      </span>
    </div>

    @{
      var listSyasyu = Model.SyaryoList.OrderBy(m => m.SortOrder).ToList();

      foreach (var itemSyasyu in listSyasyu)
      {
        var itemKata = Model.KataList.FirstOrDefault(m => m.Kata_ID == itemSyasyu.Kata_ID);

        if (itemKata != null)
        {
        <div class="clearfix">
          <h5 style="float: left;">@(itemSyasyu.SIZE) - @(itemKata.Kata_Display) (@(itemKata.Kata_ID))</h5>
          @if (Model.EditEnabled)
          {
            <button id="btnSortCommit-@(itemSyasyu.SIZE)-@(itemSyasyu.Kata_ID)" disabled class="btn btn-success" style="width: 200px;margin: 2px; float: right; margin-right: 40px; margin-left: 20px;" onclick="SortCommit_Click('@(itemSyasyu.SIZE)','@(itemSyasyu.Kata_ID)'); return false;">並び順変更反映</button>
            <button class="btn btn-primary" style="width: 200px; margin: 2px; float: right;" onclick="ExecShowDetailOnClick(0, '@(itemSyasyu.SIZE)','@(itemSyasyu.Kata_ID)'); return false;">新規登録</button>
          }
          <div id="option_attendance_setting" class="sight-settings">
            <div class="tables">
              <table id="tableMain_@(itemSyasyu.SIZE)_@(itemSyasyu.Kata_ID)" width="100%" class="table table-setting table-bordered border-info table-striped">
                <thead>
                  <tr align="center">
                    <th hidden>ID</th>
                    <th hidden>Company_ID</th>
                    <th>車種サイズ</th>
                    <th hidden>型ID</th>
                    <th>型</th>
                    <th>区分</th>
                    <th>並び順</th>
                    <th style="font-size:10px;">削除<br />フラグ</th>
                    <th>修正</th>
                    <th>並び順</th>
                  </tr>
                </thead>
                <tbody>
                  @{
                    var listData = Model.SyasyuKubunList.Where(m => m.SIZE == itemSyasyu.SIZE && m.Kata_ID == itemSyasyu.Kata_ID).OrderBy(m => m.SortOrder).ToList();
                    int i = 1;
                    foreach (var itemData in listData)
                    {
                      <tr id="@(i)-@(itemData.SIZE)-@(itemData.Kata_ID)">
                        <td hidden>@(itemData.SyasyuKubun_ID)</td>
                        <td hidden>@(itemData.Company_ID)</td>
                        <td align="center" width="200px">@(itemData.SIZE)</td>
                        <td hidden>@(itemData.Kata_ID)</td>
                        <td align="center" width="200px">@(itemKata.Kata_Display) (@(itemData.Kata_ID))</td>
                        <td align="center">@(itemData.KUBUN)</td>
                        <td align="center" width="80px">@(itemData.SortOrder)</td>
                        <td align="center" width="60px">@Html.CheckBoxFor(model => itemData.Del_Flg, new { @class = "form-control text-left form-check-input", @onclick = "return false;" })</td>
                        <td align="center" width="80px">
                          @if (Model.EditEnabled)
                          {
                            <button class="btn btn-outline-success" style="width: 100%; padding: 0; font-size: 12px; height: 30px;" onclick="ExecShowDetailOnClick('@(itemData.SyasyuKubun_ID)', '@(itemSyasyu.SIZE)','@(itemSyasyu.Kata_ID)'); return false;">詳細</button>
                          }
                        </td>
                        <td align="center" width="150px">
                          @if (Model.EditEnabled)
                          {
                            <input type="button" value="上" onclick="moveUp(this)">
                            <input type="button" value="下" onclick="moveDown(this)">
                          }
                        </td>
                      </tr>
                      i++;
                    }
                  }
                </tbody>
              </table>
            </div>
          </div>
        </div>
        }
      }
    }


  </div>

</div>

<script>

  function moveUp(obj1) {
    // tr行を取得
    var line1 = obj1.parentNode.parentNode;
    // 一番上の行のときは終了する
    if (line1.previousElementSibling === null) {
      alert("１番上の行です");
      return;
    }
    //　行のIDを取得し移動
    var id = line1.id;
    $("#" + id).insertBefore(line1.previousElementSibling);

    a = id.substring(0, id.indexOf("-"));
    var idNameTail = id.substring(id.indexOf("-"));

    var idMinus = (Number(a) - 1).toString() + idNameTail;
    var line2 = document.getElementById(idMinus);

    var idNew = line2.cells[6].innerHTML;
    var idBefore = line1.cells[6].innerHTML

    line2.cells[6].innerHTML = idBefore;
    line1.cells[6].innerHTML = idNew;

    line2.id = a;
    line1.id = idMinus;

    document.getElementById("btnSortCommit" + idNameTail).disabled = null;

  }
  function moveDown(obj1) {
    // tr行を取得
    var line1 = obj1.parentNode.parentNode;
    // 一番下の行のときは終了する
    if (line1.nextElementSibling === null) {
      alert("１番下の行です");
      return;
    }
    //　行のIDを取得し移動
    var id = line1.id;
    $("#" + id).insertAfter(line1.nextElementSibling);

    a = id.substring(0, id.indexOf("-"));
    var idNameTail = id.substring(id.indexOf("-"));

    var idPlus = (Number(a) + 1).toString() + idNameTail;
    var line2 = document.getElementById(idPlus);

    var idNew = line2.cells[6].innerHTML;
    var idBefore = line1.cells[6].innerHTML

    line2.cells[6].innerHTML = idBefore;
    line1.cells[6].innerHTML = idNew;

    line2.id = a;
    line1.id = idPlus;

    document.getElementById("btnSortCommit" + idNameTail).disabled = null;
  }

  function ExecShowDetailOnClick(paramID, paramSize, paramKataID) {

    var btnName = "btnSortCommit-" + paramSize + "-" + paramKataID;

    if (false == document.getElementById(btnName).disabled) {
      var result = window.confirm('並び順を変更しています。先に登録しないと変更内容が消えます。登録しますか？');
      if (result) { alert("「並び順変更反映」ボタンを押してください。"); return false; }
    }
    CommonWaitStart();
    $.post('@Url.RouteUrl("Default", new { controller = "Setting", Action = "SyasyuKubunModal" })',
      {
        SyasyuKubunID: paramID,
        Size: paramSize,
        KataID: paramKataID,
      })
      .done(function (response) {
        if (response.message != null) {
            alertError(`【エラー】${response.message}`);
            return false;
        } else {
          //alert("【done】" + response.partialView);
          $("#ModalHere").html(response.partialView);
          $("#ModalHere").find('.modal').modal('show');
          return false;
        }
      })
      .fail(function (xhr) {
          console.log(xhr);
      })
      .always(function (xhr, msg) {
        CommonWaitEnd();
      });
  };

  function closeModel() {
    $('#ModalHere').find('.modal').modal('hide');
    $("#ModalHere").html('');
  };

  function closeModelAndRefresh() {
    $('#ModalHere').find('.modal').modal('hide');
    location.reload();
/*    document.getElementById("btnSortCommit").disabled = "disabled";*/
    alert("登録が完了しました。");
  };


  function SortCommit_Click(paramSize, paramKataID) {
    CommonWaitStart();
    var idName = "tableMain_" + paramSize + "_" + paramKataID;
    var btnName = "btnSortCommit-" + paramSize + "-" + paramKataID;

    // table要素を取得
    var tableElem = document.getElementById(idName);

    // 行（tr要素）を取得
    var rowElems = tableElem.rows;

    // 取得した行（tr要素）を繰り返しHTMLを取得
    var htmlStr = '';
    for (i = 1, len = rowElems.length; i < len; i++) {
      htmlStr += "    <tr>";
      htmlStr += "      <td><input name='SyasyuKubunList[" + (i - 1).toString() + "].SyasyuKubun_ID' value='" + rowElems[i].cells[0].innerHTML + "' /></td>";
      htmlStr += "      <td><input name='SyasyuKubunList[" + (i - 1).toString() + "].SortOrder' value='" + rowElems[i].cells[6].innerHTML + "' /></td>";
      htmlStr += "    </tr>";
    }

    var html = "";
    html += "<form id='sortData'>";
    html += "<div hidden>";
    html += "  <input name='CompanyID' value='" + $('#CompanyID').val() + "' />";
    html += "</div >";
    html += "<table>";
    html += "  <tbody>";
    html += htmlStr;
    html += "  </tbody>";
    html += "</table>";
    html += "</form >";

    //alert(html);

    $("#SortHere").html(html);

    //alert(htmlStr);
    document.getElementById(btnName).disabled = "disabled";

    //Formの参照を取る
    var $form = $('#sortData');

    $.ajax({
        url: '@Url.RouteUrl("Default", new { controller = "Setting", Action = "SyasyuKubunListSortCommit" })',
        type: 'post',
        data: $form.serialize(),
      }).done(function (response) {
        if (response.errorMessage != null) {
          alert("【エラー】" + response.errorMessage, 'warning');
          return false;
        } else {
          if (response.retrunFlg) {
            alertInfo('正常に登録出来ました。', 'success');
          } else {
            alertError('登録に失敗しました。原因不明。');
          }
          return false;
        }
      }).fail(function (xhr) {
        alert('【ネットワークエラー】:' + xhr, 'warning');
          console.log(xhr);
          return false;
      }).always(function (xhr, msg) {
        CommonWaitEnd();
      });

  };

  function varidationCheckForOverlap(Size, KataID, Kubun) {

    var idName = "tableMain_" + Size + "_" + KataID;

    // table要素を取得
    var tableElem = document.getElementById(idName);

    // 行（tr要素）を取得
    var rowElems = tableElem.rows;

    // 取得した行（tr要素）を繰り返しHTMLを取得
    var htmlStr = '';
    for (i = 1, len = rowElems.length; i < len; i++) {
      var SizeA = rowElems[i].cells[2].innerHTML;
      var KataA = rowElems[i].cells[3].innerHTML;
      var KubunA = rowElems[i].cells[5].innerHTML;

      if (SizeA == Size && KataA == KataID && KubunA == Kubun) {
        return true;
      }
    }

    return false;

  };

</script>