@model SettingModel.KataModalDto

  @{
      Layout = "_LayoutForSettingModal";
  }

<style>
/*  .float-left {
    float: left;
    padding: 0.5em 1em;
    margin: 2em 0;
    background: #f0f7ff;
    border: dashed 2px #5b8bd0;
  }

  .float-right {
    float: right;
    padding: 0.5em 1em;
    margin: 2em 0;
    background: #f0f7ff;
    border: dashed 2px #5b8bd0;
  }*/

  .readonly {
    background-color: lightgray;
  }

</style>



  <div role="dialog" aria-hidden="true" tabindex="-1" class="modal fade" style="z-index: 1240;" data-backdrop="static" aria-labelledby="exampleModalCenterTitle">
    <div class="modal-dialog modal-dialog-centered" role="document" style="max-width:650px;">
      <div class="modal-content">
        <div class="modal-header" style="background-color: gainsboro;">
          <h1 class="modal-title fs-3" id="exampleModalLabel">@(Model.Title)</h1>
          <button type="button" class="btn btn-primary" onclick="regExec(); return false;">@(Model.BtnCaption)</button>
          <button type="button" class="btn btn-secondary" onclick="closeModel(); return false;">閉じる</button>
        </div>
        <div class="model-body">
          <form id="form1">
            <div id="hidden" hidden>
              @Html.HiddenFor(model => Model.BtnCaption)
              @Html.HiddenFor(model => Model.Title)
            </div>
            <div class="contents-wrap-middle" style="margin: 10px;">
              <h4 class="">注意</h4>
              <span>
                ・一度データを登録すると物理削除は出来ません。「非表示フラグ」を立ててください。
              </span>
            </div>
            <div>
              <table class="table table-striped-columns table-bordered border-primary" border="1" style="margin: 10px; width:95%;">
                <tbody>
                  <tr hidden>
                    <th width="200px">会社ID</th>
                    <td width="300px">@Html.TextBoxFor(model => Model.KataData.Company_ID, null, new { @class = "form-control text-end", @onblur = "", @style = "width: 100px;" })</td>
                    <td width="200px"></td>
                  </tr>
                  <tr hidden>
                    <th width="200px">並び順</th>
                    <td width="300px">@Html.TextBoxFor(model => Model.KataData.SortOrder, null, new { @class = "form-control text-end", @onblur = "", @style = "width: 100px;" })</td>
                    <td></td>
                  </tr>
                  <tr style="vertical-align: middle;">
                    <th>型キー</th>
                    @if (Model.KataData.SortOrder == 0)
                    {
                      <td>@Html.TextBoxFor(model => Model.KataData.Kata_ID, null, new { @class = "form-control", @style = "width: 50%;", @onblur = "toHalfWidth(this);" })</td>
                    }
                    else
                    {
                      <td>@Html.TextBoxFor(model => Model.KataData.Kata_ID, null, new { @readonly = "readonly", @class = "form-control readonly", @style = "width: 50%;" })</td>
                    }
                    <td></td>
                  </tr>
                  <tr style="vertical-align: middle;">
                    <th>型表示</th>
                    <td>@Html.TextBoxFor(model => Model.KataData.Kata_Display, null, new { @class = "form-control", @style = "width: 90%;" })</td>
                    <td></td>
                  </tr>
                  <tr style="vertical-align: middle;">
                    <th>備考</th>
                    <td colspan="2">@Html.TextBoxFor(model => Model.KataData.Remarks, null, new { @class = "form-control", @style = "width: 90%;" })</td>
                  </tr>
                  <tr>
                    <th>非表示フラグ</th>
                    <td class="">@Html.CheckBoxFor(model => Model.KataData.Del_Flg, new { @class = "form-control text-left form-check-input", @style = "height: 20px;" })</td>
                    <td>オンにすると、登録時に選択不可。</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>



<script>

  $(function () {

    setTimeout(function () {
      $('.modal-backdrop')
        .not('.modal-stack')
        .css('z-index', 1239)
        .addClass('modal-stack');
    }, 0);

  });

  function regExec() {

    if (varidationCheck()) {
      return false;
    }

    //Formの参照を取る
    var $form = $('#form1');

    //alert($form.serialize());

    $.ajax({
          url: '@Url.RouteUrl("Default", new { controller = "Setting", Action = "KataRegExec" })',
          type: 'post',
          data: $form.serialize(),
        }).done(function (response) {
          if (response.errorMessage != null) {
              alertError(`【エラー】${response.errorMessage}`);
              return false;
          } else {
            closeModelAndRefresh();
            return false;
          }
        }).fail(function (xhr) {
          alert('【ネットワークエラー】:' + xhr);
            console.log(xhr);
            return false;
        }).always(function (xhr, msg) {
            console.log(xhr, msg);
        });

  };

  function varidationCheck() {

    if (!($('#KataData_Kata_ID').val() != null && $('#KataData_Kata_ID').val().length > 0)) {
      alert("型キーが入力されていません");
      $('#KataData_Kata_ID').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#KataData_Kata_ID').css('background-color', 'white');
    }

    if (!($('#KataData_Kata_Display').val() != null && $('#KataData_Kata_Display').val().length > 0)) {
      alert("型表示が入力されていません");
      $('#KataData_Kata_Display').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#KataData_Kata_Display').css('background-color', 'white');
    }
    
    if ($('#KataData_SortOrder').val() == 0) {
      if (varidationCheckForOverlap($('#KataData_Kata_ID').val())) {
        alert("入力の型キーは既に登録されています");
        $('#KataData_Kata_ID').css('background-color', 'lightcoral');
        return true;
      } else {
        $('#KataData_Kata_ID').css('background-color', 'white');
      }
      if (varidationCheckForOverlapForName($('#KataData_Kata_Display').val())) {
        alert("入力の型表示は既に登録されています");
        $('#KataData_Kata_Display').css('background-color', 'lightcoral');
        return true;
      } else {
        $('#KataData_Kata_Display').css('background-color', 'white');
      }
    }
    return false;

  };






</script>