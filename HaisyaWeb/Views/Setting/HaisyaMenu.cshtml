@{
    Layout = "MasterData3Menu";
}

<div id="content" style="font-size: 14px;">
  <h2>
    <span class="glyphicon glyphicon-chevron-right"></span>配車設定
  </h2>
  <div id="contents">

    <div id="menu_01" class=" clearfix">
      <div class="setting-separator">配車管理<span style="font-size: 12px; color: red;"></span></div>
      <div id="option_attendance_setting" class="sight-settings">
        <div class="title">
          配車グループ
          <br>
        </div>
        <div class="buttons" style="padding: 5px 10px;">
          <a asp-area="" asp-controller="Setting" asp-action="CompanyUserGroup" asp-route-GroupKubun="1" target="_blank">設定画面</a>
        </div>
        <div class="description">
          <div style="min-width:305px;">
            配車担当を行うグループを設定
          </div>
        </div>
      </div>

      <div id="option_attendance_setting" class="sight-settings">
        <div class="title">
          専属設定
          <br>
        </div>
        <div class="buttons" style="padding: 5px 10px;">
          <a asp-area="" asp-controller="Setting" asp-action="SenzokuIndex" target="_blank">設定画面</a>
        </div>
        <div class="description">
          <div style="min-width:305px;">
            専属情報と乗務員を設定
          </div>
        </div>
      </div>

    </div>

    <div id="menu_02" class=" clearfix">
      <div class="setting-separator">車輌管理<span style="font-size: 12px; color: red;"></span></div>
      
      <div id="option_attendance_setting" class="sight-settings">
        <div class="title">
          車種区分
          <br>
        </div>
        <div class="buttons" style="padding: 5px 10px;">
          <a asp-area="" asp-controller="Setting" asp-action="SyasyuKubun" target="_blank">設定画面</a>
        </div>
        <div class="description">
          <div style="min-width:305px;">
            統計や目標設定に使用する乗務員の区分設定
          </div>
        </div>
      </div>

    </div>

  </div>
  <div id="scrollspy" class="bg-white clearfix">
    <nav id="navbar" class="fixed">
      <div class="setting-separator" style="width:250px;">項目メニュー</div>
      <ul class="nav nav-list">
        <li class="nav-btn active"><a href="#menu_01">配車管理</a></li>
        <li class="nav-btn"><a href="#menu_02">車輌管理</a></li>
        <li class="nav-btn"><a href="#menu_03">〇〇設定</a></li>
      </ul>
      <hr>
      <div class="btn-block">
        <input type="submit" class="btn btn-warning" style="text-decoration: none; float:left; margin-left:10px" value="設定を保存">
      </div>
    </nav>
  </div>
</div>


<script>

  $(function () {

    let tabs = $('.sub-btn'); // tabのクラスを全て取得し、変数tabsに配列で定義
    $('.sub-btn').removeClass('active');
    $('#tabHaisyaMenu').addClass('active');



  });


</script>