@model HaisyaWeb.Models.SettingModel.CompanyDto

@{
    Layout = "MasterData1Menu";

    var listData = Model.M_CompanyBranchList.OrderBy(m => m.SortOrder).ToList();
}

<style>
  .readonly {
    background-color: lightgray;
  }
</style>

<!--<div>-->
  @*//モダール表示用のスペースを追加*@
  <!--<div id="ModalHere" data-keyboard="false" data-backdrop="static"></div>
  <div id="SortHere" hidden></div>
</div>-->


<div id="content" style="font-size: 14px;">
  <h2>
    <span class="bi bi-chevron-right"></span>会社情報設定
  </h2>
  @using (Html.BeginForm("CompanyRegExec", "Setting", FormMethod.Post, new { id = "Form1" }))
  {
    <div hidden>
      @Html.HiddenFor(model => Model.CompanyID)
      @Html.HiddenFor(model => Model.EditEnabled)
    </div>
    <div id="contents">

      <div id="menu_01" class="clearfix">

        <div class="setting-separator">会社情報<span style="font-size: 12px; color: red;"></span></div>

        @*<div class="contents-wrap-middle">
            <h5 class="">使い方</h5>
            <span>
              <span style="background-color: #FF9966 ">・同時に複数のユーザーが変更処理を実施するとデータが壊れたり、不整合が発生したりします。必ず１ユーザーのみで実施してください。</span>
            </span>
          </div>*@

        <div class="clearfix">
          @if (Model.EditEnabled)
          {
            <button type="button" class="btn btn-primary" style="width: 200px;margin: 2px;" onclick="CompanyRegExec(); return false;">更新</button>
          }
          <div id="option_attendance_setting" class="company-settings">
            <div class="title">
              会社ID：
              <br>
            </div>
            <div class="buttons" style="padding: 5px 10px;">
              @Html.TextBoxFor(Model => Model.M_Company.Company_ID, null, new { @readonly = "readonly", @class = "form-control text-center readonly", @style = "width:50px;" })
            </div>
            <div class="description">
              <div style="min-width:305px;">

              </div>
            </div>
          </div>
          <div id="option_attendance_setting" class="company-settings">
            <div class="title">
              会社コード：
              <br>
            </div>
            <div class="buttons" style="padding: 5px 10px;">
              @Html.TextBoxFor(Model => Model.M_Company.Company_Code, null, new { @class = "form-control text-left", @style = "" })
            </div>
            <div class="description">
              <div style="min-width:305px;">

              </div>
            </div>
          </div>
          <div id="option_attendance_setting" class="company-settings">
            <div class="title">
              会社名：
              <br>
            </div>
            <div class="buttons" style="padding: 5px 10px;">
              @Html.TextBoxFor(Model => Model.M_Company.Company_Name, null, new { @class = "form-control text-left", @style = "" })
            </div>
            <div class="description">
              <div style="min-width:305px;">

              </div>
            </div>
          </div>
          <div id="option_attendance_setting" class="company-settings">
            <div class="title">
              会社名(略称)：
              <br>
            </div>
            <div class="buttons" style="padding: 5px 10px;">
              @Html.TextBoxFor(Model => Model.M_Company.Company_Name_Abbr, null, new { @class = "form-control text-left", @style = "" })
            </div>
            <div class="description">
              <div style="min-width:305px;">

              </div>
            </div>
          </div>
          <div id="option_attendance_setting" class="company-settings">
            <div class="title">
              郵便番号：
              <br>
            </div>
            <div class="buttons" style="padding: 5px 10px;">
              <div style="display: flex;">
                @Html.TextBoxFor(Model => Model.M_Company.Post1, null, new { @class = "form-control text-center", @style = "width: 60px; margin-right: 10px;" })
                <label style="align-self: center;font-weight: bolder;">―</label>
                @Html.TextBoxFor(Model => Model.M_Company.Post2, null, new { @class = "form-control text-center", @style = "width: 70px; margin-left: 10px;" })
              </div>
            </div>
            <div class="description">
              <div style="min-width:305px;">

              </div>
            </div>
          </div>
          <div id="option_attendance_setting" class="company-settings">
            <div class="title">
              住所：
              <br>
            </div>
            <div class="buttonsCol2" style="padding: 5px 10px;">
              @Html.TextBoxFor(Model => Model.M_Company.Address, null, new { @class = "form-control text-left", @style = "width: 90%;" })
            </div>
          </div>
          <div id="option_attendance_setting" class="company-settings">
            <div class="title">
              電話番号：
              <br>
            </div>
            <div class="buttons" style="padding: 5px 10px;">
              @Html.TextBoxFor(Model => Model.M_Company.Phone, null, new { @class = "form-control text-left", @style = "width: 200px;" })
            </div>
            <div class="description">
              <div style="min-width:305px;">
                "-"（ハイフン）付きで半角数値で入力してください。<br />(例:03-999-9999)
              </div>
            </div>
          </div>
          <div id="option_attendance_setting" class="company-settings">
            <div class="title">
              FAX番号：
              <br>
            </div>
            <div class="buttons" style="padding: 5px 10px;">
              @Html.TextBoxFor(Model => Model.M_Company.Fax, null, new { @class = "form-control text-left", @style = "width: 200px;" })
            </div>
            <div class="description">
              <div style="min-width:305px;">
                "-"（ハイフン）付きで半角数値で入力してください。<br />(例:03-999-9999)
              </div>
            </div>
          </div>
        </div>

      </div>

      <div id="menu_02" class="clearfix">
        <div class="setting-separator">支社・営業所・事業所<span style="font-size: 12px; color: red;"></span></div>
        <div id="option_attendance_setting" class="company-settings">
          <div class="clearfix">
            @if (Model.EditEnabled)
            {
              <button type="button" class="btn btn-primary" style="width: 200px;margin: 2px;" onclick="ExecShowModalOnClick('0'); return false;">新規登録</button>
              <button type="button" id="btnSortCommit" disabled class="btn btn-success" style="width: 200px;margin: 2px; float: right; margin-right: 40px;" onclick="SortCommit_Click(); return false;">並び順変更反映</button>
            }
            <div id="option_attendance_setting" class="sight-settings">
              <div class="tables">
                <table id="tableMain" width="100%" class="table table-setting table-bordered border-info table-striped" style="">
                  <thead>
                    <tr align="center">
                      <th hidden>Company_ID</th>
                      <th hidden>Branch_ID</th>
                      <th hidden>Oya_Branch_ID</th>
                      <th class="vertical" align="center" valign="middle" style="font-size: 12px; margin: 0;">並び順</th>
                      <th>コード</th>
                      <th>名称</th>
                      <th>略名</th>
                      <th>更新日時</th>
                      <th style="font-size: 12px; margin: 0;">非表示</th>
                      <th>修正</th>
                      <th>並び順</th>
                    </tr>
                  </thead>
                  <tbody>
                    @{
                      int i = 1;
                      foreach (var itemData in listData)
                      {
                                        <tr id="@(i)">
                                          <td hidden>@(itemData.Company_ID)</td>
                                          <td hidden>@(itemData.Branch_ID)</td>
                                          <td hidden>@(itemData.Oya_Branch_ID)</td>
                                          <td align="center" width="30px">@(itemData.SortOrder)</td>
                                          <td align="center" width="100px">@(itemData.Branch_Code)</td>
                                          <td width="320px">@(itemData.Branch_Name)</td>
                                          <td width="250px">@(itemData.Branch_Name_Abbr)</td>
                                          <td align="center" width="200px">@Convert.ToDateTime(itemData.UP_DATE).ToString("yyyy/MM/dd HH:mm:ss")</td>
                                          <td align="center" width="20px">@Html.CheckBoxFor(model => itemData.Del_Flg, new { @readonly = "readonly", @class = "form-control text-left form-check-input", @onclick = "return false;" })</td>
                                          <td align="center" width="100px" style="margin: 0; vertical-align: middle; ">
                                            @if (Model.EditEnabled)
                                            {
                                              <button type="button" class="btn btn-outline-success" style="width: 100%; padding: 0; font-size: 12px; height: 30px; " onclick="ExecShowModalOnClick('@(itemData.Branch_ID)'); return false;">詳細</button>
                                            }
                                          </td>
                                          <td align="center" width="130px" style="margin: 0; padding: 0; vertical-align: middle; ">
                                            @if (Model.EditEnabled)
                                            {
                                              <input type="button" value="上" onclick="moveUp(this)">
                                              <input type="button" value="下" onclick="moveDown(this)">
                                            }
                                          </td>
                                        </tr>
                        i++;
                      }
                    }
                  </tbody>
                </table>
              </div>
            </div>
          </div>


        </div>
      </div>
    </div>
    <div id="scrollspy" class="bg-white clearfix">
      <nav id="navbar" class="fixed">
        <div class="setting-separator" style="width:250px;">項目メニュー</div>
        <ul class="nav nav-list">
          <li class="nav-btn active"><a href="#menu_01">会社情報</a></li>
          <li class="nav-btn"><a href="#menu_02">支社・営業所・事業所</a></li>
        </ul>
        <hr>
        @*@if (Model.EditEnabled)
          {
            <div class="btn-block">
              <input type="submit" class="btn btn-warning" style="text-decoration: none; float:left; margin-left:10px" value="設定を保存">
            </div>
          }*@
      </nav>
    </div>
  }
</div>


<script>

  $(function () {

    let tabs = $('.sub-btn'); // tabのクラスを全て取得し、変数tabsに配列で定義
    $('.sub-btn').removeClass('active');
    $('#tabCompanyMenu').addClass('active');



  });

  function moveUp(obj1) {
    // tr行を取得
    var line1 = obj1.parentNode.parentNode;
    // 一番上の行のときは終了する
    if (line1.previousElementSibling === null) {
      alert("１番上の行です");
      return;
    }
    //　行のIDを取得し移動
    a = line1.id;
    $("#" + a).insertBefore(line1.previousElementSibling);

    var idMinus = (Number(a) - 1).toString();
    var line2 = document.getElementById(idMinus);

    var idNew = line2.cells[3].innerHTML;
    var idBefore = line1.cells[3].innerHTML

    line2.cells[3].innerHTML = idBefore;
    line1.cells[3].innerHTML = idNew;

    line2.id = a;
    line1.id = idMinus;

    document.getElementById("btnSortCommit").disabled = null;

  };

  function moveDown(obj1) {
    // tr行を取得
    var line1 = obj1.parentNode.parentNode;
    // 一番下の行のときは終了する
    if (line1.nextElementSibling === null) {
      alert("１番下の行です");
      return;
    }
    //　行のIDを取得し移動
    a = line1.id;
    $("#" + a).insertAfter(line1.nextElementSibling);

    var idPlus = (Number(a) + 1).toString();
    var line2 = document.getElementById(idPlus);

    var idNew = line2.cells[3].innerHTML;
    var idBefore = line1.cells[3].innerHTML

    line2.cells[3].innerHTML = idBefore;
    line1.cells[3].innerHTML = idNew;

    line2.id = a;
    line1.id = idPlus;

    document.getElementById("btnSortCommit").disabled = null;
  };

  function ExecShowModalOnClick(paramBranchID) {

    //alert(document.getElementById("btnSortCommit").disabled);

    if (false == document.getElementById("btnSortCommit").disabled) {
      var result = window.confirm('並び順を変更しています。先に登録しないと変更内容が消えます。登録しますか？');
      if (result) { alert("「並び順変更反映」ボタンを押してください。"); return false; }
    }

    $.post('@Url.RouteUrl("Default", new { controller = "Setting", Action = "CompanyBranchModal" })',
      {
        BranchID: paramBranchID,
      })
      .done(function (response) {
        if (response.message != null) {
            alertError(`【エラー】${response.message}`);
            return false;
        } else {
          //alert("【done】" + response.partialView);
          $("#ModalHere").html(response.partialView);
          $("#ModalHere").find('.modal').modal('show');
          return false;
        }
      })
      .fail(function (xhr) {
          console.log(xhr);
      })
      //.always(function (xhr, msg) {
      //    console.log(xhr, msg);
      //});
  };

  function closeModel() {
    $('#ModalHere').find('.modal').modal('hide');
    //$('#ModalHere').modal('hide');
    $("#ModalHere").html('');
  };

  function closeModelAndRefresh() {
    $('#ModalHere').find('.modal').modal('hide');
    //$('#ModalHere').modal('hide');
    location.reload();
    document.getElementById("btnSortCommit").disabled = "disabled";
    alert("登録が完了しました。");
  };

  function CompanyRegExec() {

     //Formの参照を取る
    var $form = $('#Form1');

    //alert($form.serialize());

    $.ajax({
        url: '@Url.RouteUrl("Default", new { controller = "Setting", Action = "CompanyRegExec" })',
        type: 'post',
        data: $form.serialize(),
      }).done(function (response) {
        if (response.errorMessage != null && response.errorMessage !== '') {
          alert("【エラー】" + response.errorMessage, 'warning');
          return false;
        } else {
          if (response.retrunFlg) {
            alert('正常に登録出来ました。', 'success');
          } else {
            alert('登録に失敗しました。原因不明。', 'warning');
          }
          return false;
        }
      }).fail(function (xhr) {
        alert('【ネットワークエラー】:' + xhr, 'warning');
          console.log(xhr);
          return false;
      }).always(function (xhr, msg) {
          //console.log(xhr, msg);
      });
  };

  function SortCommit_Click() {

    // table要素を取得
    var tableElem = document.getElementById('tableMain');

    // 行（tr要素）を取得
    var rowElems = tableElem.rows;

    // 取得した行（tr要素）を繰り返しHTMLを取得
    var htmlStr = '';
    for (i = 1, len = rowElems.length; i < len; i++) {
      htmlStr += "    <tr>";
      htmlStr += "      <td><input name='M_CompanyBranchList[" + (i - 1).toString() + "].SortOrder' value='" + rowElems[i].cells[3].innerHTML + "' /></td>";
      htmlStr += "      <td><input name='M_CompanyBranchList[" + (i - 1).toString() + "].Branch_ID' value='" + rowElems[i].cells[1].innerHTML + "' /></td>";
      htmlStr += "      <td><input name='M_CompanyBranchList[" + (i - 1).toString() + "].Company_ID' value='" + rowElems[i].cells[0].innerHTML + "' /></td>";
      htmlStr += "    </tr>";
    }

    var html = "";
    html += "<form id='sortData'>";
    html += "<div hidden>";
    html += "  <input name='CompanyID' value='" + $('#CompanyID').val() + "' />";
    html += "</div >";
    html += "<table>";
    html += "  <tbody>";
    html += htmlStr;
    html += "  </tbody>";
    html += "</table>";
    html += "</form >";

    $("#SortHere").html(html);

    //alert(htmlStr);
    document.getElementById("btnSortCommit").disabled = "disabled";

    //Formの参照を取る
    var $form = $('#sortData');

    $.ajax({
        url: '@Url.RouteUrl("Default", new { controller = "Setting", Action = "CompanyBranchListSortCommit" })',
        type: 'post',
        data: $form.serialize(),
      }).done(function (response) {
        if (response.errorMessage != null) {
          alert("【エラー】" + response.errorMessage, 'warning');
          return false;
        } else {
          if (response.retrunFlg) {
            alert('正常に登録出来ました。', 'success');
          } else {
            alert('登録に失敗しました。原因不明。', 'warning');
          }
          return false;
        }
      }).fail(function (xhr) {
        alert('【ネットワークエラー】:' + xhr, 'warning');
          console.log(xhr);
          return false;
      }).always(function (xhr, msg) {
          //console.log(xhr, msg);
      });

  };

  function varidationCheckForOverlap(branchName, branchID) {

    // table要素を取得
    var tableElem = document.getElementById('tableMain');

    // 行（tr要素）を取得
    var rowElems = tableElem.rows;


    // 取得した行（tr要素）を繰り返しHTMLを取得
    var htmlStr = '';
    for (i = 1, len = rowElems.length; i < len; i++) {

      var branchNameA = rowElems[i].cells[6].innerHTML;
      var branchIDA = rowElems[i].cells[1].innerHTML;

      //alert(branchName + ";;;;" + branchID);
      //alert(branchNameA + ";;;;" + branchIDA);

      if (branchNameA == branchName && branchIDA != branchID) {
        return true;
      }
    }

    return false;

  };


</script>