@model SettingModel.LoginUserRoleDto

@{
  Layout = "_LayoutForSettingWindow";

  var listData = Model.LoginUserRoleList.OrderBy(m => m.Role).ToList();
}

<div id="content">
  <!-- 2秒間だけアラートを表示する -->
  <!--<div class="col-12">
    <div id="alert-1" class="lead"></div>
  </div>-->
  <div hidden>
    @Html.HiddenFor(model => Model.CompanyID)
  </div>
  <h2>
    <span class="bi bi-chevron-right"></span>権限設定
  </h2>

  <div id="main">
    <div class="setting-separator">権限一覧<span style="font-size: 12px; color: red;"> - 権限マスタを設定。</span></div>

    <div class="contents-wrap-middle">
      <h4 class="">使い方</h4>
      <span>
        <span style="background-color: #FF9966 ">・同時に複数のユーザーが変更処理を実施するとデータが壊れたり、不整合が発生したりします。必ず１ユーザーのみで実施してください。</span>
      </span>
    </div>

    <div class="clearfix">
      @if (Model.EditEnabled)
      {
        <button type="button" class="btn btn-primary" style="width: 200px;margin: 2px;" onclick="ExecShowDetailOnClick('新規', ''); return false;">新規登録</button>
      }

      <div id="option_attendance_setting" class="sight-settings">
        <div class="tables">
          <table id="tableMain" width="100%" class="table table-setting table-bordered border-info table-striped">
            <thead>
              <tr align="center">
                <th>ロールID</th>
                <th hidden>会社ID</th>
                <th>ロール名称</th>
                <th>更新日</th>
                <th>非表示</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              @{
                int i = 1;
                foreach (var item in listData)
                {
                  <tr id="@(i)">
                    <td align="center" width="70px">@(item.Role)</td>
                    <td align="center" width="100px" hidden>@(item.Company_ID)</td>
                    <td align="center" width="400px">@(item.RoleName)</td>
                    <td align="center" width="190px">@Convert.ToDateTime(item.UP_DATE).ToString("yyyy/MM/dd HH:mm:ss")</td>
                    <td align="center" width="80px">@Html.CheckBoxFor(model => item.Del_Flg, new { @class = "form-control text-left form-check-input", @onclick = "return false;" })</td>
                    <td align="center" width="90px" style="margin: 0; vertical-align: middle; ">
                      @if (Model.EditEnabled)
                      {
                        <button type="button" class="btn btn-outline-success" style="width: 100%; padding: 0; font-size: 12px; height: 30px; " onclick="ExecShowDetailOnClick('@(item.Role)'); return false;">詳細</button>
                      }
                    </td>
                  </tr>
                  i++;
                }
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!--<div>-->
  @*//モダール表示用のスペースを追加*@
  <!--<div id="ModalHere" data-keyboard="false" data-backdrop="static"></div>
  <div id="SortHere" hidden></div>
</div>-->

<script>

  function closeModel() {
    $('#ModalHere').find('.modal').modal('hide');
    //$('#ModalHere').modal('hide');
    $("#ModalHere").html('');
  };

  function closeModelAndRefresh() {
    $('#ModalHere').find('.modal').modal('hide');
    //$('#ModalHere').modal('hide');
    location.reload();
    document.getElementById("btnSortCommit").disabled = "disabled";
    alert("登録が完了しました。");
  };


  function ExecShowDetailOnClick(paramRole) {

    //alert(document.getElementById("btnSortCommit").disabled);

    $.post('@Url.RouteUrl("Default", new { controller = "Setting", Action = "LoginUserRoleModal" })',
      {
        Role: paramRole,
      })
      .done(function (response) {
        if (response.message != null) {
            alertError(`【エラー】${response.message}`);
            return false;
        } else {
          //alert("【done】" + response.partialView);
          $("#ModalHere").html(response.partialView);
          $("#ModalHere").find('.modal').modal('show');
          return false;
        }
      })
      .fail(function (xhr) {
          console.log(xhr);
      })
      .always(function (xhr, msg) {
          console.log(xhr, msg);
      });
  };


  function varidationCheckForOverlap(roleName) {

    // table要素を取得
    var tableElem = document.getElementById('tableMain');

    // 行（tr要素）を取得
    var rowElems = tableElem.rows;

    // 取得した行（tr要素）を繰り返しHTMLを取得
    var htmlStr = '';
    for (i = 1, len = rowElems.length; i < len; i++) {

      var roleNameA = rowElems[i].cells[2].innerHTML;

      //alert(syasyu + ";;;;" + kata);
      //alert(syasyuA + ";;;;" + kataA);

      if (roleNameA == roleName) {
        return true;
      }
    }

    return false;

  };
</script>
