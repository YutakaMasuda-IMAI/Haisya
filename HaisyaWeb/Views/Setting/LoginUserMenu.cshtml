@model HaisyaWeb.Models.SettingModel.LoginUserMenuDto

@{
    Layout = "MasterData1Menu";

    var listRoleData = Model.LoginUserRoleList.OrderBy(m => m.Role).ToList();
}


<div id="content" style="font-size: 14px;">
  <h2>
    <span class="glyphicon glyphicon-chevron-right"></span>ログイン・権限設定
  </h2>

  <div id="contents">
    <div hidden>
      @Html.HiddenFor(model => Model.CompanyID)
      @Html.HiddenFor(model => Model.EditEnabled)
    </div>
    <div id="menu_01" class="clearfix">
      <div class="setting-separator">権限設定<span style="font-size: 12px; color: red;"></span></div>
      <div id="option_attendance_setting" class="sight-settings">
        <div class="title">
          権限一覧情報
          <br>
        </div>
      <div class="buttons" style="padding: 5px 10px;">
        <a asp-area="" asp-controller="Setting" asp-action="LoginUserRole" target="_blank">設定画面</a>
      </div>
      <div class="description">
        <div style="min-width:305px;">
          権限一覧を設定
        </div>
      </div>
    </div>

