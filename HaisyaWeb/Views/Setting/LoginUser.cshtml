@model HaisyaWeb.Models.SettingModel.LoginUserMenuDto

@{

  var listData = Model.LoginUserList.OrderBy(m => m.Employee_Number).ToList();
}



<div class="setting-separator">ログインユーザ情報<span style="font-size: 12px; color: red;"></span></div>

<div class="contents-wrap-middle">
  <h4 class="">使い方</h4>
  <span>
    <span style="background-color: #FF9966 ">・同時に複数のユーザーが変更処理を実施するとデータが壊れたり、不整合が発生したりします。必ず１ユーザーのみで実施してください。</span>
  </span>
</div>

<div class="clearfix">
  @if (Model.EditEnabled)
  {
    <button type="button" class="btn btn-primary" style="width: 200px;margin: 2px;" onclick="ExecShowDetailOnClick('0'); return false;">新規登録</button>
  }
  <div id="option_attendance_setting" class="sight-settings">
    <div class="tables">
      <table id="tableMain" width="100%" class="table table-setting table-bordered border-info table-striped">
        <thead>
          <tr align="center">
            <th hidden>ログインユーザID</th>
            <th hidden>ユーザID</th>
            <th>ログインID</th>
            <th hidden>パスワード</th>
            <th>従業員CD</th>
            <th>従業員名</th>
            <th>支店<br />営業所<br />事業所</th>
            <th>初期車種</th>
            <th>更新日</th>
            <th>非表示</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          @{
            int i = 1;
            foreach (var item in listData)
            {
                    <tr id="@(i)">
                      <td align="center" width="100px" hidden>@(item.LoginUser_ID)</td>
                      <td align="center" width="100px" hidden>@(item.User_ID)</td>
                      <td align="center" width="100px">@(item.LoginID)</td>
                      <td align="center" width="70px" hidden>@(item.Password)</td>
                      <td align="center" width="90px">@(item.Employee_Number)</td>
                      <td align="center" width="120px">@(item.User_Name)</td>
                      <td align="center" width="120px">@(item.Branch_Name_Abbr)</td>
                      <td align="center" width="150px">@(item.SyasyuDisplay)</td>
                      <td align="right" width="180px">@Convert.ToDateTime(item.UP_DATE).ToString("yyyy/MM/dd HH:mm:ss")</td>
                      <td align="center" width="20px">@Html.CheckBoxFor(model => item.Del_Flg, new { @class = "form-control text-left form-check-input", @onclick = "return false;" })</td>
                      <td align="center" width="80px" style="margin: 0; vertical-align: middle; ">
                        @if (Model.EditEnabled)
                        {
                          <button type="button" class="btn btn-outline-success" style="width: 100%; padding: 0; font-size: 12px; height: 30px; " onclick="ExecShowDetailOnClick('@(item.LoginUser_ID)'); return false;">詳細</button>
                        }
                      </td>
                    </tr>
              i++;
            }
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

<!--<div>-->
  @*//モダール表示用のスペースを追加*@
  <!--<div id="ModalHere" data-keyboard="false" data-backdrop="static"></div>
  <div id="SortHere" hidden></div>
</div>-->



<script>

  function ExecShowDetailOnClick(paramLoginUserID) {

    //alert(document.getElementById("btnSortCommit").disabled);

    $.post('@Url.RouteUrl("Default", new { controller = "Setting", Action = "LoginUserModal" })',
      {
        LoginUserID: paramLoginUserID,
      })
      .done(function (response) {
        if (response.message != null) {
            alertError(`【エラー】${response.message}`);
            return false;
        } else {
          //alert("【done】" + response.partialView);
          $("#ModalHere").html(response.partialView);
          $("#ModalHere").find('.modal').modal('show');
          return false;
        }
      })
      .fail(function (xhr) {
          console.log(xhr);
      })
      .always(function (xhr, msg) {
          console.log(xhr, msg);
      });
  };

  function closeModel() {
    $('#ModalHere').find('.modal').modal('hide');
    $("#ModalHere").html('');
  };

  function closeModelAndRefresh() {
    $('#ModalHere').find('.modal').modal('hide');
    location.reload();
    document.getElementById("btnSortCommit").disabled = "disabled";
    alert("登録が完了しました。");
  };

  function varidationCheckForOverlap(loginID, loginUserID) {

    // table要素を取得
    var tableElem = document.getElementById('tableMain');

    // 行（tr要素）を取得
    var rowElems = tableElem.rows;

    // 取得した行（tr要素）を繰り返しHTMLを取得
    var htmlStr = '';
    for (i = 1, len = rowElems.length; i < len; i++) {

      var loginUserIDA = rowElems[i].cells[0].innerHTML;
      var loginIDA = rowElems[i].cells[2].innerHTML;

      //alert(loginUserID + ";;;;" + loginUserIDA);
      //alert(loginID + ";;;;" + loginIDA);

      if (loginUserID != loginUserIDA && loginIDA == loginID) {
        return true;
      }
    }

    return false;

  };
</script>