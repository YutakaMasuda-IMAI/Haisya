<script>

  function moveUp(obj1) {
    // tr行を取得
    var line1 = obj1.parentNode.parentNode;
    // 一番上の行のときは終了する
    if (line1.previousElementSibling === null) {
      alert("１番上の行です");
      return;
    }
    //　行のIDを取得し移動
    a = line1.id;
    $("#" + a).insertBefore(line1.previousElementSibling);

    var idMinus = (Number(a) - 1).toString();
    var line2 = document.getElementById(idMinus);

    var idNew = line2.cells[1].innerHTML;
    var idBefore = line1.cells[1].innerHTML

    line2.cells[1].innerHTML = idBefore;
    line1.cells[1].innerHTML = idNew;

    line2.id = a;
    line1.id = idMinus;

    document.getElementById("btnSortCommit").disabled = null;

  };

  function moveDown(obj1) {
    // tr行を取得
    var line1 = obj1.parentNode.parentNode;
    // 一番下の行のときは終了する
    if (line1.nextElementSibling === null) {
      alert("１番下の行です");
      return;
    }
    //　行のIDを取得し移動
    a = line1.id;
    $("#" + a).insertAfter(line1.nextElementSibling);

    var idPlus = (Number(a) + 1).toString();
    var line2 = document.getElementById(idPlus);

    var idNew = line2.cells[1].innerHTML;
    var idBefore = line1.cells[1].innerHTML

    line2.cells[1].innerHTML = idBefore;
    line1.cells[1].innerHTML = idNew;

    line2.id = a;
    line1.id = idPlus;

    document.getElementById("btnSortCommit").disabled = null;
  };

  function ExecShowDetailOnClick(paramSyaryoID) {

    //alert(document.getElementById("btnSortCommit").disabled);

    if (false == document.getElementById("btnSortCommit").disabled) {
      var result = window.confirm('並び順を変更しています。先に登録しないと変更内容が消えます。登録しますか？');
      if (result) { alert("「並び順変更反映」ボタンを押してください。"); return false; }
    }

    CommonWaitStart();

    $.post('@Url.RouteUrl("Default", new { controller = "Setting", Action = "SyaryoModal" })',
      {
        SyaryoID: paramSyaryoID,
      })
      .done(function (response) {
        if (response.message != null) {
            alertError(`【エラー】${response.message}`);
            return false;
        } else {
          //alert("【done】" + response.partialView);
          $("#ModalHere").html(response.partialView);
          $("#ModalHere").find('.modal').modal('show');
          return false;
        }
      })
      .fail(function (xhr) {
          console.log(xhr);
      })
      .always(function (xhr, msg) {
        CommonWaitEnd();
      });
  };

  function closeModel() {
    $('#ModalHere').find('.modal').modal('hide');
    $("#ModalHere").html('');
  };

  function closeModelAndRefresh() {
    $('#ModalHere').find('.modal').modal('hide');
    location.reload();
    document.getElementById("btnSortCommit").disabled = "disabled";
    alert("登録が完了しました。");
  };


  function SortCommit_Click() {

    CommonWaitStart();

    // table要素を取得
    var tableElem = document.getElementById('tableMain');

    // 行（tr要素）を取得
    var rowElems = tableElem.rows;

    // 取得した行（tr要素）を繰り返しHTMLを取得
    var htmlStr = '';
    for (i = 1, len = rowElems.length; i < len; i++) {
      htmlStr += "    <tr>";
      htmlStr += "      <td><input name='M_SyaryoList[" + (i - 1).toString() + "].SortOrder' value='" + rowElems[i].cells[1].innerHTML + "' /></td>";
      htmlStr += "      <td><input name='M_SyaryoList[" + (i - 1).toString() + "].Syaryo_ID' value='" + rowElems[i].cells[0].innerHTML + "' /></td>";
      htmlStr += "    </tr>";
    }

    var html = "";
    html += "<form id='sortData'>";
    html += "<div hidden>";
    html += "  <input name='CompanyID' value='" + $('#CompanyID').val() + "' />";
    html += "</div >";
    html += "<table>";
    html += "  <tbody>";
    html += htmlStr;
    html += "  </tbody>";
    html += "</table>";
    html += "</form >";

    $("#SortHere").html(html);

    //alert(htmlStr);
    document.getElementById("btnSortCommit").disabled = "disabled";

    //Formの参照を取る
    var $form = $('#sortData');

    $.ajax({
        url: '@Url.RouteUrl("Default", new { controller = "Setting", Action = "SyaryoListSortCommit" })',
        type: 'post',
        data: $form.serialize(),
      }).done(function (response) {
        if (response.errorMessage != null) {
          alert("【エラー】" + response.errorMessage, 'warning');
          return false;
        } else {
          if (response.retrunFlg) {
            alert('正常に登録出来ました。', 'success');
          } else {
            alert('登録に失敗しました。原因不明。', 'warning');
          }
          return false;
        }
      }).fail(function (xhr) {
        alert('【ネットワークエラー】:' + xhr, 'warning');
          console.log(xhr);
          return false;
      }).always(function (xhr, msg) {
        CommonWaitEnd();
      });

  };

  function varidationCheckForOverlap(syasyu, kata) {

    // table要素を取得
    var tableElem = document.getElementById('tableMain');

    // 行（tr要素）を取得
    var rowElems = tableElem.rows;


    // 取得した行（tr要素）を繰り返しHTMLを取得
    var htmlStr = '';
    for (i = 1, len = rowElems.length; i < len; i++) {

      var syasyuA = rowElems[i].cells[1].innerHTML;
      var kataA = rowElems[i].cells[2].innerHTML;

      //alert(syasyu + ";;;;" + kata);
      //alert(syasyuA + ";;;;" + kataA);

      if (syasyuA == syasyu && kataA == kata) {
        return true;
      }
    }

    return false;

  };


