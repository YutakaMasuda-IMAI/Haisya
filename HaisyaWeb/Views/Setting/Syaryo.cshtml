@model SettingModel.SyaryoDto

  @{
      Layout = "_LayoutForSettingWindow";

      var listSyaryo = Model.M_SyaryoList.OrderBy(m => m.SortOrder).ToList();
  }

<div id="content">
  <!-- 2秒間だけアラートを表示する -->
  <!--<div class="col-12">
    <div id="alert-1" class="lead"></div>
  </div>-->
  <div hidden>
    @Html.HiddenFor(model => Model.CompanyID)
  </div>
  <h2>
    <span class="glyphicon glyphicon-chevron-right"></span>車輌設定
  </h2>

  <div id="main">
    @*<div class="setting-separator">車輌リスト<span style="font-size: 12px; color: red;"> - 案件登録時に選択する車輌を登録します。</span></div>*@

    <div class="contents-wrap-middle">
      <h4 class="">使い方</h4>
      <span>
        ・右側の上下「▲ ▼」ボタンで並び替えできます。<br>
        ・並び替え終了後は、最上部の「並び順変更反映」ボタンにて保存して下さい。<br>
        <span style="background-color: #FF9966 ">・同時に複数のユーザーが変更処理を実施するとデータが壊れたり、不整合が発生したりします。必ず１ユーザーのみで実施してください。</span>
      </span>
    </div>

    <div class="clearfix">
      @if (Model.EditEnabled)
      {
      <button class="btn btn-primary" style="width: 200px;margin: 2px;" onclick="ExecShowDetailOnClick('0'); return false;">新規登録</button>
      <button id="btnSortCommit" disabled class="btn btn-success" style="width: 200px;margin: 2px; float: right; margin-right: 40px;" onclick="SortCommit_Click(); return false;">並び順変更反映</button>
      }
      <div id="option_attendance_setting" class="sight-settings">
        <div class="tables">
          <table id="tableMain" width="100%" class="table table-setting table-bordered border-info table-striped">
            <thead>
              <tr align="center">
                <th hidden>車輌ID</th>
                <th class="vertical" align="center" valign="middle" style="font-size: 11px; margin: 0;">並び順</th>
                <th>車種</th>
                <th>型</th>
                <th style="font-size: 10px;">車種<br />サイズ</th>
                <th>車種表示</th>
                <th>型表示</th>
                <th>長さ</th>
                <th>横幅</th>
                <th>高さ</th>
                <th style="font-size: 10px;">最大<br />積載量</th>
                <th style="font-size: 10px;">車両<br />重量</th>
                <th style="font-size: 10px;">車両<br />総重量</th>
                <th style="font-size: 10px;">平均<br />燃費</th>
                @*<th style="font-size: 10px;">詳細<br />車種</th>*@
                @*<th style="font-size: 10px;">料金<br />車種</th>*@
                <th>更新日時</th>
                <th>修正</th>
                <th>並び順</th>
              </tr>
            </thead>
            <tbody>
              @{
                int i = 1;
                foreach (var itemSyaryo in listSyaryo)
                {
                  string menuId = itemSyaryo.SYASYU;
                            <tr id="@(i)">
                              <td hidden align="center" width="30px">@(itemSyaryo.Syaryo_ID)</td>
                              <td align="center" width="30px">@(itemSyaryo.SortOrder)</td>
                              <td align="center" width="100px">@(itemSyaryo.SYASYU)</td>
                              <td align="center" width="100px">@(itemSyaryo.KATA)</td>
                              <td align="center" width="150px">@(itemSyaryo.SIZE)</td>
                              <td width="260px" style="font-size: 12px;">@(itemSyaryo.SyasyuDisplay)</td>
                              <td width="250px" style="font-size: 12px;">@(itemSyaryo.KataDisplay)</td>
                              <td align="right" width="70px">@(itemSyaryo.LONG)</td>
                              <td align="right" width="70px">@(itemSyaryo.WIDTH)</td>
                              <td align="right" width="70px">@(itemSyaryo.HEIGHT)</td>

                              <td align="right" width="70px">@(itemSyaryo.MAX_LOAD_CAPA)</td>
                              <td align="right" width="70px">@(itemSyaryo.CAR_WEIGHT)</td>
                              <td align="right" width="70px">@(itemSyaryo.CAR_GROSS_WEIGHT)</td>
                              <td align="right" width="70px">@Convert.ToDouble(itemSyaryo.AVG_FUEL_COSTS).ToString("0.00")</td>

                              @*<td align="left" width="200px">@(itemSyaryo.CARDETAILINFO_Disp)</td>*@
                              @*<td align="left" width="110px">@(itemSyaryo.TOLL_TYPE_Disp)</td>*@

                              <td align="right" width="120px" style="font-size: 11px;">@Convert.ToDateTime(itemSyaryo.UP_DATE).ToString("yyyy/MM/dd HH:mm:ss")</td>
                              <td align="center" width="120px" style="margin: 0; vertical-align: middle; ">
                                @if (Model.EditEnabled)
                                {
                                  <button class="btn btn-outline-success" style="width: 100%; padding: 0; font-size: 12px; height: 30px; " onclick="ExecShowDetailOnClick('@(itemSyaryo.Syaryo_ID)'); return false;">詳細</button>
                                }
                              </td>
                              <td align="center" width="180px" style="margin: 0; padding: 0; vertical-align: middle; ">
                                @if (Model.EditEnabled)
                                {
                                  <input type="button" value="上" onclick="moveUp(this)">
                                  <input type="button" value="下" onclick="moveDown(this)">
                                }
                              </td>
                            </tr>
                    i++;
                  }
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

