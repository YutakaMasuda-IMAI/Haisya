@model SettingModel.SyaryoSizeModalDto

  @{
      Layout = "_LayoutForSettingModal";
  }

<style>
/*  .float-left {
    float: left;
    padding: 0.5em 1em;
    margin: 2em 0;
    background: #f0f7ff;
    border: dashed 2px #5b8bd0;
  }

  .float-right {
    float: right;
    padding: 0.5em 1em;
    margin: 2em 0;
    background: #f0f7ff;
    border: dashed 2px #5b8bd0;
  }*/

  .readonly {
    background-color: lightgray;
  }

</style>



  <div role="dialog" aria-hidden="true" tabindex="-1" class="modal fade" style="z-index: 1240;" data-backdrop="static" aria-labelledby="exampleModalCenterTitle">
    <div class="modal-dialog modal-dialog-centered" role="document" style="max-width:650px;">
      <div class="modal-content">
        <div class="modal-header" style="background-color: gainsboro;">
          <h1 class="modal-title fs-3" id="exampleModalLabel">@(Model.Title)</h1>
          <button type="button" type="button" class="btn btn-primary" onclick="regExec(); return false;">@(Model.BtnCaption)</button>
          <button type="button" type="button" class="btn btn-secondary" onclick="closeModel(); return false;">閉じる</button>
        </div>
        <div class="model-body">
          <form id="form1">
            <div id="hidden" hidden>
              @Html.HiddenFor(model => Model.BtnCaption)
              @Html.HiddenFor(model => Model.Title)
            </div>
            <div class="contents-wrap-middle" style="margin: 10px;">
              <h4 class="">注意</h4>
              <span>
                ・一度データを登録すると物理削除は出来ません。「非表示フラグ」を立ててください。
              </span>
            </div>
            <div>
              <table class="table table-striped-columns table-bordered border-primary" border="1" style="margin: 10px; width:95%;">
                <tbody>
                  <tr hidden>
                    <th width="200px">会社ID</th>
                    <td width="300px">@Html.TextBoxFor(model => Model.M_SyaryoSize.Company_ID, null, new { @class = "form-control text-end", @onblur = "", @style = "width: 100px;" })</td>
                    <td width="200px"></td>
                  </tr>
                  <tr hidden>
                    <th width="200px">並び順</th>
                    <td width="300px">@Html.TextBoxFor(model => Model.M_SyaryoSize.SortOrder, null, new { @class = "form-control text-end", @onblur = "", @style = "width: 100px;" })</td>
                    <td></td>
                  </tr>
                  <tr style="vertical-align: middle;">
                    <th>車輌サイズ</th>
                    @if (Model.M_SyaryoSize.SortOrder == 0)
                    {
                      <td>@Html.TextBoxFor(model => Model.M_SyaryoSize.SIZE, null, new { @class = "form-control", @style = "width: 200px;" })</td>
                    }
                    else
                    {
                      <td>@Html.TextBoxFor(model => Model.M_SyaryoSize.SIZE, null, new { @readonly = "readonly", @class = "form-control readonly", @style = "width: 200px;" })</td>
                    }
                    <td>小型車/中型車/大型車/トレーラ</td>
                  </tr>
                  <tr>
                    <th>非表示フラグ</th>
                    <td class="">@Html.CheckBoxFor(model => Model.M_SyaryoSize.HIDDEN_FLG, new { @class = "form-control text-left form-check-input", @style = "height: 20px;" })</td>
                    <td>オンにすると、登録時に選択不可。</td>
                  </tr>
                  <tr>
                    <th>最終更新日</th>
                    <td>@Convert.ToDateTime(Model.M_SyaryoSize.UP_DATE).ToString("yyyy/MM/dd HH:mm:ss")</td>
                    <td hidden>@Html.TextBoxFor(model => Model.M_SyaryoSize.UP_DATE, null, new { @class = "form-control text-end" })</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>



<script>

  $(function () {

    setTimeout(function () {
      $('.modal-backdrop')
        .not('.modal-stack')
        .css('z-index', 1239)
        .addClass('modal-stack');
    }, 0);


  });

  function regExec() {

    if (varidationCheck()) {
      return false;
    }

    //Formの参照を取る
    var $form = $('#form1');

    //alert($form.serialize());

    $.ajax({
          url: '@Url.RouteUrl("Default", new { controller = "Setting", Action = "SyaryoSizeRegExec" })',
          type: 'post',
          data: $form.serialize(),
        }).done(function (response) {
            if (response.errorMessage != null && response.errorMessage !== '') {
              alertError(`【エラー】${response.errorMessage}`);
              return false;
          } else {
            closeModelAndRefresh();
            return false;
          }
        }).fail(function (xhr) {
          alert('【ネットワークエラー】:' + xhr);
            console.log(xhr);
            return false;
        }).always(function (xhr, msg) {
            console.log(xhr, msg);
        });

  };

  function varidationCheck() {

    if (!($('#M_SyaryoSize_SIZE').val() != null && $('#M_SyaryoSize_SIZE').val().length > 0)) {
      alert("車種サイズが入力されていません");
      $('#M_SyaryoSize_SIZE').css('background-color', 'lightcoral');
      return true;
    } else {
      $('#M_SyaryoSize_SIZE').css('background-color', 'white');
    }
    
    if ($('#M_SyaryoSize_SortOrder').val() == 0) {
      if (varidationCheckForOverlap($('#M_SyaryoSize_SIZE').val())) {
        alert("入力の車種・型は既に登録されています");
        $('#M_SyaryoSize_SIZE').css('background-color', 'lightcoral');
        return true;
      } else {
        $('#M_SyaryoSize_SIZE').css('background-color', 'white');
      }
    }
    return false;

  };



</script>