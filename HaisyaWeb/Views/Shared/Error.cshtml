@model ErrorViewModel
@{
  Layout = Model.Layout;
//ViewData["Title"] = "Error";
}

<div style="text-align: center; margin-top: 3rem;">
  <h1 class="text-danger">処理エラー.</h1>
  <h2 class="text-danger">要求の処理中にエラーが発生しました.</h2>
  <h3 class="text-danger">@Model.Title</h3>


  @if (Model.Message != null && Model.Message.Length > 0)
  {
    <p>
      <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
    <p>
      <strong>エラーメッセージ:</strong> <code><label class="display-6">@Model.Message</label>   </code>
    </p>
  }

</div>

