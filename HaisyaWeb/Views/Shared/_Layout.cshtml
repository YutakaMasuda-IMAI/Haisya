  <link href="~/lib/jquery-ui/dist/themes/base/jquery-ui.css" rel="stylesheet" />
  <link href="~/lib/jquery-ui/dist/themes/base/theme.css" rel="stylesheet" />
  <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
  <link href="~/lib/glyphicons/css/bootstrap.css" rel="stylesheet" />
  <link href="~/lib/sweetalert2/dist/sweetalert2.css" rel="stylesheet" />
  @*<link href="~/lib/tablesorter/dist/css/theme.default.min.css" rel="stylesheet" />*@

  <script src="~/lib/jquery/dist/jquery.js" charset="utf-8"></script>
  <script src="~/lib/jquery-ui/dist/jquery-ui.js" charset="utf-8"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.js" charset="utf-8"></script>
  <script src="~/lib/sweetalert2/dist/sweetalert2.js"></script>
  <script src="~/lib/add-clear/addclear.js"></script>
  @*<script src="~/lib/tablesorter/dist/js/jquery.tablesorter.js"></script>
    <script src="~/lib/tablesorter/dist/js/jquery.tablesorter.combined.js"></script>
    <script src="~/lib/tablesorter/dist/js/jquery.tablesorter.widgets.js"></script>*@
  <script src="~/js/ympicker.js" charset="utf-8"></script>

  <script src="~/js/site.js" asp-append-version="true"></script>


  <link rel="stylesheet" href="~/css/site.css"  asp-append-version="true"/>
  <link href="~/css/Tool.css" rel="stylesheet"  asp-append-version="true"/>

  @RenderSection("styles", false)

  <style>
    /* dropdown category */
    div.category {
      background-color: lightyellow;
      color: #505050;
      position: absolute;
      width: 100%;
      z-index: 1;
      border-bottom: 1px solid #b9b9b9;
      padding-left: 20px;
      margin-top: -0px;
    }

      div.category .arrow {
        margin: 0px 0px 0px -180px;
      }

      div.category .row {
        width: 1250px;
        margin: 0 auto;
        padding: 15px 0 30px 0;
      }

      div.category > ul > li {
        float: left;
        min-width: 115px;
        margin: 0px 12px 0px 12px;
      }

        div.category > ul > li:first-child {
          width: 400px;
        }

        div.category > ul > li:last-child {
          /*          //width:170px;
          //margin:0px 0px 0px 0px;*/
        }

          div.category > ul > li:last-child a {
            /*      //display:block;*/
          }

          div.category > ul > li:last-child img {
            margin: 0px 0px 5px;
          }

      div.category a:hover {
        text-decoration: underline;
      }

      div.category dd ul {
        padding-left: 10px;
      }

      div.category dd li {
        line-height: 1.5em;
        min-height: 20px;
        padding: 3px 0px;
        width: 100%;
      }

      div.category li:nth-of-type(1) dd li {
        float: left;
        width: 70%;
      }

      div.category dd a {
        font-size: 13px;
        text-decoration: none;
        color: #636363;
      }

        div.category dd a:hover {
          text-decoration: none !important;
          color: #007cff !important;
        }

      div.category li dl dt {
        font-size: 16px;
        margin: 15px 0;
        border-bottom: 1px solid #ccc;
      }

        div.category li dl dt a {
          text-decoration: none;
        }

          div.category li dl dt a:hover {
            text-decoration: none;
            color: #007cff;
          }

        div.category li dl dt span {
          padding-right: 5px;
        }

      div.category li dl li .tooltipTarget {
        padding-left: 5px;
        opacity: 0.5;
        position: relative;
        top: 2px;
      }

        div.category li dl li .tooltipTarget:hover {
          opacity: 0.8;
        }

    .menuCenterHeader {
      padding-top: 0px !important;
      padding-bottom: 0px !important;
      display: table-cell !important;
      vertical-align: middle;
      text-align: center;
      height: 35px;
      width: 7%;
    }
  </style>
</head>

<body>
