<script>
  var cl = 0;
  var menuTimer = null;
  jQuery("#header ul.navbar-nav > li > a").each(function () {
    if (jQuery('#' + jQuery(this).data('submenu-name') + '-menu').length > 0) {
      timerName = 'timer' + cl;
      cl++;
      var target = jQuery('#' + jQuery(this).data('submenu-name') + '-menu');
      jQuery(this).parent().on({
        "mouseenter.dropdown": function () {
          menuTimer = setTimeout(function () {
            if (target.is(":hidden")) {
              target.stop().show();
            } else {
              clearTimeout(timerName);
            }
          }, 250);
        },
        "mouseleave.dropdown": function () {
          timerName = setTimeout(function () {
            target.stop().hide();
          }, 50);
        },
        'mouseout': function () {
          if (menuTimer != null) {
            clearTimeout(menuTimer);
            menuTimer = null;
          }
        }
      })
      jQuery(target).on({
        "mouseenter.dropdown": function () {
          if (target.is(":hidden")) {
            target.stop().show();
          } else {
            clearTimeout(timerName);
          }
        },
        "mouseleave.dropdown": function () {
          timerName = setTimeout(function () {
            target.stop().hide();
          }, 50);
        }

      })
    }
  });


</script>