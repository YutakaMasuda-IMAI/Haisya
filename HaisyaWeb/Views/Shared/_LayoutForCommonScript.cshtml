   /**
   * 共通得意先選択ダイアログを開く
   * @@param userID
   * @@param SelectedId
   */
  function openCommonDialogForCustomerOya(companyID, userID = 0, SelectedId = 0, yosyaFlg = 0) {

    $.post('@Url.RouteUrl("Default", new { controller = "CommonDialog", Action = "OpenDialogForSelectCustomerOya" })',
      {
        companyId: companyID,
        selectedId: SelectedId,
        yosyaFlg: yosyaFlg
      })
      .done(function (response) {

        if (response.message != null) {
            alertError(response.errorMessage, "【処理エラー】");
            return false;
        } else {
            //alert(response.partialView);
          $("#ModalCommonDialog").html("");
          $("#ModalCommonDialog").html(response.partialView);
          CommonDailogOpen("ModalCommonDialog", "親顧客選択", 1100, 700, "ModalCommonDialogClose()");
          return;
        }
      })
      .fail(function (xhr) {
          alertError(xhr, "【ネットワークエラー】");
          console.log(xhr);
          return false;
      })
      .always(function (xhr, msg) {
      });

    return false;

  };


