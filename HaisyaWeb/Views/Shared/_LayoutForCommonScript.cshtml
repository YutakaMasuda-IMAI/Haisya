  function CommonDailogOpen(id, title, width, height, closeFunction) {
    var thedialogCommon;

    thedialogCommon = $("#" + id).dialog({
      autoOpen: false,
      modal: true,
      width: width,
      height: height,
      title: title,
      position: { my: "center", at: "center", of: window },
      open: function () { //Xボタン非表示

        //var aa = $(this).closest(".ui-dialog").find('.ui-dialog-titlebar-close');

        $(".ui-dialog-titlebar-close", $(this).closest(".ui-dialog")).attr('id', 'btnCloseCommon');
        $(".ui-dialog-titlebar-close", $(this).closest(".ui-dialog")).text("閉じる");
        $(".ui-dialog-titlebar-close", $(this).closest(".ui-dialog")).attr('class', 'btn btn-secondary');
        $(".ui-dialog-titlebar-close", $(this).closest(".ui-dialog")).addClass('btnCloseCommon');
        $(".ui-dialog-title", $(this).closest(".ui-dialog")).addClass('fs-4');

        $("#btnCloseCommon", $(this).closest(".ui-dialog")).on('click', function () {
          //if (typeof closeFunction == 'function') { closeFunction(); }
          if (closeFunction != null && closeFunction.length > 0) { eval(closeFunction + ';'); }
        });
      },
      close: function () {
        $(this).dialog("destroy");
      }
    });

    thedialogCommon.dialog("open");
  }



  /**
   * 案件照会画面(モーダル)を開く
   * @@param url
   * @@param ankenID
   * @@param ankenDisplayID
   * @@param driverID
   * @@param driverSyaryoID
   * @@param haisyaKubun
   */
  function AnkenRefenceModalEx(url, ankenID, ankenDisplayID, driverID, driverSyaryoID, haisyaKubun) {
    ///処理中ダイアログ
    Swal.fire({
      title: 'データ読込中'
      , html: '表示されるまでそのままお待ちください。'
      , allowOutsideClick: true     //枠外をクリックしても画面を閉じない
      , showConfirmButton: false
      , didOpen: () => {
        Swal.showLoading();
      }
    });

    $.post(url,
      {
        ankenId: ankenID,
        ankenDisplayId: ankenDisplayID,
        driverId: driverID,
        driverSyaryoId: driverSyaryoID,
        haisyaKubun: haisyaKubun,
      })
      .done(function (response) {
        if (response.message != null) {
            alertError(`【エラー】${response.message}`);
            return false;
        } else {
          //alert("【done】" + response.partialView);
          $("#ModalHere").html(response.partialView);
          //$("#ModalHere").find('.modal').modal('show');

          DailogOpen("ModalHere", "案件照会", 1020, 700, null, 'ClearHtml("ModalHere")');


          return false;
        }
      })
      .fail(function (xhr) {
        console.log(xhr);
      })
      .always(function (xhr, msg) {
        //console.log(xhr, msg);
        //alert(msg);
        //完了ダイアログ
        Swal.fire({
          title: '処理終了'
          , html: '処理を終了しました。'
          , type: 'info'
          , timer: 1
        });
      });

  };


