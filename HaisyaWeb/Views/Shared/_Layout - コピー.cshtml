  <style>

    /* ▼ヘッダ▼ */

    #header {
      position: relative;
      min-height: 100px;
    }

      #header #header-inner {
        border-top: 3px solid #3481fa;
        width: 100%;
        margin: 0 auto;
      }

      #header .navbar-inner {
        /*width: 100% !important;*/
      }

      #header #header-inner > * {
        vertical-align: top;
      }

      #header h1 {
        padding: 15px 0px 0px 15px;
        position: absolute;
        display: inline-block;
        zoom: 1;
        float: left;
      }

      #header #header-inner #logout {
        float: right;
        margin-top: 4px;
      }

        #header #header-inner #logout table {
          line-height: 1;
        }

    .navbar-inner {
      background-color: ivory;
      border-top: 1px solid #d4d4d4;
      border-bottom: 1px solid #d4d4d4;
      *zoom: 1;
    }


    /* dropdown category */
    div.category {
      background-color: lightyellow;
      color: #505050;
      position: absolute;
      width: 100%;
      z-index: 1;
      border-bottom: 1px solid #b9b9b9;
      padding-left: 20px;
      margin-top: -25px;
    }

      div.category .arrow {
        margin: 0px 0px 0px -180px;
      }

      div.category .row {
        width: 1250px;
        margin: 0 auto;
        padding: 15px 0 30px 0;
      }

      div.category > ul > li {
        float: left;
        min-width: 115px;
        margin: 0px 12px 0px 12px;
      }

        div.category > ul > li:first-child {
          width: 400px;
        }

        div.category > ul > li:last-child {
/*          //width:170px;
          //margin:0px 0px 0px 0px;*/
        }

          div.category > ul > li:last-child a {
      /*      //display:block;*/
          }

          div.category > ul > li:last-child img {
            margin: 0px 0px 5px;
          }

      div.category a:hover {
        text-decoration: underline;
      }

      div.category dd ul {
        padding-left: 10px;
      }

      div.category dd li {
        line-height: 1.5em;
        min-height: 20px;
        padding: 3px 0px;
        width: 100%;
      }

      div.category li:nth-of-type(1) dd li {
        float: left;
        width: 50%;
      }

      div.category dd a {
        font-size: 13px;
        text-decoration: none;
        color: #636363;
      }

        div.category dd a:hover {
          text-decoration: none !important;
          color: #007cff !important;
        }

      div.category li dl dt {
        font-size: 16px;
        margin: 15px 0;
        border-bottom: 1px solid #ccc;
      }

        div.category li dl dt a {
          text-decoration: none;
        }

          div.category li dl dt a:hover {
            text-decoration: none;
            color: #007cff;
          }

        div.category li dl dt span {
          padding-right: 5px;
        }

      div.category li dl li .tooltipTarget {
        padding-left: 5px;
        opacity: 0.5;
        position: relative;
        top: 2px;
      }

        div.category li dl li .tooltipTarget:hover {
          opacity: 0.8;
        }

    .navbar {
      --bs-navbar-padding-y: 0.25rem;
    }


    .navbar .nav > li {
      display: inline-block;
      font-size: 14px;
      flex: auto;
     
    }

      .navbar .nav > li > a {
        float: none;
        padding: 10px 5px 10px;
        color: #777777;
        text-decoration: none;
        display: table-cell !important;
        vertical-align: middle;
        text-align: center;
        border-left: solid 1px #ddd;
      }

      .navbar .nav > li:last-child > a {
        border-right: solid 1px #ddd;
      }






    .menuCenterHeader {
      padding-top: 0px !important;
      padding-bottom: 0px !important;
      display: table-cell !important;
      vertical-align: middle;
      text-align: center;
      height: 41px;
      width: 10%;
    }
  </style>
