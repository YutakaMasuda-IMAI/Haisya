@model HaisyaWeb.Models.SelectCodeDto;


@{

}

<link href="~/css/Tool.css" rel="stylesheet" />

<style>
  /*  .float-left {
    float: left;
    padding: 0.5em 1em;
    margin: 2em 0;
    background: #f0f7ff;
    border: dashed 2px #5b8bd0;
  }

  .float-right {
    float: right;
