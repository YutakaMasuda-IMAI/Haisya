@using Newtonsoft.Json
@model HaisyaWeb.Models.ShitabaraiCheckDataModel.DataListModel

@if ((Model?.ShitabaraiCheckDataList == null || Model.ShitabaraiCheckDataList.Count == 0))
{
  <div class="no-data-row">
    <h4 class="no-data-row-text">データ無し</h4>
  </div>
}
else
{
  <table id="myTable" class="table ex_DataList  search-list" style="width: 100%;" border="1">
    <tr>
      <th style="width:80px;">
        <button id="chk-all" class="btn btn-info" style="width: 100%; padding:0;" value="1" onclick="CheckAll()">全選択</button>
      </th>
      <th style="width:60px;">
        <a href="#" onclick="dataListFirstSortChange('Inquiry_Status_String')">状態</a>
      </th>
      <th style="width:80px;">メール</th>
      <th style="width:80px;">印刷</th>
      <th style="width:80px;">プレビュー</th>
      <th>
        <a href="#" onclick="dataListFirstSortChange('SHIHARAI_TANTOU')">下払担当</a>
      </th>
      <th>
        <a href="#" onclick="dataListFirstSortChange('Yosya_Name')">傭車先</a>
      </th>
      <th style="width:300px;">
        <a href="#" onclick="dataListFirstSortChange('Mail_Address1')">メールアドレス</a>
      </th>
      <th style="width:80px;">
        <a href="#" onclick="dataListFirstSortChange('Meisai_Count')">明細件数</a>
      </th>
      <th style="width:80px;">
        <a href="#" onclick="dataListFirstSortChange('ShiharaiUnchin')">運賃計</a>
      </th>
      <th style="width:80px;">
        <a href="#" onclick="dataListFirstSortChange('Tatekaekin')">立替計</a>
      </th>
      <th style="width:80px;">
        <a href="#" onclick="dataListFirstSortChange('Anken_Count')">案件件数</a>
      </th>
      <th style="width:100px;">
        <a href="#" onclick="dataListFirstSortChange('Kakutei_Count')">下払い確定件数</a>
      </th>
      <th style="width:80px;">
        <a href="#" onclick="dataListFirstSortChange('Zantei_Count')">暫定件数</a>
      </th>
      <th style="width:80px;">
        <a href="#" onclick="dataListFirstSortChange('Kari_Count')">仮件数</a>
      </th>
    </tr>
    <tbody>
      @{
        var i = 0;
        var listData = Model.ShitabaraiCheckDataList;
        if (!string.IsNullOrEmpty(Model.SortParam.SortItemParam) && !string.IsNullOrEmpty(Model.SortParam.SortOrder))
        {
            if ("asc".Equals(Model.SortParam.SortOrder))
            {
                listData = listData.OrderBy(s => s.GetType().GetProperty(Model.SortParam.SortItemParam).GetValue(s, null)).ToList();
            }
            else
            {
                listData = listData.OrderByDescending(s => s.GetType().GetProperty(Model.SortParam.SortItemParam).GetValue(s, null)).ToList();
            }
        }
      }

      @foreach (var item in listData)
      {
        i++;
        var color = i % 2 == 1 ? "row-even" : "row-odd";
        <tr>
          <td class="@(color)" align="center">
            @Html.TextBox("Order", i, new { @id = $"Order-{i}", @type = "checkbox", @onchange = "SelectShitabarai()" })
          </td>
          <td class="@(color)" align="center">@Html.DisplayFor(m => item.Inquiry_Status_String)</td>
          <td class="@(color)" align="center">
            <button class="btn btn-success" style="width: 96%; padding: 0; background-color: #b27aab;" onclick="PublishShitabarai(@i, @((int)ConfirmationViews.MAIL));">メール</button>
          </td>
          <td class="@(color)" align="center">
            <button class="btn btn-success" style="width: 96%; padding: 0; background-color: #84e291;" onclick="PublishShitabarai(@i, @((int)ConfirmationViews.PRINT));">印刷</button>
          </td>
          <td class="@(color)" align="center">
            <button class="btn btn-success" style="width: 96%; padding: 0; background-color: #ffc000;" onclick="PublishShitabarai(@i, @((int)ConfirmationViews.PREVIEW));">プレビュー</button>
          </td>
          <td class="@(color)">@Html.DisplayFor(m => item.SHIHARAI_TANTOU)</td>
          <td class="@(color)">@Html.DisplayFor(m => item.Yosya_Name)</td>
          <td class="@(color)">@Html.DisplayFor(m => item.Mail_Address1)</td>
          <td class="@(color)" align="right">
            @(item.Meisai_Count?.ToString("#,0") ?? "")
          </td>
          <td class="@(color)" align="right">
            @(item.ShiharaiUnchin?.ToString("#,0") ?? "")
          </td>
          <td class="@(color)" align="right">
            @(item.Tatekaekin?.ToString("#,0") ?? "")
          </td>
          <td class="@(color)" align="right">@Html.DisplayFor(m => item.Anken_Count)</td>
          <td class="@(color)" align="right">@Html.DisplayFor(m => item.Kakutei_Count)</td>
          <td class="@(color)" align="right">@Html.DisplayFor(m => item.Zantei_Count)</td>
          <td class="@(color)" align="right">@Html.DisplayFor(m => item.Kari_Count)</td>
          @Html.HiddenFor(m => item.Check_Shitabarai_ID, htmlAttributes: new { id = $"id-{i}" })
          @Html.HiddenFor(m => item.Yosya_Name, htmlAttributes: new { id = $"name-{i}" })
          @Html.HiddenFor(m => item.Mail_Address1, htmlAttributes: new { id = $"mail1-{i}" })
          @Html.HiddenFor(m => item.Mail_Address2, htmlAttributes: new { id = $"mail2-{i}" })
          @Html.HiddenFor(m => item.Shime_Day, htmlAttributes: new { id = $"shime-{i}" })
          @Html.HiddenFor(m => item.Yosya_Branch_ID, htmlAttributes: new { id = $"branch-{i}" })
          @Html.HiddenFor(m => item.Uriage_Shiharai_ID, htmlAttributes: new { id = $"uriage-{i}" })
          @Html.HiddenFor(m => item.Uriage_Shiharai_ID_LIST, htmlAttributes: new { id = $"uriagelist-{i}" })
          @Html.HiddenFor(m => item.Zei_Kubun, htmlAttributes: new { id = $"tax-{i}" })
        </tr>
      }
    </tbody>
  </table>
}