@model DailyReportModel.DailyReportRegistrationDetailModel

<div class="other-paid-list">
  <table class="table table-HaisyaWeb">
    <thead class="table-active">
      <tr>
        <th style="width:200px;">項目名</th>
        <th style="width:auto;">発</th>
        <th style="width:auto;">着</th>
        <th style="width:120px;">料金</th>
        <th style="width:120px;">負担選択</th>
      </tr>
    </thead>
    <tbody id="otherTollTable">
      @{
        var otherIndex = 0;
      }
      @if (Model.NippouTollOther != null)
      {
        @foreach (var item in Model.NippouTollOther)
        {
          <tr data-index="@otherIndex" class="align-middle">
            <td onclick="OtherPaidModal(this, @otherIndex);" class="pointer text-center" style="">
              @Model.GroupUserSelectList.FirstOrDefault(x => x.Value == item.Toll_Kubun.ToString())?.Text
            </td>
            <td onclick="OtherPaidModal(this, @otherIndex);" class="pointer" style="">@item.Start_Name</td>
            <td onclick="OtherPaidModal(this, @otherIndex);" class="pointer" style="">@item.End_Name</td>
            <td onclick="OtherPaidModal(this, @otherIndex);" class="pointer text-end toll-money " style="">@string.Format("{0:N0}", item.Toll_Fee)円</td>
            <td>
              @Html.DropDownListFor(
                     m => item.Futan_Kubun,
                     new SelectList(Model.FutanKubunList, "Value", "Text"),
                     new { @class = "form-control list text-center futan-select other-futan-select", onchange = $"onOtherPaidFutanKubunChange(this, {otherIndex})" }
                     )
            </td>
          </tr>
          otherIndex++;
        }
      }
    </tbody>
  </table>
</div>

<script>

  $(function() {
    $('.other-futan-select').change(function() {
      CalcTollMoney();
    });
  });


</script>