    event.preventDefault();

    let nippouKaisoDegitakoIdList = $('#NippouKaisoDegitakoIdList').val() || [];
    if (!Array.isArray(nippouKaisoDegitakoIdList)) {
      nippouKaisoDegitakoIdList = [nippouKaisoDegitakoIdList];
    }

    const nippouKaisoDegitakoIdListInt = nippouKaisoDegitakoIdList
      .map(function (item) {
        return parseInt(item, 10);
      })
      .filter(function (item) {
        return !isNaN(item);
      });

    let nippouStayDegitakoIdList = $('#NippouStayDegitakoIdList').val() || [];
    if (!Array.isArray(nippouStayDegitakoIdList)) {
      nippouStayDegitakoIdList = [nippouStayDegitakoIdList];
    }

    const nippouStayDegitakoIdListInt = nippouStayDegitakoIdList
      .map(function (item) {
        return parseInt(item, 10);
      })
      .filter(function (item) {
        return !isNaN(item);
      });

    let KUDGSIRIdList = $('#KUDGSIRIdList').val() || [];
