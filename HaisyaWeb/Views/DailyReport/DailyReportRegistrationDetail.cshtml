      KUDGSIRIdList = [KUDGSIRIdList];
    }

    const KUDGSIRIdListInt = KUDGSIRIdList
      .map(function (item) {
        return parseInt(item, 10);
      })
      .filter(function (item) {
        return !isNaN(item);
      });
    const data = {
      Nippou_ID: @Html.Raw(Json.Serialize(Model.Nippou_ID)),
      HaisyaDataList: @Html.Raw(Json.Serialize(Model.HaisyaDataList)),
      NippouTollOther: OtherPaidData,
      NippouToll: NippouToll,
      Nippou_Stay: {
        Start_Datetime: $('#Nippou_Stay_Start_Datetime').val(),
        End_Datetime: $('#Nippou_Stay_End_Datetime').val(),
        Start_ShikuName: $('#Nippou_Stay_Start_ShikuName').val(),
        End_ShikuName: $('#Nippou_Stay_End_ShikuName').val(),
        Interval_Time: parseInt($('#Nippou_Stay_Interval_Time').val()),
        Dllowance: ($('#Nippou_Stay_Dllowance').val() || 0)
      },
      NippouStayDegitakoIdList: nippouStayDegitakoIdListInt,
      Nippou_Kaiso: {
        Start_Datetime: $('#Nippou_Kaiso_Start_Datetime').val(),
        End_Datetime: $('#Nippou_Kaiso_End_Datetime').val(),
        Start_ShikuName: $('#Nippou_Kaiso_Start_ShikuName').val(),
        End_ShikuName: $('#Nippou_Kaiso_End_ShikuName').val(),
        Commnet: $('#Nippou_Kaiso_Commnet').val(),
        Distance: parseInt($('#Nippou_Kaiso_Distance').val()),
        Dllowance: ($('#Nippou_Kaiso_Dllowance').val() || 0)
      },
      NippouKaisoDegitakoIdList: nippouKaisoDegitakoIdListInt,
      KUDGSIRIdList: KUDGSIRIdListInt,
      InitialDisplayNippouToll: InitialDisplayNippouToll,
      AnkenDisplay: @Html.Raw(Json.Serialize(Model.AnkenDisplay)),
      Nippou: {
        RenkeiStatus: $('#digitalTachograph').is(':checked') ? 0 : 1,
        ApprovalStatus: ApprovalStatus,
        Nippou_ID: @Html.Raw(Json.Serialize(Model.Nippou_ID)),
        Anken_ID: @Html.Raw(Json.Serialize(Model.Nippou.Anken_ID)),
        AnkenDisplay_ID: @Html.Raw(Json.Serialize(Model.Nippou.AnkenDisplay_ID)),
        Distance: $('#Nippou_Distance').val(),
      }
    }

    $.post('@Url.RouteUrl("Default", new { controller = "DailyReport", Action = "ProvisionalRegistration" })',
      {
        data: JSON.stringify(data)
      })
      .done(function (response) {
        if (response.message != null) {
          alert("【エラー】" + response.message);
          return false;
        } else {
          showChangeTransitionDialog(Anken_ID)
          return false;
        }
      })
      .fail(function (xhr) {
        console.log(xhr);
      })
      .always(function (xhr, msg) {
      });
  };

  function ApprovalRegistration() {
    event.preventDefault();

    var comment = $('#Nippou_Kaiso_Commnet').val();
    var dllowance = $('#Nippou_Stay_Dllowance').val();
    let Distance = $('#Nippou_Distance').val();
    if ($('#digitalTachograph').is(':checked')) {
      if (!comment || !dllowance) {
        alertError('泊まり設定　または　空車回送設定を行ってください');
        return;
      }
    } else {
      if (!Distance) {
        alertError('日報情報の走行距離を入力してください');
        return;
      }
    }

    alertYesNoMsg("確認", "承認登録します。よろしいですか。", "question", "はい", "いいえ")
    .then(function (result) {
      if (result) {
        ProvisionalRegistration(1)

      } else {
      }

    })
    .catch(function (error) {
      console.error('Error in alertThreeButtonsMsg:', error);
    });
  }
</script>