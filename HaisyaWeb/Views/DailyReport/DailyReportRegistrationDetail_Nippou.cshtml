  // 高速情報の負担選択変更時の処理(デジタコ連携)
  function onHighwayDataFutanKubunChange(selectElement, index) {
    var selectedValue = selectElement.value;
    if (index < NippouTollDegitako.length){
      NippouTollDegitako[index].futan_Kubun = selectedValue;
      NippouTollDegitako[index].sort = index;
    }
    else
    {
      var tollIndex = NippouToll.length >= NippouTollDegitako.length ? index : index - NippouTollDegitako.length;
      NippouToll[tollIndex].futan_Kubun = selectedValue;
      NippouToll[tollIndex].sort = index;
    }
  }

