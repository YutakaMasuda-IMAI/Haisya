    hiddenNumOfInq.name = 'kubun';
    hiddenNumOfInq.value = 0;
    form.appendChild(hiddenNumOfInq);

    var hiddenNumOfFilter = document.createElement('input');
    hiddenNumOfFilter.type = 'hidden';
    hiddenNumOfFilter.name = 'processingCategory';
    hiddenNumOfFilter.value = processingCategory;
    form.appendChild(hiddenNumOfFilter);

    // Add the form to the body and submit it
    document.body.appendChild(form);
    form.submit();
  }

