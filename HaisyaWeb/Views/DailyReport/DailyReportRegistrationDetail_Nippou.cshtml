  //高速情報追加のレコードの追加・更新処理
  function saveHighwayList() {
    if (!validateHighwayListForm()) {
      return; // 必須フィールドが空の場合は処理を中断
    }
    var feeInput = $("#fee");
    feeInput.val(feeInput.val().replace(/,/g, ""));
    
    const index = $("#recordIndex").val();

    if (index == -1) {
      // Add new record

      const highwayData = {
        開始日時: $("#startDatetime").val(),
        開始道路名: $("#startRoadName").val(),
        終了道路名: $("#endRoadName").val(),
        終了日時: $("#endDatetime").val(),
        開始IC名: $("#startICName").val(),
        終了IC名: $("#endICName").val(),
        料金: feeInput.val(),
        futan_Kubun: 0,
        sort: Math.max(NippouTollDegitako.length, NippouToll.length)
      };
      NippouToll.push(highwayData);
    } else {
      // Update existing record

      NippouToll[index].開始日時 = $("#startDatetime").val();
      NippouToll[index].開始道路名 = $("#startRoadName").val();
      NippouToll[index].終了道路名 = $("#endRoadName").val();
      NippouToll[index].終了日時 = $("#endDatetime").val();
      NippouToll[index].開始IC名 = $("#startICName").val();
      NippouToll[index].終了IC名 = $("#endICName").val();
      NippouToll[index].料金 = feeInput.val();

    }
    postHighwayList(NippouToll);
    closeHighwayList();
  };

