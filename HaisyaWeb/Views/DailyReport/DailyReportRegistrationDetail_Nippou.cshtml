  //空車回送設定時の選択したレコードの終了日時以降のデータのみを表示
  function filterHighwayList(endDatetime) {
    $(".highway-list tbody tr:nth-child(odd)").each(function() {
      var row = $(this);
      var rowEndDatetime = new Date(row.find("td:nth-child(1)").text());
      if (rowEndDatetime >= endDatetime) {
        row.show();
        row.next().show();
      } else {
        row.hide();
        row.next().hide();
      }
    });
  }

