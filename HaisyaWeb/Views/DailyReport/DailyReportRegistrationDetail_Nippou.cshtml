@model DailyReportModel.DailyReportRegistrationDetailModel

<head>
  <meta charset="UTF-8">
  <style>
  </style>
</head>

<link href="~/css/DailyReport.css" rel="stylesheet" />
<div style="padding:5px 5px 5px 15px;">
  <div hidden>
    @Html.HiddenFor(model => Model.NippouStayDegitakoIdList)
    @Html.HiddenFor(model => Model.NippouKaisoDegitakoIdList)
    @Html.HiddenFor(model => Model.KUDGSIRIdList)
    @Html.HiddenFor(model => Model.NippouApproval.Nippou_Approval_ID)

    @Html.HiddenFor(model => Model.NippouApproval.Approval_Group_ID)
    @Html.HiddenFor(model => Model.NippouApproval.Limit_DateTime)
    @Html.HiddenFor(model => Model.NippouApproval.Order_Memo)
  </div>

  <div class="heading-21 w-100" style="font-weight: bold; margin-top: 1rem;">
    <h3 id="labelTitle" class="heading-40 w-100" style="">運転日報登録修正</h3>
    <div class="w-100" style="border: 1px solid #000000; height: 100px; overflow: auto; ">
      @Html.DisplayFor(model => model.SeikyuRemarks)
    </div>
  </div>
  <div class="header-buttons" style="margin-top:1rem;">
    <table width="100%">
      <tr>
        <td><button type="button" class="btn btn-outline-dark" style="width: 150px;" onclick="ProvisionalRegistrationWithConfirm()">仮登録</button></td>
        <td><button type="button" class="btn btn-outline-success" style="width:150px;" onclick="CertificationRequestModal()">登録(承認依頼)</button></td>
        <td><button type="button" class="btn btn-outline-danger" style="width: 150px;" onclick="ApprovalRegistration()">登録(承認)</button></td>
        <td><button type="button" class="btn btn-outline-secondary" style="width: 150px;" onclick="salesEntry()">売上入力</button></td>
        <td align="right"><button type="button" class="btn btn-outline-warning" style="width: 150px;" onclick="btnCloseOnClick(); return false;">閉じる</button></td>
      </tr>
    </table>
  </div>
  <div class="row">
    <div class="col-4">
    </div>
    <div class="col-8 root-list">
      <table>
        <thead>
          <tr class="" style="text-align-last: center;">
            <th style="width: 140px;">開始日時</th>
            <th style="width: 140px;">終了日時</th>
            <th style="width: 70px;" class="p-0">勤務時間</th>
            <th style="width: 70px;" class="p-0">実労働時間</th>
            <th style="width: 70px;" class="p-0">休憩時間</th>
            <th style="width: 70px;" class="p-0">走行距離</th>
          </tr>
        </thead>
        <tbody class="root-list-body">
          <tr class="" style="height:28px;text-align-last: center;">
            <td class="" style="">@(Model.AnkenDegitakoStartDatetime.ToString("yyyy/MM/dd HH:mm"))</td>
            <td class="" style="">@(Model.AnkenDegitakoEndDatetime.ToString("yyyy/MM/dd HH:mm"))</td>
            <td class="" style="">@(Model.AnkenDegitakoWorkTime.ToString("HH:mm"))</td>
            <td class="" style="">@(Model.AnkenDegitakoActualWorkTime.ToString("HH:mm"))</td>
            <td class="" style="">@(Model.AnkenDegitakoBreakTime.ToString("HH:mm"))</td>
            <td class="" style="">@(Model.AnkenDegitakoDistance)</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
  <div class="row" style="">
    <div class="col-6">
    </div>
    <div class="col-6 root-list">
      <table>
        <thead>
          <tr class="" style="text-align-last: center;">
            <th style="width: 130px;background-color:aquamarine;" class="p-0">高速代合計</th>
            <th style="width: 130px;" class="p-0">荷主負担合計</th>
            <th style="width: 130px;" class="p-0">会社負担合計</th>
            <th style="width: 130px;" class="p-0">個人負担合計</th>
          </tr>
        </thead>
        <tbody class="root-list-body">
          <tr class="" style="height:28px;text-align-last: center;">
            <td class="" style=""><div id="disp-TollTotalSum" class="text-center routedisplay ms-0" style="" /></td>
            <td class="" style=""><div id="disp-TollTotalClient" class="text-center routedisplay ms-0" style="" /></td>
            <td class="" style=""><div id="disp-TollTotalCompany" class="text-center routedisplay ms-0" style="" /></td>
            <td class="" style=""><div id="disp-TollTotalPersonal" class="text-center routedisplay ms-0" style="" /></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
  <div class="row" style="margin-top:0.5rem;">
    <div class="col-4">
      @if (Model.HaisyaDataList.Haisya_Kubun != 2)
      {
        <div class="radio-container">
          @Html.RadioButtonFor(m => m.Nippou.RenkeiStatus, 0, new { id = "digitalTachograph" }) <label for="digitalTachograph">デジタコ連携</label>
          @Html.RadioButtonFor(m => m.Nippou.RenkeiStatus, 1, new { id = "manualEntry" }) <label for="manualEntry">手入力</label>
        </div>
      }
      else
      {
        <div style="display:none"><input type="checkbox" id="manualEntry" name="manualEntry" value="1" checked />手入力</div>
      }
    </div>
    <div class="col-8">
      <div class="header">
        <div></div>
        <div>
          <button type="button" class="btn btn-outline-primary" style="width: 200px;" onclick="OvernightModal();" id="btnOvernightModal">泊まり設定</button>
          <button type="button" class="btn btn-outline-primary" style="width: 200px;" onclick="EmptyCarModal();" id="btnEmptyCarModal">空車回送設定</button>
        </div>
      </div>
    </div>
  </div>

  <br />

  <button type="button" class="btn btn-primary btn-sm w-100 p-0" style="" data-bs-toggle="collapse" data-bs-target="#divCollapseHighway" aria-expanded="false" aria-controls="divCollapseHighway">
    <div style="padding: 0rem 2rem;"><span class="size17 float-start" style="">高速代</span><span class=" float-start" style="">▼</span></div>
  </button>
  <div id="divCollapseHighway" class="container collapse show p-0" style="border-collapse: collapse; ">
    <div class="header">
      <div></div>
      <button type="button" class="btn btn-outline-info" style="width:250px;" onclick="HighwayDataModal(this, -1);" id="highwayButton">高速情報追加</button>
      <div class="all-setting">
        <div style="text-align: center;">一括設定</div>
        <div class="highway-buttons2">
          <button type="button" class="btn btn-outline-dark" style="width:100px;" id="clientButton" onclick="changeFutanKubun(3)">荷主負担</button>
          <button type="button" class="btn btn-outline-dark" style="width:100px;" id="companyButton" onclick="changeFutanKubun(2)">会社負担</button>
          @if (Model.HaisyaDataList.Haisya_Kubun != 2)
          {
            <button type="button" class="btn btn-outline-dark" style="width:100px;" id="personalButton" onclick="changeFutanKubun(1)">個人負担</button>
          }
        </div>
      </div>
    </div>
    <div class="highway-list">
      <table class="table table-HaisyaWeb">
        <thead class="table-active">
          <tr>
            <th style="width:200px;">開始日時</th>
            <th style="width:300px;">開始道路名</th>
            <th>開始IC名</th>
            <th style="width:150px;">精算区分名</th>
            <th style="width:120px;">料金</th>
            <th style="width:120px;" rowspan="2">負担選択</th>
            <th style="width:60px;" rowspan="2">保存</th>
          </tr>
          <tr>
            <th>終了日時</th>
            <th>終了道路名</th>
            <th>終了IC名</th>
            <th>読取NO</th>
            <th>走行距離</th>
          </tr>
        </thead>
        <tbody id="highwayDataTable" style="display: none;">
          @{
            var index = 0;

            var datalist = Model.NippouTollDegitako.Where(m => m.開始日時 >= Model.AnkenDegitakoStartDatetime && m.終了日時 <= Model.AnkenDegitakoEndDatetime).ToList();
          }
          @foreach (var item in datalist)
          {
            <tr data-index="@index" style="border-bottom: 0.05em dashed #cfcfcf;">
              <td onclick="HighwayDataModal(this, @index);" class="text-ceter pointer" style="">@Html.DisplayFor(modelItem => item.開始日時)</td>
              <td onclick="HighwayDataModal(this, @index);" class="pointer" style="">@Html.DisplayFor(modelItem => item.開始道路名)</td>
              <td onclick="HighwayDataModal(this, @index);" class="pointer" style="">@Html.DisplayFor(modelItem => item.開始IC名)</td>
              <td onclick="HighwayDataModal(this, @index);" hidden><input type="hidden" id="start-ic" value="@item.開始IC名" /></td>
              <td onclick="HighwayDataModal(this, @index);" class="text-ceter pointer" style="">@Html.DisplayFor(modelItem => item.精算区分名)</td>
              <td onclick="HighwayDataModal(this, @index);" class="text-end toll-money pointer" style="">@String.Format("{0:N0}", item.料金)円</td>
              <td rowspan="2" class="text-ceter p-0" style="align-content: center; border-bottom: 1px solid #000000;">
                @Html.DropDownListFor(
                     m => item.Futan_Kubun,
                     new SelectList(Model.FutanKubunList, "Value", "Text"),
                       new { @class = "form-control list text-center futan-select", @id = "entry" }
                 )
              </td>
              <td rowspan="2" class="text-ceter p-0" style="align-content: center; border-bottom: 1px solid #000000;"><button type="button" class="highway-button" onClick="saveHighwayDataFutanKubunChange(@index)">保存</button></td>
            </tr>
            <tr data-index="@index" onclick="HighwayDataModal(this, @index);" >
              <td class="text-ceter pointer" style="">@Html.DisplayFor(modelItem => item.終了日時)</td>
              <td class="pointer" style="">@Html.DisplayFor(modelItem => item.終了道路名)</td>
              <td hidden><input type="hidden" id="end-ic" value="@item.終了IC名" /></td>
              <td class="pointer" style="">@Html.DisplayFor(modelItem => item.終了IC名)</td>
              <td class="text-ceter pointer" style="">@Html.DisplayFor(modelItem => item.読取NO)</td>
              <td class="text-end pointer" style="">@Html.DisplayFor(modelItem => item.走行距離)km</td>
            </tr>
            index++;
          }
        </tbody>
        <tbody id="nippouTollTable" style="display: none;">
          @{
            index = 0;
          }
          @foreach (var item1 in Model.NippouToll)
          {
            <tr data-index="@index" style="border-bottom: 0.05em dashed #cfcfcf;">
              <td onclick="HighwayDataModal(this, @index);" class="text-ceter pointer" style="">@Html.DisplayFor(modelItem => item1.開始日時)</td>
              <td onclick="HighwayDataModal(this, @index);" class="pointer" style="">@Html.DisplayFor(modelItem => item1.開始道路名)</td>
              <td onclick="HighwayDataModal(this, @index);" class="pointer" style="">@Html.DisplayFor(modelItem => item1.開始IC名)</td>
              <td onclick="HighwayDataModal(this, @index);" class="pointer" style=""></td>
              <td onclick="HighwayDataModal(this, @index);" class="text-end toll-money pointer" style="">@String.Format("{0:N0}", item1.料金)円</td>
              <td rowspan="2">
                @Html.DropDownListFor(
                   m => item1.Futan_Kubun,
                   new SelectList(Model.FutanKubunList, "Value", "Text"),
                       new { @class = "form-control list text-center futan-select", @id = "entry", onchange = $"onNippouTollFutanKubunChange(this, {index})" }
               )
              </td>
              <td rowspan="2"><button type="button" class="highway-button" onClick="saveNippouTollDataChange(@index)">保存</button></td>
            </tr>
            <tr data-index="@index">
              <td onclick="HighwayDataModal(this, @index);" class="text-ceter pointer" style="">@Html.DisplayFor(modelItem => item1.終了日時)</td>
              <td onclick="HighwayDataModal(this, @index);" class="pointer" style="">@Html.DisplayFor(modelItem => item1.終了道路名)</td>
              <td onclick="HighwayDataModal(this, @index);" class="pointer" style="">@Html.DisplayFor(modelItem => item1.終了IC名)</td>
              <td onclick="HighwayDataModal(this, @index);" class="pointer" style=""></td>
              <td onclick="HighwayDataModal(this, @index);" class="text-end pointer" style="">@Html.DisplayFor(modelItem => item1.走行距離)km</td>
            </tr>
            index++;
          }
        </tbody>
      </table>
    </div>
  </div>
  <br />

  <button type="button" class="btn btn-primary btn-sm p-0 w-100" style="" data-bs-toggle="collapse" data-bs-target="#divCollapseOtherPaid" aria-expanded="false" aria-controls="divCollapseOtherPaid">
    <div style="padding: 0rem 2rem;"><span class="size17 float-start" style="">その他有料代</span><span class="float-start" style="">▼</span></div>
  </button>
  <div id="divCollapseOtherPaid" class="container collapse show p-0" style="border-collapse: collapse; ">
    <div class="header">
      <div></div>
      <div>
        <button type="button" class="btn btn-outline-info" style="width:100px;" onclick="OtherPaidModal(this, -1);">追加</button>
      </div>
    </div>
    @await Html.PartialAsync("OthderPaidList", Model)

  </div>
  <br />
</div>


<script>

  if (typeof NippouToll === 'undefined') {
    var NippouToll = JSON.parse('@Html.Raw(Json.Serialize(Model.NippouToll))') || [];
  } else {
    NippouToll = JSON.parse('@Html.Raw(Json.Serialize(Model.NippouToll))') || [];
  }
  if (typeof OtherPaidData === 'undefined') {
    var OtherPaidData = JSON.parse('@Html.Raw(Json.Serialize(Model.NippouTollOther))') || [];
  } else {
    OtherPaidData = JSON.parse('@Html.Raw(Json.Serialize(Model.NippouTollOther))') || [];
  }
  var NippouApproval = JSON.parse('@Html.Raw(Json.Serialize(Model.NippouApproval))');
  var NippouStay = JSON.parse('@Html.Raw(Json.Serialize(Model.Nippou_Stay))');
  var NippouKaiso = JSON.parse('@Html.Raw(Json.Serialize(Model.Nippou_Kaiso))');
  var NippouStayDegitakoIdList = JSON.parse('@Html.Raw(Json.Serialize(Model.NippouStayDegitakoIdList))') || [];
  var NippouKaisoDegitakoIdList = JSON.parse('@Html.Raw(Json.Serialize(Model.NippouKaisoDegitakoIdList))') || [];
  var InitialDisplayNippouTollOther = JSON.parse('@Html.Raw(Json.Serialize(Model.InitialDisplayNippouTollOther))') || [];
  var InitialDisplayNippouToll = JSON.parse('@Html.Raw(Json.Serialize(Model.InitialDisplayNippouToll))') || [];
  var HighwayData = JSON.parse('@Html.Raw(Json.Serialize(Model.HighwayData))') || [];
  var NippouTollDegitako = JSON.parse('@Html.Raw(Json.Serialize(Model.NippouTollDegitako.Where(m => m.開始日時 >= Model.AnkenDegitakoStartDatetime && m.終了日時 <= Model.AnkenDegitakoEndDatetime).ToList()))') || [];

  /** 案件期間のデジタコ選択 */
  let AnkenDegitakoStartId = Number(@Html.Raw(Json.Serialize(Model.AnkenDegitakoStartId)));
  let AnkenDegitakoStartDatetime = new Date('@Html.Raw(Json.Serialize(Model.AnkenDegitakoStartDatetime))');
  let AnkenDegitakoEndId = Number(@Html.Raw(Json.Serialize(Model.AnkenDegitakoEndId)));
  let AnkenDegitakoEndDatetime = new Date('@Html.Raw(Json.Serialize(Model.AnkenDegitakoEndDatetime))');
  let AnkenDegitakoDistance = parseFloat(@Html.Raw(Json.Serialize(Model.AnkenDegitakoDistance)));
  let AnkenDegitakoBreakTime = new Date('@Html.Raw(Json.Serialize(Model.AnkenDegitakoBreakTime))');
  let AnkenDegitakoWorkTime = new Date('@Html.Raw(Json.Serialize(Model.AnkenDegitakoWorkTime))');
  let AnkenDegitakoActualWorkTime = new Date('@Html.Raw(Json.Serialize(Model.AnkenDegitakoActualWorkTime))');



  // 変更内容があるかどうかのデータチェック
  function DataCheck() {
    let nippouKaisoDegitakoIdList = $('#NippouKaisoDegitakoIdList').val() || "";
    const nippouKaisoDegitakoIdListInt = nippouKaisoDegitakoIdList.split(",")
      .map(function(item) {
        return parseInt(item, 10);
      })
      .filter(function(item) {
        return !isNaN(item);
      });

    let nippouStayDegitakoIdList = $('#NippouStayDegitakoIdList').val() || "";

    const nippouStayDegitakoIdListInt = nippouStayDegitakoIdList.split(",")
      .map(function(item) {
        return parseInt(item, 10);
      })
      .filter(function(item) {
        return !isNaN(item);
      });
    const isStayIdListEqual = compareArrays(NippouStayDegitakoIdList, nippouStayDegitakoIdListInt);

    if (!isStayIdListEqual) {
      return false;
    }

    const isKaisoIdListEqual = compareArrays(NippouKaisoDegitakoIdList, nippouKaisoDegitakoIdListInt);

    // Change 負担選択 at 高速代
    if (!compareFutanKubun(InitialDisplayNippouToll, NippouToll)) {
      return false;
    }

    // Change 負担選択 at その他有料代
    if (!compareFutanKubun(InitialDisplayNippouTollOther, OtherPaidData)) {
      return false;
    }

    if (!isKaisoIdListEqual) {
      return false;
    }
    // 泊まり設定の比較
    if ((NippouStay.start_Datetime || '') !== $('#Nippou_Stay_Start_Datetime').val()) return false;
    if ((NippouStay.end_Datetime || '') !== $('#Nippou_Stay_End_Datetime').val()) return false;
    if ((NippouStay.start_ShikuName || '') !== $('#Nippou_Stay_Start_ShikuName').val()) return false;
    if ((NippouStay.end_ShikuName || '') !== $('#Nippou_Stay_End_ShikuName').val()) return false;

    const formIntervalTime = $('#Nippou_Stay_Interval_Time').val();
    if ((NippouStay.interval_Time === null && formIntervalTime !== '') ||
      (NippouStay.interval_Time !== null && parseInt(formIntervalTime) !== NippouStay.interval_Time)) {
      return false;
    }

    const formDllowance = parseFloat($('#Nippou_Stay_Dllowance').val() || 0);
    if (NippouStay.dllowance !== formDllowance) return false;


    // 空車回送設定の比較
    if ((NippouKaiso.start_Datetime || '') !== $('#Nippou_Kaiso_Start_Datetime').val()) return false;
    if ((NippouKaiso.end_Datetime || '') !== $('#Nippou_Kaiso_End_Datetime').val()) return false;
    if ((NippouKaiso.start_ShikuName || '') !== $('#Nippou_Kaiso_Start_ShikuName').val()) return false;
    if ((NippouKaiso.end_ShikuName || '') !== $('#Nippou_Kaiso_End_ShikuName').val()) return false;
    if ((NippouKaiso.commnet || '') !== $('#Nippou_Kaiso_Commnet').val()) return false;

    // distanceの比較
    const formDistance = $('#Nippou_Kaiso_Distance').val();
    if ((NippouKaiso.distance === null && formDistance !== '') ||
      (NippouKaiso.distance !== null && parseInt(formDistance) !== NippouKaiso.distance)) {
      return false;
    }

    // dllowanceの比較
    const formKaisoDllowance = parseFloat($('#Nippou_Kaiso_Dllowance').val() || 0);
    if (NippouKaiso.dllowance !== formKaisoDllowance) return false;

    if (!compareLists(NippouToll, InitialDisplayNippouToll)) {
      return false;
    }

    // その他有料代の比較
    if (!compareLists(OtherPaidData, InitialDisplayNippouTollOther)) {
      return false;
    }

    return true;
  }

    function compareFutanKubun(array1, array2) {
        if (array1.length !== array2.length) return false;

        return array1.every((obj1, index) => obj1.futan_Kubun === array2[index].futan_Kubun);
    }

    function compareArrays(arr1, arr2) {
    if (arr1.length !== arr2.length) {
      return false;
    }

    // 配列をソートしてから比較
    const sortedArr1 = [...arr1].sort();
    const sortedArr2 = [...arr2].sort();

    for (let i = 0; i < sortedArr1.length; i++) {
      if (sortedArr1[i] !== sortedArr2[i]) {
        return false;
      }
    }

    return true;
  }

  function compareObjects(obj1, obj2) {
    return obj1.Toll_Kubun === obj2.Toll_Kubun &&
      obj1.Start_Name === obj2.Start_Name &&
      obj1.End_Name === obj2.End_Name &&
      obj1.Toll_Fee === obj2.Toll_Fee;
  }

  function compareLists(list1, list2) {
    if (list1.length !== list2.length) return false;
    for (let i = 0; i < list1.length; i++) {
      if (!compareObjects(list1[i], list2[i])) return false;
    }
    return true;
  }

  $(function () {
    //ラジオボタンの表示・非表示を制御
    var isManualEntry = $('#manualEntry').is(':checked') || @(Model.HaisyaDataList.Haisya_Kubun == 2 ? "true" : "false");

    $('#distanceInputContainer').toggle(isManualEntry);
    //案件情報の表示・非表示を制御
    var isManualEntry = $('#digitalTachograph').is(':checked') && @(Model.HaisyaDataList.Haisya_Kubun != 2 ? "true" : "false");

    // $('#distanceContainer').collapse(isManualEntry == true ? 'show':'hide');

    $('#digitalTachograph, #manualEntry').change(function() {
      var isManualEntry = $('#manualEntry').is(':checked') || @(Model.HaisyaDataList.Haisya_Kubun == 2 ? "true" : "false");
      $('#distanceInputContainer').toggle(isManualEntry);
      var isManualEntry = $('#digitalTachograph').is(':checked') && @(Model.HaisyaDataList.Haisya_Kubun != 2 ? "true" : "false");
      // $('#distanceContainer').toggle(isManualEntry);
      // $('#distanceContainer').collapse(isManualEntry == true ? 'show':'hide');
    });


    $('#NippouStayDegitakoIdList').val(@Html.Raw(Json.Serialize(Model.NippouStayDegitakoIdList)));
    $('#NippouKaisoDegitakoIdList').val(@Html.Raw(Json.Serialize(Model.NippouKaisoDegitakoIdList)));


    $('.futan-select').change(function() {
        CalcTollMoney();
    });

    CalcTollMoney();
  });

  $(document).ready(function() {
    $('#digitalTachograph, #manualEntry').change(updateTableVisibility);

    updateTableVisibility();
    updateNippouDetails();
    
  });

  function updateNippouDetails(){
    $('#Nippou_Kaiso_Start_Datetime').val('@Model.Nippou_Kaiso?.Start_Datetime');
    $('#Nippou_Kaiso_Start_ShikuName').val('@Html.Raw(Model.Nippou_Kaiso?.Start_ShikuName)');
    $('#Nippou_Kaiso_End_Datetime').val('@Model.Nippou_Kaiso?.End_Datetime');
    $('#Nippou_Kaiso_End_ShikuName').val('@Html.Raw(Model.Nippou_Kaiso?.End_ShikuName)');
    $('#Nippou_Kaiso_Disatnce').val('@Model.Nippou_Kaiso?.Distance');
    $('#Nippou_Kaiso_Dllowance').val('@Model.Nippou_Kaiso?.Dllowance');
    $('#Nippou_Kaiso_Day').val('@Model.Nippou_Kaiso?.Day');
    $('#Nippou_Kaiso_Commnet').val('@Html.Raw(Model.Nippou_Kaiso?.Commnet)');

    $('#Nippou_Stay_Start_Datetime').val('@Model.Nippou_Stay?.Start_Datetime');
    $('#Nippou_Stay_End_Datetime').val('@Model.Nippou_Stay?.End_Datetime');
    $('#Nippou_Stay_Start_ShikuName').val('@Html.Raw(Model.Nippou_Stay?.Start_ShikuName)');
    $('#Nippou_Stay_End_ShikuName').val('@Html.Raw(Model.Nippou_Stay?.End_ShikuName)');
