    // HighwayDataから該当するindexの行を取得

    var activeData = NippouTollDegitako;
    var selectedRowIndex = NippouTollDegitako.findIndex(record =>
      record.開始IC名 === row.find('#start-ic').val() &&
      record.終了IC名 === row.find('#end-ic').val()
    );

    if (selectedRowIndex < 0){
      selectedRowIndex = NippouToll.findIndex(record =>
        record.開始IC名 === row.find('#start-ic').val() &&
        record.終了IC名 === row.find('#end-ic').val()
      );
      activeData = NippouToll;
    }
    var selectedRow = activeData[selectedRowIndex];
    // 選択された負担区分を取得
    var selectedFutanKubun = row.find('select').val();

    // T_Nippou_Tollモデルに合わせてデータを整形
    var formattedData = {
      nippou_Toll_ID: 0,
      nippou_ID: 0,
      sort: selectedRow.sort,
      運行NO: selectedRow.運行NO || '',
      読取日: selectedRow.読取日 ? new Date(selectedRow.読取日) : null,
      事業所CD: null,
      運行日: new Date(selectedRow.開始日時),
      事業所名: selectedRow.事業所名 || '',
      車輌CD: selectedRow.車輌CD || null,
      車輌名: selectedRow.車輌名 || '',
      乗務員CD: selectedRow.乗務員CD || null,
      乗務員名: selectedRow.乗務員名 || '',
      対象乗務員区分: null,
      開始日時: selectedRow.開始日時 || null,
      終了日時: selectedRow.終了日時 || null,
      開始道路番号: selectedRow.開始道路番号 || '',
      開始道路名: selectedRow.開始道路名 || '',
      開始ETC番号: selectedRow.開始ETC番号 || '',
      開始IC名: selectedRow.開始IC名 || '',
      終了道路番号: selectedRow.終了道路番号 || '',
      終了道路名: selectedRow.終了道路名 || '',
      終了ETC番号: selectedRow.終了ETC番号 || '',
      終了IC名: selectedRow.終了IC名 || '',
      精算区分: null,
      精算区分名: '',
      料金: selectedRow.料金 || '',
      走行距離: selectedRow.走行距離 || null,
      高速車種区分: null,
      高速車種区分名: '',
      標準料金: null,
      料金区分: null,
      料金区分名: '',
      futan_Kubun: parseInt(selectedFutanKubun),
      insert_Datetime: new Date(),
      insert_User: null,
      update_Datetime: new Date(),
      update_User: null
    };

    activeData[index].futan_Kubun = selectedFutanKubun;

    var existingRecordIndex = NippouToll.findIndex(record =>
      record.開始IC名 === formattedData.開始IC名 &&
      record.終了IC名 === formattedData.終了IC名
    );

    if (existingRecordIndex !== -1) {
      // 既存のレコードが見つかった場合、更新する
      NippouToll[existingRecordIndex] = {
        ...NippouToll[existingRecordIndex],
          ...formattedData,
          Nippou_Toll_ID: NippouToll[existingRecordIndex].Nippou_Toll_ID, // 既存のIDを保持
          Update_Datetime: new Date() // 更新日時を現在の日時に設定
      };
    } else {
      // 既存のレコードが見つからなかった場合、新しいレコードを追加
      var KUDGSIRIdList = $('#KUDGSIRIdList').val().split(',');

      // selectedRowのIDがすでにKUDGSIRIdListに含まれていない場合のみ追加
      if (!KUDGSIRIdList.includes(selectedRow.id)) {
        KUDGSIRIdList.push(selectedRow.id);
      }

      // 配列を再度文字列に変換して、inputの値を更新
      $('#KUDGSIRIdList').val(KUDGSIRIdList.join(','));
      NippouToll.push(formattedData);
    }
  }

