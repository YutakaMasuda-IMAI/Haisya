      alertMessage = alertMessage + "終了日時を選択してください。";
      isValid = false;
    }

    if ($('#startICName').val().trim() === "") {
      if (alertMessage !== "") {
        alertMessage = alertMessage + "<br>";
      }
      alertMessage = alertMessage + "開始IC名を入力してください。";
      isValid = false;
    }

    if ($('#endICName').val().trim() === "") {
      if (alertMessage !== "") {
        alertMessage = alertMessage + "<br>";
      }
      alertMessage = alertMessage + "終了IC名を入力してください。";
      isValid = false;
