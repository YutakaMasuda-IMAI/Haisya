  /** 有料料金を集計して集計結果を表示 */
  function CalcTollMoney() {

    let totalTollMoney = 0;
    let companyTollMoney = 0;
    let clientTollMoney = 0;
    let personalTollMoney = 0;

    let bodys = ["highwayDataTable", "nippouTollTable", "otherTollTable"];

    for (let i = 0; i < bodys.length; i++) {
      $('#' + bodys[i] + ' tr').each(function() {
          // 現在の行を取得
          let currentRow = $(this);
          let rowId = currentRow.data('index');

          // 行内のセルの値を取得（例: 最初のセル）
          let futankubun = currentRow.find('.futan-select').val();
          let futankubunText = currentRow.find('.futan-select').text();

          if (typeof futankubunText === "undefined") {
          } else {
              let tollmoneyText = currentRow.find('.toll-money').text();
              tollmoneyText = tollmoneyText.replace('円','').replace(',','').replace(',','');
              let tollmoney = Number(tollmoneyText);
              if (isNumber(tollmoney)) {
                  totalTollMoney += Number(tollmoney);
                  if (futankubun === '1') { personalTollMoney += Number(tollmoney); }
                  if (futankubun === '2') { companyTollMoney += Number(tollmoney); }
                  if (futankubun === '3') { clientTollMoney += Number(tollmoney); }
              }
          }

      });
    }

    $("#disp-TollTotalSum").text(kanmaChange2(totalTollMoney));
    $("#disp-TollTotalCompany").text(kanmaChange2(companyTollMoney));
    $("#disp-TollTotalClient").text(kanmaChange2(clientTollMoney));
    $("#disp-TollTotalPersonal").text(kanmaChange2(personalTollMoney));
  }
