@model HaisyaWeb.Models.FixAmountApprovalDetailModel.DataListModel
@{
  Layout = "_Layout";
  ViewData["Title"] = "請求問合わせ変更承認";
}

<head>
  <link href="~/css/Entry.css" rel="stylesheet" />
  <style>
    .detail-list {
      background-color: #d5d5d5;
    }
  </style>
</head>

<body>
  <div id="hiddenItem" hidden>
    @Html.HiddenFor(model => Model.Search.SelectDay)
    @Html.HiddenFor(model => Model.Search.SelectShimebi)
    @Html.HiddenFor(model => Model.Search.SelectSeikyuTantou)
    @Html.HiddenFor(model => Model.Search.SelectZeiKubun)
    @Html.HiddenFor(model => Model.Search.SelectHakkouKubun)
    @Html.HiddenFor(model => Model.Search.SelectKingakuHenkou)
    @Html.HiddenFor(model => Model.Search.BackMenuAction)
    @Html.HiddenFor(model => Model.Search.SelectTokuisakiID)
    @Html.HiddenFor(model => Model.Search.SelectTokuisakiName)
    @Html.HiddenFor(model => Model.Search.SelectTokuisakiIDTo)
    @Html.HiddenFor(model => Model.Search.SelectTokuisakiNameTo)
    @Html.HiddenFor(model => Model.Search.IsSelectTokuisaki)
  </div>
  <div>
    @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "Form" }))
    {
      <div id="hedder" class="row">
        <div class="table-div">
          <table class="head-button">
            <tr>
              <td width="350px"><h3 id="labelTitle" class="heading-40">請求問合わせ変更承認</h3></td>
              <td></td>
              <td style="text-align:right;"><button type="button" class="btn btn-outline-warning" style="width:100px;" onClick="backToList(); return false;">一覧に戻る</button></td>
            </tr>
          </table>
        </div>
      </div>

      <div class="table-div">
        <table id="select" class="list" border="1">
          <thead>
            <tr align="center">
              <th class="detail-list" width="100px">請求年月</th>
              <th class="detail-list" width="100px">締日</th>
              <th class="detail-list" width="100px">税区分</th>
              <th class="detail-list" width="100px">確認方法</th>
              <th class="detail-list" width="100px">ステータス</th>
              <th class="detail-list" width="100px">金額変更</th>
              <th class="detail-list" width="200px">請求担当</th>
              <th class="detail-list">請求先</th>
              <th class="detail-list" width="100px">明細件数</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td id='Seikyu_Month' align="center">@(Model.SeikyuCheckData?.Seikyu_Month.ToString("yyyy/MM/dd"))</td>
              <td align="center">@(Model.SeikyuCheckData?.Shime_Day)日</td>
              <td align="center">@(Model.SeikyuCheckData?.Zei_Kubun == 0 ? "課税" : "非課税")</td>
              <td align="center">@(Model.SeikyuCheckData?.Inquiry_Status == 1 ? "WEB":"帳票" )</td>
              <td align="center">
                @{
                  string Check_Status = "";
                  Check_Status = Model.SeikyuCheckData?.Check_Status == 0 ? "発行済み" :
                            Model.SeikyuCheckData?.Check_Status == 1 ? "確認中" :
                            Model.SeikyuCheckData?.Check_Status == 2 ? "確認済" :
                            Model.SeikyuCheckData?.Check_Status == 4 ? "承認済" :
                            "";
                }
                @Check_Status
              </td>
              <td align="center">
                @{
                  string seikyuChanged = Model.SeikyuCheckData?.Seikyu_Changed == 0 ? "なし" : "あり";
                }
                @seikyuChanged
              </td>
              <td>@(Model.SeikyuCheckData?.Seikyu_Tantou)</td>
              <td>@(Model.SeikyuCheckData?.Customer_Name)</td>
              <td align="right">
                @Convert.ToInt32(Model.SeikyuCheckData?.Meisai_Count).ToString("#,0")
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    }
  </div>

  <div class="table-div" style="margin-top:10px;">
    <table id="tblCollapse" class="list" border="1">
      <thead>
        <tr align="center">
          <th class="detail-list" width="100px" rowspan="2">運賃計</th>
          <th class="detail-list" width="100px" rowspan="2">立替計</th>
          <th class="detail-list" width="100px" rowspan="2">案件件数</th>
          <th class="detail-list" width="100px" rowspan="2">請求確定件数</th>
          <th class="detail-list" width="100px" rowspan="2">暫定件数</th>
          <th class="detail-list" width="100px" rowspan="2">仮件数</th>
          <th class="detail-list" width="100px" rowspan="2">税区分</th>
          <th class="detail-list">送信アドレス１</th>
          <th class="detail-list" width="200px">電話番号１</th>
          <th class="detail-list" width="200px">FAX番号１</th>
        </tr>
        <tr align="center">
          <th class="detail-list">送信アドレス２</th>
          <th class="detail-list">電話番号２</th>
          <th class="detail-list">FAX番号２</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td align="right" rowspan="2">@Convert.ToInt32(Model.SeikyuCheckData?.SeikyuUnchin).ToString("#,0")</td>
          <td align="right" rowspan="2">@Convert.ToInt32(Model.SeikyuCheckData?.Tatekaekin).ToString("#,0")</td>
          <td align="right" rowspan="2">@Convert.ToInt32(Model.SeikyuCheckData?.Anken_Count).ToString("#,0")</td>
          <td align="right" rowspan="2">@Convert.ToInt32(Model.SeikyuCheckData?.Kakutei_Count).ToString("#,0")</td>
          <td align="right" rowspan="2">@Convert.ToInt32(Model.SeikyuCheckData?.Zantei_Count).ToString("#,0")</td>
          <td align="right" rowspan="2">@Convert.ToInt32(Model.SeikyuCheckData?.Kari_Count).ToString("#,0")</td>
          <td align="center" rowspan="2">
            @(Model.SeikyuCheckData?.Zei_Kubun == 0 ? "課税" : Model.SeikyuCheckData?.Zei_Kubun == 1 ? "非課税" : "")
          </td>
          <td align="center">@(Model.SeikyuCheckData?.Mail_Address1)&nbsp;</td>
          <td align="center">@(Model.SeikyuCheckData?.Phone1)</td>
          <td align="center">@(Model.SeikyuCheckData?.Fax1)</td>
        </tr>
        <tr>
          <td align="center">@(Model.SeikyuCheckData?.Mail_Address2)&nbsp;</td>
          <td align="center">@(Model.SeikyuCheckData?.Phone2)</td>
          <td align="center">@(Model.SeikyuCheckData?.Fax2)</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="category-title">集計値</div>
  <div class="table-div" style="margin-top:5px;">
    <table id="total" class="list">
      <thead>
        <tr align="center">
          <th class="detail-list" width="100px">前回請求額</th>
          <th class="detail-list" width="100px">今回入金額</th>
          <th class="detail-list" width="100px">(内 値引・調整)</th>
          <th class="detail-list" width="100px">繰越残高</th>
          <th class="detail-list" width="100px">課税対象額</th>
          <th class="detail-list" width="100px">消費税額</th>
          <th class="detail-list" width="100px">今回請求額</th>
          <th class="detail-list" width="100px">請求額合計</th>
          <td style="border:none;"></td>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td align="right">
            @Convert.ToInt32(Model.SyuukeiData?.Seikyu_Previous).ToString("#,0")
          </td>
          <td align="right">
            @Convert.ToInt32(Model.SyuukeiData?.Received_Amount_This).ToString("#,0")
          </td>
          @* <td align="right">@(Model.SyuukeiData?.Discount)</td> *@
          <td align="right"></td>
          <td align="right">
            @Convert.ToInt32(Model.SyuukeiData?.Balance_Forward).ToString("#,0")
          </td>
          <td align="right">
            @Convert.ToInt32(Model.SyuukeiData?.Taxable_Amount).ToString("#,0")
          </td>
          <td align="right">
            @Convert.ToInt32(Model.SyuukeiData?.Tax_Amout).ToString("#,0")
          </td>
          <td align="right">
            @Convert.ToInt32(Model.SeikyuCheckData?.SeikyuUnchin).ToString("#,0")
          </td>
          <td align="right">
            @Convert.ToInt32(Model.SyuukeiData?.Seikyu_Total_Amount).ToString("#,0")
          </td>
          <td style="border:none;"></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="table-div">
    <div id="FixAmountApprovalDetail_ClaimDataList" style="margin-top: 25px;"></div>
  </div>
</body>


<script>
  const weeks = ['日', '月', '火', '水', '木', '金', '土'];

  $(window).on('load', function () {
    var disp = new Date($('#Search_SelectDay').val());

    /** 日付を文字列にフォーマットする */
    var formatted = `${disp.getFullYear()}\年${(disp.getMonth() + 1).toString().padStart(2, '0')}\月`.replace(
      /\n|\r/g,
      '',
    );
    $('input#TargetDayLavel').val(formatted);
    $('input#TargetDayLavel_To').val(formatted);

    dataListDisplay();
  });

  $(document).ready(function () {
    $(document).on('show.bs.modal', '.modal', (e) => {
      const $currentModal = $(e.currentTarget);
      var zIndex = 1040 + 10 * ($('.modal:visible').length || 2);
      $currentModal.css('z-index', zIndex);
      setTimeout(function () {
        $('.modal-backdrop')
          .not('.modal-stack')
          .css('z-index', zIndex - 1)
          .addClass('modal-stack');
      }, 0);
    });
  });

  function ModalClose() {
    $('#ModalHere').find('.modal').modal('hide');
  }

  function closeModel() {
    $('#ModalHere').find('.modal').modal('hide');
    $('#ModalStatusHaisya').find('.modal').modal('hide');
  }

  function dataListDisplay() {
    $.post(
      '@Url.RouteUrl("Default", new { controller = "FixAmountApprovalDetail", Action = "JsonGetDataListForFixApprovalDetail" })',
      {
        SelectDay: $('#Seikyu_Month').text(),
        Customer_Branch_ID: '@(Model.SeikyuCheckData?.Customer_Branch_ID)',
        Check_Seikyu_ID: '@(Model.SeikyuCheckData?.Check_Seikyu_ID)',
        Print_Seikyu_ID: '@(Model.SyuukeiData?.Print_Seikyu_ID)',
      },
      function (data) {
        $('#FixAmountApprovalDetail_ClaimDataList').html(data.partialView);
      },
    );
  }

  /// <summary>
  /// リスト画面に戻る
  /// </summary>
  function backToList() {
    var form = document.createElement('form');
    form.action =
      '@Url.RouteUrl("Default", new { controller = "FixAmountApproval", Action = "FixAmountApprovalIndex" })';
    form.method = 'POST';

    var params = [
      'SelectDay',
      'SelectShimebi',
      'SelectSeikyuTantou',
      'SelectZeiKubun',
      'SelectHakkouKubun',
      'SelectKingakuHenkou',
      'BackMenuAction',
      'SelectTokuisakiID',
      'SelectTokuisakiName',
      'SelectTokuisakiIDTo',
      'SelectTokuisakiNameTo',
      'IsSelectTokuisaki'
    ];

    params.forEach(function (param) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = param;
      input.value = document.getElementById('Search_' + param).value;
      form.appendChild(input);
    });

    document.body.appendChild(form);
    form.submit();
  }
</script>