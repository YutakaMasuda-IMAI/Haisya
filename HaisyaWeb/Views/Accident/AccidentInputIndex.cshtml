      // バリデーション関数
    function validateForm() {
        var isValid = true;
        var errorMessages = [];

        if (!$("#Jiko_Jiko_Kubun").val()) {
            isValid = false;
            errorMessages.push("事故区分");
        }

        if (!$("#Jiko_Jiko_WorkFlow_Base_ID").val()) {
            isValid = false;
            errorMessages.push("ワークフロー");
        }

        if (!$("#Jiko_Haisya_Group_ID").val()) {
            isValid = false;
            errorMessages.push("配車担当");
        }

        if (!$("#Jiko_Jiko_Display").val()) {
            isValid = false;
            errorMessages.push("事故名");
        }

        if (!$("#Jiko_Jiko_Date").val()) {
            isValid = false;
            errorMessages.push("事故発生日");
        }

        if (parseInt($("#Jiko_Driver_ID").val()) === 0) {
            isValid = false;
            errorMessages.push("当事者");
        }

        if ($("#Road_Width").val() != '' && (parseFloat($("#Road_Width").val()) || 0) == 0) {
            isValid = false;
            errorMessages.push("道幅");
        }

         if (!isValid) {
            alertError(errorMessages.join("と") + "を入力または選択してください");
        }

        return isValid;

    }

    function validateJikoTypeList() {
        var isValid = true;
        var totalRows = $("#JikoTypeListTableBody tr").length;

        $("#JikoTypeListTableBody tr").each(function(index) {
            var $row = $(this);
            var jikoTypeId = parseInt($row.find("#Jiko_Type_ID").val()) || 0;
            var jikoTypeRemarks = $row.find("#Jiko_Type_Remarks").val() || "";

            // 最後のレコード以外で Jiko_Type_ID が 0 または NaN の場合、エラーフラグを立てる
            if (index < totalRows - 1 && (isNaN(jikoTypeId) || jikoTypeId === 0)) {
                isValid = false;
            }

            // 最後の行の jikoTypeId が 0 の場合に jikoTypeRemarks が空でないときに false
            if (index === totalRows - 1 && jikoTypeId === 0 && jikoTypeRemarks !== "") {
                isValid = false;
            }
        });

        var allRowsValid = true;
        $("#JikoTypeListTableBody tr").each(function() {
            var $row = $(this);
            var jikoTypeId = parseInt($row.find("#Jiko_Type_ID").val()) || 0;
            var jikoTypeRemarks = $row.find("#Jiko_Type_Remarks").val() || "";

            if (jikoTypeId !== 0) {
                // この行は無視する
                allRowsValid = false;
            }
        });

        if (!isValid && !allRowsValid) {
            alertError('事故種類が選択されていません');
        } else if(!isValid && allRowsValid) {
            isValid = true;
        }
        return isValid
    }

    function ChangeCheck() {
        var isValid = true;
        // T_Jiko_Items情報の変更を検知
        for (var i = 0; i < jikoItemList.length; i++) {
            var item = jikoItemList[i];
            var inputValue = $("#" + item.jiko_Items_Prop_Name).val();

            var itemVal = item.jiko_Items_Val == null ? '' : item.jiko_Items_Val;

            if (item.jiko_Items_Prop_Name === "KokyakuId" && itemVal === "") {
                itemVal = "0";
            }

            if (item.jiko_Items_Type.toLowerCase() === "int") {
              if (inputValue !== undefined && inputValue != "") {
                inputValue = parseInt(kanmaChangeRevert(inputValue)) || 0;
                itemVal = parseInt(kanmaChangeRevert(itemVal)) || 0;
              }
            }

            if (item.jiko_Items_Type.toLowerCase() === "double") {
              if (inputValue !== undefined && inputValue != "") {
                inputValue = parseFloat(kanmaChangeRevert(inputValue)) || 0;
                itemVal = parseFloat(kanmaChangeRevert(itemVal)) || 0;
              }
            }

            if (item.jiko_Items_Type.toLowerCase() === "money") {
              if (inputValue !== undefined && inputValue != "") {
                inputValue = parseFloat(kanmaChangeRevert(inputValue)) || 0;
                itemVal = parseFloat(kanmaChangeRevert(itemVal)) || 0;
              }
            }

            if (inputValue !== undefined && inputValue != itemVal) {
                isValid = false;
            }
        }

        // 事故種類の変更を検知
        $("#JikoTypeListTableBody tr").each(function(index) {
            var $row = $(this);

            var modelJikoType = jikoTypeList[index];

            var jikoType = {
                Jiko_Type_ID: parseInt($row.find("#Jiko_Type_ID").val()) || 0,
                Jiko_Type_Remarks: $row.find("#Jiko_Type_Remarks").val() || ""
            };

            if (
                jikoType.Jiko_Type_ID !== (modelJikoType?.jiko_Type_ID || 0) ||
                jikoType.Jiko_Type_Remarks !== (modelJikoType?.jiko_Type_Remarks || "")
            ) {
                isValid = false;
                return false;
            }
        });
        jiko.haisya_Group_ID = jiko.haisya_Group_ID == 0 ? 1 : jiko.haisya_Group_ID;
        // T_Jiko情報の変更を検知
        if(
           jiko.jiko_WorkFlow_Base_ID !== (parseInt($("#Jiko_Jiko_WorkFlow_Base_ID").val()) || 0) ||
            new Date(jiko.jiko_Date).toString() !== new Date($("#Jiko_Jiko_Date").val() + "T00:00:00").toString() ||
            (jiko.jiko_Display || "") !== $("#Jiko_Jiko_Display").val() ||
            jiko.syaryoManagement_ID !== (parseInt($("#Jiko_SyaryoManagement_ID").val()) || 0) ||
            jiko.syaryoManagement_ID1 !== (parseInt($("#Jiko_SyaryoManagement_ID1").val()) || 0) ||
            jiko.jiko_Kubun !== (parseInt($("#Jiko_Jiko_Kubun").val()) || 0) ||
            jiko.haisya_Group_ID !== (parseInt($("#Jiko_Haisya_Group_ID").val()) || 0) ||
            jiko.driver_ID !== (parseInt($("#Jiko_Driver_ID").val()) || 0)
        ) {
            isValid = false;
        }

        return isValid;
    }

    function updateView(){
        $.ajax({
            url: '@Url.RouteUrl("Default", new { controller = "Accident", action = "GetJikoWorkFlowList" })',
            type: 'GET',
            data: { jikoId: jikoId },
            success: function (response) {
                    var updateValue = '<tr>'
                response.forEach((item, index) => {
                    updateValue += '<td style="text-align:center;">'
                    if (item.workFlowStatus != null && item.workFlowStatus.approval_Datetime != null) {
                        var date = new Date(item.workFlowStatus.approval_Datetime);
                        const year = date.getFullYear().toString().slice(-2); // Get last two digits of the year
                        const month = date.getMonth() + 1; // Months are zero-indexed
                        const day = date.getDate();
                        updateValue += `${year}/${month}/${day}`;
                    }
                    updateValue += '<br>'
                    if (item.workFlowStatus != null && item.workFlowStatus.approval_User_ID == @Model.Login_User_ID && item.workFlowStatus.approval_Kubun == 3) {
                        updateValue += '<span>差戻し</span>';
                    } else {
                        updateValue += '<span>&nbsp;</span>';
                    }
                    updateValue += '<br>';
                    updateValue += '<div'
                    if (item.workFlowFlg) {
                        updateValue += 'style=""background-color: rgba(160, 206, 99, 1);"';
                    }
                    updateValue += '>';
                    updateValue += item.display_Name;
                    updateValue += '</div>';
                });
                updateValue += '<td class="noborder">&nbsp;</td>'
                updateValue += '</tr>'
              $('#WorkFlowRouteListTableBody').html(updateValue);
            },
            error: function (xhr, status, error) {
                console.error('Error:', error);
            }
        });
    }
</script>