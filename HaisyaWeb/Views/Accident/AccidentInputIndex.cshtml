@using HaisyaWeb.Dto

@model AccidentModel_Local

@{
    Layout = "_Layout";
    ViewData["Title"] = "事故入力・修正・照会";
}

<head>
<link href="~/css/Anken.css" rel="stylesheet" />
<link href="~/css/Entry.css" rel="stylesheet" />
<script src="https://app.zip-site.com/auth/jsapi/loader.htm"></script>
<style>
  .approval-buttons {
    display: flex;
    justify-content: space-between;
    width: 100%;
  }
  .approval-buttons button {
    flex: 1;
    background-color: rgba(91, 156, 213, 1);
    color: white;
    border: none;
    border-radius: 20px;
  }
  .approval-buttons div {
    height: 20px;
    background-color: rgba(91, 156, 213, 1);
    width: 50px;
    border: none;
    align-self: center;
  }
  .blue-button {
    border-radius: 8px;
    background-color: rgba(91, 156, 213, 1);
    border: none;
    color: white;
    white-space: nowrap;
  }
  #jikoNo {
    padding: 5px 10px;
  }
</style>
</head>

<body>
    <div id="hiddenItem" hidden>
        @Html.HiddenFor(model => Model.Search.FromDate)
        @Html.HiddenFor(model => Model.Search.ToDate)
        @Html.HiddenFor(model => Model.Search.AccidentReason)
        @Html.HiddenFor(model => Model.Search.AccidentName)
        @Html.HiddenFor(model => Model.Search.DriverName)
        @Html.HiddenFor(model => Model.Search.CarNumber)
        @Html.HiddenFor(model => Model.Search.WfRadioButtons)
    </div>
  <div id="hedder" class="row">
    <div class="table-div">
      <table class="head-button">
        <tr>
          <td><h3 id="labelTitle" class="heading-40">事故入力・修正・照会</h3></td>
          <td style="text-align:right;"><button id="draftingButton" class="btn btn-outline-dark" style="width:100px;" onClick="DraftingButton();">起案</button></td>
          <td style="text-align:right;"><button id="submitButton" class="btn btn-outline-success" style="width:120px;" onClick="SubmitButton();">承認</button></td>
          <td style="text-align:right;"><button id="sendBackButton" class="btn btn-outline-info" style="width:120px;" onClick="SendBackButton();">差戻し</button></td>
          <td style="text-align:right;"><button id="cancelButton" class="btn btn-outline-warning" style="width:100px;" onClick="CancelButton();">キャンセル</button></td>
        </tr>
      </table>
    </div>
  </div>
  <div id="jikoNo">
    <span>事故No.</span>
    <span>
      @Model.Jiko.Jiko_No
    </span>
  </div>
  <div class="approval-buttons">
    <button id="step1" onClick="ChangeStatus(1)">発生</button>
    <div></div>
    <button id="step2" onClick="ChangeStatus(2)">荷主<br>対応</button>
    <div></div>
    <button id="step3" onClick="ChangeStatus(3)">事故<br>報告</button>
    <div></div>
    <button id="step4" onClick="ChangeStatus(4)">保険（相手）<br>対応</button>
    <div></div>
    <button id="step5" onClick="ChangeStatus(5)">修理・経費</button>
    <div></div>
    <button id="step6" onClick="ChangeStatus(6)">完了</button>
  </div>

  @if (Model.Jiko.Jiko_ID != 0)
  {
    <div style="margin-top: 20px;">
      <table class="list">
        <thead>
          @if (Model.JikoWorkFlowList != null)
          {
            <tr>
              @foreach (var item in Model.JikoWorkFlowList)
              {
                <th class="bgcolor" style="width:120px;text-align:center;">@item.WorkFlowRoute.Jiko_WorkFlow_Display</th>
              }
              <td class="noborder">&nbsp;</td>
            </tr>
          }
        </thead>
        <tbody id="WorkFlowRouteListTableBody">
          @if (Model.JikoWorkFlowList != null)
          {
            <tr>
              @foreach (var item in Model.JikoWorkFlowList)
              {
                <td style="text-align:center;">
                  @(item.WorkFlowStatus != null && item.WorkFlowStatus.Approval_Datetime.HasValue ? item.WorkFlowStatus.Approval_Datetime.Value.ToString("yy/M/d") : "")
                  <br>
                  @if (item.WorkFlowStatus != null && item.WorkFlowStatus.Approval_User_ID == Model.Login_User_ID && item.WorkFlowStatus.Approval_Kubun == 3)
                  {
                    <span>差戻し</span>
                  }
                  else
                  {
                    <span>&nbsp;</span>
                  }
                  <br>
                  <div style="@(item.WorkFlowFlg ? "background-color: rgba(160, 206, 99, 1);" : "")">
                      @item.Display_Name
                  </div>
                </td>
              }
              <td class="noborder">&nbsp;</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }


  <div style="width: 100%; margin-top: 20px; display: flex;">
    <div style="width: 60%; margin-right: 2%;">
      <div class="top-side">
        <table class="no-line">
          <tr>
            <th><span class="required">事故区分</span></th>
            <td>
              @Html.DropDownListFor(
                  m => m.Jiko.Jiko_Kubun,
                  new SelectList(Model.JikoKubunDto, "Value", "Text"),
                  new { @class = "form-control list dropdown ", @style = "width:140px;" }
              )
            </td>
          </tr>
          <tr>
            <th><span class="required">事故名</span></th>
            <td>
              @Html.TextBoxFor(model => model.Jiko.Jiko_Display, new { @class = "form-control" })
            </td>
          </tr>
          @{
            var jikoWeatherKubun = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Jiko_Weather_Kubun")?.Jiko_Items_Val ?? string.Empty;
            var addressValue = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Address")?.Jiko_Items_Val ?? string.Empty;
            var addressRemarksValue = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Address_Remarks")?.Jiko_Items_Val ?? string.Empty;
            var roadWidth = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Road_Width")?.FormatNumberOrRawValue() ?? string.Empty;
            var roadSituation = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Road_Situation")?.Jiko_Items_Val ?? string.Empty;
            var limitSpeed = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Limit_Speed")?.FormatNumberOrRawValue() ?? string.Empty;
            var drivingSpeed = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Driving_Speed")?.FormatNumberOrRawValue() ?? string.Empty;
            var roadCondition = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Road_Condition")?.Jiko_Items_Val ?? string.Empty;
            var workKubun = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Work_Kubun")?.Jiko_Items_Val ?? string.Empty;
            var workSituation = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Work_Situation")?.Jiko_Items_Val ?? string.Empty;
            var policeStation = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Police_Station")?.Jiko_Items_Val ?? string.Empty;
            var policeOfficer = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Police_Officer")?.Jiko_Items_Val ?? string.Empty;
            var policePhone = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Police_Phone")?.Jiko_Items_Val ?? string.Empty;
            var nitifiNumber = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Notifi_Number")?.FormatNumberOrRawValue() ?? string.Empty;
            var policeRemarks = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Police_Remarks")?.Jiko_Items_Val ?? string.Empty;
            var policeSection = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Police_Section")?.Jiko_Items_Val ?? string.Empty;
            var remarks = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Remarks")?.Jiko_Items_Val ?? string.Empty;
            if (Model.Jiko.Jiko_ID == 0)
            {
              Model.Jiko.Jiko_Date = DateTime.Now.Date;
            }
          }
          <tr>
            <th><span class="required">事故発生日</span></th>
            <td>
              <table class="no-line">
                <tr>
                  <td width="200px">
                    @Html.TextBoxFor(model => model.Jiko.Jiko_Date, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", @style = "width:140px;text-align:center;" })
                  </td>
                  <th style="width:80px;"><span>天候</span></th>
                  <td>
                    @Html.DropDownList(
                        "Jiko_Weather_Kubun",
                        new SelectList(Model.WeatherKubunDto, "Value", "Text", jikoWeatherKubun),
                        new { @class = "form-control list dropdown", @style = "width:80px;" }
                    )
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <th><span class="required">配車担当者</span></th>
            <td>
              @Html.DropDownListFor(
                  m => m.Jiko.Haisya_Group_ID,
                  new SelectList(Model.UserGroupDataDto, "Value", "Text"),
                  new { @class = "form-control list dropdown", @style = "width:120px;" }
              )
            </td>
          </tr>
          <tr>
            <th><span class="required">当事者</span></th>
            <td>
              <div style="display: flex;">
                <button class="blue-button" onClick="DriverDialog()">設定</button>
                @Html.TextBoxFor(model => model.Driver_Display_Name, new { @class = "form-control", @style = "width:200px;margin-left:5px;", @readonly = "readonly" })
                @Html.HiddenFor(model => model.Jiko.Driver_ID)
              </div>
            </td>
          </tr>
          <tr>
            <th style="vertical-align: top;">車輌</th>
            <td>
              <div style="display: flex;">
                <button class="blue-button" onClick="SayryoDialog(0)">設定</button>
                @Html.TextBoxFor(model => model.SyaryoManagement_Number, new { @class = "form-control", @style = "width:80px;margin-left:5px;margin-bottom:5px;", @readonly = "readonly" })
                @Html.HiddenFor(model => model.Jiko.SyaryoManagement_ID)
              </div>
              <div style="display: flex;">
                <button class="blue-button" style="margin-top: 0.5px;" onClick="SayryoDialog(1)">設定</button>
                @Html.TextBoxFor(model => model.SyaryoManagement_Number1, new { @class = "form-control", @style = "width:80px;margin-left:5px;", @readonly = "readonly" })
                @Html.HiddenFor(model => model.Jiko.SyaryoManagement_ID1)
                <span style="width:150px">後ろがある場合</span>
              </div>
            </td>
          </tr>
          <tr>
            <th style="vertical-align: top;">発生場所<br>（詳細）</th>
            <td>
              <div style="display: flex;">
                <button class="blue-button" onClick="AddressDialog()">設定</button>
                @Html.TextBox("Address", addressValue, new { @class = "form-control", @style = "width:600px;margin-left:5px;", @readonly = "readonly" })
              </div>
              <textarea id="Address_Remarks" name="" class="form-control textareas" style="width:100%;height:60px;margin-top:5px;">@Html.Raw(addressRemarksValue)</textarea>
            </td>
          </tr>
          <tr>
            <th style="vertical-align: top;">道路状況</th>
            <td>
              <table class="no-line">
                <tr>
                  <th width="70px"><span>道幅</span></th>
                  <td>@Html.TextBox("Road_Width", roadWidth, new { @class = "form-control", @style = "width:200px;" })</td>
                  <th width="160px"><span>道幅状況</span></th>
                  <td>@Html.TextBox("Road_Situation", roadSituation, new { @class = "form-control", @style = "width:200px;" })</td>
                </tr>
                <tr>
                  <th><span>制限速度</span></th>
                  <td style="display: flex;">
                    @Html.TextBox("Limit_Speed", limitSpeed, new { @class = "form-control", @style = "width:60px;text-align:right;", @maxlengh="3" })km/h
                  </td>
                  <th><span>走行速度</span></th>
                  <td style="display: flex;">
                    @Html.TextBox("Driving_Speed", drivingSpeed, new { @class = "form-control", @style = "width:60px;text-align:right;", @maxlengh = "3" })km/h
                  </td>
                </tr>
                <tr>
                  <th><span>路面状況</span></th>
                  <td colspan="3">
                    @Html.TextBox("Road_Condition", roadCondition, new { @class = "form-control", @style = "width:100%;" })
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <th>当時の業務</th>
            <td>
              <div style="display: flex;">
                @Html.DropDownList(
                    "Work_Kubun",
                    new SelectList(Model.WorkKubunDto, "Value", "Text", workKubun),
                    new { @class = "form-control list dropdown", @style = "width:80px;" }
                )
                @Html.TextBox("Work_Situation", workSituation, new { @class = "form-control" })
              </div>
            </td>
          </tr>
          <tr>
            <th style="vertical-align: top;">届出警察署</th>
            <td>
              <table class="no-line">
                <tr>
                  <th>警察署</th>
                  <td>@Html.TextBox("Police_Station", policeStation, new { @class = "form-control", @style = "width:200px;" })</td>
                  <th>課/係</th>
                  <td>@Html.TextBox("Police_Section", policeSection, new { @class = "form-control", @style = "width:200px;" })</td>
                </tr>
                <tr>
                  <th>担当官</th>
                  <td>
                    @Html.TextBox("Police_Officer", policeOfficer, new { @class = "form-control", @style = "width:200px;" })
                  </td>
                  <th>連絡先</th>
                  <td>
                    @Html.TextBox("Police_Phone", policePhone, new { @class = "form-control", @style = "width:200px;" })
                  </td>
                </tr>
                <tr>
                  <th>届出番号</th>
                  <td>@Html.TextBox("Notifi_Number", nitifiNumber, new { @class = "form-control", @style = "width:200px;" })</td>
                  <th>備考</th>
                  <td>@Html.TextBox("Police_Remarks", policeRemarks, new { @class = "form-control", @style = "width:200px;" })</td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <th>実質負担額</th>
            <td style="display: flex;">
              <table>
                <tr>
                  <td>
                    @Html.TextBoxFor(model => model.Jiko.Jiko_Futan_Money, "{0:N0}", new { @class = "form-control", @id = "Jiko_Jiko_Futan_Money", @type = "text", @style = "width:130px;text-align:right;", @onblur = "kanmaChange(this);" })
                  </td>
                  <td>円</td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <th style="vertical-align: top;">備考</th>
            <td>
              <textarea id="Remarks" name="" class="form-control textareas" style="width:100%;height:60px;">@Html.Raw(remarks)</textarea>
            </td>
          </tr>
        </table>
      </div>
    </div>
    <div style="width: 38%;">
      <table class="no-line">
        <tr>
          <th><span class="required">ワークフロー</span></th>
          <td>
            @if (Model.Jiko.Jiko_ID != 0)
            {
              @Html.DropDownListFor(
                  m => m.Jiko.Jiko_WorkFlow_Base_ID,
                  new SelectList(Model.WorkFlowListDto, "Value", "Text"),
                  new { @class = "form-control list dropdown", @disabled = "disabled" }
              )
            }
            else
            {
              @Html.DropDownListFor(
                  m => m.Jiko.Jiko_WorkFlow_Base_ID,
                  new SelectList(Model.WorkFlowListDto, "Value", "Text"),
                  new { @class = "form-control list dropdown", @onchange = "onWorkflowChange(this.value)" }
              )
            }
          </td>
        </tr>
      </table>

      <table class="no-line" style="margin-top:5px;">
        <tr>
          <th>&nbsp;</th>
          <td id="WorkflowList"></td>
        </tr>
      </table>

      <div class="category-title">事故種類</div>
      <div style="text-align:right;margin:10px 0 10px 0;"><button class="blue-button" onClick="addRow()">追加</button></div>

      <table class="list" style="">
        <tr>
          <th class="bgcolor" style="width:30px;">順</th>
          <th class="bgcolor" style="width:150px;">種類</th>
          <th class="bgcolor">備考</th>
        </tr>
        <tbody id="JikoTypeListTableBody">
          @if (Model.JikoTypeList != null)
          {
            var index = 1;
            @foreach (var item in Model.JikoTypeList)
            {
              <tr>
                <td style="text-align:center;">@index</td>
                <td style="text-align:center;">
                  @Html.DropDownList(
                      "Jiko_Type_ID",
                      new SelectList(Model.JikoTypeKubunDto, "Value", "Text", item.Jiko_Type_ID),
                      new { @class = "form-control list dropdown", @style = "" }
                  )
                </td>
                <td>
                  @Html.TextBoxFor(m => item.Jiko_Type_Remarks, new { @class = "form-control", @id = "Jiko_Type_Remarks" })
                </td>
              </tr>
              index++;
            }
          }
        </tbody>
      </table>
    </div>
  </div>

  <div style="width: 100%;">
    <div class="category-title">荷主対応</div>
    @{
      var kokyakuTantouName = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "KokyakuTantouName")?.Jiko_Items_Val ?? string.Empty;
      var kokyakuVisitFlg = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Kokyaku_Visit_Flg")?.Jiko_Items_Val ?? string.Empty;
      var kokyakuVisitDatetime = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Kokyaku_Visit_Datetime")?.Jiko_Items_Val ?? string.Empty;
      var kokyakuVisitPerson = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Kokyaku_Visit_Person")?.Jiko_Items_Val ?? string.Empty;
      var kokyakuReportFlg = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Kokyaku_Report_Flg")?.Jiko_Items_Val ?? string.Empty;
      var kokyakuReportDatetime = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Kokyaku_Report_Datetime")?.Jiko_Items_Val ?? string.Empty;
      var kokyakuReportPerson = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Kokyaku_Report_Person")?.Jiko_Items_Val ?? string.Empty;
      var kokyakuRemarks = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Kokyaku_Remarks")?.Jiko_Items_Val ?? string.Empty;
      var luggageDamageFlg = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Luggage_Damage_Flg")?.Jiko_Items_Val ?? string.Empty;
      var luggageWeight = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Luggage_Weight")?.FormatNumberOrRawValue() ?? string.Empty;
      var luggageRemarks = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Luggage_Remarks")?.Jiko_Items_Val ?? string.Empty;
    }
    <div class="table-div">
      <table class="no-line">
        <tr>
          <th>荷主</th>
          <td style="width:300px;">
            <div style="display: flex;">
              <button class="blue-button" onClick="CustomerDialog()">設定</button>
              @Html.TextBoxFor(model => model.CustomerData.Customer_Name, new { @class = "form-control", @style = "width:250px;margin-left:5px;", @readonly = "readonly" })
              @Html.HiddenFor(model => model.CustomerData.Customer_ID, new { id = "KokyakuId" })
            </div>
          </td>
          <th>担当者</th>
          <td style="width:300px;">
            @Html.TextBox("KokyakuTantouName", kokyakuTantouName, new { @class = "form-control", @style = "width:250px;" })
          </td>
          <th>&nbsp;</th>
          <td style="width:300px;">&nbsp;</td>
          <td>&nbsp;</td>
        </tr>
        <tr>
          <th>訪問</th>
          <td>
            @Html.DropDownList(
                "Kokyaku_Visit_Flg",
                new SelectList(Model.ListKubunDto, "Value", "Text", kokyakuVisitFlg),
                new { @class = "form-control list text-center dropdown", @style = "width:60px;" }
            )
          </td>
          <th>訪問日時</th>
          <td>
            @Html.TextBox("Kokyaku_Visit_Datetime", kokyakuVisitDatetime, new { @class = "form-control", @type = "date", @style = "width:140px;text-align:center;" })
          </td>
          <th>訪問者</th>
          <td>
            @Html.TextBox("Kokyaku_Visit_Person", kokyakuVisitPerson, new { @class = "form-control", @style = "width:250px;" })
          </td>
          <td>&nbsp;</td>
        </tr>
        <tr>
          <th>報告書提出</th>
          <td>
            @Html.DropDownList(
                "Kokyaku_Report_Flg",
                new SelectList(Model.ListKubunDto, "Value", "Text", kokyakuReportFlg),
                new { @class = "form-control list dropdown", @style = "width:60px;" }
            )
          </td>
          <th>提出日時</th>
          <td>
            @Html.TextBox("Kokyaku_Report_Datetime", kokyakuReportDatetime, new { @class = "form-control", @type = "date", @style = "width:140px;text-align:center;" })
          </td>
          <th>提出担当者</th>
          <td>
            @Html.TextBox("Kokyaku_Report_Person", kokyakuReportPerson, new { @class = "form-control", @style = "width:250px;" })
          </td>
        </tr>
        <tr>
          <th>備考</th>
          <td colspan="5">
            @Html.TextBox("Kokyaku_Remarks", kokyakuRemarks, new { @class = "form-control" })
          </td>
        </tr>
      </table>
    </div>


    <div class="category-title">事故当時の車輌状況</div>
    <div class="table-div">
      <table class="no-line">
        <tr>
          <th>荷物損傷</th>
          <td style="width:200px;">
            @Html.DropDownList(
                "Luggage_Damage_Flg",
                new SelectList(Model.ListKubunDto, "Value", "Text", luggageDamageFlg),
                new { @class = "form-control list dropdown", @style = "width:60px;" }
            )
          </td>
          <th>積載量</th>
          <td>
            <div style="display: flex;">
              @Html.TextBox("Luggage_Weight", luggageWeight, new { @class = "form-control", @style = "width: 120px;text-align:right;", @onblur = "kanmaChange(this);" })&nbsp;kg
            </div>
          </td>
        </tr>
        <tr>
          <th style="vertical-align:top;">詳細</th>
          <td colspan="3">
            <textarea id="Luggage_Remarks" name="" class="form-control textareas" style="width:100%;height:60px;">@Html.Raw(luggageRemarks)</textarea>
          </td>
        </tr>
      </table>
    </div>


    <div class="category-title">相手方詳細</div>
    @{
      var otherPartyName = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Other_Party_Name")?.Jiko_Items_Val ?? string.Empty;
      var otherPartyDriverRecotderFlg = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Other_Party_DriveRecorder_Flg")?.Jiko_Items_Val ?? string.Empty;
      var otherPartyAddress = Model.JikoItemList.FirstOrDefault(item => item.Jiko_Items_Prop_Name == "Other_Party_Address")?.Jiko_Items_Val ?? string.Empty;
