    // 事故種類の行追加メソッド
    function addRow() {
        var $tableBody = $('#JikoTypeListTableBody');
        var newRowIndex = $tableBody.children().length + 1;
        var $newRow = $('<tr>');
        $newRow.html(
            '<td style="text-align:center;">' + newRowIndex + '</td>' +
            '<td style="text-align:center;">' +
                '<select id="Jiko_Type_ID" name="JikoTypeList[' + (newRowIndex - 1) + '].Jiko_Type_ID" class="form-control list dropdown">' +
                    generateOptions(jikoTypeOptions) +
                '</select>' +
            '</td>' +
            '<td>' +
                '<input type="text" id="Jiko_Type_Remarks" name="JikoTypeList[' + (newRowIndex - 1) + '].Jiko_Type_Remarks" class="form-control">' +
            '</td>'
        );

        $tableBody.append($newRow);
    };

    function generateOptions(options) {
        return $.map(options, function(option) {
            return '<option value="' + option.value + '">' + option.text + '</option>';
        }).join('');
    }

    async function DraftingButton() {
        // 起案
        if (!validateForm() || !validateJikoTypeList()) {
          return; // バリデーションに失敗した場合は処理を中断
        }

        var Company_ID = @Html.Raw(Json.Serialize(Model.Company_ID));
        var Jiko_ID = @Html.Raw(Json.Serialize(Model.Jiko.Jiko_ID));

        var Jiko = {
            Jiko_ID : Jiko_ID,
            Branch_ID : 0,
            Company_ID : Company_ID,
            Jiko_WorkFlow_Base_ID : parseInt($("#Jiko_Jiko_WorkFlow_Base_ID").val()) || 0,
            Jiko_WorkFlow_Status : currentButtonIndex + 1,
            Jiko_Date : $("#Jiko_Jiko_Date").val() || "",
            Jiko_Display : $("#Jiko_Jiko_Display").val(),
            SyaryoManagement_ID: parseInt($("#Jiko_SyaryoManagement_ID").val()) || 0,
            SyaryoManagement_ID1: parseInt($("#Jiko_SyaryoManagement_ID1").val()) || 0,
            Jiko_Status : currentButtonIndex + 1,
            Jiko_Kubun : parseInt($("#Jiko_Jiko_Kubun").val()) || 0,
            Jiko_Futan_Money: kanmaChangeRevert($("#Jiko_Jiko_Futan_Money").val()) || 0,
            Haisya_Group_ID : parseInt($("#Jiko_Haisya_Group_ID").val()) || 0,
            Driver_ID: parseInt($("#Jiko_Driver_ID").val()) || 0,
         }

        for (var i = 0; i < jikoItemList.length; i++) {
            var item = jikoItemList[i];

            // Jiko_Items_Prop_Name と一致する ID を見つけて、その value を取得
            var inputValue = $("#" + item.jiko_Items_Prop_Name).val();

            // 一致する場合、Jiko_Items_Val を更新
            if (inputValue !== undefined) {
              if (item.jiko_Items_Type.toLowerCase() == "int" ||
                  item.jiko_Items_Type.toLowerCase() == "money" ||
                  item.jiko_Items_Type.toLowerCase() == "double" ) {
                item.jiko_Items_Val = String(kanmaChangeRevert(inputValue));
              } else {
                item.jiko_Items_Val = inputValue;
              }
            }
        }

        var JikoTypeList = [];
        $("#JikoTypeListTableBody tr").each(function(index) {
            var $row = $(this);
            var jikoType = {
            Jiko_ID: Jiko_ID,
            Jiko_Type_ID: parseInt($row.find("#Jiko_Type_ID").val()) || 0,
            Jiko_Type_Remarks: $row.find("#Jiko_Type_Remarks").val() || "",
        };
        // Jiko_Type_IDが0でない場合のみリストに追加
        if (jikoType.Jiko_Type_ID !== 0) {
            JikoTypeList.push(jikoType);
        }
    });

    var combinedData = {
        JikoItemList: jikoItemList,
        Jiko: Jiko,
        JikoTypeList: JikoTypeList
    };

    var res = await post_accident(combinedData);
    if (res.errorMessage != null) {
        alertError(`【エラー】${res.errorMessage}`);
    }
    else {
        await CancelButton('DraftingButton', res.jiko_ID);
    }
}

    function post_accident(combinedData) {
        return $.ajax({
            url: '@Url.RouteUrl("Default", new { controller = "Accident", action = "PostAccident" })',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(combinedData),
            success: function (response) {
            },
            error: function(xhr, status, error) {
                console.error('Error:', error);
            }
        });
    }

    function submitEdit(jikoid) {

        var form = document.createElement('form');

        @* TODO:POST先を修正必要なパラメータも送る *@
        form.action = '@Url.RouteUrl("Default", new { controller = "Accident", Action = "AccidentInputIndex" })';
        form.method = 'POST';

        // body に追加
        document.body.appendChild(form);

        var html = '';
        html += '            <input type="hidden" id="jikoId" name="jikoId" value="' + jikoid + '" />';

        form.innerHTML = html;
      form.submit();
    }

    async function CancelButton(action = '', jiko_ID = 0) {

        if (action.length > 0)
        {
          confirmation = await alertYesNoMsg("確認", "登録処理が完了しました。前の画面に戻りますか？", "question", "戻る", "キャンセル");
          if (!confirmation) {
            if (action == 'DraftingButton' || action == 'SubmitButton' || action == 'SubmitRemand') {
              submitEdit(jiko_ID);
              return;
            }
          }
        }

        if (action.length == 0 && !ChangeCheck()) {
            let resultMsg = await alertYesNoMsg("確認", "内容が変更されています。よろしいですか？", "question", "はい", "いいえ")
            if (resultMsg == false) { return false; }
            }

         var form = document.createElement('form');

        form.action = '@Url.RouteUrl("Default", new { controller = "AccidentList", Action = "Index" })';
        form.method = 'POST';

        // body に追加
        document.body.appendChild(form);

        var html = '';
        html += '            <input type="hidden" id="FromDate" name="FromDate" value="' + $('#Search_FromDate').val() + '" />';
        html += '            <input type="hidden" id="ToDate" name="ToDate" value="' + $('#Search_ToDate').val() + '" />';
        html += '            <input type="hidden" id="AccidentReason" name="AccidentReason" value="' + $('#Search_AccidentReason').val() + '" />';
        html += '            <input type="hidden" id="AccidentName" name="AccidentName" value="' + $('#Search_AccidentName').val() + '" />';
        html += '            <input type="hidden" id="DriverName" name="DriverName" value="' + $('#Search_DriverName').val() + '" />';
        html += '            <input type="hidden" id="CarNumber" name="CarNumber" value="' + $('#Search_CarNumber').val() + '" />';
        html += '            <input type="hidden" id="WfRadioButtons" name="WfRadioButtons" value="' + $('#Search_WfRadioButtons').val() + '" />';
        html += '            <input type="hidden" id="IsBack" name="IsBack" value="true" />';

        form.innerHTML = html;
        form.submit();
    }

