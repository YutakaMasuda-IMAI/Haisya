<script>
  var jikoId = @Model.Jiko.Jiko_ID;
  var jiko = @Html.Raw(Json.Serialize(Model.Jiko));
  var jikoWorkFlowID = @Model.Jiko.Jiko_WorkFlow_Base_ID;
  var jikoTypeOptions = @Html.Raw(Json.Serialize(Model.JikoTypeKubunDto));
  var jikoWorkFlowList = @Html.Raw(Json.Serialize(Model.JikoWorkFlowList));
  var jikoTypeList = @Html.Raw(Json.Serialize(Model.JikoTypeList));
  var jikoItemList = @Html.Raw(Json.Serialize(Model.JikoItemList));
  var currentButtonIndex = 0;  // 押されたボタンのインデックス（0-5）
  var totalButtons = 6;
  var JikoWorkFlowStatusID = @Model.JikoWorkFlowStatusID;

  $(document).ready(function () {


    loadSetting();
    // 新規登録時初期値として一行分を表示
    if (jikoTypeList.length === 0) {
      addRow();
    }
  });

  function loadSetting() {
    var isDisabled = @(Model.IsDisabled.ToString().ToLower());
    var approvalIsDisabled = @(Model.ApprovalIsDisabled.ToString().ToLower());
    var jikoStatus = @Model.Jiko.Jiko_Status;
    if (isDisabled) {
      // キャンセルボタン以外を非活性にする
      $("#submitButton").prop("disabled", true);
      $("#sendBackButton").prop("disabled", true);
    }

    if (jikoId === 0 || approvalIsDisabled) {
      // 承認と差戻しボタンを非活性にする
      $("#submitButton").prop("disabled", true);
      $("#sendBackButton").prop("disabled", true);
    }

    // 初期表示時のボタン色設定
    setInitialButtonColors(jikoStatus);

    // 承認ボタンのクリックイベント
    $(".approval-buttons button").click(function() {
      var clickedIndex = $(this).index(".approval-buttons button");
      setButtonColors(clickedIndex);
    });

    WorkflowList();
  }
    // Indexに直すメソッド
    function setInitialButtonColors(status) {
      var maxIndex = (status >= 1 && status <= 6) ? status - 1 : -1;
      setButtonColors(maxIndex);
    }

    // ボタンの色を設定する関数
    function setButtonColors(maxIndex) {
      $(".approval-buttons button, .approval-buttons div").each(function(index) {
        if (index <= maxIndex * 2) {  // *2 はdivタグも含めるため
          $(this).css({
              "background-color": "rgba(208, 115, 106, 1)",
              "color": "white"
          });
        } else {
          $(this).css({
            "background-color": "rgba(91, 156, 213, 1)",
            "color": "white"
          });
        }
      });
      currentButtonIndex = Math.min(Math.floor(maxIndex), totalButtons - 1);
    }

    function ChangeStatus(status) {
        var combinedData = {
            Jiko_Status: status,
            Jiko_ID: jikoId
        };

        $.ajax({
            url: '@Url.RouteUrl("Default", new { controller = "Accident", action = "ChangeStatus" })',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(combinedData),
            success: function(response) {
                console.log('Success:', response);
                if (response.errorMessage != null) {
                    alertError(`【エラー】${response.errorMessage}`);
                }
            },
            error: function(xhr, status, error) {
                console.error('Error:', error);
            }
        });
    }

    function onWorkflowChange(value) {
        jikoWorkFlowID = value;
        WorkflowList();
    }

    function WorkflowList() {
        $.ajax({
            url: '@Url.RouteUrl("Default", new { controller = "Accident", action = "GetWorkflowList" })',
            type: 'GET',
            data: { Jiko_ID: jikoId, Jiko_WorkFlow_Base_ID: jikoWorkFlowID},
            success: function(response) {
                $('#WorkflowList').html(response.partialView);
                },
            error: function(xhr, status, error) {
                  console.error('Error:', error);
                }
        });
    }

    // 共通得意先選択ダイアログの表示
    function CustomerDialog() {
        var User_ID = @Html.Raw(Json.Serialize(Model.Login_User_ID));
        var Company_ID = @Html.Raw(Json.Serialize(Model.Company_ID));
        var SelectedId = parseInt($("#KokyakuId").val()) || 0;
        openCommonDialogForCustomer(Company_ID,User_ID,SelectedId)
    }

    // グローバル変数として currentSyaryoType を定義
    var currentSyaryoType = 0;

    // 共通車輌選択ダイアログの表示
    function SayryoDialog(type) {
