@model HaisyaWeb.Models.YosyaModel.YosyaDataListModel

@{
  Layout = "../Setting/MasterDataMenu";
}

<head>
  <style>
  </style>
</head>

<body>
  <div id="hiddenItem" hidden>
    @Html.HiddenFor(model => Model.CompanyID)
  </div>
  <div>
    @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "Form2" }))
    {
      <div id="hedder" class="row" style="margin-bottom: -20px;">
        <h6 class="heading-pagetitle">傭車一覧</h6>
        <div class="form-group" style="width: 100%">
          <div class="row">
            <table class="table jbc-table table-borderless" style="padding: 0; background-color: whitesmoke;" border="1">
              <tbody>
                <tr>
                  <td width="20px"></td>
                  <td class="col-sm-3">
                    <label class="control-label align-self-center align-middle text-end" style="padding:0;">顧客コード：</label>
                    <input type="text" id="txtCode" style="width: 150px; display: inline-block;" class="form-control" />
                  </td>
                  <td class="col-sm-3">
                    <label class="control-label align-self-center align-middle text-end" style="padding:0;">検索キー：</label>
                    <input type="text" id="txtKey" style="width: 150px; display: inline-block;" class="form-control" />
                  </td>
                  <td class="col-sm-3">
                    <label class="control-label align-self-center align-middle text-end" style="padding:0;">電話(Fax)番号：</label>
                    <input type="text" id="txtPhone" style="width: 150px; display: inline-block;" class="form-control" />
                  </td>
                  <td>
                    <button style="width: 100px;" class="btn btn-primary align-items-end" onclick="listDisplay();return false;">検索</button>
                    @*<button type="button" class="btn btn-success align-items-end" style="float: right; width: 150px;" onclick="addNewCustomer(); return false;">新規追加</button>*@
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    }
  </div>

  <div id="DataList" class="dataList" style="margin-top: 25px;">
  </div>

</body>


<script>

  $(window).on('load', function () {

    let tabs = $('.sub-btn'); // tabのクラスを全て取得し、変数tabsに配列で定義

    $('.sub-btn').removeClass('active');

    $('#tabYosya').addClass('active');

    dataListDisplay();


  });

  $(function () {

    $('#query').on('change', function () {
      dataListDisplay();
    });

    $('#txtCode').on('change', function () {
      dataListDisplay();
      return false;
    });

    $('#txtKey').on('change', function () {
      dataListDisplay();
      return false;
    });

    $('#txtPhone').on('change', function () {
      dataListDisplay();
      return false;
    });

  });


  function dataListDisplay() {

    $.post('@Url.RouteUrl("Default", new { controller = "Yosya", Action = "JsonGetDataList" })',
      {
        CompanyID: $('#CompanyID').val(),
        code: $("#txtCode").val(),
        key: $("#txtKey").val(),
        phone: $("#txtPhone").val(),
      },
      function (data) {
        //alert(data.partialView);
        $('#DataList').html(data.partialView);
      }
    );

  };

  /// <summary>
  ///
  /// </summary>
  function dataListFirstSortChange(name) {

    if (typeof name === "undefined") {
      return;
    }




  };


  function submitModal(branchId, driverId, driverSyaryoId) {

      $.post('@Url.RouteUrl("Default", new { controller = "Yosya", Action = "YosyaModal" })',
      {
        CustomerBranchID: branchId,
        CustomerDriverID: driverId,
        CustomerDriverSyaryoID: driverSyaryoId,
      })
      .done(function (response) {
        if (response.message != null) {
            alertError(`【エラー】${response.message}`);
            return false;
        } else {
          //alert("【done】" + response.partialView);
          $("#ModalHere").html(response.partialView);
          $("#ModalHere").find('.modal').modal('show');
          return false;
        }
      })
      .fail(function (xhr) {
          console.log(xhr);
      })
      .always(function (xhr, msg) {
          console.log(xhr, msg);
      });


  };

  function closeModel() {
    $('#ModalHere').find('.modal').modal('hide');
    $("#ModalHere").html('');
  };

  function closeModelAndRefresh() {
    $('#ModalHere').find('.modal').modal('hide');
    location.reload();
    alertInfo("登録が完了しました。");
  };

</script>
<script src="~/js/EnterKeyCancel.js"></script>