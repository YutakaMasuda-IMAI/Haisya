[View]
PName=V_Heisya_Syaryo
LName=V_Heisya_Syaryo
Comment=
Query=SelectTopNRows コマンドのスクリプト  ******/\n\n CREATE VIEW [dbo].[V_Heisya_Syaryo]\n AS\n  SELECT\n  TOP 100 PERCENT\n  Z.[Driver_ID]\n      ,Z.[Start_Date] AS [START_DATE]\n\t  ,Z.END_DATE\n      ,Z.[SYASYU]\n      ,Z.[KATA]\n\t  ,Z.[KUBUN]\n      ,Z.[Tntou_ID]\n\t  ,Z.[Syaryo_ID]\n      ,Z.[Syaryo_ID_Trailer]\n\t  ,Z.[Company_ID]\n  FROM\n  (\t\n  SELECT A.[Driver_ID]\n      ,B.[Start_Date] AS START_DATE\n      ,DATEADD(day,-1,A.[Start_Date]) AS END_DATE\n      ,B.[SYASYU]\n      ,B.[KATA]\n\t  ,B.[KUBUN]\n      ,B.[Tntou_ID]\n\t  ,B.[Syaryo_ID]\n\t  ,B.[Syaryo_ID_Trailer]\n\t  ,B.[Company_ID]\n\t  ,ROW_NUMBER() OVER(PARTITION BY A.[Driver_ID],A.[Start_Date] ORDER BY ISNULL(B.[Start_Date],\q2999/01/01\q) DESC) AS SORT\n  FROM \n  [dbo].[T_Heisya_Syaryo] A\n  INNER JOIN [dbo].[T_Heisya_Syaryo] B ON\n  A.[Driver_ID] = B.[Driver_ID]\n  AND\n  A.[Start_Date] > B.[Start_Date]\n  )Z\n  WHERE\n  SORT = 1\n\n  UNION ALL\n\n  SELECT \n      TOP 100 PERCENT\n\t  A.[Driver_ID]\n      ,A.[Start_Date] AS START_DATE\n      ,\q2999/01/01\q AS END_DATE\n      ,A.[SYASYU]\n      ,A.[KATA]\n\t  ,A.[KUBUN]\n      ,A.[Tntou_ID]\n\t  ,A.[Syaryo_ID]\n\t  ,A.[Syaryo_ID_Trailer]\n\t  ,A.[Company_ID]\n  FROM \n  [dbo].[T_Heisya_Syaryo] A\n  LEFT JOIN[dbo].[T_Heisya_Syaryo] B ON\n  A.[Driver_ID] = B.[Driver_ID]\n  AND\n  A.[Start_Date] < B.[Start_Date]\n  WHERE\n  B.[Start_Date] IS NULL\n \n  ORDER BY\n  [Driver_ID]\n  ,[START_DATE] DESC\n
Color=$000000
BkColor=$FFFFFF
Position="MAIN",3800,1650
ZOrder=-55
Page=MAIN
Left=3800
Top=1650

[View]
PName=V_LoginUser
LName=V_LoginUser
Comment=
Query=SelectTopNRows コマンドのスクリプト  ******/\nCREATE VIEW [dbo].[V_LoginUser]\nAS\nSELECT\n    M.LoginUser_ID\n    , M.User_ID\n    , M.LoginID\n    , M.Password\n    , M.Lock_Flg\n    , M.Del_Flg\n    , M.Role\n    , LR.[RoleName]\n\t, CU.Employee_Number\n    , CU.Display_Name AS User_Name\n    , CU.Company_ID\n    , CU.Branch_ID\n\t, CU.[Tntou_ID]\n    , C.Company_Code\n    , C.Company_Name\n    , C.Company_Name_Abbr\n    , CB.Branch_Code\n    , CB.Branch_Name\n    , CB.Branch_Name_Abbr\n    , M.DefaultEria\n    , S.SIZE AS [DefaultSize]\n    , M.[DefaultSyasyu]\n    , M.[DefaultKata]\n\t, S.SyasyuDisplay\n\t, S.KataDisplay\n\t, CU.UP_DATE\nFROM\n    [dbo].M_LoginUser AS M \n    INNER JOIN [dbo].M_CompanyUser AS CU \n        ON M.User_ID = CU.User_ID \n    INNER JOIN [dbo].M_CompanyBranch AS CB \n        ON CU.Branch_ID = CB.Branch_ID \n    INNER JOIN [dbo].M_Company AS C \n        ON CB.Company_ID = C.Company_ID \n    LEFT JOIN [dbo].[M_LoginUser_Role] LR \n        ON C.Company_ID = LR.Company_ID \n        AND M.Role = LR.Role\n    LEFT JOIN [dbo].[M_Syaryo] AS S ON CU.Company_ID = S.Company_ID AND M.[DefaultSyasyu] = S.SYASYU AND M.[DefaultKata] = S.KATA\n
Color=$000000
BkColor=$FFFFFF
Position="MAIN",1250,150,228,310
ZOrder=-56
Page=MAIN
Left=1250
Top=150

