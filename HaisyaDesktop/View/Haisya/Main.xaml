            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="18" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="gdSplitter" Grid.Column="0" Background="YellowGreen" Click="gdSplitter_Click" BorderThickness="0" />
            <Wpf:WebView2 x:Name="webView" Grid.Column="1"  Source="{Binding MapsApiForJSUrl.Value}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  />
          </Grid>

        </Grid>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="並替B" Margin="2" />
              <Button DockPanel.Dock="Right" Content="並替B" Margin="2" />
              <Button DockPanel.Dock="Right" Content="並替A" Margin="2" />
              <TextBlock DockPanel.Dock="Left" Text="案件一覧" FontSize="18" TextAlignment="Center" VerticalAlignment="Center" />
            </DockPanel>
          </Grid>
          <Grid Grid.Row="1" Background="Aqua">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
              </Grid.ColumnDefinitions>

              <Button Content="未割当" Grid.Column="1" Margin="2" />
              <Button Content="割当済" Grid.Column="2" Margin="2"  />
              <Button Content="全て" Grid.Column="3" Margin="2"  />

              <ComboBox Grid.Column="0" Margin="2" VerticalAlignment="Center" FontSize="14" Padding="0">
                <ComboBoxItem Content="15tW" IsSelected="True" />
                <ComboBoxItem Content="8t" />
              </ComboBox>

            </Grid>
            <DockPanel>

            </DockPanel>
          </Grid>

          <Grid Grid.Row="2">

            <ScrollViewer HorizontalScrollBarVisibility="auto" VerticalScrollBarVisibility="Auto">
              
            
              <ListBox x:Name="AnkenListBox"  ItemsSource="{Binding AnkenInfoList}" ScrollViewer.CanContentScroll="False"
                    Background="Orange" SelectionChanged="AnkenListView_SelectionChanged" AllowDrop="True" Margin="0,0,15,0">

                

                <ListBox.Template>
                  <ControlTemplate TargetType="ItemsControl">
                    <Border BorderThickness="0" BorderBrush="Transparent" Background="Transparent" CornerRadius="10" >
                      <ItemsPresenter Margin="5">
                      </ItemsPresenter>
                    </Border>
                  </ControlTemplate>
                </ListBox.Template>

                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Name="AnkenListViewItemGrid" >
                      <!--<Border BorderThickness="1" BorderBrush="Black" CornerRadius="10" Background="LightGreen"  />-->
                      <DockPanel Margin="5" >
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                          <Label Content="依頼主：" Style="{StaticResource ListViewItemTextLabel}" />
                          <TextBlock Text="{Binding KokyakuName}" Style="{StaticResource ListViewItemTextBlock}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" >
                          <Label Content="車種　：" Style="{StaticResource ListViewItemTextLabel}" />
                          <TextBlock Text="{Binding SyasyuDisplay}" Style="{StaticResource ListViewItemTextBlock}" />
                          <TextBlock Text="{Binding Daisuu, StringFormat={}{0}台}" Margin="10,0,0,0" Style="{StaticResource ListViewItemTextBlock}" />
                          <TextBlock Text="{Binding Products}" DockPanel.Dock="Top" Style="{StaticResource ListViewItemTextBlock}" Margin="10,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" >
                          <Label Content="積時間：" Style="{StaticResource ListViewItemTextLabel}" />
                          <TextBlock Text="{Binding OroshiDate, StringFormat=HH:mm}" Style="{StaticResource ListViewItemTextBlock}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" >
                          <Label Content="卸日時：" Style="{StaticResource ListViewItemTextLabel}" Margin="0,0,0,0" />
                          <TextBlock Text="{Binding OroshiDate, StringFormat=MM月dd日 HH:mm}" Style="{StaticResource ListViewItemTextBlock}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                          <Label Content="施設名：" Style="{StaticResource ListViewItemTextLabel}" />
                          <TextBlock Text="{Binding TsumiFacilityName}" Style="{StaticResource ListViewItemTextBlock}"  />
                        </StackPanel>

                        <TextBlock Text="{Binding TsumiAddress}" DockPanel.Dock="Top" Style="{StaticResource ListViewItemTextBlock}" Margin="50,0,0,0"  />
                      </DockPanel>
                      <i:Interaction.Behaviors>
                        <behaviors:DragStartBehavior AllowedEffects="Copy" DragDropData="{Binding}" />
                      </i:Interaction.Behaviors>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical">
                    </StackPanel>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>


                <!-- ListBox.ItemContainerStyleを設定 -->
                <!--項目にマウスが乗ったときに色を変える、項目が選択されたときに色を変える、といった動作を決定する-->
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="Red" />
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="Background" Value="Aquamarine" />
                    <Setter Property="Margin" Value="0,0,0,5"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ContentControl}">
                          <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="2" BorderBrush="Black"  >
                            <Border.Effect>
                              <DropShadowEffect
                                                BlurRadius="10"
                                                RenderingBias="Quality"
                                                ShadowDepth="2.5"
                                                Color="Gray" />
                              </Border.Effect>
                            <ContentPresenter >
                            </ContentPresenter>
                          </Border>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Plum" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="LightGray" />
                      </Trigger>
                    </Style.Triggers>

                  </Style>
                  
                </ListBox.ItemContainerStyle>

            </ListBox>
            </ScrollViewer>


          </Grid>


        </Grid>



