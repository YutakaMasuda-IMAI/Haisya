              </Grid.ColumnDefinitions>

              <TextBlock Text="2022年6月23日(木曜日)" VerticalAlignment="Center" FontSize="20" />

              <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="2" >
                <TextBlock Text="表示グループ：" VerticalAlignment="Center" FontSize="18" />
                <ComboBox VerticalAlignment="Center" FontSize="18" >
                  <ComboBoxItem Content="大型ウィング" IsSelected="True" />
                  <ComboBoxItem Content="〇〇営業所" />
                </ComboBox>
              </StackPanel>

              
            </Grid>
          </Grid>

