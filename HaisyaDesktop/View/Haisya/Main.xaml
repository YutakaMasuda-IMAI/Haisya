            <ColumnDefinition Width="10*" x:Name="GridSchedule" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="20" x:Name="GridMap" />
            <!--<ColumnDefinition Width="2*" x:Name="GridMap" />-->
          </Grid.ColumnDefinitions>

          <GridSplitter Grid.Column="1" Background="YellowGreen" HorizontalAlignment="Stretch" />


