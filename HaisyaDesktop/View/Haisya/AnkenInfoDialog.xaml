<Window x:Class="HaisyaDesktop.View.Haisya.AnkenInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HaisyaDesktop.View.Haisya"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="案件情報ダイアログ" Height="600" Width="1000">

    <Window.Resources>
        <Style x:Key="KomokuTitle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="SelectTextBox" TargetType="TextBox">
            <Setter Property="Margin" Value="5,3" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="SelectTextBlock" TargetType="TextBlock">
            <Setter Property="Margin" Value="5,2" />
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="SelectGroupBox" TargetType="GroupBox">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Red" />
        </Style>
        <Style x:Key="SelectRadioButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}" >
            <Setter Property="Margin" Value="5,6,5,1" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Background" Value="LightCyan" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border BorderThickness="2" BorderBrush="Blue" Background="LightBlue">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelectToggleButton" TargetType="ToggleButton">
            <Setter Property="Margin" Value="5,5,0,2" />
        </Style>
    </Window.Resources>


    <Grid x:Name="AnkenInfoDialogMain" Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" >
            <DockPanel>
                <Button DockPanel.Dock="Right" Name="Close" Content="閉じる" Width="200" Margin="2" Click="Close_Click" />
                <Label Content="案件情報" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="18" Padding="0" />
            </DockPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="root" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="0.7*" />
                    <RowDefinition Height="0.7*" />
                    <RowDefinition Height="0.7*" />
                    <RowDefinition Height="0.7*" />
                </Grid.RowDefinitions>


                <DockPanel Grid.Row="0" LastChildFill="True">
                    <Label Content="顧客" Width="40" Style="{StaticResource KomokuTitle}" DockPanel.Dock="Left" />
                    <TextBox IsReadOnly="True" Text="{Binding KokyakuId.Value}" Visibility="Visible" Width="40" Background="Gray" DockPanel.Dock="Left" Style="{StaticResource SelectTextBox}" />
                    <TextBox IsReadOnly="True" Text="{Binding KokyakuName.Value}" DockPanel.Dock="Bottom" Style="{StaticResource SelectTextBox}" />
                </DockPanel>
                <DockPanel Grid.Row="1" LastChildFill="True">
                    <Label Content="車種" Width="40" Style="{StaticResource KomokuTitle}" DockPanel.Dock="Left" />
                    <TextBox IsReadOnly="True" Visibility="Visible" Width="40" Background="Gray" DockPanel.Dock="Left" Text="{Binding Syasyu.Value}" Style="{StaticResource SelectTextBox}" />

                    <TextBox Width="50" DockPanel.Dock="Right" Style="{StaticResource SelectTextBox}" Text="{Binding Daisuu.Value}"  />
                    <Label Content="台数" Width="40" Style="{StaticResource KomokuTitle}" DockPanel.Dock="Right" HorizontalContentAlignment="Right" />
                    
                    <Grid DockPanel.Dock="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource SelectTextBox}" Text="{Binding SyasyuDisplay.Value}"  />
                        <TextBox Grid.Column="1" Style="{StaticResource SelectTextBox}" Text="{Binding Kata.Value}"  />
                    </Grid>

                </DockPanel>

                <StackPanel Orientation="Horizontal" Grid.Row="2">
                    <Label Content="積日" Width="40" Style="{StaticResource KomokuTitle}"  />
                    <TextBlock Text="{Binding TsumiDate.Value, StringFormat=yyyy/MM/dd}" Style="{StaticResource SelectTextBlock}" />
                    <TextBox IsReadOnly="True" Width="150" Style="{StaticResource SelectTextBox}" Text="{Binding TsumiTime.Value}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Row="3">
                    <Label Content="卸日" Width="40" Style="{StaticResource KomokuTitle}"  />
                    <TextBlock Text="{Binding OroshiDate.Value, StringFormat=yyyy/MM/dd}" Style="{StaticResource SelectTextBlock}" />
                    <TextBox IsReadOnly="True" Width="150" Style="{StaticResource SelectTextBox}" Text="{Binding OroshiTime.Value}" />
                </StackPanel>

                <Grid Grid.Row="4" Grid.RowSpan="3" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Label Content="走行&#10;条件" Grid.Column="0" Style="{StaticResource KomokuTitle}" HorizontalAlignment="Left" />
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Row="0">
                            <Label Content="フェリー" Width="80" Style="{StaticResource KomokuTitle}" />
                            <GroupBox  HorizontalAlignment="Left" Style="{StaticResource SelectGroupBox}"  >
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Ferry_F" Style="{StaticResource SelectRadioButton}" Content="利用しない" Width="100"  Tag="F" />
                                    <RadioButton x:Name="Ferry_T" Style="{StaticResource SelectRadioButton}" Content="利用する" Width="100" Tag="T" />
                                    <TextBlock x:Name="FerrySelected" Visibility="Hidden" Text="{Binding Ferry.Value, UpdateSourceTrigger=PropertyChanged}" Width="0" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Row="1">
                            <Label Content="規制考慮" Width="80" Style="{StaticResource KomokuTitle}"  />
                            <GroupBox HorizontalAlignment="Left" Style="{StaticResource SelectGroupBox}" >
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Regulation_none" Style="{StaticResource SelectRadioButton}" Content="なし" Width="60"  Tag="none" />
                                    <RadioButton x:Name="Regulation_season" Style="{StaticResource SelectRadioButton}" Content="季節" Width="60" Tag="season" />
                                    <RadioButton x:Name="Regulation_time" Style="{StaticResource SelectRadioButton}" Content="時間" Width="60" Tag="time" />
                                    <RadioButton x:Name="Regulation_season_time" Style="{StaticResource SelectRadioButton}" Content="季節・時間" Width="80" Tag="season,time" />
                                    <TextBlock x:Name="RegulationSelected" Visibility="Hidden" Text="{Binding Regulation.Value, UpdateSourceTrigger=PropertyChanged}" Width="0" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Row="2">
                            <Label Content="2段階Uﾀｰﾝ&#10;回避指定" Width="80" FontSize="9" Style="{StaticResource KomokuTitle}"  />
                            <GroupBox HorizontalAlignment="Left" Style="{StaticResource SelectGroupBox}" >
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Twouturn_T" Style="{StaticResource SelectRadioButton}" Content="する" Width="100" Tag="T" />
                                    <RadioButton x:Name="Twouturn_F" Style="{StaticResource SelectRadioButton}" Content="しない" Width="100" Tag="F" />
                                    <TextBlock x:Name="TwouturnSelected" Visibility="Hidden" Text="{Binding Twouturn.Value, UpdateSourceTrigger=PropertyChanged}" Width="0" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </Grid>

                <StackPanel Orientation="Vertical" Grid.Row="7" Grid.RowSpan="6" Margin="0,5,0,0">
                    <DockPanel >
                        <StackPanel Orientation="Vertical" DockPanel.Dock="Left" Width="40" VerticalAlignment="Center">
                            <Label DockPanel.Dock="Left" Content="積地"></Label>
                        </StackPanel >
                        <DataGrid x:Name="datagridTsumi" DockPanel.Dock="Bottom" HeadersVisibility="None" CanUserAddRows="false" ItemsSource="{Binding TsumiPointList, NotifyOnSourceUpdated=True}" 
                                          AutoGenerateColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" 
                                          Margin="5,0,0,0" VerticalContentAlignment="Center" FontSize="16">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="10" Binding="{Binding id, NotifyOnSourceUpdated=True}"></DataGridTextColumn>
                                <DataGridTextColumn Width="*" Binding="{Binding Address, NotifyOnSourceUpdated=True}"></DataGridTextColumn>
                                <DataGridTextColumn Width="70" Binding="{Binding Lng, NotifyOnSourceUpdated=True}"></DataGridTextColumn>
                                <DataGridTextColumn Width="70" Binding="{Binding Lat, NotifyOnSourceUpdated=True}"></DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <DockPanel Margin="0,10,0,0" >
                        <StackPanel Orientation="Vertical" DockPanel.Dock="Left" Width="40" VerticalAlignment="Center">
                            <Label DockPanel.Dock="Left" Content="卸地"></Label>
                        </StackPanel >
                        <DataGrid x:Name="datagridOroshi" DockPanel.Dock="Bottom" HeadersVisibility="None" CanUserAddRows="false" ItemsSource="{Binding OroshiPointList, NotifyOnSourceUpdated=True}" 
                                      AutoGenerateColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" 
                                      Margin="5,0,0,0"  VerticalContentAlignment="Center"  FontSize="16">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="10" Binding="{Binding id, NotifyOnSourceUpdated=True}"></DataGridTextColumn>
                                <DataGridTextColumn Width="*" Binding="{Binding Address, NotifyOnSourceUpdated=True}"></DataGridTextColumn>
                                <DataGridTextColumn Width="70" Binding="{Binding Lng, NotifyOnSourceUpdated=True}"></DataGridTextColumn>
                                <DataGridTextColumn Width="70" Binding="{Binding Lat, NotifyOnSourceUpdated=True}"></DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </StackPanel>

                <DockPanel Grid.Row="13">
                    <Label Content="運賃計算" Width="60" Style="{StaticResource KomokuTitle}" DockPanel.Dock="Left" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" >
                        <ToggleButton Content="トン数計算" Width="70" Style="{StaticResource SelectToggleButton}"  />
                        <ToggleButton Content="距離計算" Width="70" Style="{StaticResource SelectToggleButton}"  />
                        <ToggleButton Content="時間計算" Width="70" Style="{StaticResource SelectToggleButton}"  />
                        <ToggleButton Content="金額指定" Width="70" Style="{StaticResource SelectToggleButton}"  />
                    </StackPanel>
                </DockPanel>

                <DockPanel Grid.Row="14" Grid.RowSpan="2">
                    <Label Content="ルート" Width="40" Style="{StaticResource KomokuTitle}" DockPanel.Dock="Left" />
                    <Grid DockPanel.Dock="Left" Margin="0,5">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="LightGray" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" IsReadOnly="True" Text="ルート" Background="Aqua" HorizontalContentAlignment="Center" />
                            <TextBox Grid.Column="1" IsReadOnly="True" Text="所要時間" Background="Aqua" HorizontalContentAlignment="Center" />
                            <TextBox Grid.Column="2" IsReadOnly="True" Text="距離" Background="Aqua" HorizontalContentAlignment="Center" />
                            <TextBox Grid.Column="3" IsReadOnly="True" Text="有料道路" Background="Aqua" HorizontalContentAlignment="Center" />
                            <TextBox Grid.Column="4" IsReadOnly="True" Text="原価" Background="Aqua" HorizontalContentAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="1" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" IsReadOnly="True" Text="推奨ルート" HorizontalContentAlignment="Center" />
                            <TextBox Grid.Column="1" IsReadOnly="True" Text="4時間47分" HorizontalContentAlignment="Center" />
                            <TextBox Grid.Column="2" IsReadOnly="True" Text="150.4km" HorizontalContentAlignment="Center" />
                            <TextBox Grid.Column="3" IsReadOnly="True" Text="\8,120" HorizontalContentAlignment="Center" />
                            <TextBox Grid.Column="4" IsReadOnly="True" Text="\62,120" HorizontalContentAlignment="Center" />
                        </Grid>
                    </Grid>
                </DockPanel>

                <DockPanel Grid.Row="16" Grid.RowSpan="2">
                    <Label Content="金額" Width="40" Style="{StaticResource KomokuTitle}" DockPanel.Dock="left" HorizontalAlignment="Left" />
                    <Grid DockPanel.Dock="Left" Margin="0,5" >
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="LimeGreen" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" IsReadOnly="True" Text="区分" Background="LimeGreen" HorizontalContentAlignment="Center" />
                            <TextBox Grid.Column="1" IsReadOnly="True" Text="基本運賃" Background="LimeGreen" HorizontalContentAlignment="Center" />
                            <TextBox Grid.Column="2" IsReadOnly="True" Text="追加費用" Background="LimeGreen" HorizontalContentAlignment="Center" />
                            <TextBox Grid.Column="3" IsReadOnly="True" Text="有料道路" Background="LimeGreen" HorizontalContentAlignment="Center" />
                            <TextBox Grid.Column="4" IsReadOnly="True" Text="請求運賃" Background="LimeGreen" HorizontalContentAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="1" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" IsReadOnly="True" Text="暫定" HorizontalContentAlignment="Center" />
                            <TextBox Grid.Column="1" IsReadOnly="True" Text="\54,000" HorizontalContentAlignment="Center" />
                            <TextBox Grid.Column="2" IsReadOnly="True" Text="\2,000" HorizontalContentAlignment="Center" />
                            <TextBox Grid.Column="3" IsReadOnly="True" Text="\8,120" HorizontalContentAlignment="Center" />
                            <TextBox Grid.Column="4" IsReadOnly="True" Text="\64,120" HorizontalContentAlignment="Center" />
                        </Grid>
                    </Grid>
                </DockPanel>

            </Grid>

            <Grid Grid.Column="1" Margin="5,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>



                <DockPanel Grid.Row="0" Grid.RowSpan="2" LastChildFill="True">
                    <Label Content="荷物" Width="40" Style="{StaticResource KomokuTitle}" DockPanel.Dock="Left" />
                    <TextBox IsReadOnly="True" DockPanel.Dock="Bottom" Style="{StaticResource SelectTextBox}" />
                </DockPanel>

                <DockPanel Grid.Row="2" Grid.RowSpan="2" >
                    <Label Content="装備" Width="40" Style="{StaticResource KomokuTitle}" DockPanel.Dock="Left" />
                    <TextBox IsReadOnly="True" DockPanel.Dock="Bottom" Style="{StaticResource SelectTextBox}" />
                </DockPanel>

                <Grid Grid.Row="4" Grid.RowSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Content="車番&#10;連絡" Grid.Column="0" Style="{StaticResource KomokuTitle}" />
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0"  HorizontalAlignment="Left" Style="{StaticResource SelectGroupBox}" >
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="NumberComm_1" Style="{StaticResource SelectRadioButton}" Content="要" Width="100"  Tag="1" />
                                <RadioButton x:Name="NumberComm_0" Style="{StaticResource SelectRadioButton}" Content="不要" Width="100" Tag="0" />
                                <TextBlock x:Name="NumberCommSelected" Visibility="Hidden" Text="{Binding NumberComm.Value}" Width="0" />
                            </StackPanel>
                        </GroupBox>
                        <StackPanel Grid.Row="1" Orientation="Horizontal"  >
                            <Label Content="希望期日" Width="60" Style="{StaticResource KomokuTitle}" />
                            <TextBlock Text="{Binding NumberCommLimitDate.Value, StringFormat=yyyy/MM/dd}" Style="{StaticResource SelectTextBlock}" />
                            <TextBox IsReadOnly="True" Width="50" Style="{StaticResource SelectTextBox}" Text="{Binding NumberCommLimitTime.Value}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <DockPanel Grid.Row="6" Grid.RowSpan="2" LastChildFill="True" >
                    <Label Content="条件" Width="40" Style="{StaticResource KomokuTitle}" DockPanel.Dock="Left" />
                    <TextBox IsReadOnly="True" DockPanel.Dock="Bottom" Style="{StaticResource SelectTextBox}" />
                </DockPanel>

            </Grid>


        </Grid>
        
    </Grid>
</Window>
