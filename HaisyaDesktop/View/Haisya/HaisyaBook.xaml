<Window x:Class="HaisyaDesktop.View.Haisya.HaisyaBook"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dd="urn:gong-wpf-dragdrop"
        xmlns:viewmodel="clr-namespace:HaisyaDesktop.ViewModel.Haisya"
        xmlns:behaviors="clr-namespace:HaisyaDesktop.Behavior" 
        xmlns:local="clr-namespace:HaisyaDesktop.View.Haisya" 
        d:DataContext="{d:DesignInstance Type=viewmodel:HaisyaBookViewModel}"
        mc:Ignorable="d"
        Title="HaisyaTable" MinHeight="800" MinWidth="1200" 
        Closing="Window_Closing" Loaded="Window_Loaded" SizeChanged="Window_SizeChanged">

  <Window.Resources>
    <ResourceDictionary>
      <Style x:Key="ComboboxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="White"/>
        <!--<Setter Property="SelectedValuePath" Value="Id" />-->
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="18" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>


  <Grid x:Name="MainGrid">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="Head" Height="50" />
        <RowDefinition Height="*" />
        <RowDefinition x:Name="Tail" Height="50" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.Background>
          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black"/>
            <GradientStop Color="LightGray" Offset="1"/>
          </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Button Name="btnTopMenu0" Grid.Column="0" Content="メニュー" Style="{StaticResource MenuButtonCommonStyle}" Click="btnMenu_Click" />
        <Button Name="btnTopMenu1" Grid.Column="1" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
        <Button Name="btnTopMenu2" Grid.Column="2" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
        <Button Name="btnTopMenu3" Grid.Column="3" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
        <Button Name="btnTopMenu4" Grid.Column="4" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
        <Button Name="btnTopMenu5" Grid.Column="5" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
      </Grid>

      <Grid Grid.Row="2">
        <Grid.Background>
          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black" Offset="1"/>
            <GradientStop Color="LightGray" Offset="0"/>
          </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Button x:Name="btnUnder0" Grid.Column="0" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
        <Button x:Name="btnUnder1" Grid.Column="1" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
        <Button x:Name="btnUnder2" Grid.Column="2" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
        <Button x:Name="btnUnder3" Grid.Column="3" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
        <Button x:Name="btnUnder4" Grid.Column="4" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
        <Button x:Name="btnUnder5" Grid.Column="5" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
      </Grid>

      <Grid Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="50" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="WhiteSmoke">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.18*" />
            <ColumnDefinition Width="0.13*" />
            <ColumnDefinition Width="0.1*" />
            <ColumnDefinition Width="0.1*" />
            <ColumnDefinition Width="0.32*" />
            <!--<ColumnDefinition Width="0.1*" />-->
          </Grid.ColumnDefinitions>

          <DockPanel Grid.Column="0" Margin="1" >
            <Button Content="前日" Width="60" Tag="Before" Click="TargetDateChange_Click" DockPanel.Dock="Left" />
            <Button Content="翌日" Width="60" Tag="After" Click="TargetDateChange_Click" DockPanel.Dock="Right" />
            <CalendarButton Width="20" Background="LightGreen" DockPanel.Dock="Right" Margin="3"></CalendarButton>
            <TextBlock Text="{Binding TartgetDate.Value, StringFormat=yy/MM/dd}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" />
          </DockPanel>


          <DockPanel Grid.Column="1" Margin="20,2,2,2" >
            <TextBlock Text="配車担当：" VerticalAlignment="Center" FontSize="18"  />
            <ComboBox x:Name="cboTantou" ItemsSource="{Binding TantouItems}" SelectedValue="{Binding SelectTantouID.Value}" SelectedValuePath="Id"  DisplayMemberPath="Name" Style="{StaticResource ComboboxStyle}" SelectionChanged="cbo_SelectionChanged"></ComboBox>
          </DockPanel>
          <DockPanel Grid.Column="2" Margin="10,2,2,2" >
            <TextBlock Text="車種：" VerticalAlignment="Center" FontSize="18" />
            <ComboBox ItemsSource="{Binding SyasyuItems}" SelectedValue="{Binding SelectSyasyu.Value}"  SelectedValuePath="Name"  DisplayMemberPath="Name" Style="{StaticResource ComboboxStyle}" SelectionChanged="cbo_SelectionChanged"></ComboBox>
          </DockPanel>
          <DockPanel Grid.Column="3" Margin="10,2,2,2" >
            <TextBlock Text="型：" VerticalAlignment="Center" FontSize="18" />
            <ComboBox ItemsSource="{Binding KataItems}" SelectedValue="{Binding SelectKata.Value}"  SelectedValuePath="Name"  DisplayMemberPath="Name" Style="{StaticResource ComboboxStyle}" SelectionChanged="cbo_SelectionChanged"></ComboBox>
          </DockPanel>
          

        </Grid>


        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.65*" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="0.35*" />
          </Grid.ColumnDefinitions>
          

          <GridSplitter Grid.Column="1" Background="LightGray" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

          <Grid Grid.Column="0" Background="NavajoWhite">
            <Grid.RowDefinitions>
              <RowDefinition Height="20"/>
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--<StackPanel Orientation="Vertical" Background="Transparent">-->
              <Grid Background ="#3CB371" Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MinWidth="100"/>
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="35" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="50" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="50" />
                  <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Padding="0">
                  <TextBlock HorizontalAlignment="Center"  Text="荷主" />
                </Border>
                <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Padding="0">
                  <TextBlock  HorizontalAlignment="Center"  Text="積地" />
                </Border>
                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1" Padding="0">
                  <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Padding="0" Text="積時間" />
                </Border>
                <Border Grid.Column="3" BorderBrush="Black" BorderThickness="1" Padding="0">
                  <TextBlock  HorizontalAlignment="Center"  Text="卸地" />
                </Border>
                <Border Grid.Column="4" BorderBrush="Black" BorderThickness="1" Padding="0">
                  <TextBlock  HorizontalAlignment="Center"  Text="卸日時" />
                </Border>
                <Border Grid.Column="5" BorderBrush="Black" BorderThickness="1" Padding="0">
                  <TextBlock  HorizontalAlignment="Center"  Text="車種型" />
                </Border>
                <Border Grid.Column="6" BorderBrush="Black" BorderThickness="1" Padding="0">
                  <TextBlock  HorizontalAlignment="Center"  Text="荷物" />
                </Border>
                <Border Grid.Column="7" BorderBrush="Black" BorderThickness="1" Padding="0">
                  <TextBlock  HorizontalAlignment="Center"  Text="備考" />
                </Border>
                <Border Grid.Column="8" BorderBrush="Black" BorderThickness="1" Padding="0">
                  <TextBlock  HorizontalAlignment="Center"  Text="区分" />
                </Border>
                <Border Grid.Column="9" BorderBrush="Black" BorderThickness="1" Padding="0">
                  <TextBlock  HorizontalAlignment="Center"  Text="乗務員" />
                </Border>
              </Grid>
              
              <ListBox x:Name="gridAnkenList"
                     Margin="0,0" Grid.Row="1"
                     BorderThickness="1" BorderBrush="DimGray"
                     ItemsSource="{Binding AnkenData}"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" 
                            CornerRadius="5" Background="Bisque" 
                            Margin="-2,0,-2,0" Padding="0"
                            dd:DragDrop.IsDropTarget="{Binding IsDropTarget}"
                            dd:DragDrop.IsDragSource="{Binding IsDragSource}"
                            dd:DragDrop.DropHandler="{Binding HaisyaBookDropHandler}">
                      <Grid Margin="1,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="0.97*" MinWidth="100" />
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition Width="35" />
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition Width="70" />
                          <ColumnDefinition Width="50" />
                          <ColumnDefinition Width="100" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="50" />
                          <ColumnDefinition Width="95" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0">
                          <TextBlock x:Name="Anken_Customer_Name_Abbr"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left" TextWrapping="Wrap"
                                            Text="{Binding VAnkenDataList.Customer_Name_Abbr}"/>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,0">
                          <TextBlock x:Name="Anken_StartAddressDisplay2"
                                              Margin="3,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" TextWrapping="Wrap"
                                              Text="{Binding VAnkenDataList.StartAddressDisplay2}"/>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,0">
                          <TextBlock x:Name="Anken_START_PointTime"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center" TextWrapping="Wrap"
                                              Text="{Binding VAnkenDataList.START_PointTime}"/>
                        </Border>
                        <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0,0,1,0">
                          <TextBlock x:Name="Anken_EndAddressDisplay2"
                                              Margin="3,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" TextWrapping="Wrap"
                                              Text="{Binding VAnkenDataList.EndAddressDisplay2}"/>
                        </Border>
                        <Border Grid.Column="4" BorderBrush="Black" BorderThickness="0,0,1,0">
                          <TextBlock x:Name="Anken_EndDatetimeDisplay"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Text="{Binding VAnkenDataList.EndDatetimeDisplay}"/>
                        </Border>
                        <Border Grid.Column="5" BorderBrush="Black" BorderThickness="0,0,1,0">
                          <TextBlock x:Name="Anken_SyasyuDisplay2"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Text="{Binding VAnkenDataList.SyasyuDisplay2}"/>
                        </Border>
                        <Border Grid.Column="6" BorderBrush="Black" BorderThickness="0,0,1,0">
                          <TextBlock x:Name="Anken_Luggage"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" TextWrapping="Wrap"
                                          Text="{Binding VAnkenDataList.Luggage}"/>
                        </Border>
                        <Border Grid.Column="7" BorderBrush="Black" BorderThickness="0,0,1,0">
                          <TextBlock x:Name="Anken_Remarks"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left" TextWrapping="Wrap"
                                            Text="{Binding VAnkenDataList.Remarks}"/>
                        </Border>
                        <Border Grid.Column="8" BorderBrush="Black" BorderThickness="0,0,1,0">
                        </Border>

                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            <!--</StackPanel>-->
          </Grid>

          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="7*" />
              <RowDefinition Height="10" />
              <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" />
            <DataGrid Grid.Row="0"
                     Margin="0,0"
                     BorderThickness="1"
                     ItemsSource="{Binding DriverData}"
                     BorderBrush="DimGray"
                     ColumnHeaderStyle="{StaticResource DefaultDataGridHeaderStyle}"
                     AutoGenerateColumns="False"
                     CanUserAddRows="False"
                      
                     dd:DragDrop.IsDragSource="True"
                     dd:DragDrop.UseDefaultDragAdorner="True" 
                     
                     RowHeight="30">
              
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                  <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter Property="Foreground" Value="Black"/>
                      <!--<Setter Property="Background" Value="GoldenRod"/>-->
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.RowStyle>
              
              <!--<dd:DragDrop.DragAdornerTemplate>
                <DataTemplate>
                  <Border BorderThickness="0.3"
                                            BorderBrush="Blue"
                                            Padding="10,2"
                                            Background="AliceBlue">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="200" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding DriverLists.Syaryo_Sayban}"/>
                      <TextBlock Grid.Column="1" Text="{Binding DriverLists.Display_Name}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </dd:DragDrop.DragAdornerTemplate>-->

              <DataGrid.Columns>
                <DataGridTextColumn Header="空車地" IsReadOnly="True" Binding="{Binding DriverLists.Before_PointName}">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="VerticalAlignment" Value="Center"/>
                      <Setter Property="HorizontalAlignment" Value="Center"/>
                      <Setter Property="Margin" Value="10,2" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="車番" IsReadOnly="True" Binding="{Binding DriverLists.Syaryo_Sayban}">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="VerticalAlignment" Value="Center"/>
                      <Setter Property="HorizontalAlignment" Value="Center"/>
                      <Setter Property="Margin" Value="10,2" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="車番2" IsReadOnly="True" Binding="{Binding DriverLists.Syaryo_Sayban_Trailer}">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="VerticalAlignment" Value="Center"/>
                      <Setter Property="HorizontalAlignment" Value="Center"/>
                      <Setter Property="Margin" Value="10,2" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="乗務員" IsReadOnly="True" Binding="{Binding DriverLists.Display_Name}">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="VerticalAlignment" Value="Center"/>
                      <Setter Property="HorizontalAlignment" Value="Center"/>
                      <Setter Property="Margin" Value="10,2" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="車庫" IsReadOnly="True" Binding="{Binding DriverLists.Branch_Name_Abbr}">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="VerticalAlignment" Value="Center"/>
                      <Setter Property="HorizontalAlignment" Value="Center"/>
                      <Setter Property="Margin" Value="10,2" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="車種" IsReadOnly="True" Binding="{Binding DriverLists.SYASYU}">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="VerticalAlignment" Value="Center"/>
                      <Setter Property="HorizontalAlignment" Value="Center"/>
                      <Setter Property="Margin" Value="10,2" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="型" IsReadOnly="True" Binding="{Binding DriverLists.KATA}">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="VerticalAlignment" Value="Center"/>
                      <Setter Property="HorizontalAlignment" Value="Center"/>
                      <Setter Property="Margin" Value="10,2" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="区分" IsReadOnly="True" Binding="{Binding DriverLists.KUBUN}">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="VerticalAlignment" Value="Center"/>
                      <Setter Property="HorizontalAlignment" Value="Center"/>
                      <Setter Property="Margin" Value="10,2" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>

        </Grid>
        
      </Grid>
    </Grid>
  </Grid>
</Window>
