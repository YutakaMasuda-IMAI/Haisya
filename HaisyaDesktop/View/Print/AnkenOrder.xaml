      <DockPanel >
        <UserControls:RichTextBoxToolbar DockPanel.Dock="Top"></UserControls:RichTextBoxToolbar>
        <RichTextBox Name="mainRTB" AcceptsTab="True" Height="300" DockPanel.Dock="Top"></RichTextBox>

      </DockPanel>
    </StackPanel>-->

</Window>
