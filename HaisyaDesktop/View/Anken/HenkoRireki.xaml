<Window x:Class="HaisyaDesktop.View.Anken.HenkoRireki"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HaisyaDesktop.View.Anken"
        mc:Ignorable="d"
        WindowState="Normal"
        WindowStyle="ThreeDBorderWindow"
        WindowStartupLocation="CenterOwner"
        Title="案件変更履歴" MinHeight="450" MinWidth="800">

  <Window.Resources>
    <Style x:Key="KomokuTitle" TargetType="Label">
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontSize" Value="20" />
      <Setter Property="BorderBrush" Value="Black"/>
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="20,0,0,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Gold" />
    </Style>
    <Style x:Key="KomokuValue" TargetType="TextBlock">
      <Setter Property="Margin" Value="5,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="16" />
    </Style>
  </Window.Resources>


  <Grid x:Name="MainGrid">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="Head" Height="50" />
        <RowDefinition Height="*" />
        <RowDefinition x:Name="Tail" Height="50" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.Background>
          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="DarkBlue"/>
            <GradientStop Color="LightBlue" Offset="0.4"/>
            <GradientStop Color="DarkBlue" Offset="1.1"/>
          </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Button Name="btnTopMenu" Grid.Column="0" Content="メニュー" Style="{StaticResource MenuButtonCommonStyle}" Click="btnTopMenu_Click" />
        <Button Name="btnTopMenu1" Grid.Column="1" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
        <Button Name="btnTopMenu2" Grid.Column="2" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
        <Button Name="btnTopMenu3" Grid.Column="3" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
        <Button Name="btnTopMenu4" Grid.Column="4" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
        <Button Name="btnTopMenu5" Grid.Column="5" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
      </Grid>

      <Grid Grid.Row="2">
        <Grid.Background>
          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="DarkBlue"/>
            <GradientStop Color="LightBlue" Offset="0.4"/>
            <GradientStop Color="DarkBlue" Offset="1.1"/>
          </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Button x:Name="btnUnder0" Grid.Column="0" Content="" Style="{StaticResource MenuButtonCommonStyle}" Click="btnUnder0_Click"  />
        <Button x:Name="btnUnder1" Grid.Column="1" Content="" Style="{StaticResource MenuButtonCommonStyle}" Click="btnUnder1_Click"  />
        <Button x:Name="btnUnder2" Grid.Column="2" Content="" Style="{StaticResource MenuButtonCommonStyle}" Click="btnUnder2_Click" />
        <Button x:Name="btnUnder3" Grid.Column="3" Content="" Style="{StaticResource MenuButtonCommonStyle}" Click="btnUnder3_Click" />
        <Button x:Name="btnUnder4" Grid.Column="4" Content="" Style="{StaticResource MenuButtonCommonStyle}" Click="btnUnder4_Click" />
        <Button x:Name="btnUnder5" Grid.Column="5" Content="" Style="{StaticResource MenuButtonCommonStyle}"  />
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="5*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="5*" />
          <!--<ColumnDefinition Width="200"/>-->
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderBrush="Black" BorderThickness="4" >
        </GridSplitter>

        <!--<Border Grid.Column="4"  BorderBrush="Black" BorderThickness="2">
          <DockPanel>
            <Label DockPanel.Dock="Top" Content="変更履歴" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ListBox Name="HenkoList" Margin="5" ItemsSource="{Binding AnkenList}" BorderThickness="2" Background="Aqua">
              
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="5" BorderThickness="2" BorderBrush="Black" Margin="2" Background="LawnGreen" >
                    <DockPanel>
                      <DockPanel DockPanel.Dock="Top" Margin="0,0,2,0">
                        <Label Content="変更日時： " DockPanel.Dock="Left"  />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding UpdateDateTime, StringFormat=yy/MM/dd HH:mm}" VerticalAlignment="Center" />
                      </DockPanel>
                      <DockPanel DockPanel.Dock="Top">
                        <Label Content="変更者　： " DockPanel.Dock="Left"  />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding UpdateName}" VerticalAlignment="Center" />
                      </DockPanel>

                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>-->


        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" BorderBrush="Black" BorderThickness="2" Background="Gold"  >
            <TextBlock Text="項目" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" />
          </Border>

          <Label Content="配車担当" Grid.Row="1" Style="{StaticResource KomokuTitle}" />
          <Label Content="顧客" Grid.Row="2" Style="{StaticResource KomokuTitle}" />
          <Label Content="車種" Grid.Row="3" Style="{StaticResource KomokuTitle}" />
          <Label Content="積日" Grid.Row="4" Style="{StaticResource KomokuTitle}" />
          <Label Content="卸日" Grid.Row="5" Style="{StaticResource KomokuTitle}" />
          <Label Content="積地" Grid.Row="6" Style="{StaticResource KomokuTitle}" />
          <Label Content="卸地" Grid.Row="7" Style="{StaticResource KomokuTitle}" />
          <Label Content="荷物" Grid.Row="8" Style="{StaticResource KomokuTitle}" />
          <Label Content="装備" Grid.Row="9" Style="{StaticResource KomokuTitle}" />
          <Label Content="車番連絡" Grid.Row="10" Style="{StaticResource KomokuTitle}" />
          <Label Content="条件" Grid.Row="11" Style="{StaticResource KomokuTitle}" />
          <Label Content="ルート" Grid.Row="12" Style="{StaticResource KomokuTitle}" />
          <Label Content="金額" Grid.Row="13" Style="{StaticResource KomokuTitle}" />
        </Grid>

        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" BorderBrush="Black" BorderThickness="2" Background="Aqua" >
            <ComboBox Name="cboAnkenListL" ItemsSource="{Binding AnkenInfoDtoList}" 
                      SelectedIndex="{Binding SelectAnkenListIndexL, UpdateSourceTrigger=PropertyChanged}" 
                      SelectedItem="{Binding SelectedAnkenInfoDtoL, UpdateSourceTrigger=PropertyChanged}" 
                      Margin="1" Background="BlanchedAlmond" VerticalContentAlignment="Center" 
                      SelectionChanged="cboAnkenList_SelectionChanged" 
                      >
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="5" BorderThickness="2" BorderBrush="Black" Margin="3,0,3,0" Padding="5,0,5,0" Background="LawnGreen" >
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <DockPanel  Margin="0,0,2,0">
                        <Label Content="変更日時： " DockPanel.Dock="Left"  FontSize="16" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding UpdateDateTime, StringFormat=yy/MM/dd HH:mm}" VerticalAlignment="Center" FontSize="16" />
                      </DockPanel>
                      <DockPanel Margin="10,0,0,0">
                        <Label Content="変更者： " DockPanel.Dock="Left"  FontSize="16" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding UpdateName}" VerticalAlignment="Center" FontSize="16" />
                      </DockPanel>
                      <DockPanel Margin="50,0,10,0">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding RirekiDisplay}" VerticalAlignment="Center" FontSize="16" />
                      </DockPanel>
                    </StackPanel>
                  </Border>
                   
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Border>

          <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="益田" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="2" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="●●商事" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="3" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="15t平" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="4" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="2022/07/12 09:00-11:00" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="5" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="2022/07/13 10:00" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="6" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="〇〇工場　〇〇支店　(〇〇県〇〇市)" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="7" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="〇〇県〇〇市" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="8" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="〇〇〇〇〇〇〇〇" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="9" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="〇〇〇〇〇〇〇〇" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="10" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="【必要】　期限：前日15：00まで" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="11" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="〇〇〇〇〇〇〇〇" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="12" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="【標準ルート】所要時間:4:47 距離:150km 有料:8,120 原価:62,120" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="13" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="【暫定】運賃:54,000 追加:2,000 有料:8,120 値引:10,000 請求:54,120" Style="{StaticResource KomokuValue}" />
          </Border>
        </Grid>

        <Grid Grid.Column="3">
          <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" BorderBrush="Black" BorderThickness="2" Background="GreenYellow" >
            <ComboBox Name="cboAnkenListR" ItemsSource="{Binding AnkenInfoDtoList}" Margin="1" 
                      SelectedIndex="{Binding SelectAnkenListIndexR.Value, UpdateSourceTrigger=PropertyChanged}" 
                      SelectedItem="{Binding SelectedAnkenInfoDtoR, UpdateSourceTrigger=PropertyChanged}" 
                      Background="BlanchedAlmond" VerticalContentAlignment="Center">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="5" BorderThickness="2" BorderBrush="Black" Margin="3,0,3,0" Padding="5,0,5,0" Background="LawnGreen" >
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <DockPanel  Margin="0,0,2,0">
                        <Label Content="変更日時： " DockPanel.Dock="Left"  FontSize="16" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding UpdateDateTime, StringFormat=yy/MM/dd HH:mm}" VerticalAlignment="Center" FontSize="16" />
                      </DockPanel>
                      <DockPanel Margin="10,0,0,0">
                        <Label Content="変更者： " DockPanel.Dock="Left"  FontSize="16" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding UpdateName}" VerticalAlignment="Center" FontSize="16" />
                      </DockPanel>
                      <DockPanel Margin="50,0,10,0">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding RirekiDisplay}" VerticalAlignment="Center" FontSize="16" />
                      </DockPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Border>

          <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="益田" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="2" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="●●商事" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="3" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="15t平" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="4" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="2022/07/12 09:00-11:00" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="5" BorderBrush="Black" BorderThickness="1" Background="Yellow">
            <TextBlock Text="2022/07/13 08:00" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="6" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="〇〇工場　〇〇支店　(〇〇県〇〇市)" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="7" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="〇〇県〇〇市" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="8" BorderBrush="Black" BorderThickness="1" Background="Yellow">
            <TextBlock Text="××××××××" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="9" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="〇〇〇〇〇〇〇〇" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="10" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="【必要】　期限：前日15：00まで" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="11" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="〇〇〇〇〇〇〇〇" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="12" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="【標準ルート】所要時間:4:47 距離:150km 有料:8,120 原価:62,120" Style="{StaticResource KomokuValue}" />
          </Border>
          <Border Grid.Row="13" BorderBrush="Black" BorderThickness="1">
            <TextBlock Text="【暫定】運賃:54,000 追加:2,000 有料:8,120 値引:10,000 請求:54,120" Style="{StaticResource KomokuValue}" />
          </Border>

        </Grid>

      </Grid>





    </Grid>
  </Grid>
</Window>
