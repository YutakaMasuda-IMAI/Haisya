<Window x:Class="HaisyaDesktop.View.Anken.DriveRouteList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HaisyaDesktop.View.Anken"
        xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" 
        xmlns:vm="clr-namespace:HaisyaDesktop.ViewModel.Anken"
        xmlns:behavior="clr-namespace:HaisyaDesktop.Behavior" 
        d:DataContext="{d:DesignInstance Type=vm:DriveRouteListViewModel}"
        WindowStyle="ThreeDBorderWindow"
        mc:Ignorable="d"
        Title="自動車ルート検索" MinHeight="800" MinWidth="1200" 
        Closing="Window_Closing" Loaded="Window_Loaded">

  <Window.Resources>
    <Style x:Key="dgHeaderStyle" TargetType="DataGridColumnHeader">
      <Setter Property="Background" >
        <Setter.Value>
          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black" Offset="0" />
            <GradientStop Color="Gray" Offset="1" />
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" >
        <Setter.Value>
          <SolidColorBrush Color="{StaticResource {x:Static SystemColors.AppWorkspaceColorKey}}"/>
        </Setter.Value>
      </Setter>
      <Setter Property="BorderThickness" Value="0,1,1,0" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="18"/>
    </Style>
    <Style x:Key="dgCellStyle" TargetType="DataGridCell" >
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type DataGridCell}">
            <Grid Background="{TemplateBinding Background}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="MinHeight" Value="40" />
    </Style>

    <Style x:Key="dgRowStyle" TargetType="DataGridRow" >
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="Black"/>
          <Setter Property="Background" Value="Gold"/>
        </Trigger>
      </Style.Triggers>
    </Style>
      
    <Style x:Key="TitleLavel" TargetType="Label">
      <Setter Property="Margin" Value="20,0,0,0" />
      <Setter Property="FontSize" Value="18" />
    </Style>
    
    <Style x:Key="TitleTextblock" TargetType="TextBlock">
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>

    <LinearGradientBrush x:Key="GrayBlueGradientBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="DarkGray" Offset="0" />
      <GradientStop Color="#CCCCFF" Offset="0.5" />
      <GradientStop Color="DarkGray" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BlueGradientBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="Blue" Offset="0" />
      <GradientStop Color="#CCCCFF" Offset="0.5" />
      <GradientStop Color="Blue" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RedGradientBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="Red" Offset="0" />
      <GradientStop Color="#CCCCFF" Offset="0.5" />
      <GradientStop Color="Red" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GreenGradientBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="GreenYellow" Offset="0" />
      <GradientStop Color="#CCCCFF" Offset="0.5" />
      <GradientStop Color="GreenYellow" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PinkGradientBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="DeepPink" Offset="0" />
      <GradientStop Color="#CCCCFF" Offset="0.5" />
      <GradientStop Color="DeepPink" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SkyBlueGradientBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="SkyBlue" Offset="0" />
      <GradientStop Color="#CCCCFF" Offset="0.5" />
      <GradientStop Color="SkyBlue" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="RouteTile" TargetType="{x:Type Button}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding RouteTitleStyle}" Value="GrayBlueGradientBrush">
          <Setter Property="Background" Value="{StaticResource GrayBlueGradientBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding RouteTitleStyle}" Value="RedGradientBrush">
          <Setter Property="Background" Value="{StaticResource RedGradientBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding RouteTitleStyle}" Value="BlueGradientBrush">
          <Setter Property="Background" Value="{StaticResource BlueGradientBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding RouteTitleStyle}" Value="GreenGradientBrush">
          <Setter Property="Background" Value="{StaticResource GreenGradientBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding RouteTitleStyle}" Value="PinkGradientBrush">
          <Setter Property="Background" Value="{StaticResource PinkGradientBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding RouteTitleStyle}" Value="SkyBlueGradientBrush">
          <Setter Property="Background" Value="{StaticResource SkyBlueGradientBrush}" />
        </DataTrigger>
      </Style.Triggers>
      <Setter Property="Margin" Value="10,1,10,1" />
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" ClipToBounds="True">
              <!-- Outer Rectangle with rounded corners. -->
              <Rectangle x:Name="outerRectangle" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stroke="{TemplateBinding Background}" RadiusX="10" RadiusY="10" StrokeThickness="5" Fill="Transparent" />
              <!-- Inner Rectangle with rounded corners. -->
              <Rectangle x:Name="innerRectangle" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stroke="Transparent" StrokeThickness="15" Fill="{TemplateBinding Background}" RadiusX="10" RadiusY="10" />
              <!-- Present Content (text) of the button. -->
              <DockPanel Name="myContentPresenterDockPanel">
                <ContentPresenter x:Name="myContentPresenter" Margin="10" Content="{TemplateBinding  Content}" TextBlock.Foreground="Black" HorizontalAlignment="Center" />
              </DockPanel>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>


    <Style x:Key="dgCellStyleForOption" TargetType="DataGridCell" >
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type DataGridCell}">
            <Grid Background="{TemplateBinding Background}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style x:Key="aa" TargetType="DataGrid">
      
    </Style>
  </Window.Resources>

  <Grid>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="Head" Height="50" />
        <RowDefinition />
        <!--<RowDefinition x:Name="Tail" Height="20" />-->
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.Background>
          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="DarkGreen"/>
            <GradientStop Color="LightGreen" Offset="1"/>
          </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Button Name="btnTopMenu" Grid.Column="0" Content="閉じる" Style="{StaticResource MenuButtonCommonStyle}" Click="btnMenu_Click" />
        <Button Name="btnTopMenu1" Grid.Column="1" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
        <Button Name="btnTopMenu2" Grid.Column="2" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
        <Button Name="btnTopMenu3" Grid.Column="3" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
        <Button Name="btnTopMenu4" Grid.Column="4" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
        <Button Name="btnTopMenu5" Grid.Column="5" Content="" Style="{StaticResource MenuButtonCommonStyle}" />
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="113*"/>
          <ColumnDefinition Width="37*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="30"/>
          <RowDefinition Height="255"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="WhiteSmoke" Grid.ColumnSpan="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="421*"/>
            <ColumnDefinition Width="179*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Background="Transparent" Grid.ColumnSpan="2">
            <Label Content="車種：" Style="{StaticResource TitleLavel}" />
            <TextBlock Text="{Binding DriveRouteListData[0].Shyasyu}" Style="{StaticResource TitleTextblock}" />
            <Label Content="型：" Style="{StaticResource TitleLavel}" />
            <TextBlock Text="{Binding DriveRouteListData[0].Kata}" Style="{StaticResource TitleTextblock}" />
            <Label Content="車高：" Style="{StaticResource TitleLavel}" />
            <TextBlock Text="{Binding DriveRouteListData[0].Height, StringFormat={}{0:N0}}" Style="{StaticResource TitleTextblock}" />
            <Label Content="車幅：" Style="{StaticResource TitleLavel}" />
            <TextBlock Text="{Binding DriveRouteListData[0].Width, StringFormat={}{0:N0}}" Style="{StaticResource TitleTextblock}" />
            <Label Content="車重：" Style="{StaticResource TitleLavel}" />
            <TextBlock Text="{Binding DriveRouteListData[0].Weight, StringFormat={}{0:N0}}" Style="{StaticResource TitleTextblock}" />
            <Label Content="平均燃費：" Style="{StaticResource TitleLavel}" />
            <TextBlock Text="{Binding DriveRouteListData[0].Nenpi, StringFormat={}{0:N2}}" Style="{StaticResource TitleTextblock}" />
            <!--<Label Content="最大値引率：" Style="{StaticResource TitleLavel}" />
            <TextBlock Text="20％" Style="{StaticResource TitleTextblock}" />-->

            <!--<Label Content="SyasyuDisplay：" Style="{StaticResource TitleLavel}" />
            <TextBlock x:Name="SyasyuDisplay" Text="{Binding SyasyuDisplay2.Value}" />
            <Label Content="TsumiTaskTime：" Style="{StaticResource TitleLavel}" />
            <TextBlock x:Name="TsumiTaskTime" Text="{Binding TsumiTaskTime.Value}" />
            <Label Content="OroshiTaskTime：" Style="{StaticResource TitleLavel}" />
            <TextBlock x:Name="OroshiTaskTime" Text="{Binding OroshiTaskTime.Value}" />-->
          </StackPanel>


        </Grid>

        <Grid Grid.Row="1" Grid.ColumnSpan="2">
          <DataGrid  x:Name="dgDriveRouteList" Margin="0" 
                               VerticalAlignment="Stretch" HorizontalAlignment="Stretch" 
                               ItemsSource="{Binding DriveRouteListData}" 
                               AutoGenerateColumns="False" 
                               HorizontalGridLinesBrush="AntiqueWhite"
                               VerticalGridLinesBrush="AntiqueWhite" 
                               ColumnHeaderStyle="{StaticResource dgHeaderStyle}"
                               CellStyle="{StaticResource dgCellStyle}"
                            
                               CanUserAddRows="false"  
                               ScrollViewer.VerticalScrollBarVisibility="Hidden" 
                               PreviewMouseDoubleClick="dgDriveRouteList_PreviewMouseDoubleClick" 
                               SelectionChanged="dgDriveRouteList_SelectionChanged"
                               >


            <DataGrid.Columns>
              <DataGridTextColumn Header="タイプ" IsReadOnly="True" Binding="{Binding RouteType}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="ルート" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button x:Name="DriveListRouteTitle" Style="{StaticResource RouteTile}" Content="{Binding RouteTypeDisplay}" >

                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="所要時間" IsReadOnly="True" Binding="{Binding TotalTime}" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <!--<Setter Property="Margin" Value="20,0"/>-->
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn  IsReadOnly="True" Binding="{Binding BreakTimeDisplay}" Width="0.8*">
                <DataGridTextColumn.Header>
                  <TextBlock Text="休憩" HorizontalAlignment="Center" />
                </DataGridTextColumn.Header>
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <!--<Setter Property="Margin" Value="10,0"/>-->
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn  IsReadOnly="True" Binding="{Binding RestTimeDisplay}" Width="0.9*">
                <DataGridTextColumn.Header>
                  <TextBlock Text="休息" HorizontalAlignment="Center" />
                </DataGridTextColumn.Header>
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <!--<Setter Property="Margin" Value="10,0"/>-->
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="距離" IsReadOnly="True" Binding="{Binding TotalDistance, StringFormat={}{0:N2}km}" Width="0.9*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <!--<Setter Property="Margin" Value="10,0"/>-->
                    <Setter Property="Padding" Value="2,0" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="消費燃料" IsReadOnly="True" Binding="{Binding FuelConsume, StringFormat={}{0:N2}L}" Width="0.9*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <!--<Setter Property="Margin" Value="10,0"/>-->
                    <Setter Property="Padding" Value="2,0" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="有料道路" IsReadOnly="True" Binding="{Binding Totaltoll, StringFormat={}{0:C}, ConverterCulture=ja-JP}" Width="0.9*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <!--<Setter Property="Margin" Value="10,0"/>-->
                    <Setter Property="Padding" Value="2,0" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>

              <DataGridTemplateColumn IsReadOnly="True" Width="*" >
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="標準運賃&#10;   (距離)" HorizontalAlignment="Center" FontSize="14" />
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid Background="Aquamarine">
                      <TextBlock Text="{Binding StdFreight, StringFormat={}{0:C}, ConverterCulture=ja-JP}"  Foreground="Black"
                                 VerticalAlignment="Center" HorizontalAlignment="Right" Padding="2,0" FontSize="18" >
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn IsReadOnly="True"  Width="*">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text=" 標準運賃&#10;(追加料金)" HorizontalAlignment="Center" FontSize="14" />
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid Background="Aquamarine">
                      <TextBlock Text="{Binding StdExcharge, StringFormat={}{0:C}, ConverterCulture=ja-JP}" Foreground="Black"
                                 VerticalAlignment="Center" HorizontalAlignment="Right" Padding="2,0" FontSize="18" >
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <DataGridTemplateColumn IsReadOnly="True"  Width="*">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="   標準運賃&#10;合計(有料込)" HorizontalAlignment="Center" FontSize="14" />
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid Background="Aquamarine">
                      <TextBlock Text="{Binding StdTotalFreight, StringFormat={}{0:C}, ConverterCulture=ja-JP}" Foreground="Black"
                                 VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="ExtraBold" Padding="2,0" FontSize="18" >
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              
              <DataGridTemplateColumn IsReadOnly="True"  Width="*">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="見積原価&#10; (有料別)" HorizontalAlignment="Center" FontSize="14" />
                </DataGridTemplateColumn.Header>
                <!--<DataGridTemplateColumn.CellStyle>
                  <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="LightSkyBlue"/>
                  </Style>
                </DataGridTemplateColumn.CellStyle>-->
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid Background="LightSkyBlue">
                      <TextBlock Text="{Binding GrossAmount, StringFormat={}{0:C}, ConverterCulture=ja-JP}" Foreground="Black" 
                                 VerticalAlignment="Center" HorizontalAlignment="Right" Padding="2,0" FontSize="18" >
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>


              <DataGridTemplateColumn IsReadOnly="True"  Width="*">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="見積原価&#10; (有料込)" HorizontalAlignment="Center" FontSize="14" />
                </DataGridTemplateColumn.Header>
                <!--<DataGridTemplateColumn.CellStyle>
                  <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="LightSkyBlue"/>
                    <Setter Property="FontWeight" Value="ExtraBold" />
                  </Style>
                </DataGridTemplateColumn.CellStyle>-->
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid Background="LightSkyBlue">
                      <TextBlock Text="{Binding GrossAmountTotal, StringFormat={}{0:C}, ConverterCulture=ja-JP}" Foreground="Black" 
                                 VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="ExtraBold" Padding="2,0" FontSize="18" >
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                
              </DataGridTemplateColumn>

              <DataGridTemplateColumn Header="ルート詳細" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid  >
                      <Button Name="RouteDetail" Margin="5" Content="詳細" Style="{StaticResource DefaultButtonStyle}" Click="RouteDetail_Click" />
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>


          </DataGrid>


        </Grid>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" >
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="3*" />
          </Grid.ColumnDefinitions>
          <Wpf:WebView2 x:Name="webView" Grid.Column="0"  Source="{Binding MapsApiForJSUrl.Value}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  />

          <Grid Grid.Column="1" Margin="3" >
            <!--<Button Content="test" x:Name="Text" Click="Text_ClickAsync" />-->
            <Grid.RowDefinitions>
              <!--<RowDefinition Height="70"/>-->
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--<Grid Grid.Row="0" Background="AliceBlue">
              <StackPanel Orientation="Vertical">
                <TextBlock Text="〇〇商事の値引きは最大２０％です。" FontSize="16" />
                <StackPanel Orientation="Horizontal">
                  <DockPanel>
                    <Label DockPanel.Dock="Left" Content="値引率" Width="60" Padding="0" VerticalAlignment="Center" FontSize="16" />
                    <ComboBox Margin="3,1,10,1" Width="100" HorizontalAlignment="Center" FontSize="16"  >
                      <ComboBoxItem IsSelected="True">0</ComboBoxItem>
                      <ComboBoxItem>5</ComboBoxItem>
                      <ComboBoxItem>10</ComboBoxItem>
                      <ComboBoxItem>15</ComboBoxItem>
                      <ComboBoxItem>20</ComboBoxItem>
                    </ComboBox>
                  </DockPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,0" >
                    <Label  Content="or " FontSize="16"  />
                    <Label Content="値引額" Width="60" Padding="0" VerticalAlignment="Center" FontSize="16" />
                    <TextBox Margin="3,1,3,1" Width="100"  FontSize="16" />
                    <Label  Content="円" FontSize="16"  />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Grid>-->
            <Grid Grid.Row="0">
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>

              <Button Grid.Row="6" IsEnabled="False" Margin="5" Content="顧客契約料金表" FontSize="18" Style="{StaticResource DefaultButtonStyle}" />
              <Button Grid.Row="7" IsEnabled="False" Margin="5" Content="標準運賃表" FontSize="18" Style="{StaticResource DefaultButtonStyle}" />
              <!--<Button x:Name="TEST" Click="TEST_Click" />-->
              <DockPanel Grid.Row="0" Grid.RowSpan="3">
                <Label DockPanel.Dock="Top" FontSize="16">追加料金内訳</Label>
                <DataGrid 
                                    DockPanel.Dock="Top"
                                    ItemsSource="{Binding ExtraChargeList}"
                                    AutoGenerateColumns="False" 
                                    HorizontalGridLinesBrush="AntiqueWhite"
                                    VerticalGridLinesBrush="AntiqueWhite" 
                                    ColumnHeaderStyle="{StaticResource DefaultDataGridHeaderStyle}"
                                    CellStyle="{StaticResource dgCellStyleForOption}"
                                    CanUserAddRows="false" 
                                       >

                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="項目ID" Visibility="Hidden">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding KoumokuId}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="項目名" Width="*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Title}" Margin="2,0,0,0" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="時間" Width="60">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding WorkTime, StringFormat={}{0:F1} H}" HorizontalAlignment="Center" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="標準価格" Width="80">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding StdAmount, StringFormat={}{0:N0}, ConverterCulture=ja-JP}" HorizontalAlignment="Right" Margin="0,0,5,0" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="見積原価" Width="80">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding GrossAmount, StringFormat={}{0:N0}, ConverterCulture=ja-JP}" HorizontalAlignment="Right" Margin="0,0,5,0" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
              <DockPanel Grid.Row="3" Grid.RowSpan="3">

                <DockPanel DockPanel.Dock="Top" >
                  <Label DockPanel.Dock="Left" FontSize="16">過去同様案件</Label>
                  <Button Content="過去案件詳細表示" IsEnabled="False" Style="{StaticResource DefaultButtonStyle}" Margin="20,2,10,2" FontSize="16" />
                </DockPanel>

                <DataGrid  Name="dgPastMatterList"
                                    DockPanel.Dock="Bottom"
                                    ItemsSource="{Binding PastMatterList}"
                                    AutoGenerateColumns="False" 
                                    HorizontalGridLinesBrush="AntiqueWhite"
                                    VerticalGridLinesBrush="AntiqueWhite" 
                                    ColumnHeaderStyle="{StaticResource DefaultDataGridHeaderStyle}"
                                    CellStyle="{StaticResource dgCellStyleForOption}"
                                    CanUserAddRows="false" 
                                    >

                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="日付" Width="80">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding MatterDay, StringFormat=yy/MM/dd}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="積地" Width="*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding FromAddress}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="卸地" Width="*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding ToAddress}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="総額" Width="80">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:C}, ConverterCulture=ja-JP}" HorizontalAlignment="Right" Margin="0,0,5,0" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>

                </DataGrid>
              </DockPanel>
            </Grid>
          </Grid>

        </Grid>

      </Grid>

    </Grid>

  </Grid>
</Window>
