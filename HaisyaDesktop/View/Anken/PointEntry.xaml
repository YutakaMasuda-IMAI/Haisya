<Window x:Class="HaisyaDesktop.View.Anken.PointEntry"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HaisyaDesktop.View.Anken"
        xmlns:vm="clr-namespace:HaisyaDesktop.ViewModel.Anken"
        d:DataContext="{d:DesignInstance Type=vm:PointEntryViewModel}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="None"
        Title="地図ポイント保存" 
        Height="450" Width="600" Loaded="Window_Loaded">

  <Window.Resources>
    <Style x:Key="KomokuTitle" TargetType="Label">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="5,0,0,0" />
    </Style>

    <Style x:Key="ComboboxStyle" TargetType="ComboBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="FontSize" Value="18" />
    </Style>
  </Window.Resources>


  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
        <LinearGradientBrush.GradientStops>
          <GradientStop Offset="0.0" Color="WhiteSmoke" />
          <GradientStop Offset="0.3" Color="WhiteSmoke" />
          <GradientStop Offset="0.4" Color="WhiteSmoke" />
          <GradientStop Offset="1.0" Color="WhiteSmoke" />
        </LinearGradientBrush.GradientStops>
      </LinearGradientBrush>
    </Grid.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="30" />
      <RowDefinition Height="50" />
      <RowDefinition Height="50" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Background="Azure">
      <Label Content="地図ポイント保存" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" />
    </DockPanel>

    <Border Grid.Row="0" BorderBrush="DarkGray" BorderThickness="2" />
    <Border Grid.Row="1" BorderBrush="DarkGray" BorderThickness="2" />
    <Border Grid.Row="2" BorderBrush="DarkGray" BorderThickness="2" />
    <Border Grid.Row="3" BorderBrush="DarkGray" BorderThickness="2" />
    <Grid Grid.Row="1" Margin="2" >
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Button Name="btnReg" Content="登録" Grid.Column="0" Width="150" Margin="5" Background="LightSkyBlue" Click="btnReg_Click" />
      <Button Name="btnClose" Content="閉じる"  Grid.Column="1" Width="150" Margin="5" Click="btnClose_Click"/>
    </Grid>

    <Grid Grid.Row="2">
      <StackPanel Orientation="Horizontal" Margin="10,10">
        <Label Content="公開設定:" Style="{StaticResource KomokuTitle}" HorizontalContentAlignment="Right" Margin="0,0,10,0" />
        <RadioButton x:Name="GroupKubun_0" Tag ="0" GroupName="GroupKubun" Content="個人" Width="0" IsChecked="True" Checked="GroupKubun_Checked" />
        <RadioButton x:Name="GroupKubun_1" Tag ="1" GroupName="GroupKubun" Content="グループ" Width="0" Checked="GroupKubun_Checked" />
        <Border Background="White">
          <ComboBox SelectedValue="{Binding SelectGroupId.Value}" ItemsSource="{Binding PointComboBoxItemsEntrykubun}" 
                  SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource ComboboxStyle}"  Width="250" Margin="0" 
                  ></ComboBox>
        </Border>
        

        <!--<TextBlock x:Name="EntrykubunSelected" Visibility="Hidden" Text="{Binding EntryKubun.Value, UpdateSourceTrigger=PropertyChanged}" Width="0" />-->
      </StackPanel>
    </Grid>
    
    <Grid Grid.Row="3" Margin="10" >
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>

      <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="LightGray" BorderThickness="0,2,0,0" />
      <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="LightGray" BorderThickness="0,2,0,0" />
      <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="LightGray" BorderThickness="0,2,0,0" />
      <Border Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="LightGray" BorderThickness="0,2,0,0" />
      <Border Grid.Row="5" Grid.ColumnSpan="2" BorderBrush="LightGray" BorderThickness="0,2,0,0" />
      <Border Grid.Row="6" Grid.ColumnSpan="2" BorderBrush="LightGray" BorderThickness="0,2,0,0" />

      <Label Content="ポイント名(必須)" Grid.Row="0" Style="{StaticResource KomokuTitle}" HorizontalContentAlignment="Right" Margin="0,0,5,0" />
      <Label Content="郵便番号:" Grid.Row="1" Style="{StaticResource KomokuTitle}" HorizontalContentAlignment="Right" Margin="0,0,5,0" />
      <Label Content="住所:" Grid.Row="2" Style="{StaticResource KomokuTitle}" HorizontalContentAlignment="Right" Margin="0,0,5,0" />
      <Label Content="建物ZIP(地図):" Grid.Row="3" Style="{StaticResource KomokuTitle}" HorizontalContentAlignment="Right" Margin="0,0,5,0" />

      <TextBox Grid.Row="0" Grid.Column="1" FontSize="18" Text="{Binding TPoint.Value.BuildingName}" Margin="5,3,3,3" Padding="2,0,0,0" Background="Aqua" VerticalAlignment="Center" />
      <TextBlock Grid.Row="1" Grid.Column="1" DockPanel.Dock="Left" FontSize="18" Text="{Binding TPoint.Value.Post_code}" Padding="2,0,0,0" VerticalAlignment="Center" />
      <TextBlock Grid.Row="2" Grid.Column="1" DockPanel.Dock="Left" FontSize="18" Text="{Binding TPoint.Value.Address}" Padding="2,0,0,0" VerticalAlignment="Center" />
      <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
        <Label Content="緯度:" Style="{StaticResource KomokuTitle}" Width="40" Margin="0,0,5,0" />
        <TextBlock DockPanel.Dock="Left" FontSize="18" Text="{Binding TPoint.Value.Lat}" Width="200" Padding="2,0,0,0" VerticalAlignment="Center" />
        <Label Content="経度:" Style="{StaticResource KomokuTitle}" Width="40" Margin="20,0,5,0"/>
        <TextBlock DockPanel.Dock="Left" FontSize="18" Text="{Binding TPoint.Value.Lng}" Width="200" Padding="2,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
        <Label Content="県:" Style="{StaticResource KomokuTitle}" Width="30" />
        <TextBlock DockPanel.Dock="Left" FontSize="18" Text="{Binding TPoint.Value.Address2}" Width="90" Padding="2,0,0,0" VerticalAlignment="Center" />
        <Label Content="市区町村:" Style="{StaticResource KomokuTitle}" Width="65" />
        <TextBlock DockPanel.Dock="Left" FontSize="18" Text="{Binding TPoint.Value.Address3}" Width="130" Padding="2,0,0,0" VerticalAlignment="Center" />
        <Label Content="大字:" Style="{StaticResource KomokuTitle}" Width="40" />
        <TextBlock DockPanel.Dock="Left" FontSize="18" Text="{Binding TPoint.Value.Address4}" Width="130" Padding="2,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Grid.Row="3" Grid.Column="1" DockPanel.Dock="Left" FontSize="18" Text="{Binding TPoint.Value.BuildingZid}" Padding="2,0,0,0" VerticalAlignment="Center" />
      <!--<Border Grid.Row="5" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="2,0,2,0" Margin="5,3,3,3" >
        <TextBlock DockPanel.Dock="Left" FontSize="18" Text="{Binding TPoint.Value.Lat}" Padding="2,0,0,0" />
      </Border>-->

    </Grid>
  </Grid>
</Window>
