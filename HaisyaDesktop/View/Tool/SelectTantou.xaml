<Window x:Class="HaisyaDesktop.View.Tool.SelectTantou"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HaisyaDesktop.View.Tool" 
        xmlns:viewmodel="clr-namespace:HaisyaDesktop.ViewModel.Tool" 
        d:DataContext="{d:DesignInstance Type=viewmodel:SelectTantouViewModel}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="ThreeDBorderWindow"
        Title="担当者選択" Height="600" Width="700" Loaded="Window_Loaded">

  <Window.Resources>

  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="30" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Background="Azure">
      <Button Name="btnClose" Content="閉じる" DockPanel.Dock="Right" Width="150" Click="btnClose_Click"/>
      <Label Content="担当者選択" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" />
    </DockPanel>

    <Border Grid.Row="0" BorderBrush="DarkGray" BorderThickness="2" />
    <Border Grid.Row="1" BorderBrush="DarkGray" BorderThickness="2" />
    <Grid Grid.Row="1" >

      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*"/>
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="7*"/>
      </Grid.ColumnDefinitions>

      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Black" />

      <Grid Grid.Column="0" >
        <ListBox x:Name="CompanyBranchListBox" ItemsSource="{Binding CompanyBranchList}"  SelectionChanged="CompanyBranchListBox_SelectionChanged">
          <ListBox.Template>
            <ControlTemplate TargetType="ItemsControl">
              <Border BorderThickness="0" BorderBrush="Transparent" Background="Transparent" CornerRadius="10" >
                <ItemsPresenter Margin="5">
                </ItemsPresenter>
              </Border>
            </ControlTemplate>
          </ListBox.Template>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <DockPanel Height="50">
                  <TextBlock Text="{Binding Branch_Name}" FontSize="30" VerticalAlignment="Center" Margin="5,0,0,0" />
                </DockPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical">
              </StackPanel>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>

          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Foreground" Value="Red" />
              <Setter Property="FontSize" Value="15" />
              <Setter Property="Background" Value="Aquamarine" />
              <Setter Property="Margin" Value="0,0,0,5"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="2" BorderBrush="Black"  >
                      <Border.Effect>
                        <DropShadowEffect
                                                BlurRadius="10"
                                                RenderingBias="Quality"
                                                ShadowDepth="2.5"
                                                Color="Gray" />
                      </Border.Effect>
                      <ContentPresenter >
                      </ContentPresenter>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="Plum" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="LightGray" />
                </Trigger>
              </Style.Triggers>

            </Style>

          </ListBox.ItemContainerStyle>

        </ListBox>
      </Grid>

      <Grid Grid.Column="2">
        <ListBox Name="TantouListBox" ItemsSource="{Binding CompanyUserList}" SelectionChanged="TantouListBox_SelectionChanged" >
          <ListBox.Template>
            <ControlTemplate TargetType="ItemsControl">
              <Border BorderThickness="0" BorderBrush="Transparent" Background="Transparent" CornerRadius="10" >
                <ItemsPresenter Margin="5">
                </ItemsPresenter>
              </Border>
            </ControlTemplate>
          </ListBox.Template>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Height="30">
                <DockPanel  VerticalAlignment="Center">
                  <TextBlock Text="{Binding Last_Name}" DockPanel.Dock="Left" Margin="10,0,0,0" />
                  <TextBlock Text="{Binding First_Name}" DockPanel.Dock="Left" Margin="10,0,0,0" />
                </DockPanel>
              </Grid>

            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical">
              </StackPanel>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>

          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Foreground" Value="Red" />
              <Setter Property="FontSize" Value="15" />
              <Setter Property="Background" Value="Aquamarine" />
              <Setter Property="Margin" Value="0,0,0,5"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="2" BorderBrush="Black"  >
                      <Border.Effect>
                        <DropShadowEffect
                                                BlurRadius="10"
                                                RenderingBias="Quality"
                                                ShadowDepth="2.5"
                                                Color="Gray" />
                      </Border.Effect>
                      <ContentPresenter >
                      </ContentPresenter>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="Plum" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="LightGray" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </Grid>
    </Grid>
  </Grid>
</Window>
