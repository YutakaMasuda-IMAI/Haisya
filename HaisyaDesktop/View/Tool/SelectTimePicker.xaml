<Window x:Class="HaisyaDesktop.View.Tool.SelectTimePicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HaisyaDesktop.View.Tool"
        mc:Ignorable="d"
        WindowStyle="ToolWindow"
        Title="時刻選択" Height="600" Width="800" Background="LightGray" >
  <Window.Resources>
    <Style x:Key="TimeButtonStyle" TargetType="Button">
      <Setter Property="Margin" Value="5" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="20" />

    </Style>

    <Style x:Key="SelectRadioButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}" >
      <Setter Property="Margin" Value="15,5,15,5" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="False">
          <Setter Property="Background" Value="LightCyan" />
        </Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="Green" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ToggleButton">
                <Border BorderThickness="2" BorderBrush="Blue" Background="LightBlue">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="Green"/>
        </Trigger>
      </Style.Triggers>
    </Style>

  </Window.Resources>

  <Grid Background="GoldenRod" Margin="5,0,5,5">
    <Grid.RowDefinitions>
      <RowDefinition Height="30" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>


    <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" />
    <DockPanel Grid.Row="0" Background="Azure">
      <Button Name="btnClose" Content="閉じる" DockPanel.Dock="Right" Width="150" Click="btnClose_Click" Margin="0,0,10,0" />
      <Label Content="時刻選択  ※このUIは暫定です" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" />
    </DockPanel>

    <Grid Grid.Row="1" >
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <!--<RowDefinition Height="*"/>
        <RowDefinition Height="*"/>-->
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Grid.Column="2" Grid.RowSpan="13" Background="LightGray"/>

      <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="Aqua">
        <Border BorderBrush="Gray" BorderThickness="1" />
        <Label Content="時" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="26" />
      </Grid>

      <Grid Grid.Row="0" Grid.Column="3" Background="LightYellow">
        <Border BorderBrush="Gray" BorderThickness="1" />
        <Label Content="分" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="26" />
      </Grid>

      <RadioButton Grid.Row="1" Grid.Column="0" GroupName="Hour" Content="0" Tag="00" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="2" Grid.Column="0" GroupName="Hour" Content="1" Tag="01" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="3" Grid.Column="0" GroupName="Hour" Content="2" Tag="02" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="4" Grid.Column="0" GroupName="Hour" Content="3" Tag="03" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="5" Grid.Column="0" GroupName="Hour" Content="4" Tag="04" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="6" Grid.Column="0" GroupName="Hour" Content="5" Tag="05" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="7" Grid.Column="0" GroupName="Hour" Content="6" Tag="06" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="8" Grid.Column="0" GroupName="Hour" Content="7" Tag="07" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="9" Grid.Column="0" GroupName="Hour" Content="8" Tag="08" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="10" Grid.Column="0" GroupName="Hour" Content="9" Tag="09" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="11" Grid.Column="0" GroupName="Hour" Content="10" Tag="10" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="12" Grid.Column="0" GroupName="Hour" Content="11" Tag="11" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />

      <RadioButton Grid.Row="1" Grid.Column="1" GroupName="Hour" Content="12" Tag="12" Style="{StaticResource SelectRadioButton}" Checked="HourClick"/>
      <RadioButton Grid.Row="2" Grid.Column="1" GroupName="Hour" Content="13" Tag="13" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="3" Grid.Column="1" GroupName="Hour" Content="14" Tag="14" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="4" Grid.Column="1" GroupName="Hour" Content="15" Tag="15" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="5" Grid.Column="1" GroupName="Hour" Content="16" Tag="16" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="6" Grid.Column="1" GroupName="Hour" Content="17" Tag="17" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="7" Grid.Column="1" GroupName="Hour" Content="18" Tag="18" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="8" Grid.Column="1" GroupName="Hour" Content="19" Tag="19" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="9" Grid.Column="1" GroupName="Hour" Content="20" Tag="20" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="10" Grid.Column="1" GroupName="Hour" Content="21" Tag="21" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="11" Grid.Column="1" GroupName="Hour" Content="22" Tag="22" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />
      <RadioButton Grid.Row="12" Grid.Column="1" GroupName="Hour" Content="23" Tag="23" Style="{StaticResource SelectRadioButton}" Checked="HourClick" />

      <RadioButton Grid.Row="1" Grid.Column="3" GroupName="Minute" Grid.RowSpan="2" Content="00" Tag="00" Style="{StaticResource SelectRadioButton}" Click="MinuteClick"/>
      <RadioButton Grid.Row="4" Grid.Column="3" GroupName="Minute" Grid.RowSpan="2" Content="15" Tag="15" Style="{StaticResource SelectRadioButton}" Click="MinuteClick" />
      <RadioButton Grid.Row="7" Grid.Column="3" GroupName="Minute" Grid.RowSpan="2" Content="30" Tag="30" Style="{StaticResource SelectRadioButton}" Click="MinuteClick" />
      <RadioButton Grid.Row="10" Grid.Column="3" GroupName="Minute" Grid.RowSpan="2" Content="45" Tag="45" Style="{StaticResource SelectRadioButton}" Click="MinuteClick" />

    </Grid>

  </Grid>
</Window>
