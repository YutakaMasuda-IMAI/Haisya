<Window x:Class="HaisyaDesktop.View.Tool.SelectAddress"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HaisyaDesktop.Utils"
        xmlns:behavior="clr-namespace:HaisyaDesktop.Behavior" 
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        xmlns:cb="clr-namespace:CalcBinding;assembly=CalcBinding" xmlns:tool="clr-namespace:HaisyaDesktop.ViewModel.Tool" d:DataContext="{d:DesignInstance Type=tool:SelectAddressViewModel}"
        mc:Ignorable="d"
        Title="住所検索" MinHeight="450" MinWidth="800"
        IsEnabled="{cb:Binding !IsBusy, Mode=OneWay}"
        Loaded="Window_Loaded">
  
  <Window.Background>
    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
      <LinearGradientBrush.GradientStops>
        <GradientStop Offset="0.0" Color="DarkGray" />
        <GradientStop Offset="0.5" Color="LightCyan" />
        <GradientStop Offset="1.0" Color="DarkGray" />
      </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>
  </Window.Background>

  <Window.Resources>
    <local:IsGreaterThanConverter x:Key="IsGreaterThanConverter" />
    <!-- Resource -->
    <Style x:Key="ListViewItemStyle1" TargetType="ListViewItem">
      <!--<Setter Property="BorderBrush" Value="Gray"/>-->
      <!--<Setter Property="BorderThickness" Value="0,0,0,1"/>-->
      <!--<Setter Property="Background" Value="Black"/>-->
      <Setter Property="Margin" Value="3"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="False">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border BorderThickness="1" BorderBrush="DimGray" Background="Black">
                  <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0"/>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="Blue"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border BorderThickness="2" BorderBrush="Blue" Background="LightBlue">
                  <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0" />
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ListViewItemStyle2" TargetType="ListViewItem">
      <Setter Property="BorderBrush" Value="Gray"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Background" Value="Black"/>
      <Setter Property="Margin" Value="3"/>
    </Style>

    <Style x:Key="ListViewItemStyle3" TargetType="ListViewItem">
      <!--<Setter Property="BorderBrush" Value="Gray"/>-->
      <!--<Setter Property="BorderThickness" Value="0,0,0,1"/>-->
      <!--<Setter Property="Background" Value="Black"/>-->
      <Setter Property="Margin" Value="3,3,20,3"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="False">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border BorderThickness="1" BorderBrush="DimGray" Background="Black">
                  <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0"/>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="Blue"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border BorderThickness="2" BorderBrush="Blue" Background="LightBlue">
                  <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0" />
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="5">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
        <LinearGradientBrush.GradientStops>
          <GradientStop Offset="0.0" Color="Linen" />
          <GradientStop Offset="0.5" Color="LightCyan" />
          <GradientStop Offset="1.0" Color="Linen" />
        </LinearGradientBrush.GradientStops>
      </LinearGradientBrush>
    </Grid.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="50" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <DockPanel >
        <Button x:Name="Close" Width="200" Content="閉じる" FontSize="20" DockPanel.Dock="Left" Click="Close_Click"></Button>
        <Button x:Name="Close2" Width="200" Content="閉じる" FontSize="20" DockPanel.Dock="Right" Click="Close_Click"></Button>

        <Grid DockPanel.Dock="Bottom" Opacity="0.4">
          <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
              <LinearGradientBrush.GradientStops>
                <GradientStop Offset="0.0" Color="LightCyan" />
                <GradientStop Offset="0.3" Color="Yellow" />
                <GradientStop Offset="0.7" Color="Yellow" />
                <GradientStop Offset="1.0" Color="LightCyan" />
              </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>
          </Grid.Background>
          <Label Content="住所選択" Grid.Row="0" HorizontalContentAlignment="Center" Foreground="Black" FontSize="30" VerticalContentAlignment="Center" Padding="0"  />
        </Grid>
      </DockPanel>
    </Grid>

    <TabControl Grid.Row="1" >

      <TabItem Header="住所選択検索" Height="40" FontSize="20" FontWeight="Bold" Width="200">
        <Grid >
          <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
              <LinearGradientBrush.GradientStops>
                <GradientStop Offset="0.0" Color="PaleTurquoise" />
                <GradientStop Offset="0.3" Color="LightCyan" />
                <GradientStop Offset="0.4" Color="LightCyan" />
                <GradientStop Offset="1.0" Color="PaleTurquoise" />
              </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>
          </Grid.Background>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" x:Name="gridArea" />
            <ColumnDefinition Width="1*" x:Name="gridKen" />
            <ColumnDefinition Width="2*"  />
            <ColumnDefinition Width="2*" x:Name="gridChyo" />
            <ColumnDefinition Width="3*" x:Name="gridAA" />
          </Grid.ColumnDefinitions>

          <ListView x:Name="listViewArea" Grid.Column="0" ItemsSource="{Binding Area}"  ItemContainerStyle="{StaticResource ListViewItemStyle1}" SelectionChanged="listViewArea_SelectionChangedAsync" Background="LightYellow" SelectionMode="Single" >
            <ListView.ItemTemplate>
              <DataTemplate >
                <TextBlock Text="{Binding Name}" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <ListView x:Name="listViewKen" Grid.Column="1" ItemsSource="{Binding Ken}" ItemContainerStyle="{StaticResource ListViewItemStyle1}" Visibility="Hidden" SelectionChanged="listViewKen_SelectionChangedAsync" Background="LightYellow" SelectionMode="Single" >
            <ListView.ItemTemplate>
              <DataTemplate >
                <StackPanel >
                  <Label Content="{Binding Name}" FontSize="35" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="White" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <Grid Grid.Column="2" x:Name="gridShiku">
            <ui:ProgressRing Width="50" Height="50" IsActive="{Binding IsBusy, Mode=OneWay}" />
            <ListView x:Name="listViewShiku" ItemsSource="{Binding Shiku}" ItemContainerStyle="{StaticResource ListViewItemStyle1}" Visibility="Hidden" SelectionChanged="listViewShiku_SelectionChangedAsync" Background="LightYellow" SelectionMode="Single" PreviewMouseDoubleClick="listViewShiku_PreviewMouseDoubleClickAsync" >
              <ListView.ItemTemplate>
                <DataTemplate >
                  <StackPanel x:Name="listViewShikuBtn" Orientation="Vertical" >
                    <Label Content="{Binding NameKana}" FontSize="12" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Foreground="White" Margin="5,0,0,0"  Padding="0"  />
                    <Label Content="{Binding Name}" FontSize="28" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Foreground="White"  Padding="0" />
                  </StackPanel>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>

          <ListView x:Name="listViewChyo" Grid.Column="3" ItemsSource="{Binding Chyo}" ItemContainerStyle="{StaticResource ListViewItemStyle1}" Visibility="Hidden" Background="LightYellow" PreviewMouseDoubleClick="listViewChyo_PreviewMouseDoubleClickAsync" SelectionMode="Single" >
            <ListView.ItemTemplate>
              <DataTemplate >
                <StackPanel Orientation="Vertical">
                  <Label Content="{Binding NameKana}" FontSize="12" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Foreground="White" Margin="5,0,0,0" Padding="0" />
                  <Label Content="{Binding Name}" FontSize="24" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="White"  Padding="0" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <Grid Grid.Column="4">
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>

            <Grid Grid.Row="2">
              <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                  <GradientStop Color="Bisque" Offset="0.0"/>
                  <GradientStop Color="White" Offset="0.3"/>
                  <GradientStop Color="White" Offset="1.0"/>
                </LinearGradientBrush>
              </Grid.Background>
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="登録場所" TextAlignment="Center" FontSize="25" Background="Transparent" />
                <ScrollViewer DockPanel.Dock="Top"  VerticalScrollBarVisibility="Visible">
                  <ListBox ItemsSource="{Binding RegFacility}"  Background="Transparent" >

                    <ListBox.Template>
                      <ControlTemplate TargetType="ItemsControl">
                        <Border BorderThickness="0" BorderBrush="Transparent" Background="Transparent" CornerRadius="10" >
                          <ItemsPresenter Margin="5">
                          </ItemsPresenter>
                        </Border>
                      </ControlTemplate>
                    </ListBox.Template>

                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <StackPanel Orientation="Vertical" Margin="5,0,0,0">
                            <DockPanel>
                              <Label Content="住所　：" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0"  />
                              <TextBlock Text="{Binding Path=Address}" DockPanel.Dock="Left" FontSize="16" />
                            </DockPanel>
                            <DockPanel>
                              <Label Content="登録名：" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0" />
                              <TextBlock Text="{Binding Path=Name}" DockPanel.Dock="Left" FontSize="16" />
                            </DockPanel>
                            <StackPanel Height="5" Background="Red"/>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical">
                        </StackPanel>
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <!-- ListBox.ItemContainerStyleを設定 -->
                    <!--項目にマウスが乗ったときに色を変える、項目が選択されたときに色を変える、といった動作を決定する-->
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="Red" />
                        <Setter Property="FontSize" Value="15" />
                        <Setter Property="Background">
                          <Setter.Value>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                              <GradientStop Color="{DynamicResource ControlLightColor}" Offset="0" />
                              <GradientStop Color="{DynamicResource ControlMediumColor}" Offset="1" />
                            </LinearGradientBrush>
                          </Setter.Value>
                        </Setter>
                        <Setter Property="Margin" Value="0,0,0,5"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ContentControl}">
                              <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="2" BorderBrush="Black"  >
                                <ContentPresenter >
                                </ContentPresenter>
                              </Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <!--<Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="LightPink" />
                          </Trigger>-->
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="Pink" />
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </ListBox.ItemContainerStyle>
                  </ListBox>
                </ScrollViewer>
              </DockPanel>
            </Grid>
            <Grid Grid.Row="0" >
              <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                  <GradientStop Color="SkyBlue" Offset="0.0"/>
                  <GradientStop Color="White" Offset="0.3"/>
                  <GradientStop Color="White" Offset="1.0"/>
                </LinearGradientBrush>
              </Grid.Background>
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="使用率 Top30" TextAlignment="Center" FontSize="25" Background="Transparent" />
                <ScrollViewer DockPanel.Dock="Top"  VerticalScrollBarVisibility="Visible">
                  <ListBox ItemsSource="{Binding MostRecent}"  Background="Transparent" >
                    <ListBox.Template>
                      <ControlTemplate TargetType="ItemsControl">
                        <Border BorderThickness="0" BorderBrush="Transparent" Background="Transparent" CornerRadius="10" >
                          <ItemsPresenter Margin="5">
                          </ItemsPresenter>
                        </Border>
                      </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <StackPanel Orientation="Vertical" Margin="5,0,0,0">
                            <DockPanel>
                              <Label Content="住所　：" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0"  />
                              <TextBlock Text="{Binding Path=Address}" DockPanel.Dock="Left" FontSize="16" />
                            </DockPanel>
                            <DockPanel>
                              <Label Content="登録名：" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0" />
                              <TextBlock Text="{Binding Path=Name}" DockPanel.Dock="Left" FontSize="16" />
                            </DockPanel>
                            <StackPanel Height="5" Background="Blue"/>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical">
                        </StackPanel>
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <!-- ListBox.ItemContainerStyleを設定 -->
                    <!--項目にマウスが乗ったときに色を変える、項目が選択されたときに色を変える、といった動作を決定する-->
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="Red" />
                        <Setter Property="FontSize" Value="15" />
                        <Setter Property="Background">
                          <Setter.Value>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                              <GradientStop Color="{DynamicResource ControlLightColor}" Offset="0" />
                              <GradientStop Color="{DynamicResource ControlMediumColor}" Offset="1" />
                            </LinearGradientBrush>
                          </Setter.Value>
                        </Setter>
                        <Setter Property="Margin" Value="0,0,0,5"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ContentControl}">
                              <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="2" BorderBrush="Black"  >
                                <ContentPresenter >
                                </ContentPresenter>
                              </Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <!--<Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="LightPink" />
                          </Trigger>-->
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="Pink" />
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </ListBox.ItemContainerStyle>
                  </ListBox>
                </ScrollViewer>
              </DockPanel>
            </Grid>
            <Grid Grid.Row="1" >
              <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                  <GradientStop Color="PaleGreen"/>
                  <GradientStop Color="White" Offset="0.3"/>
                  <GradientStop Color="White" Offset="1.0"/>
                </LinearGradientBrush>
              </Grid.Background>
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="直近使用" TextAlignment="Center" FontSize="25" Background="Transparent" />
                <ScrollViewer DockPanel.Dock="Top"  VerticalScrollBarVisibility="Visible">
                  <ListBox ItemsSource="{Binding MostPastPoint}"  Background="Transparent" >
                    <ListBox.Template>
                      <ControlTemplate TargetType="ItemsControl">
                        <Border BorderThickness="0" BorderBrush="Transparent" Background="Transparent" CornerRadius="10" >
                          <ItemsPresenter Margin="5">
                          </ItemsPresenter>
                        </Border>
                      </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <StackPanel Orientation="Vertical" Margin="5,0,0,0">
                            <DockPanel>
                              <Label Content="住所　：" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0"  />
                              <TextBlock Text="{Binding Path=Address}" DockPanel.Dock="Left" FontSize="16" />
                            </DockPanel>
                            <DockPanel>
                              <Label Content="登録名：" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0" />
                              <TextBlock Text="{Binding Path=Name}" DockPanel.Dock="Left" FontSize="16" />
                            </DockPanel>
                            <StackPanel Height="5" Background="Yellow"/>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical">
                        </StackPanel>
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <!-- ListBox.ItemContainerStyleを設定 -->
                    <!--項目にマウスが乗ったときに色を変える、項目が選択されたときに色を変える、といった動作を決定する-->
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="Linen" />
                        <Setter Property="FontSize" Value="15" />
                        <Setter Property="Background">
                          <Setter.Value>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                              <GradientStop Color="{DynamicResource ControlLightColor}" Offset="0" />
                              <GradientStop Color="{DynamicResource ControlMediumColor}" Offset="1" />
                            </LinearGradientBrush>
                          </Setter.Value>
                        </Setter>
                        <Setter Property="Margin" Value="0,0,0,5"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ContentControl}">
                              <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="2" BorderBrush="Black"  >
                                <ContentPresenter >
                                </ContentPresenter>
                              </Border>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <!--<Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="LightPink" />
                          </Trigger>-->
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="Pink" />
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </ListBox.ItemContainerStyle>
                  </ListBox>
                </ScrollViewer>
              </DockPanel>
            </Grid>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="入力検索" Height="40" FontSize="20" FontWeight="Bold" Width="200">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="50" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="絞り込み" TextAlignment="Center" VerticalAlignment="Center" FontSize="32"></TextBlock>

            <ListView x:Name="listViewAreaSearchKey" Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Area}"  ItemContainerStyle="{StaticResource ListViewItemStyle1}" SelectionChanged="listViewAreaForSearchKey_SelectionChangedAsync" Background="LightYellow" SelectionMode="Single" >
              <ListView.ItemTemplate>
                <DataTemplate >
                  <TextBlock Text="{Binding Name}" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>

            <ListView x:Name="listViewKenSearchKey" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding KenForSearchKey}" ItemContainerStyle="{StaticResource ListViewItemStyle1}" SelectionChanged="listViewKenForSearchKey_SelectionChangedAsync" Background="LightYellow" SelectionMode="Single" >
              <ListView.ItemTemplate>
                <DataTemplate >
                  <StackPanel >
                    <Label Content="{Binding Name}" FontSize="35" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="White" />
                  </StackPanel>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>

          <Grid Grid.Column="1">
            <Grid.Background>
              <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="NavajoWhite" Offset="0.0"/>
                <GradientStop Color="LightCyan" Offset="1.0"/>
              </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
              <RowDefinition Height="50" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <TextBox x:Name="key" Width="300" Background="White" Margin="5" FontSize="16" KeyDown="key_KeyDown" InputMethod.PreferredImeState="On" InputMethod.PreferredImeConversionMode="FullShape,Native" />
            </Grid>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="69*" />
                <ColumnDefinition Width="9*"/>
                <ColumnDefinition Width="23*" />
                <ColumnDefinition Width="55*"/>
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0" Margin="2,2,2,2" Grid.ColumnSpan="2">
                <DockPanel>
                  <TextBlock Text="住所検索結果" DockPanel.Dock="top" HorizontalAlignment="Center" />
                  <!--<ui:ProgressRing Width="50" Height="50" IsActive="{Binding IsBusy, Mode=OneWay}" />-->
                  <ListView x:Name="listViewAddress" ItemsSource="{Binding SearchAddressList}" ItemContainerStyle="{StaticResource ListViewItemStyle3}"
                          SelectionChanged="listViewAddress_SelectionChangedAsync" Background="White" SelectionMode="Single" >
                    <ListView.ItemTemplate>
                      <DataTemplate >
                        <StackPanel Orientation="Vertical" >
                          <Label Content="{Binding NameKana}" FontSize="18" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Foreground="White" Margin="5,0,0,0"  Padding="0"  />
                          <Label Content="{Binding Name}" FontSize="18" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Foreground="White"  Padding="0" />
                        </StackPanel>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </DockPanel>
              </Grid>
              <Grid Grid.Column="2" Margin="2,2,2,2" Grid.ColumnSpan="2">
                <DockPanel>
                  <TextBlock Text="建物検索結果" DockPanel.Dock="top" HorizontalAlignment="Center" />
                  <!--<ui:ProgressRing Width="50" Height="50" IsActive="{Binding IsBusy, Mode=OneWay}" />-->
                  <ListView x:Name="listViewTatemono" ItemsSource="{Binding SearchTatemonoList}" ItemContainerStyle="{StaticResource ListViewItemStyle3}"
                          SelectionChanged="listViewTatemono_SelectionChangedAsync" Background="White" SelectionMode="Single" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.CanContentScroll="False" >
                    <ListView.ItemTemplate>
                      <DataTemplate >
                        <Grid Height="50">
                          <DockPanel >
                            <StackPanel Orientation="Vertical" DockPanel.Dock="Left" Margin="10,2,0,2">
                              <TextBlock Text="{Binding building_name}" FontSize="18" Foreground="White"  />
                              <DockPanel>
                                <TextBlock Text="{Binding post_code}" DockPanel.Dock="Left" Foreground="White" />
                                <TextBlock Text="{Binding address}" DockPanel.Dock="Left" Foreground="White" Margin="10,0,0,0" />
                              </DockPanel>
                            </StackPanel>
                          </DockPanel>
                        </Grid>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </DockPanel>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
        
      </TabItem>
      <TabItem Header="登録ポイント" Height="40" FontSize="20" FontWeight="Bold" Width="200">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="50" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="絞り込み" TextAlignment="Center" VerticalAlignment="Center" FontSize="32"></TextBlock>

            <ListView x:Name="listViewAreaForPoint" Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Area}"  ItemContainerStyle="{StaticResource ListViewItemStyle1}" SelectionChanged="listViewAreaForPoint_SelectionChangedAsync" Background="LightYellow" SelectionMode="Single" >
              <ListView.ItemTemplate>
                <DataTemplate >
                  <TextBlock Text="{Binding Name}" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>

            <ListView x:Name="listViewKenForPoint" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding KenForPoint}" ItemContainerStyle="{StaticResource ListViewItemStyle1}" SelectionChanged="listViewKenForPoint_SelectionChangedAsync" Background="LightYellow" SelectionMode="Single" >
              <ListView.ItemTemplate>
                <DataTemplate >
                  <StackPanel >
                    <Label Content="{Binding Name}" FontSize="35" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="White" />
                  </StackPanel>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>

          <Grid Grid.Column="1">
            <Grid.Background>
              <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Wheat" Offset="0.0"/>
                <GradientStop Color="LightCyan" Offset="1.0"/>
              </LinearGradientBrush>
            </Grid.Background>
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="住所ポイント登録リスト" TextAlignment="Center" FontSize="20" Background="Transparent" />
              <ScrollViewer DockPanel.Dock="Top"  VerticalScrollBarVisibility="Visible">
                <ListBox x:Name="listBoxPoint" ItemsSource="{Binding PointList}"  Background="Transparent" 
                         SelectionChanged="listBoxPoint_SelectionChangedAsync" >

                  <ListBox.Template>
                    <ControlTemplate TargetType="ItemsControl">
                      <Border BorderThickness="0" BorderBrush="Transparent" Background="Transparent" CornerRadius="10" >
                        <ItemsPresenter Margin="5">
                        </ItemsPresenter>
                      </Border>
                    </ControlTemplate>
                  </ListBox.Template>

                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <StackPanel Orientation="Vertical" Margin="5,0,0,0">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="16" Margin="0,0,10,0" >
                              <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" >
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=User_ID}" Value="0">
                                      <Setter Property="Text" Value="グループ公開"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=User_ID, Converter={StaticResource IsGreaterThanConverter},ConverterParameter=0}" Value="True" >
                                      <Setter Property="Text" Value="個人公開"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <Label Content=" ポイント名　：" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0"  />
                            <TextBlock Text="{Binding Path=BuildingName}" DockPanel.Dock="Left" FontSize="16" />
                            
                          </DockPanel>
                          <StackPanel Orientation="Horizontal" >
                            <Label Content=" 住所　　　：" DockPanel.Dock="Left" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0" />
                            <TextBlock Text="{Binding Path=Post_code}" DockPanel.Dock="Left" FontSize="16" />
                            <TextBlock Text="{Binding Path=Address}" DockPanel.Dock="Left" FontSize="16" Margin="20,0,0,0"  />
                          </StackPanel>
                          <StackPanel Height="5" Background="Blue"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>

                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Vertical">
                      </StackPanel>
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>

                  <!-- ListBox.ItemContainerStyleを設定 -->
                  <!--項目にマウスが乗ったときに色を変える、項目が選択されたときに色を変える、といった動作を決定する-->
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Foreground" Value="Red" />
                      <Setter Property="FontSize" Value="15" />
                      <Setter Property="Background">
                        <Setter.Value>
                          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="{DynamicResource ControlLightColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource ControlMediumColor}" Offset="1" />
                          </LinearGradientBrush>
                        </Setter.Value>
                      </Setter>
                      <Setter Property="Margin" Value="0,0,0,5"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type ContentControl}">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="2" BorderBrush="Black"  >
                              <ContentPresenter >
                              </ContentPresenter>
                            </Border>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                      <Style.Triggers>
                        <!--<Trigger Property="IsSelected" Value="True">
                          <Setter Property="Background" Value="LightGreen" />
                        </Trigger>-->
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Background" Value="LimeGreen" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                 </ListBox.ItemContainerStyle>
                </ListBox>
              </ScrollViewer>
            </DockPanel>
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>




  </Grid>
</Window>
